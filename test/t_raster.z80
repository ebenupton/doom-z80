                DEVICE  ZXSPECTRUM128
                include "spec.inc"
                ; these harnesses only need the image to start where the
                ; loader expects it; the spilled routines are not theirs
                ORG     ROWLO_A
                DS      ORG_ADDR-$, 0
                include "cold.z80"
                include "math.z80"
                include "raster.z80"
