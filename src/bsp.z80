; ---------------------------------------------------------------------------
; BSP traversal and seg rendering.
;
; Front-to-back walk of DOOM's tree: at each node the near child is visited
; first, then the far one, and either is skipped when its bounding box either
; falls outside the frustum or lands entirely on columns the span list has
; already closed. When the span list empties, the frame is finished and the
; walk unwinds immediately.
;
; Everything here runs with bank 0 paged at $C000, so vertices, segs,
; subsectors, sectors and nodes are all directly addressable.
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; render_frame : build this frame's display list.
; ---------------------------------------------------------------------------
render_frame:
                call    view_setup
                call    sp_reset
                ld      hl,DLIST_BASE
                ld      (dlist_ptr),hl
                xor     a
                ld      (frame_nodes),a
                ld      (frame_ss),a
                ld      (frame_segs),a
                ld      hl,(bsp_root)
                jp      walk

; ---------------------------------------------------------------------------
; walk : HL = child id.  Bit 15 marks a subsector.
; ---------------------------------------------------------------------------
walk:
                ld      a,(sp_count)
                or      a
                ret     z                       ; screen fully occluded
                bit     7,h
                jp      nz,walk_ss

                ld      a,(frame_nodes)
                inc     a
                ld      (frame_nodes),a
                ; node address = NODES + nid * 16
                add     hl,hl
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      de,NODES
                add     hl,de
                ld      (bsp_node),hl
                call    point_on_side           ; A = 0 or 1
                ld      c,a
                ld      hl,(bsp_node)
                ; DOOM's order: descend the near child unconditionally, then
                ; bounding-box test only the far one.  The recursion overwrites
                ; bsp_node, so it and the side ride on the stack.
                push    hl
                push    bc
                ld      de,ND_CHILD0
                or      a
                jr      z,wk_n0
                ld      de,ND_CHILD1
wk_n0:
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ex      de,hl
                call    walk
                ld      a,(sp_count)
                or      a
                jr      z,walk_pop
                pop     bc
                pop     hl
                push    hl
                push    bc
                ld      (bsp_node),hl
                ld      a,c
                xor     1
                call    walk_child
walk_pop:
                pop     bc
                pop     hl
                ret

; walk_child : A = which side (0 or 1) of the node at bsp_node to descend.
walk_child:
                ld      (bsp_side),a
                call    bbox_range              ; carry set when visible
                ret     nc
                ld      a,(bb_lo)
                ld      b,a
                ld      a,(bb_hi)
                ld      c,a
                call    sp_hasgap
                ret     nc
                ld      hl,(bsp_node)
                ld      a,(bsp_side)
                ld      de,ND_CHILD0
                or      a
                jr      z,wc_c0
                ld      de,ND_CHILD1
wc_c0:
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ex      de,hl
                jp      walk

; ---------------------------------------------------------------------------
; walk_ss : HL = subsector id with bit 15 set.
; ---------------------------------------------------------------------------
walk_ss:
                res     7,h
                ld      a,(frame_ss)
                inc     a
                ld      (frame_ss),a
                ; SSEC + ssid * 3
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,de                   ; * 3
                ld      de,SSEC
                add     hl,de
                ld      a,(hl)
                ld      (ss_cnt),a
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (ss_seg),de
                ld      hl,$ffff
                ld      (ch_vtx),hl             ; the chain starts empty
ss_loop:
                ld      a,(ss_cnt)
                or      a
                ret     z
                dec     a
                ld      (ss_cnt),a
                ld      hl,(ss_seg)
                push    hl
                call    render_seg
                pop     hl
                inc     hl
                ld      (ss_seg),hl
                jr      ss_loop

; ---------------------------------------------------------------------------
; point_on_side : DOOM's R_PointOnSide against the node at bsp_node.
; Returns A = 0 (front) or 1 (back).
; ---------------------------------------------------------------------------
point_on_side:
                ld      hl,(bsp_node)
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                push    hl
                ld      hl,(pl_wx)
                or      a
                sbc     hl,de
                ld      (pos_dx),hl
                pop     hl
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                push    hl
                ld      hl,(pl_wy)
                or      a
                sbc     hl,de
                ld      (pos_dy),hl
                pop     hl
                inc     hl
                ld      a,(hl)                  ; rdx
                ld      (pos_ndx),a
                inc     hl
                ld      a,(hl)                  ; rdy
                ld      (pos_ndy),a

                ld      a,(pos_ndx)
                or      a
                jr      nz,pos_notx0
                ; vertical partition
                ld      hl,(pos_dx)
                ld      a,h
                or      l
                jr      z,pos_dxle
                bit     7,h
                jr      nz,pos_dxle
                ; dx > 0
                ld      a,(pos_ndy)
                bit     7,a
                ld      a,0
                ret     z
                ld      a,1
                ret
pos_dxle:
                ld      a,(pos_ndy)
                or      a
                ld      a,0
                ret     z
                bit     7,a
                ld      a,1
                ret     z
                ld      a,0
                ret
pos_notx0:
                ld      a,(pos_ndy)
                or      a
                jr      nz,pos_general
                ; horizontal partition
                ld      hl,(pos_dy)
                ld      a,h
                or      l
                jr      z,pos_dyle
                bit     7,h
                jr      nz,pos_dyle
                ld      a,(pos_ndx)
                bit     7,a
                ld      a,1
                ret     z
                ld      a,0
                ret
pos_dyle:
                ld      a,(pos_ndx)
                bit     7,a
                ld      a,0
                ret     z
                ld      a,1
                ret
pos_general:
                ; left = ndy * dx, right = dy * ndx; front when right < left
                ld      de,(pos_dx)
                ld      a,(pos_ndy)
                call    mul_s16_u8_signed
                ld      (pos_l),hl
                ld      (pos_l+2),a
                ld      de,(pos_dy)
                ld      a,(pos_ndx)
                call    mul_s16_u8_signed
                ; compute left - right as s24
                ld      c,a
                ld      de,(pos_l)
                ex      de,hl
                or      a
                sbc     hl,de
                ld      a,(pos_l+2)
                sbc     a,c
                bit     7,a
                ld      a,0
                ret     z                       ; left - right >= 0 -> front
                ld      a,1
                ret

; mul_s16_u8_signed : A:HL = DE (s16) * A (s8, sign honoured)
mul_s16_u8_signed:
                bit     7,a
                jr      nz,msg_neg
                jp      mul_s16_u8
msg_neg:
                neg
                call    mul_s16_u8
                jp      neg_ahl

; ---------------------------------------------------------------------------
; bbox_range : screen column range of one child's bounding box.
; in : A = 0 or 1, bsp_node set.  out: carry set and bb_lo/bb_hi valid.
;
; The four corners go through the full transform. Corners behind the near
; plane are replaced by the crossing point of the bbox edge they lie on, so a
; box straddling the camera still yields a tight range instead of the whole
; screen.
; ---------------------------------------------------------------------------
bbox_range:
                ; NODEBB + nid*8 + side*4; recover nid from the node pointer
                ld      hl,(bsp_node)
                ld      de,NODES
                or      a
                sbc     hl,de                   ; nid * 16
                srl     h
                rr      l                       ; nid * 8
                ld      de,NODEBB
                add     hl,de
                ld      a,(bsp_side)
                or      a
                jr      z,bb_s0
                ld      de,4
                add     hl,de
bb_s0:
                ld      a,(hl)
                inc     hl
                push    hl
                call    sx4
                ld      (bb_top),hl
                pop     hl
                ld      a,(hl)
                inc     hl
                push    hl
                call    sx4
                ld      (bb_bot),hl
                pop     hl
                ld      a,(hl)
                inc     hl
                push    hl
                call    sx4
                ld      (bb_left),hl
                pop     hl
                ld      a,(hl)
                call    sx4
                ld      (bb_right),hl

                ; --- where does the viewer sit relative to the box? -------
                ld      hl,(pl_x)
                ld      de,(bb_left)
                CMP16F
                jr      c,bb_bx0
                jr      z,bb_bx0                ; px <= left
                ld      hl,(pl_x)
                ld      de,(bb_right)
                CMP16F
                ld      a,1
                jr      c,bb_bxd                ; px < right
                inc     a
                jr      bb_bxd
bb_bx0:         xor     a
bb_bxd:         ld      (bb_bx),a
                ld      hl,(pl_y)
                ld      de,(bb_top)
                CMP16F
                jr      nc,bb_by0               ; py >= top
                ld      hl,(pl_y)
                ld      de,(bb_bot)
                CMP16F
                ld      a,2
                jr      c,bb_byd                ; py < bot
                jr      z,bb_byd                ; py == bot
                dec     a                       ; py > bot
                jr      bb_byd
bb_by0:         xor     a
bb_byd:
                add     a,a
                add     a,a
                ld      b,a
                ld      a,(bb_bx)
                add     a,b                     ; boxpos = by*4 + bx
                cp      5
                jr      nz,bb_notin
                ; viewpoint inside the box: it spans the whole screen
                xor     a
                ld      (bb_lo),a
                ld      a,RENDER_W-1
                ld      (bb_hi),a
                scf
                ret
bb_notin:
                add     a,a
                add     a,a                     ; * 4 bytes per entry
                ld      e,a
                ld      d,0
                ld      hl,CHECKCOORD
                add     hl,de
                ld      (bb_cc),hl

                ; --- angles of the two extremes -------------------------
                ld      hl,(bb_cc)
                call    bb_corner_angle
                ld      (bb_a1),hl
                ld      hl,(bb_cc)
                inc     hl
                inc     hl
                call    bb_corner_angle
                ld      (bb_a2),hl

                ld      hl,(bb_a1)              ; widen by the atanexp bucket
                ld      de,ANGEPS               ; error, so the verdict is a
                add     hl,de                   ; superset of the exact one
                ld      (bb_a1),hl
                ld      hl,(bb_a2)
                ld      de,-ANGEPS
                add     hl,de
                ld      (bb_a2),hl
                ld      de,(bb_a2)
                ld      hl,(bb_a1)
                or      a
                sbc     hl,de
                ld      (bb_span),hl
                bit     7,h
                jp      nz,bb_full              ; more than 180 degrees across

                ; clip the left edge to the field of view
                ld      hl,(bb_a1)
                ld      de,CLIPANGLE
                add     hl,de
                ld      de,2*CLIPANGLE
                or      a
                sbc     hl,de
                jr      c,bb_c1ok
                jr      z,bb_c1ok
                ld      de,(bb_span)            ; HL = tspan - 2*CLIP
                or      a
                sbc     hl,de
                jp      nc,bb_invisible
                ld      hl,CLIPANGLE
                ld      (bb_a1),hl
bb_c1ok:
                ; clip the right edge
                ld      hl,CLIPANGLE
                ld      de,(bb_a2)
                or      a
                sbc     hl,de
                ld      de,2*CLIPANGLE
                or      a
                sbc     hl,de
                jr      c,bb_c2ok
                jr      z,bb_c2ok
                ld      de,(bb_span)
                or      a
                sbc     hl,de
                jp      nc,bb_invisible
                ld      hl,-CLIPANGLE
                ld      (bb_a2),hl
bb_c2ok:
                ld      hl,(bb_a1)
                call    bb_angtox               ; the lookup uses B as a counter
                ld      (bb_sx1),a
                ld      hl,(bb_a2)
                call    bb_angtox
                ld      c,a
                ld      a,(bb_sx1)
                ld      b,a
                ; order, then widen a column each side to absorb the table's
                ; quantisation - the range may only ever be too wide
                ld      a,b
                cp      c
                jr      c,bb_ord
                ld      a,c
                ld      c,b
                ld      b,a
bb_ord:
                ld      a,b
                or      a
                jr      z,bb_lo0
                dec     a
bb_lo0:         ld      (bb_lo),a
                ld      a,c
                cp      RENDER_W-1
                jr      nc,bb_hi0
                inc     a
bb_hi0:         ld      (bb_hi),a
                scf
                ret
bb_full:
                xor     a
                ld      (bb_lo),a
                ld      a,RENDER_W-1
                ld      (bb_hi),a
                scf
                ret
bb_invisible:
                or      a
                ret

; sx4 : HL = A sign-extended, multiplied by four (bounds are stored in
; quarter-prescale bytes).
sx4:
                ld      l,a
                rla
                sbc     a,a
                ld      h,a
                add     hl,hl
                add     hl,hl
                ret

; bb_angtox : HL = view-relative angle -> A = screen column
bb_angtox:
                ld      de,CLIPANGLE
                add     hl,de
                ld      b,6
ba_sh:          srl     h
                rr      l
                djnz    ba_sh
                ld      de,ANGTOX
                add     hl,de
                ld      a,(hl)
                ret

; bb_corner_angle : HL -> a CHECKCOORD pair; returns the corner's angle
; relative to the view direction.
bb_corner_angle:
                ld      a,(hl)
                inc     hl
                ld      c,(hl)
                push    bc
                ld      l,a
                ld      h,0
                ld      de,bb_top
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      hl,(pl_x)
                ex      de,hl
                or      a
                sbc     hl,de
                ld      (pa_dx),hl
                pop     bc
                ld      l,c
                ld      h,0
                ld      de,bb_top
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      hl,(pl_y)
                ex      de,hl
                or      a
                sbc     hl,de
                ld      (pa_dy),hl
                call    ptoa_memo
                ld      a,(pl_ang)
                ld      d,a
                ld      a,h
                sub     d
                ld      h,a                     ; the view angle is a whole byte
                ret

; ---------------------------------------------------------------------------
; ptoa : (pa_dx, pa_dy) -> HL = 16-bit angle, atan2 folded through the first
; octant.  No multiplies: one 8-bit divide and a table lookup.
; ---------------------------------------------------------------------------
; ---------------------------------------------------------------------------
; ptoa_memo : the corner angle, from the memo when this delta pair has been
; through before.  R_PointToAngle is a pure function of the pair, so an entry
; can never go stale - and sibling boxes, and a box and its parent, keep
; handing the same corners back.
; ---------------------------------------------------------------------------
ptoa_memo:
                ld      a,(pa_dx)
                ld      hl,pa_dy
                xor     (hl)
                and     31
                add     a,a
                add     a,a
                add     a,a
                ld      l,a                     ; a page-aligned table, so the
                ld      h,CPM_BASE>>8           ; slot is one shift chain
                ld      (cpm_p),hl
                ld      de,(pa_dx)
                ld      a,e
                cp      (hl)
                jr      nz,cpm_miss
                inc     l
                ld      a,d
                cp      (hl)
                jr      nz,cpm_miss
                inc     l
                ld      de,(pa_dy)
                ld      a,e
                cp      (hl)
                jr      nz,cpm_miss
                inc     l
                ld      a,d
                cp      (hl)
                jr      nz,cpm_miss
                ld      a,CPM_VALID-3
                add     a,l
                ld      l,a
                ld      a,(hl)
                or      a
                jr      z,cpm_miss
                dec     l
                ld      d,(hl)
                dec     l
                ld      e,(hl)
                ex      de,hl
                ret
cpm_miss:
                ld      hl,pa_dx                ; bank the raw pair: ptoa folds
                ld      de,(cpm_p)              ; it in place
                ld      bc,4
                ldir
                call    ptoa
                ex      de,hl
                ld      hl,(cpm_p)
                ld      bc,4
                add     hl,bc
                ld      (hl),e
                inc     hl
                ld      (hl),d
                inc     hl
                ld      (hl),1
                ex      de,hl
                ret

ptoa:
                ld      hl,(pa_dx)
                ld      a,h
                or      l
                jr      nz,pa_go
                ld      hl,(pa_dy)
                ld      a,h
                or      l
                ret     z                       ; the corner is on the viewer
pa_go:
                xor     a
                ld      (pa_oct),a
                ld      hl,(pa_dx)
                bit     7,h
                jr      z,pa_xp
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ld      (pa_dx),hl
                ld      a,4
                ld      (pa_oct),a
pa_xp:
                ld      hl,(pa_dy)
                bit     7,h
                jr      z,pa_yp
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ld      (pa_dy),hl
                ld      a,(pa_oct)
                or      2
                ld      (pa_oct),a
pa_yp:
                ld      hl,(pa_dx)
                ld      de,(pa_dy)
                or      a
                sbc     hl,de
                jr      z,pa_dyge
                jr      nc,pa_dxgt
pa_dyge:
                ld      hl,(pa_dx)
                ld      (pa_num),hl
                ld      hl,(pa_dy)
                ld      (pa_den),hl
                ld      a,(pa_oct)
                or      1
                ld      (pa_oct),a
                jr      pa_norm
pa_dxgt:
                ld      hl,(pa_dy)
                ld      (pa_num),hl
                ld      hl,(pa_dx)
                ld      (pa_den),hl
pa_norm:
                ; The angle inside the octant is a log2 subtraction and one
                ; lookup, not a divide: ta = ATANEXP[L(den) - L(num)].  The
                ; bucket error is bounded, and bbox_range widens by it, so a
                ; verdict can only ever be a superset of the exact one.
                ld      hl,(pa_num)
                ld      a,h
                or      l
                jr      z,pa_zero
                call    lf_log
                ld      (pa_lnum),hl
                ld      hl,(pa_den)
                call    lf_log
                ld      de,(pa_lnum)
                or      a
                sbc     hl,de
                bit     7,h
                jr      z,pa_kpos
                ld      hl,0                    ; rounding jitter near num=den
pa_kpos:
                ld      a,h
                or      a
                jr      z,pa_kok
                ld      l,255                   ; far-ratio tail
pa_kok:
                ld      h,0
                add     hl,hl
                ld      de,ATANEXP
                add     hl,de
                ld      a,(hl)
                inc     hl
                ld      h,(hl)
                ld      l,a
                jp      pa_comb
pa_zero:
                ld      hl,0
                jp      pa_comb

pa_comb:
                ex      de,hl                   ; DE = the first-octant angle
                ld      a,(pa_oct)
                ld      l,a
                ld      h,0
                add     hl,hl
                ld      b,0
                ld      c,a
                add     hl,bc                   ; octant * 3
                ld      bc,OCTTAB
                add     hl,bc
                ld      c,(hl)
                inc     hl
                ld      b,(hl)
                inc     hl
                ld      a,(hl)
                ld      h,b
                ld      l,c
                or      a
                jr      nz,pa_neg
                add     hl,de
                ret
pa_neg:
                or      a
                sbc     hl,de
                ret

; Per-octant base angle and whether the first-octant value is subtracted.
OCTTAB:
                DW      0
                DB      0
                DW      16384
                DB      1
                DW      0
                DB      1
                DW      49152
                DB      0
                DW      32768
                DB      1
                DW      16384
                DB      0
                DW      32768
                DB      0
                DW      49152
                DB      1

; ---------------------------------------------------------------------------
; near_cross : crossing of the near plane by the segment from (cr_vx1, cr_vy1)
; - the clipped endpoint - toward (cr_vx2, cr_vy2).  Carry set, bb_cx = cx.
; ---------------------------------------------------------------------------
near_cross:
                ld      hl,(cr_vy2)
                ld      de,(cr_vy1)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                jp      z,nc_fail
                bit     7,h
                jp      nz,nc_fail
                ld      (nc_d),hl
                ld      hl,NEAR_CROSS
                ld      de,(cr_vy1)
                or      a
                sbc     hl,de
                ld      (nc_n),hl               ; n > 0 because vy1 < 16
nc_norm:
                ld      hl,(nc_d)
                ld      a,h
                or      a
                jr      z,nc_small
                srl     h
                rr      l
                ld      (nc_d),hl
                ld      hl,(nc_n)
                srl     h
                rr      l
                ld      (nc_n),hl
                jr      nc_norm
nc_small:
                ld      a,l
                or      a
                jr      z,nc_use2               ; d became 0: take v2
                ld      c,a                     ; C = d (1..255)
                ld      hl,(nc_n)
                ld      a,h
                or      a
                jr      nz,nc_use2              ; n >= 256 > d
                ld      a,l
                cp      c
                jr      nc,nc_use2              ; n >= d -> t >= 256
                ; t = ((n << 8) + (d >> 1)) / d
                ld      h,a
                ld      l,0
                ld      a,c
                srl     a
                ld      e,a
                ld      d,0
                add     hl,de
                call    div16_8                 ; L = quotient
                ld      a,l
                ld      (nc_t),a
                ld      hl,(cr_vx2)
                ld      de,(cr_vx1)
                or      a
                sbc     hl,de                   ; dvx
                bit     7,h
                jr      nz,nc_negdvx
                ex      de,hl
                ld      a,(nc_t)
                call    mul_s16_u8
                call    rns8_ahl
                ld      de,(cr_vx1)
                add     hl,de
                jr      nc_done
nc_negdvx:
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ex      de,hl                   ; DE = |dvx|
                ld      a,(nc_t)
                call    mul_s16_u8
                call    rns8_ahl
                ex      de,hl
                ld      hl,(cr_vx1)
                or      a
                sbc     hl,de
nc_done:
                ld      (bb_cx),hl
                scf
                ret
nc_use2:
                ld      hl,(cr_vx2)
                ld      (bb_cx),hl
                scf
                ret
nc_fail:
                or      a
                ret

; div16_8 : HL / C -> HL quotient, A remainder
div16_8:
                xor     a
                ld      b,16
d168_l:
                add     hl,hl
                rla
                jr      c,d168_s
                cp      c
                jr      c,d168_n
d168_s:
                sub     c
                inc     l
d168_n:
                djnz    d168_l
                ret

; ---------------------------------------------------------------------------
; vertex_get : HL = vertex index -> vc_ptr points at its cache entry, which
; holds the view-space position and, when in front of the near plane, the
; projected column.
; ---------------------------------------------------------------------------
vertex_get:
                ld      (vg_idx),hl
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,hl
                add     hl,hl
                or      a
                sbc     hl,de                   ; seven bytes an entry
                ld      de,VCACHE_BASE
                add     hl,de
                ld      (vc_ptr),hl
                ld      a,(vc_stamp)
                cp      (hl)
                ret     z
                ld      (hl),a
                push    hl
                pop     ix                      ; IX = the entry
                ; Miss this frame - but the rotation of this vertex is the
                ; same for as long as the angle is, and the frame's whole
                ; contribution is the ref term the transform adds last.  So a
                ; vertex seen at this angle before comes back in two adds.
                call    vx_slot
                and     c
                jr      z,vg_cold
                ld      hl,(vg_idx)
                add     hl,hl
                add     hl,hl
                ld      de,VXCACHE_BASE
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                push    hl
                ld      hl,(vs_rx)
                add     hl,de
                ld      (ix+VC_TVX),l
                ld      (ix+VC_TVX+1),h
                pop     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      hl,(vs_ry)
                add     hl,de
                ld      (ix+VC_TVY),l
                ld      (ix+VC_TVY+1),h
                jp      vg_project
vg_cold:
                ld      a,(hl)
                or      c
                ld      (hl),a
                ld      hl,(vg_idx)
                add     hl,hl
                add     hl,hl
                ld      de,VERTS
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (tv_wx),de
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (tv_wy),de
                ; to_view, inlined: one caller, and the call and return were
                ; a fortieth of what the rotation itself costs
                ld      de,(tv_wx)
                call    rot_sin
                ld      (vs_acc),hl
                ld      (vs_acc+2),a
                ld      de,(tv_wy)
                call    rot_cos
                call    sub_pushed
                call    rns3_ahl
                ld      (ix+VC_TVX),l           ; L(w), before the ref term
                ld      (ix+VC_TVX+1),h
                ld      de,(vs_rx)
                add     hl,de
                ld      (tv_tvx),hl
                ld      de,(tv_wx)
                call    rot_cos
                ld      (vs_acc),hl
                ld      (vs_acc+2),a
                ld      de,(tv_wy)
                call    rot_sin
                call    add_pushed
                call    rns3_ahl
                ld      (ix+VC_TVY),l
                ld      (ix+VC_TVY+1),h
                ld      de,(vs_ry)
                add     hl,de
                push    hl                      ; tvy
                ; bank L(w) for the epoch, then finish the entry
                ld      hl,(vg_idx)
                add     hl,hl
                add     hl,hl
                ld      de,VXCACHE_BASE
                add     hl,de
                ld      a,(ix+VC_TVX)
                ld      (hl),a
                inc     hl
                ld      a,(ix+VC_TVX+1)
                ld      (hl),a
                inc     hl
                ld      a,(ix+VC_TVY)
                ld      (hl),a
                inc     hl
                ld      a,(ix+VC_TVY+1)
                ld      (hl),a
                ld      hl,(tv_tvx)
                ld      (ix+VC_TVX),l
                ld      (ix+VC_TVX+1),h
                pop     hl
                ld      (ix+VC_TVY),l
                ld      (ix+VC_TVY+1),h
vg_project:
                ; HL = tvy: project when in front of the near plane
                call    rs_near
                or      a
                jr      z,vg_front
                xor     a
                ld      (ix+VC_SX),a
                ld      (ix+VC_SX+1),a
                ret
vg_front:
                call    recip
                ld      l,(ix+VC_TVX)
                ld      h,(ix+VC_TVX+1)
                call    project_x
                ld      (ix+VC_SX),l
                ld      (ix+VC_SX+1),h
                ret

; ---------------------------------------------------------------------------
; render_seg : HL = seg index.
; ---------------------------------------------------------------------------
render_seg:
                ; IX = the seg record for the back-face test and the field
                ; fetch; after that IX and IY are the two endpoint cache
                ; records, and the near-plane verdicts ride in registers.
                add     hl,hl
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      de,SEGS
                add     hl,de
                ld      (sg_ptr),hl
                push    hl
                pop     ix
                ld      a,(ix+SG_FLAGS)
                ld      (sg_flags),a

                ; --- back face -----------------------------------------
                ; dot = ldy*(px - lx) - ldx*(py - ly) must be strictly
                ; positive.  Three quarters of DOOM's linedefs are axis
                ; aligned, and for those one term vanishes and the test
                ; collapses to a sign comparison with one delta.
                and     SF_LDX0
                jr      nz,rs_bf_x0
                ld      a,(sg_flags)
                and     SF_LDY0
                jr      nz,rs_bf_y0
                ld      e,(ix+SG_LX)
                ld      d,(ix+SG_LX+1)
                ld      hl,(pl_x)
                or      a
                sbc     hl,de
                ld      (pos_dx),hl             ; px - lx
                ld      e,(ix+SG_LY)
                ld      d,(ix+SG_LY+1)
                ld      hl,(pl_y)
                or      a
                sbc     hl,de                   ; py - ly
                ex      de,hl
                ld      a,(ix+SG_LDX)
                call    mul_s16_u8_signed       ; A:HL = ldx * dy
                ld      (pos_l+2),a             ; the multiply eats BC
                push    hl
                ld      de,(pos_dx)
                ld      a,(ix+SG_LDY)
                call    mul_s16_u8_signed       ; A:HL = ldy * dx
                pop     de
                or      a
                sbc     hl,de
                ld      d,a
                ld      a,(pos_l+2)
                ld      e,a
                ld      a,d
                sbc     a,e                     ; A:HL = ldy*dx - ldx*dy
                ret     m
                or      h
                or      l
                ret     z
                jr      rs_visible
rs_bf_x0:
                ; dot = ldy * (px - lx)
                ld      e,(ix+SG_LX)
                ld      d,(ix+SG_LX+1)
                ld      hl,(pl_x)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                ret     z
                ld      a,h
                xor     (ix+SG_LDY)             ; sign of the product
                ret     m
                jr      rs_visible
rs_bf_y0:
                ; dot = -ldx * (py - ly)
                ld      e,(ix+SG_LY)
                ld      d,(ix+SG_LY+1)
                ld      hl,(pl_y)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                ret     z
                ld      a,h
                xor     (ix+SG_LDX)
                ret     p                       ; product positive -> dot < 0
rs_visible:
                ld      hl,frame_segs
                inc     (hl)

                ; --- seg fields ----------------------------------------
                ld      a,(ix+SG_FH)
                ld      (sg_fh),a
                ld      a,(ix+SG_CH)
                ld      (sg_ch),a
                ld      a,(ix+SG_BFH)
                ld      (sg_bfh),a
                ld      a,(ix+SG_BCH)
                ld      (sg_bch),a
                ld      a,(ix+SG_VHI)
                ld      c,a
                and     1
                ld      h,a
                ld      l,(ix+SG_V1)
                ld      (sg_v1),hl
                ld      a,c
                rrca
                and     1
                ld      h,a
                ld      l,(ix+SG_V2)
                ld      (sg_v2),hl

                ; --- vertices ------------------------------------------
                ld      hl,(sg_v1)
                call    vertex_get
                ld      hl,(vc_ptr)
                push    hl
                ld      hl,(sg_v2)
                call    vertex_get
                ld      hl,(vc_ptr)
                push    hl
                pop     iy                      ; IY = v2's record
                pop     ix                      ; IX = v1's

                ; near-plane verdicts: tvy < NEAR_VERDICT, signed
                ld      l,(ix+VC_TVY)
                ld      h,(ix+VC_TVY+1)
                ld      (cr_vy1),hl
                call    rs_near
                ld      b,a
                ld      l,(iy+VC_TVY)
                ld      h,(iy+VC_TVY+1)
                ld      (cr_vy2),hl
                call    rs_near
                ld      c,a
                ld      (sg_n2),a
                ld      a,b
                ld      (sg_n1),a
                and     c
                ret     nz                      ; both behind the near plane
                ld      a,b
                or      c
                jr      nz,rs_clipx             ; a crossing needs the view x's
rs_front:
                ld      a,b
                or      a
                jr      nz,rs_clip1
                ld      a,c
                or      a
                jr      nz,rs_clip2
                ; both in front: the cached columns
                ld      hl,(cr_vy1)
                call    recip
                ld      (sg_s1),a
                ld      a,(rc_m8)
                ld      (sg_m1),a
                ld      l,(ix+VC_SX)
                ld      h,(ix+VC_SX+1)
                ld      (sg_sx1),hl
                jr      rs_do2
rs_clipx:
                push    bc
                ld      l,(ix+VC_TVX)
                ld      h,(ix+VC_TVX+1)
                ld      (cr_vx1),hl
                ld      l,(iy+VC_TVX)
                ld      h,(iy+VC_TVX+1)
                ld      (cr_vx2),hl
                pop     bc
                jr      rs_front
rs_clip1:
                ; v1 is behind: cross toward v2
                call    near_cross_seg1
                ret     nc
                ld      hl,NEAR_CROSS
                call    recip
                ld      (sg_s1),a
                ld      a,(rc_m8)
                ld      (sg_m1),a
                ld      hl,(bb_cx)
                call    project_x
                ld      (sg_sx1),hl
rs_do2:
                ld      hl,(cr_vy2)
                call    recip
                ld      (sg_s2),a
                ld      a,(rc_m8)
                ld      (sg_m2),a
                ld      l,(iy+VC_SX)
                ld      h,(iy+VC_SX+1)
                ld      (sg_sx2),hl
                jr      rs_havex
rs_clip2:
                ; v2 is behind: cross toward v1
                ld      hl,(cr_vy1)
                call    recip
                ld      (sg_s1),a
                ld      a,(rc_m8)
                ld      (sg_m1),a
                ld      l,(ix+VC_SX)
                ld      h,(ix+VC_SX+1)
                ld      (sg_sx1),hl
                call    near_cross_seg2
                ret     nc
                ld      hl,NEAR_CROSS
                call    recip
                ld      (sg_s2),a
                ld      a,(rc_m8)
                ld      (sg_m2),a
                ld      hl,(bb_cx)
                call    project_x
                ld      (sg_sx2),hl
rs_havex:
                ; order the two columns; a zero-width seg spans none
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                or      a
                sbc     hl,de
                ret     z
                jp      pe,rs_ovf
                jp      m,rs_lt
rs_ge:          ld      hl,(sg_sx2)             ; sx1 > sx2
                ld      de,(sg_sx1)
                jr      rs_range
rs_ovf:         jp      m,rs_ge
rs_lt:          ld      hl,(sg_sx1)             ; sx1 < sx2
                ld      de,(sg_sx2)
rs_range:
                ; HL = xlo, DE = xhi
                bit     7,d
                ret     nz                      ; entirely left of the screen
                bit     7,h
                jr      nz,rs_lo0
                ld      a,h
                or      a
                ret     nz                      ; entirely right of it
                ld      a,l
                jr      rs_lo1
rs_lo0:         xor     a
rs_lo1:         ld      (cl_lo),a
                ld      b,a
                ld      a,d
                or      a
                ld      a,e
                jr      z,rs_hi1
                ld      a,RENDER_W-1
rs_hi1:         ld      (cl_hi),a
                ld      c,a
                xor     a
                ld      (cl_lo+1),a
                ld      (cl_hi+1),a
                call    sp_hasgap
                ret     nc
                jp      render_seg_body

; rs_near : HL = tvy -> A = 1 when it is short of the near plane.
rs_near:
                ld      a,h
                or      a
                jr      nz,rs_nbig
                ld      a,l
                cp      NEAR_VERDICT
                sbc     a,a                     ; -1 when below
                and     1
                ret
rs_nbig:
                rla                             ; carry = sign
                sbc     a,a
                and     1
                ret

near_cross_seg1:
                ld      hl,(cr_vx1)
                ld      de,(cr_vy1)
                jp      near_cross
near_cross_seg2:
                ; swap the endpoints so v2 is the clipped one
                ld      hl,(cr_vx1)
                ld      de,(cr_vx2)
                ld      (cr_vx1),de
                ld      (cr_vx2),hl
                ld      hl,(cr_vy1)
                ld      de,(cr_vy2)
                ld      (cr_vy1),de
                ld      (cr_vy2),hl
                call    near_cross
                push    af
                ld      hl,(cr_vx1)
                ld      de,(cr_vx2)
                ld      (cr_vx1),de
                ld      (cr_vx2),hl
                ld      hl,(cr_vy1)
                ld      de,(cr_vy2)
                ld      (cr_vy1),de
                ld      (cr_vy2),hl
                pop     af
                ret

; ---------------------------------------------------------------------------
; render_seg_body : project the seg's heights, emit its visible edges, and
; apply the occlusion update it implies.
; ---------------------------------------------------------------------------
render_seg_body:
                xor     a
                ld      (sq_n),a
                ; Four segs in five share v1 with the previous seg's v2, and
                ; the front sector is the same right across a subsector, so
                ; that seg's projected pair is this one's - no reciprocal, no
                ; multiply, two loads.
                ld      a,(sg_n1)
                or      a
                jr      nz,rsb_p1
                ld      hl,(ch_vtx)
                ld      de,(sg_v1)
                or      a
                sbc     hl,de
                jr      nz,rsb_p1
                ld      hl,(ch_ft)
                ld      (sg_ft1),hl
                ld      hl,(ch_fb)
                ld      (sg_fb1),hl
                jr      rsb_p2
rsb_p1:
                ld      de,(sg_m1)
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_ft1),hl
                ld      de,(sg_m1)
                ld      a,(sg_fh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_fb1),hl
rsb_p2:
                ld      de,(sg_m2)
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_ft2),hl
                ld      de,(sg_m2)
                ld      a,(sg_fh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_fb2),hl
                ld      hl,$ffff                ; hand the pair to the next seg
                ld      (ch_vtx),hl
                ld      a,(sg_n2)
                or      a
                jr      nz,rsb_p3
                ld      hl,(sg_v2)
                ld      (ch_vtx),hl
                ld      hl,(sg_ft2)
                ld      (ch_ft),hl
                ld      hl,(sg_fb2)
                ld      (ch_fb),hl
rsb_p3:

                ld      a,(sg_flags)
                and     SF_SOLID
                jp      nz,rsb_solid

                ; --- portal --------------------------------------------
                ld      a,(sg_ch)
                ld      b,a
                ld      a,(sg_bch)
                sub     b                       ; bch - ch
                ld      a,0
                jp      p,rsb_nbt0              ; bch >= ch: no upper step
                inc     a
rsb_nbt0:
                ld      (sg_needbt),a
                ld      a,(sg_fh)
                ld      b,a
                ld      a,(sg_bfh)
                sub     b
                ld      a,0
                jp      m,rsb_nbb0
                jr      z,rsb_nbb0
                inc     a
rsb_nbb0:
                ld      (sg_needbb),a

                ld      a,(sg_needbt)
                or      a
                jr      z,rsb_nobt
                ld      de,(sg_m1)
                ld      a,(sg_bch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bt1),hl
                ld      de,(sg_m2)
                ld      a,(sg_bch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bt2),hl
                ld      a,1
                ld      (sg_emitt),a
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                jp      m,rsb_botpart
                jr      z,rsb_botpart
                ld      hl,(sg_ft1)
                ld      de,(sg_ft2)
                call    emit_edge
                jr      rsb_botpart
rsb_nobt:
                xor     a
                ld      (sg_emitt),a
                ld      a,(sg_ch)
                ld      b,a
                ld      a,(sg_bch)
                sub     b
                jp      m,rsb_botpart
                jr      z,rsb_botpart
                ld      a,1
                ld      (sg_emitt),a
rsb_botpart:
                ld      a,(sg_needbb)
                or      a
                jr      z,rsb_nobb
                ld      de,(sg_m1)
                ld      a,(sg_bfh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bb1),hl
                ld      de,(sg_m2)
                ld      a,(sg_bfh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bb2),hl
                ld      a,1
                ld      (sg_emitb),a
                ld      a,(sg_fh)
                ld      hl,vs_vz
                sub     (hl)
                jp      p,rsb_verts
                ld      hl,(sg_fb1)
                ld      de,(sg_fb2)
                call    emit_edge
                jr      rsb_verts
rsb_nobb:
                xor     a
                ld      (sg_emitb),a
                ld      a,(sg_bfh)
                ld      b,a
                ld      a,(sg_fh)
                sub     b
                jp      m,rsb_verts
                jr      z,rsb_verts
                ld      a,1
                ld      (sg_emitb),a
rsb_verts:
                call    fe_prepare
                ; step-face verticals at each endpoint
                ld      a,(sg_flags)
                and     SF_NOVT1
                jr      nz,rsb_v2
                ld      a,(sg_needbt)
                or      a
                jr      z,rsb_v1b
                ld      hl,(sg_sx1)
                ld      (dl_x1),hl
                ld      hl,(sg_ft1)
                ld      (dl_y1),hl
                ld      hl,(sg_bt1)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_v1b:
                ld      a,(sg_needbb)
                or      a
                jr      z,rsb_v2
                ld      hl,(sg_sx1)
                ld      (dl_x1),hl
                ld      hl,(sg_bb1)
                ld      (dl_y1),hl
                ld      hl,(sg_fb1)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_v2:
                ld      a,(sg_flags)
                and     SF_NOVT2
                jr      nz,rsb_tighten
                ld      a,(sg_needbt)
                or      a
                jr      z,rsb_v2b
                ld      hl,(sg_sx2)
                ld      (dl_x1),hl
                ld      hl,(sg_ft2)
                ld      (dl_y1),hl
                ld      hl,(sg_bt2)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_v2b:
                ld      a,(sg_needbb)
                or      a
                jr      z,rsb_tighten
                ld      hl,(sg_sx2)
                ld      (dl_x1),hl
                ld      hl,(sg_bb2)
                ld      (dl_y1),hl
                ld      hl,(sg_fb2)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_tighten:
                ; new top = max(ft, bt), new bottom = min(fb, bb)
                ld      a,(sg_needbt)
                or      a
                jr      z,rsb_tt_f
                ld      hl,(sg_ft1)
                ld      de,(sg_bt1)
                MAX16
                ld      (cl_yt1),hl
                ld      hl,(sg_ft2)
                ld      de,(sg_bt2)
                MAX16
                ld      (cl_yt2),hl
                jr      rsb_tb
rsb_tt_f:
                ld      hl,(sg_ft1)
                ld      (cl_yt1),hl
                ld      hl,(sg_ft2)
                ld      (cl_yt2),hl
rsb_tb:
                ld      a,(sg_needbb)
                or      a
                jr      z,rsb_tb_f
                ld      hl,(sg_fb1)
                ld      de,(sg_bb1)
                MIN16
                ld      (cl_yb1),hl
                ld      hl,(sg_fb2)
                ld      de,(sg_bb2)
                MIN16
                ld      (cl_yb2),hl
                jr      rsb_tgo
rsb_tb_f:
                ld      hl,(sg_fb1)
                ld      (cl_yb1),hl
                ld      hl,(sg_fb2)
                ld      (cl_yb2),hl
rsb_tgo:
                call    set_op_range
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                CMP16F
                ld      a,0
                jr      c,rsb_sw0
                inc     a
rsb_sw0:        ld      (sg_swap),a
                ; the two armed lines are drawn by the fuse itself, after
                ; every unarmed line has met the aperture they narrow
                ld      hl,cl_yt1
                ld      de,fu_tfn
                call    rsb_armfn
                ld      hl,cl_yb1
                ld      de,fu_bfn
                call    rsb_armfn
                jp      sp_fuse

; rsb_armfn : HL -> the pair (y at sx1, y at sx2), DE -> the fn buffer.
rsb_armfn:
                push    de
                ld      a,(sg_swap)
                or      a
                jr      nz,rsb_af_s
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      (cl_ly1),de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (cl_ly2),de
                ld      hl,(sg_sx1)
                ld      (cl_lx1),hl
                ld      hl,(sg_sx2)
                ld      (cl_lx2),hl
                jr      rsb_af_go
rsb_af_s:
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      (cl_ly2),de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (cl_ly1),de
                ld      hl,(sg_sx2)
                ld      (cl_lx1),hl
                ld      hl,(sg_sx1)
                ld      (cl_lx2),hl
rsb_af_go:
                pop     hl
                jp      linfn

; --- one-sided wall --------------------------------------------------------
rsb_solid:
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                jp      m,rsb_s_bot
                jr      z,rsb_s_bot
                ld      hl,(sg_ft1)
                ld      de,(sg_ft2)
                call    emit_edge
rsb_s_bot:
                ld      a,(sg_fh)
                ld      hl,vs_vz
                sub     (hl)
                jp      p,rsb_s_v1
                ld      hl,(sg_fb1)
                ld      de,(sg_fb2)
                call    emit_edge
rsb_s_v1:
                call    fe_prepare
                ld      a,(sg_flags)
                and     SF_NOVT1
                jr      nz,rsb_s_v2
                ld      hl,(sg_sx1)
                ld      (dl_x1),hl
                ld      hl,(sg_ft1)
                ld      (dl_y1),hl
                ld      hl,(sg_fb1)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_s_v2:
                ld      a,(sg_flags)
                and     SF_NOVT2
                jr      nz,rsb_s_op
                ld      hl,(sg_sx2)
                ld      (dl_x1),hl
                ld      hl,(sg_ft2)
                ld      (dl_y1),hl
                ld      hl,(sg_fb2)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_s_op:
                call    set_op_range
                jp      sp_marksolid

; --- helpers ---------------------------------------------------------------
; set_op_range : cl_lo / cl_hi as the half-open column range of the seg.
set_op_range:
                ld      a,(cl_lo)
                ld      l,a
                ld      h,0
                ld      (cl_lo),hl
                ld      a,(cl_hi)
                ld      l,a
                ld      h,0
                inc     hl
                ld      (cl_hi),hl
                ret

; emit_edge : HL = y at sx1, DE = y at sx2; clip and emit the sloped edge.
emit_edge:
                jp      queue_edge

; ---------------------------------------------------------------------------
; DOOM's R_CheckBBox corner table, offsets pre-doubled into the bounds array
; (top = 0, bottom = 2, left = 4, right = 6).  Entry 5 is "viewpoint inside".
; ---------------------------------------------------------------------------
