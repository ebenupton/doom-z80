; ---------------------------------------------------------------------------
; BSP traversal and seg rendering.
;
; Front-to-back walk of DOOM's tree: at each node the near child is visited
; first, then the far one, and either is skipped when its bounding box either
; falls outside the frustum or lands entirely on columns the span list has
; already closed. When the span list empties, the frame is finished and the
; walk unwinds immediately.
;
; Everything here runs with bank 0 paged at $C000, so vertices, segs,
; subsectors, sectors and nodes are all directly addressable.
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; render_frame : build this frame's display list.
; ---------------------------------------------------------------------------
render_frame:
                call    view_setup
                call    sp_reset
                ld      hl,DLIST_BASE
                ld      (dlist_ptr),hl
                xor     a
                ld      (frame_nodes),a
                ld      (frame_ss),a
                ld      (frame_segs),a
                ld      hl,(bsp_root)
                jp      walk

; ---------------------------------------------------------------------------
; walk : HL = child id.  Bit 15 marks a subsector.
; ---------------------------------------------------------------------------
walk:
                ld      a,(sp_count)
                or      a
                ret     z                       ; screen fully occluded
                bit     7,h
                jp      nz,walk_ss

                ld      a,(frame_nodes)
                inc     a
                ld      (frame_nodes),a
                ; node address = NODES + nid * 16
                add     hl,hl
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      de,NODES
                add     hl,de
                ld      (bsp_node),hl
                call    point_on_side           ; A = 0 or 1
                ld      c,a
                ld      hl,(bsp_node)
                ; DOOM's order: descend the near child unconditionally, then
                ; bounding-box test only the far one.  The recursion overwrites
                ; bsp_node, so it and the side ride on the stack.
                push    hl
                push    bc
                ld      de,ND_CHILD0
                or      a
                jr      z,wk_n0
                ld      de,ND_CHILD1
wk_n0:
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ex      de,hl
                call    walk
                ld      a,(sp_count)
                or      a
                jr      z,walk_pop
                pop     bc
                pop     hl
                push    hl
                push    bc
                ld      (bsp_node),hl
                ld      a,c
                xor     1
                call    walk_child
walk_pop:
                pop     bc
                pop     hl
                ret

; walk_child : A = which side (0 or 1) of the node at bsp_node to descend.
walk_child:
                ld      (bsp_side),a
                call    bbox_range              ; carry set when visible
                ret     nc
                ld      a,(bb_lo)
                ld      b,a
                ld      a,(bb_hi)
                ld      c,a
                call    sp_hasgap
                ret     nc
                ld      hl,(bsp_node)
                ld      a,(bsp_side)
                ld      de,ND_CHILD0
                or      a
                jr      z,wc_c0
                ld      de,ND_CHILD1
wc_c0:
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ex      de,hl
                jp      walk

; ---------------------------------------------------------------------------
; walk_ss : HL = subsector id with bit 15 set.
; ---------------------------------------------------------------------------
walk_ss:
                res     7,h
                ld      a,(frame_ss)
                inc     a
                ld      (frame_ss),a
                ; SSEC + ssid * 3
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,de                   ; * 3
                ld      de,SSEC
                add     hl,de
                ld      a,(hl)
                ld      (ss_cnt),a
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (ss_seg),de
                ld      hl,$ffff
                ld      (ch_vtx),hl             ; the chain starts empty
ss_loop:
                ld      a,(ss_cnt)
                or      a
                ret     z
                dec     a
                ld      (ss_cnt),a
                ld      hl,(ss_seg)
                push    hl
                call    render_seg
                pop     hl
                inc     hl
                ld      (ss_seg),hl
                jr      ss_loop

; ---------------------------------------------------------------------------
; point_on_side : DOOM's R_PointOnSide against the node at bsp_node.
; Returns A = 0 (front) or 1 (back).
; ---------------------------------------------------------------------------
point_on_side:
                ld      hl,(bsp_node)
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                push    hl
                ld      hl,(pl_wx)
                or      a
                sbc     hl,de
                ld      (pos_dx),hl
                pop     hl
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                push    hl
                ld      hl,(pl_wy)
                or      a
                sbc     hl,de
                ld      (pos_dy),hl
                pop     hl
                inc     hl
                ld      a,(hl)                  ; rdx
                ld      (pos_ndx),a
                inc     hl
                ld      a,(hl)                  ; rdy
                ld      (pos_ndy),a

                ld      a,(pos_ndx)
                or      a
                jr      nz,pos_notx0
                ; vertical partition
                ld      hl,(pos_dx)
                ld      a,h
                or      l
                jr      z,pos_dxle
                bit     7,h
                jr      nz,pos_dxle
                ; dx > 0
                ld      a,(pos_ndy)
                bit     7,a
                ld      a,0
                ret     z
                ld      a,1
                ret
pos_dxle:
                ld      a,(pos_ndy)
                or      a
                ld      a,0
                ret     z
                bit     7,a
                ld      a,1
                ret     z
                ld      a,0
                ret
pos_notx0:
                ld      a,(pos_ndy)
                or      a
                jr      nz,pos_general
                ; horizontal partition
                ld      hl,(pos_dy)
                ld      a,h
                or      l
                jr      z,pos_dyle
                bit     7,h
                jr      nz,pos_dyle
                ld      a,(pos_ndx)
                bit     7,a
                ld      a,1
                ret     z
                ld      a,0
                ret
pos_dyle:
                ld      a,(pos_ndx)
                bit     7,a
                ld      a,0
                ret     z
                ld      a,1
                ret
pos_general:
                ; left = ndy * dx, right = dy * ndx; front when right < left
                ld      de,(pos_dx)
                ld      a,(pos_ndy)
                call    mul_s16_u8_signed
                ld      (pos_l),hl
                ld      (pos_l+2),a
                ld      de,(pos_dy)
                ld      a,(pos_ndx)
                call    mul_s16_u8_signed
                ; compute left - right as s24
                ld      c,a
                ld      de,(pos_l)
                ex      de,hl
                or      a
                sbc     hl,de
                ld      a,(pos_l+2)
                sbc     a,c
                bit     7,a
                ld      a,0
                ret     z                       ; left - right >= 0 -> front
                ld      a,1
                ret

; mul_s16_u8_signed : A:HL = DE (s16) * A (s8, sign honoured)
mul_s16_u8_signed:
                bit     7,a
                jr      nz,msg_neg
                jp      mul_s16_u8
msg_neg:
                neg
                call    mul_s16_u8
                jp      neg_ahl

; ---------------------------------------------------------------------------
; bbox_range : screen column range of one child's bounding box.
; in : A = 0 or 1, bsp_node set.  out: carry set and bb_lo/bb_hi valid.
;
; The four corners go through the full transform. Corners behind the near
; plane are replaced by the crossing point of the bbox edge they lie on, so a
; box straddling the camera still yields a tight range instead of the whole
; screen.
; ---------------------------------------------------------------------------
bbox_range:
                ; NODEBB + nid*8 + side*4; recover nid from the node pointer
                ld      hl,(bsp_node)
                ld      de,NODES
                or      a
                sbc     hl,de                   ; nid * 16
                srl     h
                rr      l                       ; nid * 8
                ld      a,(bsp_side)
                or      a
                jr      z,bb_s0
                ld      de,NODEBB+4
                jr      bb_s1
bb_s0:          ld      de,NODEBB
bb_s1:          add     hl,de
                push    hl
                pop     ix                      ; IX -> top, bottom, left, right

                ; --- the bounds go straight to viewer-relative deltas: the
                ; position test wants their signs, and the corner angles
                ; want the deltas themselves.  Each pair is taken with the
                ; deciding bound last, so its flags are the ones still live.
                ld      bc,(pl_y)
                ld      a,(ix+1)
                BB_DELTA
                ld      (bb_bot),hl
                ld      e,2                     ; py <= bottom
                jp      p,bb_by1
                ld      e,1                     ; between the two
bb_by1:         ld      a,(ix+0)
                BB_DELTA
                ld      (bb_top),hl
                jr      z,bb_by0
                jp      m,bb_by0
                jr      bb_byd
bb_by0:         ld      e,0                     ; py >= top
bb_byd:
                ld      bc,(pl_x)
                ld      a,(ix+3)
                BB_DELTA
                ld      (bb_right),hl
                ld      d,2                     ; px >= right
                jr      z,bb_bx1
                jp      m,bb_bx1
                ld      d,1
bb_bx1:         ld      a,(ix+2)
                BB_DELTA
                ld      (bb_left),hl
                jp      m,bb_bxd
                ld      d,0                     ; px <= left
bb_bxd:
                ld      a,e
                add     a,a
                add     a,a
                add     a,d                     ; boxpos = by*4 + bx
                cp      5
                jp      z,bb_full               ; the viewer is inside the box
                add     a,a
                add     a,a                     ; * 4 bytes per entry
                ld      e,a
                ld      d,0
                ld      hl,CHECKCOORD
                add     hl,de

                ; --- angles of the two extremes, widened by the atanexp
                ; bucket error so the verdict is a superset of the exact one
                push    hl
                call    bb_corner_angle
                ld      de,ANGEPS
                add     hl,de
                ex      (sp),hl                 ; a1 down, the table pointer up
                inc     hl
                inc     hl
                call    bb_corner_angle
                ld      de,-ANGEPS
                add     hl,de
                ex      de,hl                   ; DE = a2
                pop     hl                      ; HL = a1
                push    de
                push    hl
                or      a
                sbc     hl,de                   ; the span
                jp      m,bb_full2              ; more than 180 degrees across
                ld      b,h
                ld      c,l                     ; BC = span

                ; clip the left edge to the field of view; u = angle + CLIP
                ; is the form the column lookup wants anyway
                pop     hl
                ld      de,CLIPANGLE
                add     hl,de
                ex      de,hl                   ; DE = u1
                ld      hl,-2*CLIPANGLE
                add     hl,de
                jr      nc,bb_c1ok              ; u1 < 2*CLIP: inside
                ld      a,h
                or      l
                jr      z,bb_c1ok
                or      a
                sbc     hl,bc
                jr      nc,bb_invisible1
                ld      de,2*CLIPANGLE
bb_c1ok:
                ; and the right edge
                pop     hl                      ; a2
                push    de                      ; u1
                ld      de,CLIPANGLE
                add     hl,de
                ex      de,hl                   ; DE = u2
                ld      hl,2*CLIPANGLE
                or      a
                sbc     hl,de                   ; CLIP - a2
                push    de
                ld      de,2*CLIPANGLE
                or      a
                sbc     hl,de
                pop     de
                jr      c,bb_c2ok
                jr      z,bb_c2ok
                or      a
                sbc     hl,bc
                jr      nc,bb_invisible1
                ld      de,0
bb_c2ok:
                call    bb_angtox
                ld      c,a
                pop     de
                call    bb_angtox
                ld      b,a
                ; order, then widen a column each side to absorb the table's
                ; quantisation - the range may only ever be too wide
                cp      c
                jr      c,bb_ord
                ld      a,c
                ld      c,b
                ld      b,a
bb_ord:
                ld      a,b
                or      a
                jr      z,bb_lo0
                dec     a
bb_lo0:         ld      (bb_lo),a
                ld      a,c
                cp      RENDER_W-1
                jr      nc,bb_hi0
                inc     a
bb_hi0:         ld      (bb_hi),a
                scf
                ret
bb_full2:
                pop     hl
                pop     hl
bb_full:
                xor     a
                ld      (bb_lo),a
                ld      a,RENDER_W-1
                ld      (bb_hi),a
                scf
                ret
bb_invisible1:
                pop     hl
                or      a
                ret

; bb_angtox : DE = view-relative angle + CLIPANGLE, 0..2*CLIPANGLE -> A =
; the screen column.  The shift by six is a shift up by two read a byte
; high, with the carry catching the 257th entry.
bb_angtox:
                ex      de,hl
                add     hl,hl
                add     hl,hl
                ld      l,h
                ld      h,0
                jr      nc,ba_lo
                inc     h
ba_lo:          ld      de,ANGTOX
                add     hl,de
                ld      a,(hl)
                ret

; bb_corner_angle : HL -> a CHECKCOORD pair, the low bytes of the corner's
; two deltas; returns the corner's angle relative to the view direction.
bb_corner_angle:
                ld      a,(hl)
                inc     hl
                ld      l,(hl)
                ld      h,bb_top>>8
                ld      e,(hl)
                inc     l
                ld      d,(hl)                  ; DE = dy
                ld      l,a
                ld      a,(hl)
                inc     l
                ld      h,(hl)
                ld      l,a                     ; HL = dx
                call    ptoa_memo
                ld      a,(pl_ang)
                ld      d,a
                ld      a,h
                sub     d
                ld      h,a                     ; the view angle is a whole byte
                ret

; ---------------------------------------------------------------------------
; ptoa_memo : HL = dx, DE = dy -> HL = the corner's angle, from the memo when
; this delta pair has been through before.  R_PointToAngle is a pure
; function of the pair, so an entry can never go stale - and sibling boxes,
; and a box and its parent, keep handing the same corners back.
; ---------------------------------------------------------------------------
ptoa_memo:
                ld      a,l
                xor     e
                and     31
                add     a,a
                add     a,a
                add     a,a
                ld      c,a                     ; a page-aligned table, so the
                ld      b,CPM_BASE>>8           ; slot is one shift chain
                ld      a,(bc)
                cp      l
                jr      nz,cpm_miss
                inc     c
                ld      a,(bc)
                cp      h
                jr      nz,cpm_miss
                inc     c
                ld      a,(bc)
                cp      e
                jr      nz,cpm_miss
                inc     c
                ld      a,(bc)
                cp      d
                jr      nz,cpm_miss
                ld      a,c
                add     a,CPM_VALID-3
                ld      c,a
                ld      a,(bc)
                or      a
                jr      z,cpm_miss
                dec     c
                ld      a,(bc)
                ld      h,a
                dec     c
                ld      a,(bc)
                ld      l,a
                ret
cpm_miss:
                ld      a,c
                and     $f8
                ld      c,a                     ; back to the slot's start
                ld      a,l
                ld      (bc),a
                inc     c
                ld      a,h
                ld      (bc),a
                inc     c
                ld      a,e
                ld      (bc),a
                inc     c
                ld      a,d
                ld      (bc),a
                inc     c
                push    bc
                call    ptoa
                pop     bc
                ld      a,l
                ld      (bc),a
                inc     c
                ld      a,h
                ld      (bc),a
                inc     c
                ld      a,1
                ld      (bc),a
                ret

; ---------------------------------------------------------------------------
; ptoa : HL = dx, DE = dy -> HL = 16-bit angle, atan2 folded through the
; first octant.  No multiplies and no divide: the angle inside the octant is
; a log2 subtraction and one lookup, ta = ATANEXP[L(den) - L(num)].  The
; bucket error is bounded, and bbox_range widens by it, so a verdict can
; only ever be a superset of the exact one.
; ---------------------------------------------------------------------------
ptoa:
                ld      c,0                     ; the octant
                bit     7,h
                jr      z,pa_xp
                xor     a
                sub     l
                ld      l,a
                sbc     a,a
                sub     h
                ld      h,a
                ld      c,4
pa_xp:          bit     7,d
                jr      z,pa_yp
                xor     a
                sub     e
                ld      e,a
                sbc     a,a
                sub     d
                ld      d,a
                set     1,c
pa_yp:          ; HL = |dx|, DE = |dy|
                ld      a,h
                or      l
                jr      nz,pa_go
                ld      a,d
                or      e
                ret     z                       ; the corner is on the viewer
pa_go:
                push    hl
                or      a
                sbc     hl,de
                pop     hl
                jr      z,pa_dyge
                jr      nc,pa_dxgt
pa_dyge:
                inc     c                       ; the octant is even here
                jr      pa_norm                 ; num = dx, den = dy
pa_dxgt:
                ex      de,hl                   ; num = dy, den = dx
pa_norm:
                ld      a,h
                or      l
                jr      z,pa_zero
                push    de
                call    lf_log
                pop     de
                push    hl
                ex      de,hl
                call    lf_log
                pop     de
                or      a
                sbc     hl,de                   ; L(den) - L(num)
                bit     7,h
                jr      z,pa_kpos
                ld      hl,0                    ; rounding jitter near num=den
pa_kpos:
                ld      a,h
                or      a
                jr      z,pa_kok
                ld      l,255                   ; far-ratio tail
pa_kok:
                ld      h,0
                add     hl,hl
                ld      de,ATANEXP
                add     hl,de
                ld      a,(hl)
                inc     hl
                ld      h,(hl)
                ld      l,a
                jr      pa_comb
pa_zero:
                ld      hl,0
pa_comb:
                ex      de,hl                   ; DE = the first-octant angle
                ld      l,c
                ld      h,0
                add     hl,hl
                add     hl,hl                   ; octant * 4
                ld      bc,OCTTAB
                add     hl,bc
                ld      c,(hl)
                inc     hl
                ld      b,(hl)
                inc     hl
                ld      a,(hl)
                ld      h,b
                ld      l,c
                or      a
                jr      nz,pa_neg
                add     hl,de
                ret
pa_neg:
                sbc     hl,de
                ret

OCTTAB:
                DW      0
                DB      0,0
                DW      16384
                DB      1,0
                DW      0
                DB      1,0
                DW      49152
                DB      0,0
                DW      32768
                DB      1,0
                DW      16384
                DB      0,0
                DW      32768
                DB      0,0
                DW      49152
                DB      1,0


near_cross:
                ld      hl,(cr_vy2)
                ld      de,(cr_vy1)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                jp      z,nc_fail
                bit     7,h
                jp      nz,nc_fail
                ld      (nc_d),hl
                ld      hl,NEAR_CROSS
                ld      de,(cr_vy1)
                or      a
                sbc     hl,de
                ld      (nc_n),hl               ; n > 0 because vy1 < 16
nc_norm:
                ld      hl,(nc_d)
                ld      a,h
                or      a
                jr      z,nc_small
                srl     h
                rr      l
                ld      (nc_d),hl
                ld      hl,(nc_n)
                srl     h
                rr      l
                ld      (nc_n),hl
                jr      nc_norm
nc_small:
                ld      a,l
                or      a
                jr      z,nc_use2               ; d became 0: take v2
                ld      c,a                     ; C = d (1..255)
                ld      hl,(nc_n)
                ld      a,h
                or      a
                jr      nz,nc_use2              ; n >= 256 > d
                ld      a,l
                cp      c
                jr      nc,nc_use2              ; n >= d -> t >= 256
                ; t = ((n << 8) + (d >> 1)) / d
                ld      h,a
                ld      l,0
                ld      a,c
                srl     a
                ld      e,a
                ld      d,0
                add     hl,de
                call    div16_8                 ; L = quotient
                ld      a,l
                ld      (nc_t),a
                ld      hl,(cr_vx2)
                ld      de,(cr_vx1)
                or      a
                sbc     hl,de                   ; dvx
                bit     7,h
                jr      nz,nc_negdvx
                ex      de,hl
                ld      a,(nc_t)
                call    mul_s16_u8
                call    rns8_ahl
                ld      de,(cr_vx1)
                add     hl,de
                jr      nc_done
nc_negdvx:
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ex      de,hl                   ; DE = |dvx|
                ld      a,(nc_t)
                call    mul_s16_u8
                call    rns8_ahl
                ex      de,hl
                ld      hl,(cr_vx1)
                or      a
                sbc     hl,de
nc_done:
                ld      (bb_cx),hl
                scf
                ret
nc_use2:
                ld      hl,(cr_vx2)
                ld      (bb_cx),hl
                scf
                ret
nc_fail:
                or      a
                ret

; div16_8 : HL / C -> HL quotient, A remainder
div16_8:
                xor     a
                ld      b,16
d168_l:
                add     hl,hl
                rla
                jr      c,d168_s
                cp      c
                jr      c,d168_n
d168_s:
                sub     c
                inc     l
d168_n:
                djnz    d168_l
                ret

; ---------------------------------------------------------------------------
; vertex_get : HL = vertex index -> vc_ptr points at its cache entry, which
; holds the view-space position and, when in front of the near plane, the
; projected column.
; ---------------------------------------------------------------------------
vertex_get:
                ld      (vg_idx),hl
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,hl
                add     hl,hl
                or      a
                sbc     hl,de                   ; seven bytes an entry
                ld      de,VCACHE_BASE
                add     hl,de
                ld      (vc_ptr),hl
                ld      a,(vc_stamp)
                cp      (hl)
                ret     z
                ld      (hl),a
                push    hl
                pop     ix                      ; IX = the entry
                ; Miss this frame - but the rotation of this vertex is the
                ; same for as long as the angle is, and the frame's whole
                ; contribution is the ref term the transform adds last.  So a
                ; vertex seen at this angle before comes back in two adds.
                call    vx_slot
                and     c
                jr      z,vg_cold
                ld      hl,(vg_idx)
                add     hl,hl
                add     hl,hl
                ld      de,VXCACHE_BASE
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                push    hl
                ld      hl,(vs_rx)
                add     hl,de
                ld      (ix+VC_TVX),l
                ld      (ix+VC_TVX+1),h
                pop     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      hl,(vs_ry)
                add     hl,de
                ld      (ix+VC_TVY),l
                ld      (ix+VC_TVY+1),h
                jp      vg_project
vg_cold:
                or      c
                ld      (hl),a                  ; the epoch's valid bit
                ld      hl,(vg_idx)
                add     hl,hl
                add     hl,hl
                ld      de,VXCACHE_BASE
                add     hl,de
                push    hl
                pop     iy                      ; IY -> the banked L(w)
                ld      de,VERTS-VXCACHE_BASE
                add     hl,de                   ; HL -> the vertex
                ld      c,(hl)
                inc     hl
                ld      b,(hl)
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)                  ; BC = wx, DE = wy
                push    bc
                push    de
                ; the two wy products first, so wx's each land on a whole
                ; s24 accumulator
                call    rot_cos                 ; A:HL = wy * cos
                ld      (vs_acc),hl
                ld      (vs_acc+2),a
                pop     de
                call    rot_sin                 ; A:HL = wy * sin
                ld      (vs_acc2),hl
                ld      (vs_acc2+2),a
                pop     de                      ; wx
                push    de
                call    rot_sin                 ; A:HL = wx * sin
                ld      de,(vs_acc)
                or      a
                sbc     hl,de
                ld      c,a
                ld      a,(vs_acc+2)
                ld      d,a
                ld      a,c
                sbc     a,d                     ; wx*sin - wy*cos
                RNS3                            ; HL = L(w)x
                ld      (iy+0),l
                ld      (iy+1),h
                ld      de,(vs_rx)
                add     hl,de
                ld      (ix+VC_TVX),l
                ld      (ix+VC_TVX+1),h
                pop     de                      ; wx
                call    rot_cos                 ; A:HL = wx * cos
                ld      de,(vs_acc2)
                add     hl,de
                ld      d,a
                ld      a,(vs_acc2+2)
                adc     a,d                     ; wx*cos + wy*sin
                RNS3                            ; HL = L(w)y
                ld      (iy+2),l
                ld      (iy+3),h
                ld      de,(vs_ry)
                add     hl,de
                ld      (ix+VC_TVY),l
                ld      (ix+VC_TVY+1),h
vg_project:
                ; HL = tvy: project when in front of the near plane
                bit     7,h
                jr      nz,vg_behind
                ld      a,h
                or      a
                jr      nz,vg_front
                ld      a,l
                cp      NEAR_VERDICT
                jr      nc,vg_front
vg_behind:
                xor     a
                ld      (ix+VC_SX),a
                ld      (ix+VC_SX+1),a
                ret
vg_front:
                call    recip
                ld      l,(ix+VC_TVX)
                ld      h,(ix+VC_TVX+1)
                call    project_x
                ld      (ix+VC_SX),l
                ld      (ix+VC_SX+1),h
                ret

; ---------------------------------------------------------------------------
; render_seg : HL = seg index.
; ---------------------------------------------------------------------------
render_seg:
                ; IX = the seg record for the back-face test and the field
                ; fetch; after that IX and IY are the two endpoint cache
                ; records, and the near-plane verdicts ride in registers.
                add     hl,hl
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      de,SEGS
                add     hl,de
                ld      (sg_ptr),hl
                push    hl
                pop     ix
                ld      a,(ix+SG_FLAGS)
                ld      (sg_flags),a

                ; --- back face -----------------------------------------
                ; dot = ldy*(px - lx) - ldx*(py - ly) must be strictly
                ; positive.  Three quarters of DOOM's linedefs are axis
                ; aligned, and for those one term vanishes and the test
                ; collapses to a sign comparison with one delta.
                and     SF_LDX0
                jr      nz,rs_bf_x0
                ld      a,(sg_flags)
                and     SF_LDY0
                jr      nz,rs_bf_y0
                ld      e,(ix+SG_LX)
                ld      d,(ix+SG_LX+1)
                ld      hl,(pl_x)
                or      a
                sbc     hl,de
                ld      (pos_dx),hl             ; px - lx
                ld      e,(ix+SG_LY)
                ld      d,(ix+SG_LY+1)
                ld      hl,(pl_y)
                or      a
                sbc     hl,de                   ; py - ly
                ex      de,hl
                ld      a,(ix+SG_LDX)
                call    mul_s16_u8_signed       ; A:HL = ldx * dy
                ld      (pos_l+2),a             ; the multiply eats BC
                push    hl
                ld      de,(pos_dx)
                ld      a,(ix+SG_LDY)
                call    mul_s16_u8_signed       ; A:HL = ldy * dx
                pop     de
                or      a
                sbc     hl,de
                ld      d,a
                ld      a,(pos_l+2)
                ld      e,a
                ld      a,d
                sbc     a,e                     ; A:HL = ldy*dx - ldx*dy
                ret     m
                or      h
                or      l
                ret     z
                jr      rs_visible
rs_bf_x0:
                ; dot = ldy * (px - lx)
                ld      e,(ix+SG_LX)
                ld      d,(ix+SG_LX+1)
                ld      hl,(pl_x)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                ret     z
                ld      a,h
                xor     (ix+SG_LDY)             ; sign of the product
                ret     m
                jr      rs_visible
rs_bf_y0:
                ; dot = -ldx * (py - ly)
                ld      e,(ix+SG_LY)
                ld      d,(ix+SG_LY+1)
                ld      hl,(pl_y)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                ret     z
                ld      a,h
                xor     (ix+SG_LDX)
                ret     p                       ; product positive -> dot < 0
rs_visible:
                ld      hl,frame_segs
                inc     (hl)

                ; --- seg fields ----------------------------------------
                ld      a,(ix+SG_FH)
                ld      (sg_fh),a
                ld      a,(ix+SG_CH)
                ld      (sg_ch),a
                ld      a,(ix+SG_BFH)
                ld      (sg_bfh),a
                ld      a,(ix+SG_BCH)
                ld      (sg_bch),a
                ld      a,(ix+SG_VHI)
                ld      c,a
                and     1
                ld      h,a
                ld      l,(ix+SG_V1)
                ld      (sg_v1),hl
                ld      a,c
                rrca
                and     1
                ld      h,a
                ld      l,(ix+SG_V2)
                ld      (sg_v2),hl

                ; --- vertices ------------------------------------------
                ld      hl,(sg_v1)
                call    vertex_get
                ld      hl,(vc_ptr)
                push    hl
                ld      hl,(sg_v2)
                call    vertex_get
                ld      hl,(vc_ptr)
                push    hl
                pop     iy                      ; IY = v2's record
                pop     ix                      ; IX = v1's

                ; near-plane verdicts: tvy < NEAR_VERDICT, signed
                ld      l,(ix+VC_TVY)
                ld      h,(ix+VC_TVY+1)
                ld      (cr_vy1),hl
                call    rs_near
                ld      b,a
                ld      l,(iy+VC_TVY)
                ld      h,(iy+VC_TVY+1)
                ld      (cr_vy2),hl
                call    rs_near
                ld      c,a
                ld      (sg_n2),a
                ld      a,b
                ld      (sg_n1),a
                and     c
                ret     nz                      ; both behind the near plane
                ld      a,b
                or      c
                jr      nz,rs_clipx             ; a crossing needs the view x's
rs_front:
                ld      a,b
                or      a
                jr      nz,rs_clip1
                ld      a,c
                or      a
                jr      nz,rs_clip2
                ; both in front: the cached columns
                ld      hl,(cr_vy1)
                call    recip
                ld      (sg_s1),a
                ld      a,e
                ld      (sg_m1),a
                ld      l,(ix+VC_SX)
                ld      h,(ix+VC_SX+1)
                ld      (sg_sx1),hl
                jr      rs_do2
rs_clipx:
                push    bc
                ld      l,(ix+VC_TVX)
                ld      h,(ix+VC_TVX+1)
                ld      (cr_vx1),hl
                ld      l,(iy+VC_TVX)
                ld      h,(iy+VC_TVX+1)
                ld      (cr_vx2),hl
                pop     bc
                jr      rs_front
rs_clip1:
                ; v1 is behind: cross toward v2
                call    near_cross_seg1
                ret     nc
                ld      hl,NEAR_CROSS
                call    recip
                ld      (sg_s1),a
                ld      a,e
                ld      (sg_m1),a
                ld      hl,(bb_cx)
                call    project_x
                ld      (sg_sx1),hl
rs_do2:
                ld      hl,(cr_vy2)
                call    recip
                ld      (sg_s2),a
                ld      a,e
                ld      (sg_m2),a
                ld      l,(iy+VC_SX)
                ld      h,(iy+VC_SX+1)
                ld      (sg_sx2),hl
                jr      rs_havex
rs_clip2:
                ; v2 is behind: cross toward v1
                ld      hl,(cr_vy1)
                call    recip
                ld      (sg_s1),a
                ld      a,e
                ld      (sg_m1),a
                ld      l,(ix+VC_SX)
                ld      h,(ix+VC_SX+1)
                ld      (sg_sx1),hl
                call    near_cross_seg2
                ret     nc
                ld      hl,NEAR_CROSS
                call    recip
                ld      (sg_s2),a
                ld      a,e
                ld      (sg_m2),a
                ld      hl,(bb_cx)
                call    project_x
                ld      (sg_sx2),hl
rs_havex:
                ; order the two columns; a zero-width seg spans none
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                or      a
                sbc     hl,de
                ret     z
                jp      pe,rs_ovf
                jp      m,rs_lt
rs_ge:          ld      hl,(sg_sx2)             ; sx1 > sx2
                ld      de,(sg_sx1)
                jr      rs_range
rs_ovf:         jp      m,rs_ge
rs_lt:          ld      hl,(sg_sx1)             ; sx1 < sx2
                ld      de,(sg_sx2)
rs_range:
                ; HL = xlo, DE = xhi
                bit     7,d
                ret     nz                      ; entirely left of the screen
                bit     7,h
                jr      nz,rs_lo0
                ld      a,h
                or      a
                ret     nz                      ; entirely right of it
                ld      a,l
                jr      rs_lo1
rs_lo0:         xor     a
rs_lo1:         ld      (cl_lo),a
                ld      b,a
                ld      a,d
                or      a
                ld      a,e
                jr      z,rs_hi1
                ld      a,RENDER_W-1
rs_hi1:         ld      (cl_hi),a
                ld      c,a
                xor     a
                ld      (cl_lo+1),a
                ld      (cl_hi+1),a
                call    sp_hasgap
                ret     nc
                jp      render_seg_body

; rs_near : HL = tvy -> A = 1 when it is short of the near plane.
rs_near:
                ld      a,h
                or      a
                jr      nz,rs_nbig
                ld      a,l
                cp      NEAR_VERDICT
                sbc     a,a                     ; -1 when below
                and     1
                ret
rs_nbig:
                rla                             ; carry = sign
                sbc     a,a
                and     1
                ret

near_cross_seg1:
                ld      hl,(cr_vx1)
                ld      de,(cr_vy1)
                jp      near_cross
near_cross_seg2:
                ; swap the endpoints so v2 is the clipped one
                ld      hl,(cr_vx1)
                ld      de,(cr_vx2)
                ld      (cr_vx1),de
                ld      (cr_vx2),hl
                ld      hl,(cr_vy1)
                ld      de,(cr_vy2)
                ld      (cr_vy1),de
                ld      (cr_vy2),hl
                call    near_cross
                push    af
                ld      hl,(cr_vx1)
                ld      de,(cr_vx2)
                ld      (cr_vx1),de
                ld      (cr_vx2),hl
                ld      hl,(cr_vy1)
                ld      de,(cr_vy2)
                ld      (cr_vy1),de
                ld      (cr_vy2),hl
                pop     af
                ret

; ---------------------------------------------------------------------------
; render_seg_body : project the seg's heights, emit its visible edges, and
; apply the occlusion update it implies.
; ---------------------------------------------------------------------------
render_seg_body:
                xor     a
                ld      (sq_n),a
                ; Four segs in five share v1 with the previous seg's v2, and
                ; the front sector is the same right across a subsector, so
                ; that seg's projected pair is this one's - no reciprocal, no
                ; multiply, two loads.
                ld      a,(sg_n1)
                or      a
                jr      nz,rsb_p1
                ld      hl,(ch_vtx)
                ld      de,(sg_v1)
                or      a
                sbc     hl,de
                jr      nz,rsb_p1
                ld      hl,(ch_ft)
                ld      (sg_ft1),hl
                ld      hl,(ch_fb)
                ld      (sg_fb1),hl
                jr      rsb_p2
rsb_p1:
                ld      de,(sg_m1)
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_ft1),hl
                ld      de,(sg_m1)
                ld      a,(sg_fh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_fb1),hl
rsb_p2:
                ld      de,(sg_m2)
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_ft2),hl
                ld      de,(sg_m2)
                ld      a,(sg_fh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_fb2),hl
                ld      hl,$ffff                ; hand the pair to the next seg
                ld      (ch_vtx),hl
                ld      a,(sg_n2)
                or      a
                jr      nz,rsb_p3
                ld      hl,(sg_v2)
                ld      (ch_vtx),hl
                ld      hl,(sg_ft2)
                ld      (ch_ft),hl
                ld      hl,(sg_fb2)
                ld      (ch_fb),hl
rsb_p3:

                ld      a,(sg_flags)
                and     SF_SOLID
                jp      nz,rsb_solid

                ; --- portal --------------------------------------------
                ld      a,(sg_ch)
                ld      b,a
                ld      a,(sg_bch)
                sub     b                       ; bch - ch
                ld      a,0
                jp      p,rsb_nbt0              ; bch >= ch: no upper step
                inc     a
rsb_nbt0:
                ld      (sg_needbt),a
                ld      a,(sg_fh)
                ld      b,a
                ld      a,(sg_bfh)
                sub     b
                ld      a,0
                jp      m,rsb_nbb0
                jr      z,rsb_nbb0
                inc     a
rsb_nbb0:
                ld      (sg_needbb),a

                ld      a,(sg_needbt)
                or      a
                jr      z,rsb_nobt
                ld      de,(sg_m1)
                ld      a,(sg_bch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bt1),hl
                ld      de,(sg_m2)
                ld      a,(sg_bch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bt2),hl
                ld      a,1
                ld      (sg_emitt),a
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                jp      m,rsb_botpart
                jr      z,rsb_botpart
                ld      hl,(sg_ft1)
                ld      de,(sg_ft2)
                call    emit_edge
                jr      rsb_botpart
rsb_nobt:
                xor     a
                ld      (sg_emitt),a
                ld      a,(sg_ch)
                ld      b,a
                ld      a,(sg_bch)
                sub     b
                jp      m,rsb_botpart
                jr      z,rsb_botpart
                ld      a,1
                ld      (sg_emitt),a
rsb_botpart:
                ld      a,(sg_needbb)
                or      a
                jr      z,rsb_nobb
                ld      de,(sg_m1)
                ld      a,(sg_bfh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bb1),hl
                ld      de,(sg_m2)
                ld      a,(sg_bfh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bb2),hl
                ld      a,1
                ld      (sg_emitb),a
                ld      a,(sg_fh)
                ld      hl,vs_vz
                sub     (hl)
                jp      p,rsb_verts
                ld      hl,(sg_fb1)
                ld      de,(sg_fb2)
                call    emit_edge
                jr      rsb_verts
rsb_nobb:
                xor     a
                ld      (sg_emitb),a
                ld      a,(sg_bfh)
                ld      b,a
                ld      a,(sg_fh)
                sub     b
                jp      m,rsb_verts
                jr      z,rsb_verts
                ld      a,1
                ld      (sg_emitb),a
rsb_verts:
                call    fe_prepare
                ; step-face verticals at each endpoint
                ld      a,(sg_flags)
                and     SF_NOVT1
                jr      nz,rsb_v2
                ld      a,(sg_needbt)
                or      a
                jr      z,rsb_v1b
                ld      hl,(sg_sx1)
                ld      (dl_x1),hl
                ld      hl,(sg_ft1)
                ld      (dl_y1),hl
                ld      hl,(sg_bt1)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_v1b:
                ld      a,(sg_needbb)
                or      a
                jr      z,rsb_v2
                ld      hl,(sg_sx1)
                ld      (dl_x1),hl
                ld      hl,(sg_bb1)
                ld      (dl_y1),hl
                ld      hl,(sg_fb1)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_v2:
                ld      a,(sg_flags)
                and     SF_NOVT2
                jr      nz,rsb_tighten
                ld      a,(sg_needbt)
                or      a
                jr      z,rsb_v2b
                ld      hl,(sg_sx2)
                ld      (dl_x1),hl
                ld      hl,(sg_ft2)
                ld      (dl_y1),hl
                ld      hl,(sg_bt2)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_v2b:
                ld      a,(sg_needbb)
                or      a
                jr      z,rsb_tighten
                ld      hl,(sg_sx2)
                ld      (dl_x1),hl
                ld      hl,(sg_bb2)
                ld      (dl_y1),hl
                ld      hl,(sg_fb2)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_tighten:
                ; new top = max(ft, bt), new bottom = min(fb, bb)
                ld      a,(sg_needbt)
                or      a
                jr      z,rsb_tt_f
                ld      hl,(sg_ft1)
                ld      de,(sg_bt1)
                MAX16
                ld      (cl_yt1),hl
                ld      hl,(sg_ft2)
                ld      de,(sg_bt2)
                MAX16
                ld      (cl_yt2),hl
                jr      rsb_tb
rsb_tt_f:
                ld      hl,(sg_ft1)
                ld      (cl_yt1),hl
                ld      hl,(sg_ft2)
                ld      (cl_yt2),hl
rsb_tb:
                ld      a,(sg_needbb)
                or      a
                jr      z,rsb_tb_f
                ld      hl,(sg_fb1)
                ld      de,(sg_bb1)
                MIN16
                ld      (cl_yb1),hl
                ld      hl,(sg_fb2)
                ld      de,(sg_bb2)
                MIN16
                ld      (cl_yb2),hl
                jr      rsb_tgo
rsb_tb_f:
                ld      hl,(sg_fb1)
                ld      (cl_yb1),hl
                ld      hl,(sg_fb2)
                ld      (cl_yb2),hl
rsb_tgo:
                call    set_op_range
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                CMP16F
                ld      a,0
                jr      c,rsb_sw0
                inc     a
rsb_sw0:        ld      (sg_swap),a
                ; the two armed lines are drawn by the fuse itself, after
                ; every unarmed line has met the aperture they narrow
                ld      hl,cl_yt1
                ld      de,fu_tfn
                call    rsb_armfn
                ld      hl,cl_yb1
                ld      de,fu_bfn
                call    rsb_armfn
                jp      sp_fuse

; rsb_armfn : HL -> the pair (y at sx1, y at sx2), DE -> the fn buffer.
rsb_armfn:
                push    de
                ld      a,(sg_swap)
                or      a
                jr      nz,rsb_af_s
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      (cl_ly1),de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (cl_ly2),de
                ld      hl,(sg_sx1)
                ld      (cl_lx1),hl
                ld      hl,(sg_sx2)
                ld      (cl_lx2),hl
                jr      rsb_af_go
rsb_af_s:
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      (cl_ly2),de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (cl_ly1),de
                ld      hl,(sg_sx2)
                ld      (cl_lx1),hl
                ld      hl,(sg_sx1)
                ld      (cl_lx2),hl
rsb_af_go:
                pop     hl
                jp      linfn

; --- one-sided wall --------------------------------------------------------
rsb_solid:
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                jp      m,rsb_s_bot
                jr      z,rsb_s_bot
                ld      hl,(sg_ft1)
                ld      de,(sg_ft2)
                call    emit_edge
rsb_s_bot:
                ld      a,(sg_fh)
                ld      hl,vs_vz
                sub     (hl)
                jp      p,rsb_s_v1
                ld      hl,(sg_fb1)
                ld      de,(sg_fb2)
                call    emit_edge
rsb_s_v1:
                call    fe_prepare
                ld      a,(sg_flags)
                and     SF_NOVT1
                jr      nz,rsb_s_v2
                ld      hl,(sg_sx1)
                ld      (dl_x1),hl
                ld      hl,(sg_ft1)
                ld      (dl_y1),hl
                ld      hl,(sg_fb1)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_s_v2:
                ld      a,(sg_flags)
                and     SF_NOVT2
                jr      nz,rsb_s_op
                ld      hl,(sg_sx2)
                ld      (dl_x1),hl
                ld      hl,(sg_ft2)
                ld      (dl_y1),hl
                ld      hl,(sg_fb2)
                ld      (dl_y2),hl
                call    sp_drawv
rsb_s_op:
                call    set_op_range
                jp      sp_marksolid

; --- helpers ---------------------------------------------------------------
; set_op_range : cl_lo / cl_hi as the half-open column range of the seg.
set_op_range:
                ld      a,(cl_lo)
                ld      l,a
                ld      h,0
                ld      (cl_lo),hl
                ld      a,(cl_hi)
                ld      l,a
                ld      h,0
                inc     hl
                ld      (cl_hi),hl
                ret

; emit_edge : HL = y at sx1, DE = y at sx2; clip and emit the sloped edge.
emit_edge:
                jp      queue_edge

; ---------------------------------------------------------------------------
; DOOM's R_CheckBBox corner table, each corner named by the low address
; bytes of its x delta and its y delta (top, bottom, left, right lie in one
; page).  Entry 5 is "viewpoint inside".
; ---------------------------------------------------------------------------
CHECKCOORD:
                DB      (bb_top+6)&255,(bb_top+0)&255,(bb_top+4)&255,(bb_top+2)&255
                DB      (bb_top+6)&255,(bb_top+0)&255,(bb_top+4)&255,(bb_top+0)&255
                DB      (bb_top+6)&255,(bb_top+2)&255,(bb_top+4)&255,(bb_top+0)&255
                DB      (bb_top+0)&255,(bb_top+0)&255,(bb_top+0)&255,(bb_top+0)&255
                DB      (bb_top+4)&255,(bb_top+0)&255,(bb_top+4)&255,(bb_top+2)&255
                DB      (bb_top+0)&255,(bb_top+0)&255,(bb_top+0)&255,(bb_top+0)&255
                DB      (bb_top+6)&255,(bb_top+2)&255,(bb_top+6)&255,(bb_top+0)&255
                DB      (bb_top+0)&255,(bb_top+0)&255,(bb_top+0)&255,(bb_top+0)&255
                DB      (bb_top+4)&255,(bb_top+0)&255,(bb_top+6)&255,(bb_top+2)&255
                DB      (bb_top+4)&255,(bb_top+2)&255,(bb_top+6)&255,(bb_top+2)&255
                DB      (bb_top+4)&255,(bb_top+2)&255,(bb_top+6)&255,(bb_top+0)&255
