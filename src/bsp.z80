; ---------------------------------------------------------------------------
; BSP traversal and seg rendering.
;
; Front-to-back walk of DOOM's tree: at each node the near child is visited
; first, then the far one, and either is skipped when its bounding box either
; falls outside the frustum or lands entirely on columns the span list has
; already closed. When the span list empties, the frame is finished and the
; walk unwinds immediately.
;
; Everything here runs with bank 0 paged at $C000, so vertices, segs,
; subsectors, sectors and nodes are all directly addressable.
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; render_frame : build this frame's display list.
; ---------------------------------------------------------------------------
render_frame:
                call    view_setup
                call    sp_reset
                ; the vertices' spans go out once a frame: a stamp per vertex,
                ; wiped only when the frame counter comes round
                ld      hl,vd_stamp
                inc     (hl)
                jr      nz,rf_stamped
                ld      hl,VDONE
                ld      de,VDONE+1
                ld      bc,NVERTS-1
                ld      (hl),0
                ldir
                ld      a,1
                ld      (vd_stamp),a
rf_stamped:
                ; lines are plotted as they are emitted (dl_emit): the
                ; rasteriser is mirrored in banks 6 and 7, and the back
                ; buffer's own bank serves it (B lives in 7; A's rows are
                ; always mapped, so its plots run from 6)
                ld      a,(back_buf)
                ld      e,a
                add     a,BANK_RASTER_A
                ld      d,a
                ld      a,e
                xor     1
                rlca
                rlca
                rlca
                or      d
                or      P7_ROM48
                ld      (rast_port),a
                xor     a
                ld      (frame_nodes),a
                ld      (frame_ss),a
                ld      (frame_segs),a
                ; the walk runs from bank 4 (walk4.z80) with its node records
                ; and the box check's tables; it pages the geometry in for
                ; each subsector's segs
                ld      a,BANK_OBJ
                call    set_page
                call    walk_frame
                ld      a,BANK_GEOM
                jp      set_page

; ---------------------------------------------------------------------------
; walk_ss_segs : HL = subsector id, the geometry paged in.  Its segs, front
; to back (the walk and the objects that precede them run from bank 4:
; walk4.z80), then the walk bank back before the return there.
; ---------------------------------------------------------------------------
walk_ss_segs:
                push    hl
                ld      a,BANK_GEOM
                call    set_page
                pop     hl
                ld      a,(frame_ss)
                inc     a
                ld      (frame_ss),a
                ; SSEC + ssid * 3
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,de                   ; * 3
                ld      de,SSEC
                add     hl,de
                ld      a,(hl)
                or      a
                jr      z,wss_done
                ld      b,a                     ; B = segs left
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ex      de,hl
                add     hl,hl
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      de,SEGS
                add     hl,de
                push    hl
                pop     ix                      ; IX -> the first seg's record
                ld      hl,$ffff
                ld      (ch_vtx),hl             ; the chain starts empty
ss_loop:
                push    bc
                push    ix
                call    render_seg
                pop     ix
                pop     bc
                ld      de,SEG_SIZE
                add     ix,de
                djnz    ss_loop
wss_done:       ld      a,BANK_OBJ              ; the walk continues in bank 4
                jp      set_page

; ---------------------------------------------------------------------------
; set_page : A = bank to map at $C000.  The displayed screen follows back_buf:
; whichever buffer is not being drawn into is the one on show.
; ---------------------------------------------------------------------------
set_page:
                ld      e,a
                ld      a,(back_buf)
                xor     1                       ; 1 when buffer B is displayed
                rlca
                rlca
                rlca                            ; -> bit 3 of $7FFD
                or      e
                or      P7_ROM48
                ld      (cur_port),a            ; dl_emit restores it after a plot
                ld      bc,PORT_7FFD
                out     (c),a
                ret

; ---------------------------------------------------------------------------
; cpm_init : once-only state.  The corner memo is gone (ptoa is cheaper than
; its probe was); what remains is obj_anyb_fill (objects.s): the per-subsector
; has-objects bitmap copied out of bank 4 so the walk can probe it without a
; page flip.
cpm_init:
                ld      hl,VYC_S                ; project_y's memo: the S plane
                ld      de,VYC_S+1              ; is its valid flag
                ld      bc,255
                ld      (hl),0
                ldir
                ld      a,BANK_OBJ
                call    set_page
                ld      hl,OBJ_BITS
                ld      de,OBJ_ANYB
                ld      bc,OBJ_BITS_LEN
                ldir
                ld      a,BANK_GEOM
                jp      set_page

; mul_s16_u8_signed : A:HL = DE (s16) * A (s8, sign honoured)
mul_s16_u8_signed:
                bit     7,a
                jr      nz,msg_neg
                jp      mul_s16_u8
msg_neg:
                neg
                call    mul_s16_u8
                jp      neg_ahl

near_cross:
                ld      hl,(cr_vy2)
                ld      de,(cr_vy1)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                jp      z,nc_fail
                bit     7,h
                jp      nz,nc_fail
                ld      (nc_d),hl
                ld      hl,NEAR_CROSS
                ld      de,(cr_vy1)
                or      a
                sbc     hl,de
                ld      (nc_n),hl               ; n > 0 because vy1 < 16
nc_norm:
                ld      hl,(nc_d)
                ld      a,h
                or      a
                jr      z,nc_small
                srl     h
                rr      l
                ld      (nc_d),hl
                ld      hl,(nc_n)
                srl     h
                rr      l
                ld      (nc_n),hl
                jr      nc_norm
nc_small:
                ld      a,l
                or      a
                jr      z,nc_use2               ; d became 0: take v2
                ld      c,a                     ; C = d (1..255)
                ld      hl,(nc_n)
                ld      a,h
                or      a
                jr      nz,nc_use2              ; n >= 256 > d
                ld      a,l
                cp      c
                jr      nc,nc_use2              ; n >= d -> t >= 256
                ; t = ((n << 8) + (d >> 1)) / d
                ld      h,a
                ld      l,0
                ld      a,c
                srl     a
                ld      e,a
                ld      d,0
                add     hl,de
                call    div16_8                 ; L = quotient
                ld      a,l
                ld      (nc_t),a
                ld      hl,(cr_vx2)
                ld      de,(cr_vx1)
                or      a
                sbc     hl,de                   ; dvx
                bit     7,h
                jr      nz,nc_negdvx
                ex      de,hl
                ld      a,(nc_t)
                call    mul_s16_u8
                call    rns8_ahl
                ld      de,(cr_vx1)
                add     hl,de
                jr      nc_done
nc_negdvx:
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ex      de,hl                   ; DE = |dvx|
                ld      a,(nc_t)
                call    mul_s16_u8
                call    rns8_ahl
                ex      de,hl
                ld      hl,(cr_vx1)
                or      a
                sbc     hl,de
nc_done:
                ld      (bb_cx),hl
                scf
                ret
nc_use2:
                ld      hl,(cr_vx2)
                ld      (bb_cx),hl
                scf
                ret
nc_fail:
                or      a
                ret

; div16_8 : HL / C -> HL quotient, A remainder
div16_8:
                xor     a
                ld      b,16
d168_l:
                add     hl,hl
                rla
                jr      c,d168_s
                cp      c
                jr      c,d168_n
d168_s:
                sub     c
                inc     l
d168_n:
                djnz    d168_l
                ret

; ---------------------------------------------------------------------------
; vertex_get : HL = vertex index -> HL = its cache entry, which
; holds the view-space position and, when in front of the near plane, the
; projected column.
; ---------------------------------------------------------------------------
; vertex_get : HL = a vertex index -> HL = its VCACHE entry (IX too), filled
; this frame if it was not: the epoch's rotation L(w) from VXCACHE, or a
; cold transform, plus the frame's ref term, then the reciprocal and the
; column (vg_project).  The cold transform is the same integer arithmetic
; as the rotation helpers - four s16 x u8 products of the magnitudes, the
; signed combination, RNS3 - with the frame's magnitudes, unity cases and
; signs patched into it by vs_rebuild, so it runs straight through
; registers.  Eats everything.
; ---------------------------------------------------------------------------
; vertex_get : HL = a vertex index -> HL = its VCACHE entry (IX too), filled
; this frame if it was not.  The transform is the BBC port's: the vertex is
; a low byte per axis and a page nibble; each axis is
;       floor((4 [+|-] ox*|s| [-|+] oy*|c|) / 8) + PB[pg] + ref
; with the products read from the angle's tables (TS_TAB, TC_TAB), the four
; sign sites patched by vs_rebuild_b4 and the page term PBX/PBY exact - so
; the result is the rns3 of the full rotation, the integers unchanged.  Then
; the reciprocal and the column (vg_project).  Eats everything.
; ---------------------------------------------------------------------------
; vg_build_tabs : page bank 4, build the product tables, page the geometry
; back.  HL (the entry) and DE (the index) ride through.  Once a frame.
vg_build_tabs:
                push    hl
                push    de
                ld      a,BANK_OBJ
                call    set_page
                call    vs_build_tables
                ld      a,BANK_GEOM
                call    set_page
                pop     de
                pop     hl
                ret

vertex_get:
                ld      d,h
                ld      e,l                     ; DE = idx
                add     hl,hl
                add     hl,hl
                add     hl,hl
                add     hl,de                   ; nine bytes an entry
                ld      a,l
                add     a,VCACHE_BASE & 255
                ld      l,a
                ld      a,h
                adc     a,VCACHE_BASE >> 8
                ld      h,a
                ld      a,(vc_stamp)
                cp      (hl)
                ret     z                       ; HL = the entry
                ld      (hl),a
                ld      a,(vs_tab_valid)
                or      a
                call    z,vg_build_tabs         ; build the angle's product
                push    hl                      ; tables on the first cold vertex
                pop     ix                      ; IX = the entry
                ld      hl,VP_OX
                add     hl,de
                ld      c,(hl)                  ; ox
                inc     h
                inc     h
                ld      b,(hl)                  ; oy
                inc     h
                inc     h
                ld      a,(hl)                  ; the page nibble
                add     a,a
                ld      iyl,a                   ; * 2: PB's index
                push    bc                      ; (oy, ox) for the y axis
                ; --- x ---
                ld      a,b
                add     a,a
                ld      l,a
                ld      a,TC_TAB>>8
                adc     a,0
                ld      h,a
                ld      e,(hl)
                inc     l
                ld      d,(hl)                  ; DE = oy * |cos|
                ld      a,c
                add     a,a
                ld      l,a
                ld      a,TS_TAB>>8
                adc     a,0
                ld      h,a
                ld      c,(hl)
                inc     l
                ld      b,(hl)                  ; BC = ox * |sin|
                ld      hl,4
                xor     a
vgx1:           add     hl,bc                   ; [+|-] ox*|s|   (patched, 5 bytes)
                adc     a,0
                nop
                nop
vgx2:           or      a                       ; [-|+] oy*|c|
                sbc     hl,de
                sbc     a,0
                sra     a
                rr      h
                rr      l
                sra     a
                rr      h
                rr      l
                sra     a
                rr      h
                rr      l                       ; floor(S / 8)
                ld      a,iyl
                add     a,PBX & 255
                ld      e,a
                ld      d,PBX >> 8
                ld      a,(de)
                inc     e
                ld      c,a
                ld      a,(de)
                ld      b,a
                add     hl,bc                   ; + the page term
                ld      de,(vs_rx)
                add     hl,de                   ; HL = tvx
                ld      (ix+VC_TVX),l
                ld      (ix+VC_TVX+1),h
                ex      (sp),hl                 ; tvx down, (oy, ox) up
                ; --- y ---
                ld      c,l                     ; ox
                ld      a,h                     ; oy
                add     a,a
                ld      l,a
                ld      a,TS_TAB>>8
                adc     a,0
                ld      h,a
                ld      e,(hl)
                inc     l
                ld      d,(hl)                  ; DE = oy * |sin|
                ld      a,c
                add     a,a
                ld      l,a
                ld      a,TC_TAB>>8
                adc     a,0
                ld      h,a
                ld      c,(hl)
                inc     l
                ld      b,(hl)                  ; BC = ox * |cos|
                ld      hl,4
                xor     a
vgy1:           add     hl,bc                   ; [+|-] ox*|c|
                adc     a,0
                nop
                nop
vgy2:           add     hl,de                   ; [+|-] oy*|s|
                adc     a,0
                nop
                nop
                sra     a
                rr      h
                rr      l
                sra     a
                rr      h
                rr      l
                sra     a
                rr      h
                rr      l
                ld      a,iyl
                add     a,PBY & 255
                ld      e,a
                ld      d,PBY >> 8
                ld      a,(de)
                inc     e
                ld      c,a
                ld      a,(de)
                ld      b,a
                add     hl,bc
                ld      de,(vs_ry)
                add     hl,de                   ; HL = tvy
                ld      (ix+VC_TVY),l
                ld      (ix+VC_TVY+1),h
vg_project:
                ; HL = tvy, (sp) = tvx: project when in front of the near
                ; plane, keeping the reciprocal with the column
                bit     7,h
                jr      nz,vg_behind
                ld      a,h
                or      a
                jr      nz,vg_front
                ld      a,l
                cp      NEAR_VERDICT
                jr      nc,vg_front
vg_behind:
                pop     hl
                xor     a
                ld      (ix+VC_SX),a
                ld      (ix+VC_SX+1),a
                push    ix
                pop     hl
                ret
vg_front:
                call    recip
                ld      (ix+VC_M8),e
                ld      (ix+VC_S),d
                pop     hl
                call    project_x
                ld      (ix+VC_SX),l
                ld      (ix+VC_SX+1),h
                push    ix
                pop     hl
                ret

; ---------------------------------------------------------------------------
; render_seg : HL = seg index.
; ---------------------------------------------------------------------------
render_seg:     ; IX -> the seg record
                ld      a,(ix+SG_FLAGS)
                ld      (sg_flags),a

                ; --- back face -----------------------------------------
                ; The reference's verdict is the sign of
                ;   dot = ldy * (px88 - lx88) - ldx * (py88 - ly88)
                ; in prescaled 8.8, with a tie (dot == 0) culled when
                ; ldy < 0 or (ldy == 0 and ldx > 0).  Three quarters of
                ; DOOM's linedefs are axis aligned, and for those one term
                ; vanishes and the test is a comparison of one coordinate.
                ; For the rest the integer-part dot D decides on its own
                ; unless |D| < |ldx| + |ldy|, the band inside which the
                ; fractions can still turn it (the BBC port's DBOUND gate).
                and     SF_LDX0
                jp      nz,rs_bf_x0
                ld      a,(sg_flags)
                and     SF_LDY0
                jp      nz,rs_bf_y0
                ld      e,(ix+SG_LX)
                ld      d,(ix+SG_LX+1)
                ld      hl,(pl_x)
                or      a
                sbc     hl,de
                ld      (pos_dx),hl             ; px - lx
                ld      e,(ix+SG_LY)
                ld      d,(ix+SG_LY+1)
                ld      hl,(pl_y)
                or      a
                sbc     hl,de                   ; py - ly
                ex      de,hl
                ld      a,(ix+SG_LDX)
                call    mul_s16_u8_signed       ; A:HL = ldx * dy
                ld      (pos_l+2),a             ; the multiply eats BC
                push    hl
                ld      de,(pos_dx)
                ld      a,(ix+SG_LDY)
                call    mul_s16_u8_signed       ; A:HL = ldy * dx
                pop     de
                or      a
                sbc     hl,de
                ld      d,a
                ld      a,(pos_l+2)
                ld      e,a
                ld      a,d
                sbc     a,e                     ; A:HL = D = ldy*dx - ldx*dy
                ; the band: |D| < |ldx| + |ldy|
                ld      (bf_d),hl
                ld      (bf_d+2),a
                ld      b,a
                ld      a,(ix+SG_LDX)
                bit     7,a
                jr      z,bf_b1
                neg
bf_b1:          ld      c,a
                ld      a,(ix+SG_LDY)
                bit     7,a
                jr      z,bf_b2
                neg
bf_b2:          add     a,c
                ld      c,a                     ; C = the bound
                ld      a,b
                or      a
                jr      nz,bf_dneg
                ld      a,h
                or      a
                jp      nz,rs_visible           ; D >= 256
                ld      a,l
                cp      c
                jp      nc,rs_visible           ; D >= bound
                jr      bf_exact
bf_dneg:        inc     a
                ret     nz                      ; D <= -65536
                ld      a,h
                inc     a
                ret     nz                      ; D <= -256
                ld      a,l
                add     a,c                     ; D = L - 256 > -bound iff L + bound > 256
                ret     nc
                ret     z
bf_exact:
                ; dot88 = 256 * D + ldy * (pxf - lxf) - ldx * (pyf - lyf)
                ld      a,(pl_xf)
                sub     (ix+SG_LXF)
                ld      e,a
                sbc     a,a
                ld      d,a                     ; DE = pxf - lxf, s16
                ld      a,(ix+SG_LDY)
                call    mul_s16_u8_signed
                ld      (bf_t),hl
                ld      (bf_t+2),a
                ld      a,(pl_yf)
                sub     (ix+SG_LYF)
                ld      e,a
                sbc     a,a
                ld      d,a
                ld      a,(ix+SG_LDX)
                call    mul_s16_u8_signed       ; A:HL = ldx * fy
                ld      d,a
                ld      a,(bf_t+2)
                ld      e,a
                ld      a,(bf_t)
                sub     l
                ld      l,a
                ld      a,(bf_t+1)
                sbc     a,h
                ld      h,a
                ld      a,e
                sbc     a,d                     ; A:HL = ldy*fx - ldx*fy
                ld      b,a                     ; B = its high byte
                ld      a,(bf_d)                ; + 256 * D: D's low byte
                ld      d,a                     ; into the middle
                ld      e,0
                add     hl,de
                ld      a,(bf_d+1)              ; D's sign byte (D fits s9)
                adc     a,b
                ret     m                       ; behind
                or      h
                or      l
                jr      nz,rs_visible
                ; a tie: culled when ldy < 0 (ldx, ldy both nonzero here)
                bit     7,(ix+SG_LDY)
                ret     nz
                jr      rs_visible
rs_bf_x0:
                ; dot = ldy * (px88 - lx88): the integer difference decides
                ; unless it is zero, then the fractions, then the tie rule
                ld      e,(ix+SG_LX)
                ld      d,(ix+SG_LX+1)
                ld      hl,(pl_x)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                jr      z,bx_frac
                ld      a,h
                xor     (ix+SG_LDY)             ; sign of the product
                ret     m
                jr      rs_visible
bx_frac:        ld      a,(pl_xf)
                sub     (ix+SG_LXF)
                jr      z,bx_tie
                sbc     a,a                     ; the sign of the difference
                xor     (ix+SG_LDY)
                ret     m
                jr      rs_visible
bx_tie:         bit     7,(ix+SG_LDY)           ; culled when ldy < 0
                ret     nz
                jr      rs_visible
rs_bf_y0:
                ; dot = -ldx * (py88 - ly88)
                ld      e,(ix+SG_LY)
                ld      d,(ix+SG_LY+1)
                ld      hl,(pl_y)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                jr      z,by_frac
                ld      a,h
                xor     (ix+SG_LDX)
                ret     p                       ; product positive -> dot < 0
                jr      rs_visible
by_frac:        ld      a,(pl_yf)
                sub     (ix+SG_LYF)
                jr      z,by_tie
                sbc     a,a
                xor     (ix+SG_LDX)
                ret     p
                jr      rs_visible
by_tie:         bit     7,(ix+SG_LDX)           ; culled when ldx > 0
                jr      nz,rs_visible
                ret
rs_visible:
                ld      hl,frame_segs
                inc     (hl)
                ; the four heights, contiguous in the record
                push    ix
                pop     hl
                ld      de,SG_FH
                add     hl,de
                ld      de,sg_fh
                ldi
                ldi
                ldi
                ldi
                ld      a,(ix+SG_VHI)
                ld      c,a
                and     1
                ld      h,a
                ld      l,(ix+SG_V1)
                ld      (sg_v1),hl
                ld      a,c
                rrca
                and     1
                ld      h,a
                ld      l,(ix+SG_V2)
                ld      (sg_v2),hl
                push    hl
                ld      hl,(sg_v1)
                call    vertex_get              ; HL = v1's record
                ex      (sp),hl                 ; v1's record down, v2's index up
                call    vertex_get
                pop     ix                      ; IX = v1's record
                push    hl
                pop     iy                      ; IY = v2's

                ; near-plane verdicts: tvy < NEAR_VERDICT, signed
                ld      a,(ix+VC_TVY+1)
                or      a
                jp      m,rs_n1y
                jr      nz,rs_n1n
                ld      a,(ix+VC_TVY)
                cp      NEAR_VERDICT
                jr      nc,rs_n1n
rs_n1y:         ld      c,1
                jr      rs_n2
rs_n1n:         ld      c,0
rs_n2:          ld      a,(iy+VC_TVY+1)
                or      a
                jp      m,rs_n2y
                jr      nz,rs_n2n
                ld      a,(iy+VC_TVY)
                cp      NEAR_VERDICT
                jr      nc,rs_n2n
rs_n2y:         ld      b,1
                jr      rs_nd
rs_n2n:         ld      b,0
rs_nd:          ld      (sg_n1),bc              ; C = v1's verdict, B = v2's
                ld      a,b
                and     c
                ret     nz                      ; both behind the near plane
                ld      a,b
                or      c
                jr      nz,rs_clipx             ; a crossing needs the view coords
rs_front:
                ld      a,c
                or      a
                jr      nz,rs_clip1
                ld      a,b
                or      a
                jr      nz,rs_clip2
                ; both in front: the cached columns and reciprocals
                ld      e,(ix+VC_M8)
                ld      d,(ix+VC_S)
                ld      (sg_m1),de
                ld      l,(ix+VC_SX)
                ld      h,(ix+VC_SX+1)
                ld      (sg_sx1),hl
                jr      rs_do2
rs_clipx:
                ; the view coordinates, from the entries
                ld      l,(ix+VC_TVX)
                ld      h,(ix+VC_TVX+1)
                ld      (cr_vx1),hl
                ld      l,(ix+VC_TVY)
                ld      h,(ix+VC_TVY+1)
                ld      (cr_vy1),hl
                ld      l,(iy+VC_TVX)
                ld      h,(iy+VC_TVX+1)
                ld      (cr_vx2),hl
                ld      l,(iy+VC_TVY)
                ld      h,(iy+VC_TVY+1)
                ld      (cr_vy2),hl
                jr      rs_front
rs_clip1:
                ; v1 is behind: cross toward v2
                call    near_cross_seg1
                ret     nc
                ld      hl,NEAR_CROSS
                call    recip
                ld      (sg_m1),de
                ld      hl,(bb_cx)
                call    project_x
                ld      (sg_sx1),hl
rs_do2:
                ld      e,(iy+VC_M8)
                ld      d,(iy+VC_S)
                ld      (sg_m2),de
                ld      l,(iy+VC_SX)
                ld      h,(iy+VC_SX+1)
                ld      (sg_sx2),hl
                jr      rs_havex
rs_clip2:
                ; v2 is behind: cross toward v1
                ld      e,(ix+VC_M8)
                ld      d,(ix+VC_S)
                ld      (sg_m1),de
                ld      l,(ix+VC_SX)
                ld      h,(ix+VC_SX+1)
                ld      (sg_sx1),hl
                call    near_cross_seg2
                ret     nc
                ld      hl,NEAR_CROSS
                call    recip
                ld      (sg_m2),de
                ld      hl,(bb_cx)
                call    project_x
                ld      (sg_sx2),hl
rs_havex:
                ; a reversed or tied projection covers no columns: dropped
                ld      hl,(sg_sx2)
                ld      de,(sg_sx1)
                CMP16F
                ret     c
                ret     z
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                call    sp_hasgap
                ret     nc
                jp      render_seg_body

; rs_near : HL = tvy -> A = 1 when it is short of the near plane.
rs_near:
                ld      a,h
                or      a
                jr      nz,rs_nbig
                ld      a,l
                cp      NEAR_VERDICT
                sbc     a,a                     ; -1 when below
                and     1
                ret
rs_nbig:
                rla                             ; carry = sign
                sbc     a,a
                and     1
                ret

near_cross_seg1:
                ld      hl,(cr_vx1)
                ld      de,(cr_vy1)
                jp      near_cross
near_cross_seg2:
                ; swap the endpoints so v2 is the clipped one
                ld      hl,(cr_vx1)
                ld      de,(cr_vx2)
                ld      (cr_vx1),de
                ld      (cr_vx2),hl
                ld      hl,(cr_vy1)
                ld      de,(cr_vy2)
                ld      (cr_vy1),de
                ld      (cr_vy2),hl
                call    near_cross
                push    af
                ld      hl,(cr_vx1)
                ld      de,(cr_vx2)
                ld      (cr_vx1),de
                ld      (cr_vx2),hl
                ld      hl,(cr_vy1)
                ld      de,(cr_vy2)
                ld      (cr_vy1),de
                ld      (cr_vy2),hl
                pop     af
                ret

; ---------------------------------------------------------------------------
; render_seg_body : project the seg's heights, emit its visible edges, and
; apply the occlusion update it implies.
; ---------------------------------------------------------------------------
render_seg_body:
                ; Four segs in five share v1 with the previous seg's v2, and
                ; the front sector is the same right across a subsector, so
                ; that seg's projected pair is this one's - no reciprocal, no
                ; multiply, two loads.
                ld      a,(sg_n1)
                or      a
                jr      nz,rsb_p1
                ld      hl,(ch_vtx)
                ld      de,(sg_v1)
                or      a
                sbc     hl,de
                jr      nz,rsb_p1
                ld      hl,(ch_ft)
                ld      (sg_ft1),hl
                ld      hl,(ch_fb)
                ld      (sg_fb1),hl
                jr      rsb_p2
rsb_p1:
                ld      de,(sg_m1)
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_ft1),hl
                ld      de,(sg_m1)
                ld      a,(sg_fh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_fb1),hl
rsb_p2:
                ld      de,(sg_m2)
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_ft2),hl
                ld      de,(sg_m2)
                ld      a,(sg_fh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_fb2),hl
                ld      hl,$ffff                ; hand the pair to the next seg
                ld      (ch_vtx),hl
                ld      a,(sg_n2)
                or      a
                jr      nz,rsb_p3
                ld      hl,(sg_v2)
                ld      (ch_vtx),hl
                ld      hl,(sg_ft2)
                ld      (ch_ft),hl
                ld      hl,(sg_fb2)
                ld      (ch_fb),hl
rsb_p3:
                ; the heights the vertex-span descriptors read: the back
                ; pair of a solid seg is aliased to the front by the pack
                ld      hl,(sg_fh)              ; fh, ch
                ld      (vs_h),hl
                ld      hl,(sg_bfh)             ; bfh, bch
                ld      (vs_h+2),hl
                ; --- the eyeline rule: a ceiling at or below the eye kills
                ; the top edges ($80), a floor at or above it the bottom
                ; edges ($40); the top kill wins.  Byte subtractions, as
                ; the BBC port's ---
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                ld      a,$80
                jp      m,rsb_esk
                ld      a,(sg_fh)
                sub     (hl)
                ld      a,$40
                jp      p,rsb_esk
                xor     a
rsb_esk:        ld      (sg_eskip),a
                ld      a,(sg_flags)
                and     SF_SOLID
                jp      nz,rsb_solid

                ; --- a portal: the BBC port's seg_emit cascade ------------
                xor     a
                ld      (fw_touch),a
                ld      a,(sg_flags)
                and     SF_NEEDBT
                jr      z,rsb_nbt
                ld      de,(sg_m1)
                ld      a,(sg_bch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bt1),hl
                ld      de,(sg_m2)
                ld      a,(sg_bch)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bt2),hl
rsb_nbt:        ld      a,(sg_flags)
                and     SF_NEEDBB
                jr      z,rsb_nbb
                ld      de,(sg_m1)
                ld      a,(sg_bfh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bb1),hl
                ld      de,(sg_m2)
                ld      a,(sg_bfh)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (sg_bb2),hl
rsb_nbb:
                ; the companions: the front edges beside a step, plain draws
                ld      a,(sg_flags)
                and     SF_NEEDBT|SF_NEEDBB
                cp      SF_NEEDBT|SF_NEEDBB
                jr      nz,pc_singles
                ld      a,(sg_eskip)
                or      a
                jr      nz,pc_singles
                ld      hl,sg_ft1
                call    rsb_line
                ld      hl,sg_fb1
                call    rsb_line
                jr      pc_verts
pc_singles:     ld      a,(sg_flags)
                and     SF_NEEDBT
                jr      z,pc_fb
                ld      a,(sg_eskip)
                bit     7,a
                jr      nz,pc_fb
                ld      hl,sg_ft1
                call    rsb_line
pc_fb:          ld      a,(sg_flags)
                and     SF_NEEDBB
                jr      z,pc_verts
                ld      a,(sg_eskip)
                bit     6,a
                jr      nz,pc_verts
                ld      hl,sg_fb1
                call    rsb_line
pc_verts:       call    rsb_vspans
                ; the armed aperture edges, applied as they are drawn
                ld      a,(sg_flags)
                and     SF_NEEDBT
                jr      z,pc_top_up
                ld      hl,sg_bt1
                xor     a
                call    rsb_fused
                jr      pc_bot
pc_top_up:      ld      a,(sg_flags)
                and     SF_STEPUP_T
                jr      z,pc_bot
                ld      hl,sg_ft1
                xor     a
                call    rsb_fused
pc_bot:         ld      a,(sg_flags)
                and     SF_NEEDBB
                jr      z,pc_bot_up
                ld      hl,sg_bb1
                ld      a,$80
                call    rsb_fused
                jr      pc_walk
pc_bot_up:      ld      a,(sg_flags)
                and     SF_STEPUP_B
                jr      z,pc_walk
                ld      hl,sg_fb1
                ld      a,$80
                call    rsb_fused
pc_walk:        ld      a,(fw_touch)
                or      a
                jr      z,pc_zero
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                jp      fused_merge_range
pc_zero:        call    seg_zero_rec_solid
                ret     nc
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                jp      sp_marksolid

; --- one-sided wall --------------------------------------------------------
rsb_solid:
                ld      a,(sg_eskip)
                or      a
                jr      nz,sc_esk
                ld      hl,sg_ft1
                call    rsb_line
sc_fb:          ld      hl,sg_fb1
                call    rsb_line
sc_no_fb:       call    rsb_vspans
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                jp      sp_marksolid
sc_esk:         bit     7,a
                jr      nz,sc_fb                ; no top edge: the bottom alone
                ld      hl,sg_ft1
                call    rsb_line
                jr      sc_no_fb

; cmp_s8 : A vs (HL), signed bytes: carry when A < (HL), zero when equal
cmp_s8:
                sub     (hl)
                ret     z
                jp      pe,cs8_ovf
                jp      m,cs8_lt
                or      a                       ; carry clear, NZ
                ret
cs8_ovf:        jp      m,cs8_ge                ; overflowed: the true sign is the other
cs8_lt:         scf
                ret
cs8_ge:         or      a
                ret

; rsb_line : HL -> a row pair (y at sx1; y at sx2 four bytes on), drawn from
; sx1 to sx2 through the clipper
rsb_line:
                call    rsb_stage
                jp      dcl_s16
; rsb_fused : the same line as an aperture edge, A = the side
rsb_fused:
                push    af
                call    rsb_stage
                pop     af
                jp      fused_line
rsb_stage:                                      ; (the rows are biased already)
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (lc_y1),de
                inc     hl
                inc     hl
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (lc_y2),de
                ld      hl,(sg_sx1)
                ld      (lc_x1),hl
                ld      hl,(sg_sx2)
                ld      (lc_x2),hl
                ret


; ---------------------------------------------------------------------------
; The vertex-span descriptors (emit_vertex_spans): each endpoint's
; verticals come from a per-vertex descriptor, once per frame at the first
; seg that touches it - and a first touch that is near-clipped or off the
; screen still uses it up.
; ---------------------------------------------------------------------------
rsb_vspans:
                ld      hl,(sg_v1)
                ld      de,(sg_sx1)
                ld      bc,(sg_m1)
                ld      a,(sg_n1)
                call    vspan_emit
                ld      hl,(sg_v2)
                ld      de,(sg_sx2)
                ld      bc,(sg_m2)
                ld      a,(sg_n2)
                jp      vspan_emit

; vspan_emit : HL = the vertex, DE = its column (s16), BC = (S, M8), A = 1
; when near-clipped
vspan_emit:
                ld      (vs_sx),de
                ld      (vs_ms),bc
                ld      c,a
                ; done this frame?
                ld      de,VDONE
                add     hl,de
                ld      a,(vd_stamp)
                cp      (hl)
                ret     z                       ; already
                ld      (hl),a
                ld      de,VSDESC-VDONE
                add     hl,de
                ld      a,(hl)                  ; the descriptor
                or      a
                ret     z
                ld      b,a
                ld      a,c
                or      a
                ret     nz                      ; near-clipped
                ld      a,(vs_sx+1)
                or      a
                ret     nz                      ; off the screen either side
                ld      a,b
                bit     7,a
                jr      nz,ve_explicit
                ; a code: 1 (fh, ch)  2 (fh, bfh)  3 (bch, ch)  4 both of 2 and 3
                cp      4
                jr      z,ve_c4
                cp      3
                jr      z,ve_c3
                cp      2
                jr      z,ve_c2
                ld      a,(vs_h)                ; fh
                ld      (vs_lo),a
                ld      a,(vs_h+1)              ; ch
                ld      (vs_hi),a
                jp      ve_pair
ve_c2:          ld      a,(vs_h)
                ld      (vs_lo),a
                ld      a,(vs_h+2)              ; bfh
                ld      (vs_hi),a
                jp      ve_pair
ve_c3:          ld      a,(vs_h+3)              ; bch
                ld      (vs_lo),a
                ld      a,(vs_h+1)
                ld      (vs_hi),a
                jp      ve_pair
ve_c4:          ld      a,(vs_h+3)
                ld      (vs_lo),a
                ld      a,(vs_h+1)
                ld      (vs_hi),a
                call    ve_pair
                jr      ve_c2
ve_done:        pop     hl
                ret
ve_explicit:
                and     $7f
                ld      (vs_i),a
ve_el:
                ld      a,(vs_i)
                ld      l,a
                ld      h,0
                ld      e,a
                ld      d,0
                add     hl,hl
                add     hl,de                   ; * 3
                ld      de,VSEXPL
                add     hl,de
                ; c_lo = max(h_lo, fh), c_hi = min(h_hi, ch)
                ld      a,(vs_h)
                ld      e,a                     ; E = fh
                ld      a,(hl)                  ; h_lo
                ld      c,a
                push    hl
                ld      hl,vs_h
                call    cmp_s8                  ; carry: h_lo < fh (A = the difference)
                pop     hl
                ld      a,c
                jr      nc,ve_lo1
                ld      a,e
ve_lo1:         ld      (vs_lo),a
                inc     hl
                ld      a,(vs_h+1)
                ld      e,a                     ; E = ch
                ld      a,(hl)                  ; h_hi
                ld      c,a
                push    hl
                ld      hl,vs_h+1
                call    cmp_s8                  ; carry: h_hi < ch
                pop     hl
                ld      a,c
                jr      c,ve_hi1
                ld      a,e
ve_hi1:         ld      (vs_hi),a
                inc     hl
                ld      a,(hl)                  ; cont
                push    af
                call    ve_pair
                pop     af
                or      a
                ret     z
                ld      hl,vs_i
                inc     (hl)
                jr      ve_el

; ve_pair : the vertical from height vs_hi down to vs_lo at vs_sx, when
; hi > lo
ve_pair:
                ld      a,(vs_hi)
                ld      hl,vs_lo
                call    cmp_s8
                ret     c
                ret     z
                ld      de,(vs_ms)
                ld      a,(vs_hi)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (lc_y1),hl
                ld      de,(vs_ms)
                ld      a,(vs_lo)
                ld      hl,vs_vz
                sub     (hl)
                call    project_y
                ld      (lc_y2),hl
                ld      a,(vs_sx)               ; the column (on the screen)
                jp      dcl_vert_on


; ---------------------------------------------------------------------------
; DOOM's R_CheckBBox corner table, each corner named by the low address
; bytes of its x delta and its y delta (top, bottom, left, right lie in one
; page).  Entry 5 is "viewpoint inside".
; ---------------------------------------------------------------------------
