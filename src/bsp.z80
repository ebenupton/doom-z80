; ---------------------------------------------------------------------------
; BSP traversal and seg rendering.
;
; Front-to-back walk of DOOM's tree: at each node the near child is visited
; first, then the far one, and either is skipped when its bounding box either
; falls outside the frustum or lands entirely on columns the span list has
; already closed. When the span list empties, the frame is finished and the
; walk unwinds immediately.
;
; Everything here runs with bank 0 paged at $C000, so vertices, segs,
; subsectors, sectors and nodes are all directly addressable.
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; render_frame : build this frame's display list.
; ---------------------------------------------------------------------------
render_frame:
                call    view_setup
                ld      hl,$ffff
                ld      (ch_v2),hl              ; the chain starts empty
                ; the vertices' spans go out once a frame: a stamp per vertex,
                ; wiped only when the frame counter comes round
                ld      hl,vd_stamp
                inc     (hl)
                jr      nz,rf_stamped
                ld      hl,VXR+VXR_DONE
                call    wipe8
                ld      a,1
                ld      (vd_stamp),a
rf_stamped:
                ld      a,(vd_stamp)            ; the stamp as an immediate at
                ld      (vsd1+1),a              ;  the two vspan entries
                ld      (vsd2+1),a
                ; lines are plotted as they are emitted (dl_emit): the
                ; rasteriser is mirrored in banks 6 and 7, and the back
                ; buffer's own bank serves it (B lives in 7; A's rows are
                ; always mapped, so its plots run from 6)
                ld      a,(back_buf)
                ld      e,a
                add     a,BANK_RASTER_A
                ld      d,a
                ld      a,e
                xor     1
                rlca
                rlca
                rlca
                or      d
                or      P7_ROM48
                ld      (rast_port),a
                ld      (dle_port+1),a          ; dl_emit's immediate
                xor     a
                ld      (frame_nodes),a
                ld      (frame_ss),a
                ld      (frame_segs),a
                ; the walk runs from bank 4 (walk4.z80) with its node records
                ; and the box check's tables; it pages the geometry in for
                ; each subsector's segs
                ld      a,BANK_OBJ
                call    set_page
                call    sp_reset                ; (bank 4)
                call    walk_frame
                ld      a,BANK_GEOM
                jp      set_page

; ---------------------------------------------------------------------------
; walk_ss_segs : HL = subsector id, the geometry paged in.  Its segs, front
; to back (the walk and the objects that precede them run from bank 4:
; walk4.z80), then the walk bank back before the return there.
; ---------------------------------------------------------------------------
walk_ss_segs:
                PAGE_IMM wss_pg1                ; BANK_GEOM (keeps HL)
                ; SSEC + ssid * 3
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,de                   ; * 3
                ld      de,SSEC
                add     hl,de
                ld      a,(hl)
                or      a
                jr      z,wss_done
                ld      b,a                     ; B = segs left
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)                  ; the first seg's record (the pack
                push    de                      ;  stores the address)
                pop     ix                      ; IX -> the first seg's record
                ld      hl,$ffff
                ld      (ch_vtx),hl             ; the chain starts empty
                ld      a,b
                ld      iyh,a                   ; the count rides IYH (a cull
ss_loop:                                        ;  keeps IX and IYH; the body
                call    render_seg              ;  saves them around itself)
                ld      de,SEG_SIZE
                add     ix,de
                dec     iyh
                jp      nz,ss_loop
wss_done:       PAGE_IMM wss_pg2                ; BANK_OBJ: the walk continues in bank 4
                ret

; ---------------------------------------------------------------------------
; set_page : A = bank to map at $C000.  The displayed screen follows back_buf:
; whichever buffer is not being drawn into is the one on show.
; ---------------------------------------------------------------------------
set_page:
                ld      e,a
                ld      a,(page_base)           ; the displayed screen's bits, per frame
                or      e
                ld      (cur_port),a            ; dl_emit restores it after a plot
                out     (PORT_7FFD & 255),a     ; (as dl_emit: the port decodes on
                ret                             ;  A15/A1 alone, both 0)

; (cpm_init lives in coldinit.z80: once-only code assembled over the span pool)

; mul_s16_u8_signed : A:HL = DE (s16) * A (s8, sign honoured)
mul_s16_u8_signed:
                bit     7,a
                jr      nz,msg_neg
                jp      mul_s16_u8
msg_neg:
                neg
                call    mul_s16_u8
                jp      neg_ahl

near_cross:
                ld      hl,(cr_vy2)
                ld      de,(cr_vy1)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                jp      z,nc_fail
                bit     7,h
                jp      nz,nc_fail
                ld      (nc_d),hl
                ld      hl,NEAR_CROSS
                ld      de,(cr_vy1)
                or      a
                sbc     hl,de
                ld      (nc_n),hl               ; n > 0 because vy1 < 16
nc_norm:
                ld      hl,(nc_d)
                ld      a,h
                or      a
                jr      z,nc_small
                srl     h
                rr      l
                ld      (nc_d),hl
                ld      hl,(nc_n)
                srl     h
                rr      l
                ld      (nc_n),hl
                jp      nc_norm
nc_small:
                ld      a,l
                or      a
                jr      z,nc_use2               ; d became 0: take v2
                ld      c,a                     ; C = d (1..255)
                ld      hl,(nc_n)
                ld      a,h
                or      a
                jr      nz,nc_use2              ; n >= 256 > d
                ld      a,l
                cp      c
                jr      nc,nc_use2              ; n >= d -> t >= 256
                ; t = ((n << 8) + (d >> 1)) / d
                ld      h,a
                ld      l,0
                ld      a,c
                srl     a
                ld      e,a
                ld      d,0
                add     hl,de
                call    div16_8                 ; L = quotient
                ld      a,l
                ld      (nc_t),a
                ld      hl,(cr_vx2)
                ld      de,(cr_vx1)
                or      a
                sbc     hl,de                   ; dvx
                bit     7,h
                jr      nz,nc_negdvx
                ex      de,hl
                ld      a,(nc_t)
                call    mul_s16_u8
                call    rns8_ahl
                ld      de,(cr_vx1)
                add     hl,de
                jr      nc_done
nc_negdvx:
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ex      de,hl                   ; DE = |dvx|
                ld      a,(nc_t)
                call    mul_s16_u8
                call    rns8_ahl
                ex      de,hl
                ld      hl,(cr_vx1)
                or      a
                sbc     hl,de
nc_done:
                ld      (bb_cx),hl
                scf
                ret
nc_use2:
                ld      hl,(cr_vx2)
                ld      (bb_cx),hl
                scf
                ret
nc_fail:
                or      a
                ret

; div16_8 : HL / C -> HL quotient, A remainder
div16_8:
                xor     a
                ld      b,16
d168_l:
                add     hl,hl
                rla
                jr      c,d168_s
                cp      c
                jp      c,d168_n
d168_s:
                sub     c
                inc     l
d168_n:
                djnz    d168_l
                ret

; ---------------------------------------------------------------------------
; vertex_get : HL = vertex index -> HL = its cache entry, which
; holds the view-space position and, when in front of the near plane, the
; projected column.
; ---------------------------------------------------------------------------
; vertex_get : HL = a vertex index -> HL = its stamp byte in the cache planes, filled
; this frame if it was not: the epoch's rotation L(w) from VXCACHE, or a
; cold transform, plus the frame's ref term, then the reciprocal and the
; column (vg_project).  The cold transform is the same integer arithmetic
; as the rotation helpers - four s16 x u8 products of the magnitudes, the
; signed combination, RNS3 - with the frame's magnitudes, unity cases and
; signs patched into it by vs_rebuild, so it runs straight through
; registers.  Eats everything.
; ---------------------------------------------------------------------------
                MACRO   VGETP site              ; HL = the vertex's VXR record
site:           ld      a,0                     ; SMC: vc_stamp (vs_stampok)
                cp      (hl)
                call    nz,vg_miss
                ENDM

; vertex_get : HL = a vertex index -> HL = its stamp byte in the cache planes, filled
; this frame if it was not.  The transform is the BBC port's: the vertex is
; a low byte per axis and a page nibble; each axis is
;       floor((4 [+|-] ox*|s| [-|+] oy*|c|) / 8) + PB[pg] + ref
; with the products read from the angle's tables (TS_TAB, TC_TAB), the four
; sign sites patched by vs_rebuild_b4 and the page term PBX/PBY exact - so
; the result is the rns3 of the full rotation, the integers unchanged.  Then
; the reciprocal and the column (vg_project).  Eats everything.
; ---------------------------------------------------------------------------
; obj_rot : E = ox, D = oy (7-bit offsets), IYL = the page pair * 4 -> DE = tvx,
; HL = tvy.  vertex_get's transform for an object's feet (objects.s:
; rot_w_pages reused verbatim); bank 4 code calls it, so the product tables
; page in here and bank 4 comes back before the return.  Its SMC sites are
; patched with vertex_get's (fsetup.z80).
obj_rot:
                PAGE_IN BANK_PROD
                push    de                      ; (oy, ox) for the y axis
                ld      a,e
                add     a,a
                ld      l,a
orx_ts:         ld      h,0                     ; SMC: the |sin| table's page
                ld      c,(hl)
                inc     l
                ld      b,(hl)                  ; BC = ox * |sin|
                ld      a,d
                add     a,a
                ld      l,a
orx_tc:         ld      h,0                     ; SMC: |cos|
                ld      e,(hl)
                inc     l
                ld      d,(hl)                  ; DE = oy * |cos|
                ld      hl,4
                xor     a
orx1:           add     hl,bc                   ; [+|-] ox*|s|   (patched, 5 bytes)
                adc     a,0
                nop
                nop
orx2:           or      a                       ; [-|+] oy*|c|
                sbc     hl,de
                sbc     a,0
                rra
                rr      h
                rr      l
                sra     h
                rr      l
                sra     h
                rr      l                       ; floor(S / 8)
                ld      a,iyl
                ld      e,a
                ld      d,PB >> 8
                ld      a,(de)
                inc     e
                ld      c,a
                ld      a,(de)
                ld      b,a
                add     hl,bc                   ; + the page term
                ld      de,(vs_rx)
                add     hl,de                   ; HL = tvx
                ex      (sp),hl                 ; tvx down, (oy, ox) up
                ld      c,l                     ; ox
                ld      a,h                     ; oy
                add     a,a
                ld      l,a
ory_ts:         ld      h,0                     ; SMC: |sin|
                ld      e,(hl)
                inc     l
                ld      d,(hl)                  ; DE = oy * |sin|
                ld      a,c
                add     a,a
                ld      l,a
ory_tc:         ld      h,0                     ; SMC: |cos|
                ld      c,(hl)
                inc     l
                ld      b,(hl)                  ; BC = ox * |cos|
                ld      hl,4
                xor     a
ory1:           add     hl,bc                   ; [+|-] ox*|c|
                adc     a,0
                nop
                nop
ory2:           add     hl,de                   ; [+|-] oy*|s|
                adc     a,0
                nop
                nop
                rra
                rr      h
                rr      l
                sra     h
                rr      l
                sra     h
                rr      l
                ld      a,iyl
                add     a,2
                ld      e,a
                ld      d,PB >> 8
                ld      a,(de)
                inc     e
                ld      c,a
                ld      a,(de)
                ld      b,a
                add     hl,bc
                ld      de,(vs_ry)
                add     hl,de                   ; HL = tvy
                pop     de                      ; DE = tvx
                PAGE_IN BANK_OBJ
                ret

; vg_miss : HL = the VXR record, A = the frame stamp: fill the entry (the
; BBC port's sx_vert miss).  The rotated coordinates stand while the angle
; does (VRCACHE): a viewer that only moved rotates nothing.  One straight
; run: the rotation body jumps back to vx_store, the projection is in line.
vg_miss:        ld      (hl),a                  ; the frame stamp
                push    hl                      ; the VXR record
                ld      a,h
                sub     VRR_TO_VXR
                ld      h,a                     ; the VRR record
vgm_vxs:        ld      a,0                     ; SMC: vx_stamp (vs_rebuild)
                cp      (hl)
                jp      nz,vx_miss
                inc     l                       ; the rotated pair stands
                ld      e,(hl)
                inc     l
                ld      d,(hl)                  ; DE = rx
                inc     l
                ld      c,(hl)
                inc     l
                ld      h,(hl)
                ld      l,c                     ; HL = ry
                jr      vg_have
vx_miss:        ld      (hl),a                  ; the angle's stamp
                push    hl                      ; the VRR record
vx_rot:         jp      vg_rotate_rel           ; SMC: the epoch's body (the
                                                ;  cardinal twins, vs_rebuild_b4)
vx_store:       ; DE = rx, HL = ry, the VRR record on the stack
                ex      (sp),hl                 ; HL = the record, ry down
                inc     l
                ld      (hl),e                  ; rx
                inc     l
                ld      (hl),d
                inc     l
                pop     bc                      ; ry
                ld      (hl),c
                inc     l
                ld      (hl),b
                ld      h,b
                ld      l,c                     ; HL = ry, DE = rx
vg_have:                                        ; + the viewer's term
vxh_rx:         ld      bc,0                    ; (SMC: vs_rx/vs_ry, view_setup)
                ex      de,hl
                add     hl,bc
                ex      de,hl                   ; DE = tvx
vxh_ry:         ld      bc,0
                add     hl,bc                   ; HL = tvy
vg_project:
                ; project when in front of the near plane, keeping the
                ; reciprocal with the column
                bit     7,h
                jr      nz,vg_behind
                ld      a,h
                or      a
                jp      nz,vg_front
                ld      a,l
                cp      NEAR_VERDICT
                jr      nc,vg_front
vg_behind:
                pop     hl                      ; the record
                inc     l
                inc     l                       ; -> S
                xor     a
                ld      (hl),a                  ; the verdict rs_visible reads
                inc     l
                ld      (hl),a                  ; sx = 0
                inc     l
                ld      (hl),a
                res     2,l                     ; the record again
                ret
vg_front:
                push    de                      ; tvx
                RECIP_BODY                      ; E = M8, D = S
                pop     hl                      ; tvx
                ex      (sp),hl                 ; HL = the record, tvx down
                inc     l
                ld      (hl),e                  ; M8
                inc     l
                ld      (hl),d                  ; S
                ex      (sp),hl                 ; HL = tvx, the S slot down
                PROJECT_X                       ; HL = the column
                ex      de,hl
                pop     hl                      ; the S slot
                inc     l
                ld      (hl),e                  ; sx
                inc     l
                ld      (hl),d
                res     2,l                     ; the record again
                ret

; vx_fetch : HL = a vertex's VRR record -> DE = tvx, HL = tvy from the
; rotated cache (valid: the angle stamp matched) plus the viewer's term
; (rs_clipx's crossings; the objects' twins enter at vx_have)
vx_fetch:
                inc     l
                ld      e,(hl)
                inc     l
                ld      d,(hl)                  ; DE = rx
                inc     l
                ld      c,(hl)
                inc     l
                ld      h,(hl)
                ld      l,c                     ; HL = ry
vx_have:
vxh_rx2:        ld      bc,0                    ; + the viewer's term (SMC)
                ex      de,hl
                add     hl,bc
                ex      de,hl                   ; DE = tvx
vxh_ry2:        ld      bc,0
                add     hl,bc                   ; HL = tvy
                ret

; vg_rotate_rel : HL = a vertex's VRR record -> DE = rx, HL = ry (s16
; counts, before the viewer's term): the BBC port's rot_w_pages through the
; per-angle product tables (bank 3), paged in and the caller's bank put
; back.  The offsets and page pair are the record's static bytes, so the
; geometry bank need not be in.  Eats A, BC, IY.
vg_rotate_rel:
                ld      a,l
                or      VRR_OX
                ld      l,a
                ld      e,(hl)                  ; ox (7 bits)
                inc     l
                ld      d,(hl)                  ; oy
                inc     l
                ld      a,(hl)                  ; the page pair (6 bits)
                add     a,a
                add     a,a
                ld      iyl,a                   ; * 4: PB's index
vgr_pp:         ld      a,0                     ; the product tables (bank 3;
                out     (PORT_7FFD & 255),a     ;  SMC: prod_port)
                push    de                      ; (oy, ox) for the y axis
                ; --- x ---
                ld      a,e
                add     a,a
                ld      l,a
vgx_ts:         ld      h,0                     ; SMC: the |sin| table's page
                ld      c,(hl)
                inc     l
                ld      b,(hl)                  ; BC = ox * |sin|
                ld      a,d
                add     a,a
                ld      l,a
vgx_tc:         ld      h,0                     ; SMC: the |cos| table's page
                ld      e,(hl)
                inc     l
                ld      d,(hl)                  ; DE = oy * |cos|
                ld      hl,4
                xor     a
vgx1:           add     hl,bc                   ; [+|-] ox*|s|   (patched, 5 bytes)
                adc     a,0
                nop
                nop
vgx2:           or      a                       ; [-|+] oy*|c|
                sbc     hl,de
                sbc     a,0
                ; the sum is 17 bits (7-bit offsets: |P| < 32768), so A is 0,
                ; 1 or -1 and its bit 0 IS bit 16: one rotate injects it and
                ; the rest is a 16-bit arithmetic shift (S >> 1 fits s16)
                rra
                rr      h
                rr      l
                sra     h
                rr      l
                sra     h
                rr      l                       ; floor(S / 8)
                ld      a,iyl
                ld      e,a
                ld      d,PB >> 8
                ld      a,(de)
                inc     e
                ld      c,a
                ld      a,(de)
                ld      b,a
                add     hl,bc                   ; + the page term: HL = rx
                ex      (sp),hl                 ; rx down, (oy, ox) up
                ; --- y ---
                ld      c,l                     ; ox
                ld      a,h                     ; oy
                add     a,a
                ld      l,a
vgy_ts:         ld      h,0                     ; SMC: |sin|
                ld      e,(hl)
                inc     l
                ld      d,(hl)                  ; DE = oy * |sin|
                ld      a,c
                add     a,a
                ld      l,a
vgy_tc:         ld      h,0                     ; SMC: |cos|
                ld      c,(hl)
                inc     l
                ld      b,(hl)                  ; BC = ox * |cos|
                ld      hl,4
                xor     a
vgy1:           add     hl,bc                   ; [+|-] ox*|c|
                adc     a,0
                nop
                nop
vgy2:           add     hl,de                   ; [+|-] oy*|s|
                adc     a,0
                nop
                nop
                rra                             ; (as the x axis)
                rr      h
                rr      l
                sra     h
                rr      l
                sra     h
                rr      l
                ld      a,iyl
                add     a,2
                ld      e,a
                ld      d,PB >> 8
                ld      a,(de)
                inc     e
                ld      c,a
                ld      a,(de)
                ld      b,a
                add     hl,bc                   ; HL = ry
                pop     de                      ; DE = rx
                ld      a,(cur_port)            ; the caller's bank back
                out     (PORT_7FFD & 255),a
                jp      vx_store

; ---------------------------------------------------------------------------
; The cardinal twins (BBC rwp_card_su / rwp_card_cu): at a cardinal angle one
; trig is unity and the other zero, so each axis is PB +- (offset << 5)
; exactly (floor((4 +- 256*o) / 8) = +-32*o) and the product tables are not
; consulted: no paging.  vs_rebuild_b4 points vx_rot / ob_rot at the twin
; for the epoch and patches the four sign sites (CARD_AXIS: `jr` = add,
; `xor a / sub l` = subtract).
;   su (sin unity):  rx = PBX +-s ox<<5,  ry = PBY +-s oy<<5
;   cu (cos unity):  rx = PBX -+c oy<<5,  ry = PBY +-c ox<<5
; rc_su / rc_cu : E = ox, D = oy, C = the PB index -> DE = rx, HL = ry
; ---------------------------------------------------------------------------
                MACRO   CARD_AXIS site          ; A = the offset -> HL = PB[BC] +- A << 5
                rrca
                rrca
                rrca
                ld      l,a
                and     $1F
                ld      h,a
                ld      a,l
                and     $E0
                ld      l,a                     ; HL = the offset << 5
site:           jr      .add                    ; SMC: `xor a / sub l` negates
                ld      l,a
                sbc     a,a
                sub     h
                ld      h,a
.add:           ld      a,(bc)
                add     a,l
                ld      l,a
                inc     c
                ld      a,(bc)
                adc     a,h
                ld      h,a
                ENDM
; CARD_ROT : E = ox, D = oy, C = the PB index -> DE = rx, HL = ry; su takes
; x from ox and y from oy, cu x from oy and y from ox.  (sjasmplus macro
; parameters substitute as substrings: hence the pSX-style names.)
                MACRO   CARD_ROT pSX, pSY, pXR, pYR
                ld      b,PB>>8
                ld      a,pXR
                CARD_AXIS pSX                   ; HL = rx
                inc     c                       ; -> PBY
                ld      a,pYR
                ex      de,hl                   ; DE = rx
                CARD_AXIS pSY                   ; HL = ry
                ENDM
                MACRO   CARD_FETCH              ; HL = the VRR record -> E, D, C
                ld      a,l
                or      VRR_OX
                ld      l,a
                ld      e,(hl)                  ; ox
                inc     l
                ld      d,(hl)                  ; oy
                inc     l
                ld      a,(hl)                  ; the page pair
                add     a,a
                add     a,a
                ld      c,a
                ENDM
vg_rot_su:      CARD_FETCH
                CARD_ROT vsu_xs, vsu_ys, e, d
                jp      vx_store
vg_rot_cu:      CARD_FETCH
                CARD_ROT vcu_xs, vcu_ys, d, e
                jp      vx_store
; the objects' twins: obj_rot's interface (E = ox, D = oy, IYL = the index),
; the viewer's term added as vx_have does
ob_rot_su:      ld      a,iyl
                ld      c,a
                CARD_ROT osu_xs, osu_ys, e, d
                jp      vx_have
ob_rot_cu:      ld      a,iyl
                ld      c,a
                CARD_ROT ocu_xs, ocu_ys, d, e
                jp      vx_have


; ---------------------------------------------------------------------------
; render_seg : HL = seg index.
; ---------------------------------------------------------------------------
render_seg:     ; IX -> the seg record
                ld      a,(ix+SG_FLAGS)
                ld      (sg_flags),a
                ld      c,a

                ; --- back face -----------------------------------------
                ; The reference's verdict is the sign of
                ;   dot = ldy * (px88 - lx88) - ldx * (py88 - ly88)
                ; in prescaled 8.8, with a tie (dot == 0) culled when
                ; ldy < 0 or (ldy == 0 and ldx > 0).  Three quarters of
                ; DOOM's linedefs are axis aligned, and for those one term
                ; vanishes and the test is a comparison of one coordinate.
                ; For the rest the integer-part dot D decides on its own
                ; unless |D| < |ldx| + |ldy|, the band inside which the
                ; fractions can still turn it (the BBC port's DBOUND gate).
                and     SF_LDX0
                jp      nz,rs_bf_x0
                ld      a,c
                and     SF_LDY0
                jp      nz,rs_bf_y0
                ld      e,(ix+SG_LX)
                ld      d,(ix+SG_LX+1)
bfx1:           ld      hl,0                    ; SMC: pl_x (view_setup)
                or      a
                sbc     hl,de
                ld      (pos_dx),hl             ; px - lx
                ld      e,(ix+SG_LY)
                ld      d,(ix+SG_LY+1)
bfy1:           ld      hl,0                    ; SMC: pl_y
                or      a
                sbc     hl,de                   ; py - ly
                ex      de,hl                   ; DE = dy
                ; --- the sign shortcut (the BBC port's bf_g_both): dx and dy
                ; both nonzero with P1 = ldy*dx and P2 = ldx*dy of opposite
                ; signs means D = P1 - P2 has P1's sign and |D| = |P1| + |P2|
                ; >= |ldx| + |ldy|, outside the band: no product ---
                ld      a,d
                or      e
                jr      z,bf_prod
                ld      hl,(pos_dx)
                ld      a,h
                or      l
                jr      z,bf_prod
                ld      a,h
                xor     (ix+SG_LDY)             ; b7 = sign(P1)
                ld      c,a
                ld      a,d
                xor     (ix+SG_LDX)             ; b7 = sign(P2)
                xor     c
                jp      p,bf_prod               ; the same sign: the products
                bit     7,c
                ret     nz                      ; P1 < 0: D < 0, behind
                jp      rs_visible
bf_prod:        ld      a,(ix+SG_LDX)
                call    mul_s16_u8_signed       ; A:HL = ldx * dy
                ld      (pos_l+2),a             ; the multiply eats BC
                push    hl
                ld      de,(pos_dx)
                ld      a,(ix+SG_LDY)
                call    mul_s16_u8_signed       ; A:HL = ldy * dx
                pop     de
                or      a
                sbc     hl,de
                ld      d,a
                ld      a,(pos_l+2)
                ld      e,a
                ld      a,d
                sbc     a,e                     ; A:HL = D = ldy*dx - ldx*dy
                ; the band: |D| < |ldx| + |ldy|
                ld      (bf_d),hl
                ld      (bf_d+2),a
                ld      b,a
                ld      a,(ix+SG_LDX)
                bit     7,a
                jr      z,bf_b1
                neg
bf_b1:          ld      c,a
                ld      a,(ix+SG_LDY)
                bit     7,a
                jr      z,bf_b2
                neg
bf_b2:          add     a,c
                ld      c,a                     ; C = the bound
                ld      a,b
                or      a
                jr      nz,bf_dneg
                ld      a,h
                or      a
                jp      nz,rs_visible           ; D >= 256
                ld      a,l
                cp      c
                jp      nc,rs_visible           ; D >= bound
                jr      bf_exact
bf_dneg:        inc     a
                ret     nz                      ; D <= -65536
                ld      a,h
                inc     a
                ret     nz                      ; D <= -256
                ld      a,l
                add     a,c                     ; D = L - 256 > -bound iff L + bound > 256
                ret     nc
                ret     z
bf_exact:
                ; dot88 = 256 * D + ldy * (pxf - lxf) - ldx * (pyf - lyf)
                ld      a,(pl_xf)
                sub     (ix+SG_LXF)
                ld      e,a
                sbc     a,a
                ld      d,a                     ; DE = pxf - lxf, s16
                ld      a,(ix+SG_LDY)
                call    mul_s16_u8_signed
                ld      (bf_t),hl
                ld      (bf_t+2),a
                ld      a,(pl_yf)
                sub     (ix+SG_LYF)
                ld      e,a
                sbc     a,a
                ld      d,a
                ld      a,(ix+SG_LDX)
                call    mul_s16_u8_signed       ; A:HL = ldx * fy
                ld      d,a
                ld      a,(bf_t+2)
                ld      e,a
                ld      a,(bf_t)
                sub     l
                ld      l,a
                ld      a,(bf_t+1)
                sbc     a,h
                ld      h,a
                ld      a,e
                sbc     a,d                     ; A:HL = ldy*fx - ldx*fy
                ld      b,a                     ; B = its high byte
                ld      a,(bf_d)                ; + 256 * D: D's low byte
                ld      d,a                     ; into the middle
                ld      e,0
                add     hl,de
                ld      a,(bf_d+1)              ; D's sign byte (D fits s9)
                adc     a,b
                ret     m                       ; behind
                or      h
                or      l
                jr      nz,rs_visible
                ; a tie: culled when ldy < 0 (ldx, ldy both nonzero here)
                bit     7,(ix+SG_LDY)
                ret     nz
                jr      rs_visible
rs_bf_x0:
                ; dot = ldy * (px88 - lx88): the integer difference decides
                ; unless it is zero, then the fractions, then the tie rule
                ld      e,(ix+SG_LX)
                ld      d,(ix+SG_LX+1)
bfx2:           ld      hl,0                    ; SMC: pl_x
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                jr      z,bx_frac
                ld      a,h
                xor     (ix+SG_LDY)             ; sign of the product
                ret     m
                jp      rs_visible
bx_frac:        ld      a,(pl_xf)
                sub     (ix+SG_LXF)
                jr      z,bx_tie
                sbc     a,a                     ; the sign of the difference
                xor     (ix+SG_LDY)
                ret     m
                jr      rs_visible
bx_tie:         bit     7,(ix+SG_LDY)           ; culled when ldy < 0
                ret     nz
                jr      rs_visible
rs_bf_y0:
                ; dot = -ldx * (py88 - ly88)
                ld      e,(ix+SG_LY)
                ld      d,(ix+SG_LY+1)
bfy2:           ld      hl,0                    ; SMC: pl_y
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                jr      z,by_frac
                ld      a,h
                xor     (ix+SG_LDX)
                ret     p                       ; product positive -> dot < 0
                jp      rs_visible
by_frac:        ld      a,(pl_yf)
                sub     (ix+SG_LYF)
                jr      z,by_tie
                sbc     a,a
                xor     (ix+SG_LDX)
                ret     p
                jr      rs_visible
by_tie:         bit     7,(ix+SG_LDX)           ; culled when ldx > 0
                jr      nz,rs_visible
                ret
rs_visible:
                ; the vertex indices, as their stamp addresses (H = the
                ; VXCACHE stamp page | the index's bit 8): VGETP probes them
                ; as they are, and every plane hangs off them
                ; the vertices, as their VXR records (H = the page, L = the
                ; low byte of v*8, both straight from the seg record): VGETP
                ; probes them as they are, and every field is `inc l` on
                ld      a,(ix+SG_VHI)
                ld      c,a
                rrca
                rrca
                rrca
                rrca
                and     $0F
                add     a,VXR>>8
                ld      h,a
                ld      l,(ix+SG_V2)
                ld      (sg_v2),hl
                push    hl
                ld      a,c
                and     $0F
                add     a,VXR>>8
                ld      h,a
                ld      l,(ix+SG_V1)
                ld      (sg_v1),hl
                ; v1 = the previous seg's v2?  Its (M8, S, sx) stand in
                ; sg_m2/sg_sx2 (the BBC port's v1/v2 chain): take them as
                ; v1's, no probe, no copy from the record
                ld      a,(ch_v2)
                cp      l
                jr      nz,rs_v1get
                ld      a,(ch_v2+1)
                cp      h
                jr      nz,rs_v1get
                ld      hl,(sg_m2)
                ld      (sg_m1),hl
                ld      hl,(sg_sx2)
                ld      (sg_sx1),hl
                pop     hl                      ; v2's record
                ld      (ch_v2),hl              ; (its copy follows at once)
                VGETP   vcs1
                inc     l
                ld      de,sg_m2                ; (M8, S, sx lo, sx hi): one run
                ldi
                ldi
                ldi
                ldi
                jp      rs_verdicts
rs_v1get:       VGETP   vcs2                    ; HL = v1's record
                ex      (sp),hl                 ; v1's record down, v2's up
                ld      (ch_v2),hl              ; v2's copy follows at once
                VGETP   vcs3                    ; HL = v2's record
                inc     l
                ld      de,sg_m2
                ldi
                ldi
                ldi
                ldi
                pop     hl                      ; v1's record
                inc     l
                ld      de,sg_m1
                ldi
                ldi
                ldi
                ldi
rs_verdicts:
                ; near-plane verdicts: vg_project left S = 0 on a vertex
                ; behind the near plane (a live reciprocal's S is never 0)
                ld      a,(sg_s1)
                sub     1
                sbc     a,a
                ld      c,a                     ; C = v1 behind ($FF)
                ld      a,(sg_s2)
                sub     1
                sbc     a,a
                ld      b,a                     ; B = v2 behind
rs_nd:          ld      (sg_n1),bc              ; C = v1's verdict, B = v2's
                ld      a,b
                and     c
                ret     nz                      ; both behind the near plane
                ld      a,b
                or      c
                jr      nz,rs_clipx             ; a near crossing (11%): the
                                                ;  island below rs_havex
rs_havex:
                ; a reversed or tied projection covers no columns: dropped.
                ; The pair is loaded ONCE and the order test leaves it alone
                ; (the flag-flipped compare of CMP16F ate both registers, so
                ; the old form reloaded them for sp_hasgap)
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                ld      a,d
                xor     $80
                ld      c,a                     ; C = sx2 hi, offset-binned
                ld      a,h
                xor     $80
                cp      c
                jr      c,rs_hx                 ; sx1 hi < sx2 hi: forward
                ret     nz                      ; sx1 > sx2: reversed, dropped
                ld      a,l
                cp      e
                ret     nc                      ; sx1 >= sx2: reversed or tied
rs_hx:          call    sp_hasgap
                ret     nc
                jp      render_seg_body

rs_clipx:
                ; a crossing needs the view coordinates: from the rotated
                ; cache (both vertices were probed this frame)
                push    bc
                ld      hl,(sg_v1)
                ld      a,h
                sub     VRR_TO_VXR
                ld      h,a                     ; its VRR record
                call    vx_fetch
                ld      (cr_vx1),de
                ld      (cr_vy1),hl
                ld      hl,(sg_v2)
                ld      a,h
                sub     VRR_TO_VXR
                ld      h,a
                call    vx_fetch
                ld      (cr_vx2),de
                ld      (cr_vy2),hl
                pop     bc
                ld      a,c
                or      a
                jr      z,rs_clip2
rs_clip1:
                ; v1 is behind: cross toward v2
                call    near_cross_seg1
                ret     nc
                ld      hl,NEAR_CROSS
                call    recip
                ld      (sg_m1),de
                ld      hl,(bb_cx)
                call    project_x
                ld      (sg_sx1),hl
                jp      rs_havex
rs_clip2:
                ; v2 is behind: cross toward v1
                call    near_cross_seg2
                ret     nc
                ld      hl,NEAR_CROSS
                call    recip
                ld      (sg_m2),de
                ld      hl,(bb_cx)
                call    project_x
                ld      (sg_sx2),hl
                ld      hl,$ffff                ; not the vertex's own: no chain
                ld      (ch_v2),hl
                jp      rs_havex

; rs_near : HL = tvy -> A = 1 when it is short of the near plane.
rs_near:
                ld      a,h
                or      a
                jr      nz,rs_nbig
                ld      a,l
                cp      NEAR_VERDICT
                sbc     a,a                     ; -1 when below
                and     1
                ret
rs_nbig:
                rla                             ; carry = sign
                sbc     a,a
                and     1
                ret

near_cross_seg1:
                ld      hl,(cr_vx1)
                ld      de,(cr_vy1)
                jp      near_cross
near_cross_seg2:
                ; swap the endpoints so v2 is the clipped one
                ld      hl,(cr_vx1)
                ld      de,(cr_vx2)
                ld      (cr_vx1),de
                ld      (cr_vx2),hl
                ld      hl,(cr_vy1)
                ld      de,(cr_vy2)
                ld      (cr_vy1),de
                ld      (cr_vy2),hl
                call    near_cross
                push    af
                ld      hl,(cr_vx1)
                ld      de,(cr_vx2)
                ld      (cr_vx1),de
                ld      (cr_vx2),hl
                ld      hl,(cr_vy1)
                ld      de,(cr_vy2)
                ld      (cr_vy1),de
                ld      (cr_vy2),hl
                pop     af
                ret

; ---------------------------------------------------------------------------
; render_seg_body : project the seg's heights, emit its visible edges, and
; apply the occlusion update it implies.
; ---------------------------------------------------------------------------
render_seg_body:
                push    ix                      ; the seg loop's record and count
                push    iy
                call    rsb_body
                pop     iy
                pop     ix
                ret
rsb_body:
                ; the four heights, contiguous in the record (16-aligned: the
                ; field offset never carries), copied only for a seg that
                ; reaches the body (the culled half never read them)
                ld      a,ixl
                add     a,SG_FH
                ld      l,a
                ld      a,ixh
                ld      h,a
                ld      de,sg_fh
                ldi
                ldi
                ldi
                ldi
                ; Four segs in five share v1 with the previous seg's v2, and
                ; the front sector is the same right across a subsector, so
                ; that seg's projected pair is this one's - no reciprocal, no
                ; multiply, two loads.
                xor     a
                ld      (ch_hit),a
                ld      a,(sg_n1)
                or      a
                jr      nz,rsb_p1
                ld      hl,(ch_vtx)
                ld      de,(sg_v1)
                or      a
                sbc     hl,de
                jr      nz,rsb_p1
                ld      hl,(sg_ft2)             ; (still the previous seg's)
                ld      (sg_ft1),hl
                ld      hl,(sg_fb2)
                ld      (sg_fb1),hl
                ld      a,1                     ; (and its vertical spans went
                ld      (ch_hit),a              ;  out with that seg)
                jp      rsb_p2
rsb_p1:
                ld      de,(sg_m1)
                ld      a,(sg_ch)
                PY_INLINE pyv1
                ld      (sg_ft1),hl
                ld      a,(sg_fh)               ; DE = sg_m1 still (project_y keeps DE)
                PY_INLINE pyv2
                ld      (sg_fb1),hl
rsb_p2:
                ; a portal's back pair at v1 comes before v2's front pair (the
                ; BBC port's ysb order: the project_y cache sees the same
                ; sequence, so it holds the same entries)
                ld      a,(sg_flags)
                ld      c,a                     ; (C is free until PY_INLINE)
                and     SF_SOLID
                jr      nz,rsb_p2f
                ld      a,c
                and     SF_NEEDBT
                jr      z,rsb_p2bb
                ld      de,(sg_m1)
                ld      a,(sg_bch)
                PY_INLINE pyv3
                ld      (sg_bt1),hl
rsb_p2bb:       ld      a,(sg_flags)
                and     SF_NEEDBB
                jr      z,rsb_p2f
                ld      de,(sg_m1)
                ld      a,(sg_bfh)
                PY_INLINE pyv4
                ld      (sg_bb1),hl
rsb_p2f:
                ld      de,(sg_m2)
                ld      a,(sg_ch)
                PY_INLINE pyv5
                ld      (sg_ft2),hl
                ld      a,(sg_fh)               ; DE = sg_m2 still (project_y keeps DE)
                PY_INLINE pyv6
                ld      (sg_fb2),hl
                ld      a,(sg_n2)               ; hand the pair to the next seg
                or      a                       ; (it reads sg_ft2/sg_fb2 as
                ld      hl,$ffff                ;  they stand)
                jr      nz,rsb_p3n
                ld      hl,(sg_v2)
rsb_p3n:        ld      (ch_vtx),hl
rsb_p3:
                ; the heights the vertex-span descriptors read: the back
                ; pair of a solid seg is aliased to the front by the pack
                ; (vs_h aliases sg_fh..sg_bch: nothing to copy)
                ; --- the eyeline rule: a ceiling at or below the eye kills
                ; the top edges ($80), a floor at or above it the bottom
                ; edges ($40); the top kill wins.  Byte subtractions, as
                ; the BBC port's ---
                ld      a,(sg_ch)
                ld      hl,vs_vz
                sub     (hl)
                ld      a,$80
                jp      m,rsb_esk
                ld      a,(sg_fh)
                sub     (hl)
                ld      a,$40
                jp      p,rsb_esk
                xor     a
rsb_esk:        ld      (sg_eskip),a
                ld      a,(sg_flags)
                and     SF_SOLID
                jp      nz,rsb_solid

                ; --- a portal: the BBC port's seg_emit cascade ------------
                xor     a
                ld      (fw_touch),a
                ld      a,(sg_flags)
                and     SF_NEEDBT
                jr      z,rsb_nbt
                ld      de,(sg_m2)              ; (v1's back pair went with v1)
                ld      a,(sg_bch)
                PY_INLINE pyv7
                ld      (sg_bt2),hl
rsb_nbt:        ld      a,(sg_flags)
                and     SF_NEEDBB
                jr      z,rsb_nbb
                ld      de,(sg_m2)
                ld      a,(sg_bfh)
                PY_INLINE pyv8
                ld      (sg_bb2),hl
rsb_nbb:
                ; the companions: the front edges beside a step, plain draws
                ld      a,(sg_flags)
                and     SF_NEEDBT|SF_NEEDBB
                cp      SF_NEEDBT|SF_NEEDBB
                jr      nz,pc_singles
                ld      a,(sg_eskip)
                or      a
                jr      nz,pc_singles
                ld      hl,sg_ft1
                call    rsb_line
                ld      hl,sg_fb1
                call    rsb_line
                jp      pc_verts
pc_singles:     ld      a,(sg_flags)
                and     SF_NEEDBT
                jp      z,pc_fb
                ld      a,(sg_eskip)
                bit     7,a
                jr      nz,pc_fb
                ld      hl,sg_ft1
                call    rsb_line
pc_fb:          ld      a,(sg_flags)
                and     SF_NEEDBB
                jp      z,pc_verts
                ld      a,(sg_eskip)
                bit     6,a
                jr      nz,pc_verts
                ld      hl,sg_fb1
                call    rsb_line
pc_verts:       call    rsb_vspans
                ; the armed aperture edges, applied as they are drawn
                ld      a,(sg_flags)
                and     SF_NEEDBT
                jr      z,pc_top_up
                ld      hl,sg_bt1
                xor     a
                call    rsb_fused
                jp      pc_bot
pc_top_up:      ld      a,(sg_flags)
                and     SF_STEPUP_T
                jr      z,pc_bot
                ld      hl,sg_ft1
                xor     a
                call    rsb_fused
pc_bot:         ld      a,(sg_flags)
                and     SF_NEEDBB
                jr      z,pc_bot_up
                ld      hl,sg_bb1
                ld      a,$80
                call    rsb_fused
                jp      pc_walk
pc_bot_up:      ld      a,(sg_flags)
                and     SF_STEPUP_B
                jr      z,pc_walk
                ld      hl,sg_fb1
                ld      a,$80
                call    rsb_fused
pc_walk:        ld      a,(fw_touch)
                or      a
                jr      z,pc_zero
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                jp      fused_merge_range
pc_zero:        call    seg_zero_rec_solid
                ret     nc
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                jp      sp_marksolid

; --- one-sided wall --------------------------------------------------------
rsb_solid:
                ld      a,(sg_eskip)
                or      a
                jr      nz,sc_esk
                ; --- the BBC port's dcl_solid_pair: with the six senior bytes
                ; clear and the columns apart, the top and bottom lines share
                ; xl/xr and ONE span seek (the bottom resumes at the top's
                ; first span, dcl_pair2); otherwise the classic two lines ---
                ld      hl,sg_ft1+1
                ld      a,(hl)
                inc     hl
                inc     hl
                or      (hl)                    ; fb1
                inc     hl
                inc     hl
                or      (hl)                    ; ft2
                inc     hl
                inc     hl
                or      (hl)                    ; fb2
                ld      hl,sg_sx1+1
                or      (hl)
                ld      hl,sg_sx2+1
                or      (hl)
                jr      nz,sc_classic
                ld      a,(sg_sx1)
                ld      hl,sg_sx2
                cp      (hl)
                jr      z,sc_classic            ; one column: the vertical path
                ld      (lc_x1),a
                ld      a,(hl)
                ld      (lc_x2),a
                ld      a,(sg_ft1)
                ld      (lc_y1),a
                ld      a,(sg_ft2)
                ld      (lc_y2),a
                call    dcl_pair2               ; the top, from sp_hasgap's memo
                ld      a,(sg_fb1)
                ld      (lc_y1),a
                ld      a,(sg_fb2)
                ld      (lc_y2),a
                call    dcl_pair2               ; the bottom, from the memo
                call    rsb_vspans
                jp      sp_marksolid_memo       ; from the memo too
sc_classic:     ld      hl,sg_ft1
                call    rsb_line
sc_fb:          ld      hl,sg_fb1
                call    rsb_line
sc_no_fb:       call    rsb_vspans
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                jp      sp_marksolid
sc_esk:         bit     7,a
                jr      nz,sc_fb                ; no top edge: the bottom alone
                ld      hl,sg_ft1
                call    rsb_line
                jr      sc_no_fb

; cmp_s8 : A vs (HL), signed bytes: carry when A < (HL), zero when equal
cmp_s8:
                sub     (hl)
                ret     z
                jp      pe,cs8_ovf
                jp      m,cs8_lt
                or      a                       ; carry clear, NZ
                ret
cs8_ovf:        jp      m,cs8_ge                ; overflowed: the true sign is the other
cs8_lt:         scf
                ret
cs8_ge:         or      a
                ret

; rsb_line : HL -> a row pair (y at sx1; y at sx2 four bytes on), drawn from
; sx1 to sx2 through the clipper
rsb_line:
                call    rsb_stage
                ; u8-clean and not a vertical: the seek is sp_hasgap's memo
                ld      a,(lc_x1+1)
                ld      hl,lc_y1+1
                or      (hl)
                ld      hl,lc_x2+1
                or      (hl)
                ld      hl,lc_y2+1
                or      (hl)
                jp      nz,dcl16_main
                ld      a,(lc_x1)
                ld      hl,lc_x2
                cp      (hl)
                jp      nz,dcl_pair2
                ld      a,(lc_y1)
                ld      hl,lc_y2
                cp      (hl)
                ret     z                       ; a point
                jp      draw_clipped_line       ; a vertical
; rsb_fused : the same line as an aperture edge, A = the side
rsb_fused:
                push    af
                call    rsb_stage
                pop     af
                jp      fused_line
rsb_stage:                                      ; (the rows are biased already)
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (lc_y1),de
                inc     hl
                inc     hl
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (lc_y2),de
                ld      hl,(sg_sx1)
                ld      (lc_x1),hl
                ld      hl,(sg_sx2)
                ld      (lc_x2),hl
                ret


; ---------------------------------------------------------------------------
; The vertex-span descriptors (emit_vertex_spans): each endpoint's
; verticals come from a per-vertex descriptor, once per frame at the first
; seg that touches it - and a first touch that is near-clipped or off the
; screen still uses it up.
; ---------------------------------------------------------------------------
rsb_vspans:
                ld      a,(ch_hit)              ; a chained v1 was done as the
                or      a                       ;  previous seg's v2
                jr      nz,rsb_vs2
                ld      hl,(sg_v1)
                ld      de,(sg_sx1)
                ld      bc,(sg_m1)
                ld      a,(sg_n1)
                call    vspan_emit
rsb_vs2:        ld      hl,(sg_v2)
                ld      de,(sg_sx2)
                ld      bc,(sg_m2)
                ld      a,(sg_n2)
                jp      vspan_emit2

; vspan_emit / vspan_emit2 : HL = the vertex's VXR record, DE = its column
; (s16), BC = (S, M8), A = 1 when near-clipped; the seg's projected rows at
; this endpoint are read by address (VSPAN_ENTRY: ft; fb +2, bt +8, bb +10)
                MACRO   VSPAN_ENTRY name, ft, stamp
name:
                ex      af,af'                  ; the near-clipped flag rides A'
                ld      a,l
                or      VXR_DONE
                ld      l,a                     ; -> the vertex-span stamp
                ; done this frame?  (before any staging)
stamp:          ld      a,0                     ; SMC: vd_stamp (render_frame)
                cp      (hl)
                ret     z                       ; already
                ld      (hl),a
                ex      af,af'
                or      a
                ret     nz                      ; near-clipped
                ld      a,d
                or      a
                ret     nz                      ; off the screen either side
                inc     l
                ld      a,(hl)                  ; the descriptor
                or      a
                ret     z
                bit     7,a
                jp      nz,ve_explicit
                ; a code: 1 (fh, ch)  2 (fh, bfh)  3 (bch, ch)  4 both of 2 and
                ; 3.  The rows are the seg's own at this endpoint (the BBC
                ; port's vsx_c1/c2/c3): nothing is projected, and a back pair
                ; the seg lacks is nothing
                ld      c,e                     ; C = the column
                cp      4
                jr      z,.c4
                cp      3
                jr      z,.c3
                cp      2
                jr      z,.c2
                ld      hl,(ft)                 ; ft (ch)
                ld      (lc_y1),hl
                ld      hl,(ft+2)               ; fb (fh)
.emit:          ld      (lc_y2),hl
                ld      a,c
                jp      dcl_vert_on
.c2:            ld      a,(sg_flags)
                and     SF_NEEDBB
                ret     z
                ld      hl,(ft+10)              ; bb (bfh)
                ld      (lc_y1),hl
                ld      hl,(ft+2)               ; fb (fh)
                jr      .emit
.c3:            ld      a,(sg_flags)
                and     SF_NEEDBT
                ret     z
                ld      hl,(ft)                 ; ft (ch)
                ld      (lc_y1),hl
                ld      hl,(ft+8)               ; bt (bch)
                jr      .emit
.c4:            ld      a,(sg_flags)
                and     SF_NEEDBT
                jr      z,.c2
                push    bc
                call    .c3
                pop     bc
                jr      .c2
                ENDM
                VSPAN_ENTRY vspan_emit, sg_ft1, vsd1
                VSPAN_ENTRY vspan_emit2, sg_ft2, vsd2
ve_explicit:
                ld      (vs_sx),de              ; (the explicit path projects)
                ld      (vs_ms),bc
                and     $7f
                ld      (vs_i),a
ve_el:
                ld      a,(vs_i)
                ld      l,a
                ld      h,0
                ld      e,a
                ld      d,0
                add     hl,hl
                add     hl,de                   ; * 3
                ld      de,VSEXPL
                add     hl,de
                ; c_lo = max(h_lo, fh), c_hi = min(h_hi, ch)
                ld      a,(vs_h)
                ld      e,a                     ; E = fh
                ld      a,(hl)                  ; h_lo
                ld      c,a
                push    hl
                ld      hl,vs_h
                call    cmp_s8                  ; carry: h_lo < fh (A = the difference)
                pop     hl
                ld      a,c
                jp      nc,ve_lo1
                ld      a,e
ve_lo1:         ld      ixl,a                   ; c_lo rides IXL
                inc     hl
                ld      a,(vs_h+1)
                ld      e,a                     ; E = ch
                ld      a,(hl)                  ; h_hi
                ld      c,a
                push    hl
                ld      hl,vs_h+1
                call    cmp_s8                  ; carry: h_hi < ch
                pop     hl
                ld      a,c
                jr      c,ve_hi1
                ld      a,e
ve_hi1:         ld      b,a                     ; B = c_hi
                inc     hl
                ld      a,(hl)                  ; cont
                push    af
                ld      a,ixl
                ld      c,a                     ; C = c_lo
                call    ve_pair
                pop     af
                or      a
                ret     z
                ld      hl,vs_i
                inc     (hl)
                jr      ve_el

; ve_pair : the vertical from height B down to C at vs_sx, when hi > lo
ve_pair:
                ld      a,b                     ; nothing when hi <= lo (signed
                sub     c                       ; bytes: cmp_s8's rule, inline)
                ret     z
                jp      pe,vp_ovf
                ret     m
                jp      vp_go
vp_ovf:         ret     p                       ; overflowed: the true sign is the other
vp_go:
                ld      de,(vs_ms)
                ld      a,b
                push    bc
                call    project_y_vz
                pop     bc
                ld      (lc_y1),hl
                ld      a,c                     ; DE = vs_ms still (project_y keeps DE)
                call    project_y_vz
                ld      (lc_y2),hl
                ld      a,(vs_sx)               ; the column (on the screen)
                jp      dcl_vert_on


; ---------------------------------------------------------------------------
; DOOM's R_CheckBBox corner table, each corner named by the low address
; bytes of its x delta and its y delta (top, bottom, left, right lie in one
; page).  Entry 5 is "viewpoint inside".
; ---------------------------------------------------------------------------
