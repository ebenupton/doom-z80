; ===========================================================================
; fsetup.z80 : frame setup that runs once an angle change, in bank 4 - the
; trig lookups and every patch site they feed (view.z80's vs_rebuild body).
; Entered through the paging stub in vs_rebuild; touches nothing in bank 0.
; ===========================================================================
vs_rebuild_b4:
                ld      a,(pl_ang)
                call    sincos_lookup
                ld      a,c
                ld      (vs_smag),a
                ld      a,b
                ld      (vs_sneg),a
                ld      a,e
                ld      (vs_sunity),a
                call    vs_prodpg               ; the |sin| table's page ->
                ld      (vgx_ts+1),a            ;  vertex_get's two sin sites
                ld      (vgy_ts+1),a
                ld      (orx_ts+1),a            ;  and obj_rot's
                ld      (ory_ts+1),a
                ld      a,(pl_ang)
                add     a,64
                call    sincos_lookup
                ld      a,c
                ld      (vs_cmag),a
                ld      a,b
                ld      (vs_cneg),a
                ld      a,e
                ld      (vs_cunity),a
                call    vs_prodpg
                ld      (vgx_tc+1),a
                ld      (vgy_tc+1),a
                ld      (orx_tc+1),a
                ld      (ory_tc+1),a

                ; product tables
                ; patch the rotation dispatchers
                ld      hl,rot_sin_gen
                ld      a,(vs_sunity)
                or      a
                jr      z,vs_s1
                ld      hl,rot_sin_unity
vs_s1:          ld      (rs_k+1),hl
                ld      a,(vs_smag)
                ld      (rsm1+1),a
                ld      hl,rsn
                ld      a,(vs_sneg)
                call    patch_sign

                ld      hl,rot_cos_gen
                ld      a,(vs_cunity)
                or      a
                jr      z,vs_c1
                ld      hl,rot_cos_unity
vs_c1:          ld      (rc_k+1),hl
                ld      a,(vs_cmag)
                ld      (rcm1+1),a
                ld      hl,rcn
                ld      a,(vs_cneg)
                call    patch_sign

                ; --- the vertex transform: per-angle product tables, the
                ; page terms and the four sign sites (bsp.z80 vertex_get) ---
                ld      a,(vs_sunity)
                or      a
                ld      de,256
                jr      nz,vs_ms16
                ld      a,(vs_smag)
                ld      e,a
                ld      d,0
vs_ms16:        ld      (vs_m16s),de
                ld      a,(vs_cunity)
                or      a
                ld      de,256
                jr      nz,vs_mc16
                ld      a,(vs_cmag)
                ld      e,a
                ld      d,0
vs_mc16:        ld      (vs_m16c),de
                call    vs_pbtab                ; the page terms
                                                ; this angle (skipped when a frame
                                                ; transforms none - sparse views)
                ; x: 4 [+|-] ox*|s| [-|+] oy*|c|; y: 4 [+|-] ox*|c| [+|-] oy*|s|
                ld      a,(vs_sneg)
                ld      hl,vgx1
                ld      de,$0942                ; add hl,bc / sbc hl,bc
                call    vs_patch5
                ld      a,(vs_cneg)
                xor     1
                ld      hl,vgx2
                ld      de,$1952                ; add hl,de / sbc hl,de
                call    vs_patch5
                ld      a,(vs_cneg)
                ld      hl,vgy1
                ld      de,$0942
                call    vs_patch5
                ld      a,(vs_sneg)
                ld      hl,vgy2
                ld      de,$1952
                call    vs_patch5
                ; obj_rot's four sites, the same
                ld      a,(vs_sneg)
                ld      hl,orx1
                ld      de,$0942
                call    vs_patch5
                ld      a,(vs_cneg)
                xor     1
                ld      hl,orx2
                ld      de,$1952
                call    vs_patch5
                ld      a,(vs_cneg)
                ld      hl,ory1
                ld      de,$0942
                call    vs_patch5
                ld      a,(vs_sneg)
                ld      hl,ory2
                ld      de,$1952
                call    vs_patch5
                ; the cardinal twins (bsp.z80 vg_rot_su/cu): their sign sites,
                ; then the two call sites pointed at the epoch's body
                ld      a,(vs_sneg)
                ld      hl,vsu_xs
                call    vs_patchc
                ld      a,(vs_sneg)
                ld      hl,vsu_ys
                call    vs_patchc
                ld      a,(vs_cneg)
                xor     1
                ld      hl,vcu_xs
                call    vs_patchc
                ld      a,(vs_cneg)
                ld      hl,vcu_ys
                call    vs_patchc
                ld      a,(vs_sneg)             ; the objects' copies
                ld      hl,osu_xs
                call    vs_patchc
                ld      a,(vs_sneg)
                ld      hl,osu_ys
                call    vs_patchc
                ld      a,(vs_cneg)
                xor     1
                ld      hl,ocu_xs
                call    vs_patchc
                ld      a,(vs_cneg)
                ld      hl,ocu_ys
                call    vs_patchc
                ld      hl,vg_rotate_rel
                ld      de,obj_rot
                ld      a,(vs_sunity)
                or      a
                jr      z,vs_nosu
                ld      a,(vs_cmag)
                or      a
                jr      nz,vs_rotsel            ; (unity with the other live: general)
                ld      hl,vg_rot_su
                ld      de,ob_rot_su
                jr      vs_rotsel
vs_nosu:        ld      a,(vs_cunity)
                or      a
                jr      z,vs_rotsel
                ld      a,(vs_smag)
                or      a
                jr      nz,vs_rotsel
                ld      hl,vg_rot_cu
                ld      de,ob_rot_cu
vs_rotsel:      ld      (vx_rot+1),hl
                ld      (ob_rot+1),de
                ret

; vs_patchc : A = the negative flag, HL = a CARD_AXIS sign site: `jr .add`
; (18 04) when positive, `xor a / sub l` (AF 95) when negative
vs_patchc:      ld      de,$0418
                or      a
                jp      z,vpc_ok
                ld      de,$95AF
vpc_ok:         ld      (hl),e
                inc     hl
                ld      (hl),d
                ret

; vs_prodpg : D = a quadrant index (0..64) -> A = its product table's page:
; the zero page for 0, else bank 3's table q at PROD_BASE + (q - 1) * 256
vs_prodpg:
                ld      a,d
                or      a
                ld      a,PROD_ZERO>>8
                ret     z
                ld      a,d
                add     a,(PROD_BASE>>8)-1
                ret

; vs_pbtab : the page terms.  kx = sS * 16 * |s|, ky = sC * 16 * |c| (a page
; is 128 units, floored by 8); for the page pair pg = pgx | pgy << 3 with
; fx = pgx - 4, fy = pgy - 4:
;   PBX[pg] = fx * kx - fy * ky,   PBY[pg] = fx * ky + fy * kx
; Built through the stack pointer, pg = 63 down to 0, as two running sums:
; along a row (pgx down) X steps by -kx and Y by -ky; between rows (pgy
; down) X0 gains ky and Y0 loses kx.  HL/BC = X and -kx, HL'/BC' = Y and
; -ky, DE/DE' the row fixups (8kx + ky, 8ky - kx).
vs_pbtab:
                ld      hl,(vs_m16s)
                ld      a,(vs_sneg)
                call    vs_k16
                ld      (vs_kx),hl
                ld      hl,(vs_m16c)
                ld      a,(vs_cneg)
                call    vs_k16
                ld      (vs_ky),hl
                ld      (vs_spsave),sp
                ld      sp,PB+256
                ; X0(7) = 3kx - 3ky, Y0(7) = 3ky + 3kx
                ld      hl,(vs_kx)
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,de                   ; HL = 3kx
                push    hl
                ld      hl,(vs_ky)
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,de                   ; HL = 3ky
                pop     de                      ; DE = 3kx
                push    hl
                add     hl,de                   ; Y0 = 3ky + 3kx
                ex      de,hl                   ; DE = Y0
                pop     hl                      ; HL = 3ky
                ld      b,h
                ld      c,l
                ld      h,d
                ld      l,e
                or      a
                sbc     hl,bc                   ; HL = Y0 - 3ky = 3kx
                or      a
                sbc     hl,bc                   ; X0 = 3kx - 3ky
                push    hl                      ; X0
                push    de                      ; Y0
                ; the steps and fixups
                ld      hl,(vs_kx)
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,hl
                add     hl,hl                   ; 8kx
                ld      bc,(vs_ky)
                add     hl,bc
                ld      (vs_fixx),hl            ; 8kx + ky
                ld      hl,0
                or      a
                sbc     hl,de
                ld      b,h
                ld      c,l                     ; BC = -kx
                ld      hl,(vs_ky)
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,hl
                add     hl,hl                   ; 8ky
                push    de
                ld      de,(vs_kx)
                or      a
                sbc     hl,de
                ld      (vs_fixy),hl            ; 8ky - kx
                pop     de
                ld      hl,0
                or      a
                sbc     hl,de                   ; HL = -ky
                ; the stack holds X0 (deeper) and Y0: the alternate set takes
                ; Y0, -ky and its fixup, the main set X0, -kx and its fixup
                push    hl
                exx
                pop     bc                      ; BC' = -ky
                pop     hl                      ; HL' = Y0
                ld      de,(vs_fixy)            ; DE' = the Y row fixup
                exx
                pop     hl                      ; HL = X0
                ld      de,(vs_fixx)            ; DE = the X row fixup
                ld      a,8
                ld      (vs_rows),a
pb_row:         DUP     8
                exx
                push    hl                      ; Y
                add     hl,bc
                exx
                push    hl                      ; X
                add     hl,bc
                EDUP
                add     hl,de                   ; X0 += ky (undoing the 8 steps)
                exx
                add     hl,de                   ; Y0 -= kx
                exx
                ld      a,(vs_rows)
                dec     a
                ld      (vs_rows),a
                jp      nz,pb_row
                ld      sp,(vs_spsave)
                ret
; vs_k16 : HL = a magnitude, A = its sign flag -> HL = +/- 16 * HL
vs_k16:         add     hl,hl
                add     hl,hl
                add     hl,hl
                add     hl,hl
                or      a
                ret     z
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ret

; vs_patch5 : HL -> a five-byte site, D = the add opcode, E = the second
; byte of the sbc, A = nonzero for the subtraction:
;   add hl,rr / adc a,0 / nop / nop     or     or a / sbc hl,rr / sbc a,0
vs_patch5:      or      a
                jr      nz,vp5_sub
                ld      (hl),d
                inc     hl
                ld      (hl),$ce
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),0
                ret
vp5_sub:        ld      (hl),$b7
                inc     hl
                ld      (hl),$ed
                inc     hl
                ld      (hl),e
                inc     hl
                ld      (hl),$de
                inc     hl
                ld      (hl),0
                ret

; ---------------------------------------------------------------------------
; (bank 4: render_frame calls it with this bank in, before the walk)
; sp_reset : the screen span, the free chain behind it
sp_reset:
                ; The BBC port's span_init: the pool is a partition (live list
                ; + free list = every slot), so after the first build a frame
                ; pushes whatever is still live onto the free list and pops a
                ; slot for the screen span.
                ld      h,SPH>>8
                ld      a,(sp_live)
                or      a
                jr      nz,sr_incr
                inc     a
                ld      (sp_live),a
                ld      l,16                    ; the chain 16 -> 24 -> ... -> 248 -> 0
sr_il:          ld      a,l
                add     a,8
                ld      (hl),a
                ld      l,a
                jp      nz,sr_il
                ld      a,16
                ld      (sp_free),a
                ld      l,8                     ; the screen span: slot 1
                jr      sr_setup
sr_incr:        ld      a,(sp_head)
                or      a
                jr      z,sr_pop
                ld      l,a
                ld      a,(sp_free)
sr_push:        ld      c,(hl)                  ; the chain onward
                ld      (hl),a                  ; slot.next = free
                ld      a,l                     ; free = slot
                ld      l,c
                inc     c
                dec     c
                jr      nz,sr_push
                ld      (sp_free),a
sr_pop:         ld      a,(sp_free)             ; the screen span: any slot
                ld      l,a
                ld      a,(hl)
                ld      (sp_free),a
sr_setup:       ld      a,l
                ld      (sp_head),a
                ld      (hl),0                  ; next
                inc     l
                ld      (hl),0                  ; [0, 255)
                inc     l
                ld      (hl),RENDER_W-1
                inc     l
                ld      (hl),Y_BIAS             ; ot, it
                inc     l
                ld      (hl),Y_BIAS
                inc     l
                ld      (hl),Y_BIAS+RENDER_H-1  ; ob, ib
                inc     l
                ld      (hl),Y_BIAS+RENDER_H-1
                ld      a,l
                and     $F8
                ld      l,a
                dec     h                       ; the lines
                ld      (hl),0                  ; the top: 48 at 0 and 255
                inc     l
                ld      (hl),255
                inc     l
                ld      (hl),Y_BIAS
                inc     l
                ld      (hl),Y_BIAS
                inc     l
                ld      (hl),0                  ; the bottom: 207 at 0 and 255
                inc     l
                ld      (hl),255
                inc     l
                ld      (hl),Y_BIAS+RENDER_H-1
                inc     l
                ld      (hl),Y_BIAS+RENDER_H-1
                xor     a
                ld      (fw_mode),a
                ld      (fw_touch),a
                ret

