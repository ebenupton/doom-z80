; ---------------------------------------------------------------------------
; Display-list rasteriser.
;
; The clipper emits 4-byte records (x1, y1, x2, y2), y already in render space
; (0..159) and x in 0..255. Pass 2 walks that list and ORs pixels into the back
; buffer. Nothing else touches the framebuffer, so the geometry bank stays
; paged in for all of pass 1 and only pass 2 needs the screen bank at $C000.
;
; Plot paths, by shape:
;   vertical    x1 == x2. Wall edges are exactly vertical and dominate a DOOM
;               wireframe, so this loop is unrolled over a character cell: INC H
;               steps down a scanline and the cell-crossing fixup is paid once
;               per eight pixels instead of once per pixel.
;   horizontal  y1 == y2. Whole bytes go out as LD (HL),$FF - under two
;               T-states a pixel - with masked ends.
;   general     Bresenham along the major axis.
;
; Row addresses come from 160-entry byte planes, so a lookup is two loads.
; ---------------------------------------------------------------------------

; --- init: build the four row planes and the mask tables -------------------
raster_init:
                ld      b,RENDER_H
                ld      c,0                     ; render row
ri_loop:
                ld      a,c
                add     a,RENDER_Y0             ; screen row
                ld      e,a
                and     $c0
                rrca
                rrca
                rrca                            ; (y & $C0) >> 3
                ld      d,a
                ld      a,e
                and     $07
                or      d
                or      $40                     ; bitmap base $4000
                ld      d,a                     ; D = address high byte
                ld      a,e
                and     $38
                rlca
                rlca                            ; (y & $38) << 2
                ld      e,a                     ; E = address low byte

                ld      h,ROWLO_A>>8
                ld      l,c
                ld      (hl),e
                inc     h
                ld      (hl),d                  ; ROWHI_A
                inc     h
                ld      (hl),e                  ; ROWLO_B
                inc     h
                ld      a,d
                or      $80                     ; buffer B: same offset, bank 7
                ld      (hl),a                  ; ROWHI_B

                inc     c
                djnz    ri_loop
                ret

; ---------------------------------------------------------------------------
; raster_select : A = 0 for buffer A, non-zero for buffer B.
; ---------------------------------------------------------------------------
raster_select:
                or      a
                ld      a,ROWLO_A>>8
                jr      z,rs_set
                ld      a,ROWLO_B>>8
rs_set:
                ld      (rsel1+1),a
                ld      (rsel_s+1),a
                ld      (rsel_h+1),a
                ld      (rsel_v+1),a
                ld      (rsel_m2+1),a
                ret

; ---------------------------------------------------------------------------
; raster_clear : blank the whole 6144-byte bitmap of the back buffer.
; PUSH writes two bytes per 11 T-states.  A = 0 for buffer A, else buffer B.
; Interrupts must be disabled: SP walks through the screen.
; ---------------------------------------------------------------------------
raster_clear:
                ld      (rc_sp+1),sp
                or      a
                ld      a,$58                   ; one past buffer A's bitmap
                jr      z,rc_go
                ld      a,$d8                   ; ... and buffer B's
rc_go:
                ld      h,a
                ld      l,0
                ld      sp,hl
                ld      hl,0
                ld      b,192                   ; 192 * 32 bytes = 6144
rc_loop:
                DUP     16
                push    hl
                EDUP
                djnz    rc_loop
rc_sp:          ld      sp,0
                ret

; ---------------------------------------------------------------------------
; dl_render : rasterise every record in the display list.
; ---------------------------------------------------------------------------
dl_render:
                ld      hl,(dlist_ptr)
                ld      (dl_end+1),hl
                ld      hl,DLIST_BASE
dl_loop:
                ld      a,h
dl_end:         ld      de,0
                cp      d
                jr      nz,dl_go
                ld      a,l
                cp      e
                ret     z
dl_go:
                ld      c,(hl)                  ; x1
                inc     hl
                ld      b,(hl)                  ; y1
                inc     hl
                ld      e,(hl)                  ; x2
                inc     hl
                ld      d,(hl)                  ; y2
                inc     hl
                push    hl
                call    plot_line
                pop     hl
                jr      dl_loop
; ROW_UP : HL = a byte in the bitmap -> the same byte one pixel row up.
; Within a character cell that is DEC H; at the cell's top row the byte is
; 32 back, in row 7 of the cell above, and a borrow crosses into the third
; of the screen above.  A is preserved.
                MACRO   ROW_UP
                ex      af,af'
                ld      a,h
                and     7
                jr      z,.cross
                dec     h
                jr      .done
.cross:         ld      a,l
                sub     32
                ld      l,a
                ld      a,h
                jr      nc,.same
                sub     8
.same:          or      7
                ld      h,a
.done:          ex      af,af'
                ENDM



; ---------------------------------------------------------------------------
; plot_line : C = x1, B = y1, E = x2, D = y2   (y in 0..RENDER_H-1)
; ---------------------------------------------------------------------------
plot_line:
                ; C = x0, B = y0, E = x1, D = y1: the BBC port's NJ rasteriser,
                ; pixel for pixel (nj_raster.py).  Lines are drawn bottom to
                ; top: the endpoint with the larger y goes first, and the
                ; direction is left-going when its x is the larger.  The
                ; front end stays in registers: the row's base comes from the
                ; row planes (its low byte is at most 224, so adding x >> 3
                ; never carries), and the shallow core's start mask and chain
                ; entry come from one table by x0 & 7.
                ld      a,b
                cp      d
                jr      nc,pl_sorted
                ld      a,c                     ; swap the endpoints
                ld      c,e
                ld      e,a
                ld      a,b
                ld      b,d
                ld      d,a
pl_sorted:      ld      a,b
                sub     d
                jr      z,pl_horiz              ; dy = 0
                ld      d,a                     ; D = dy
                ld      a,c
                sub     e
                jr      z,pl_vert               ; dx = 0
                jr      nc,pl_left
                neg
                ld      e,a                     ; E = dx, right-going
                cp      d
                jr      c,pl_steep_r
                ld      a,PLTAB_R & 255
                jp      pl_shallow
pl_left:        ld      e,a                     ; E = dx, left-going
                cp      d
                jr      c,pl_steep_l
                ld      a,PLTAB_L & 255
pl_shallow:
                ; A = the direction's table; C = x0, B = y0, D = dy, E = dx
                ld      iyh,a
                ; the BBC port's Hamiltonian bands: dx/2 < dy (the 1:2 band; dx >=
                ; dy here) and 2dy < dx <= 3dy (the 2:3 band) have their own
                ; cores (ham.inc), the generic NJ core takes the rest
                ld      a,e
                srl     a
                cp      d
                jp      c,pl_ham12
                ld      a,e
                sub     d
                sub     d                       ; dx - 2dy (2dy <= dx here)
                jr      z,pl_nj                 ; dx = 2dy: generic
                cp      d
                jp      c,pl_ham23              ; dx < 3dy
                jp      z,pl_ham23              ; dx = 3dy
pl_nj:          ld      a,e
                srl     a                       ; err = errs = dx >> 1 (errs is
                ex      af,af'                  ;  recomputed from E in ys_phase)
                ld      a,b
                and     7
                inc     a
                ld      iyl,a                   ; rows left in the cell, going up
                ld      l,b
rsel_s:         ld      h,ROWLO_A>>8            ; (patched by raster_select)
                ld      a,(hl)
                inc     h
                ld      h,(hl)
                ld      l,a                     ; HL = the row's base
                ld      a,c
                rrca
                rrca
                rrca
                and     $1f
                add     a,l
                ld      l,a                     ; HL = the byte
                ld      a,c
                and     7
                add     a,a
                add     a,a                     ; (mask, -, entry) by x0 & 7
                add     a,iyh
                ld      iyh,2                   ; the e-phase count (was ln_ls)
                push    hl
                ld      l,a
                ld      h,PLTAB_R >> 8
                ld      c,(hl)                  ; the run's start mask
                inc     l
                inc     l
                ld      a,(hl)
                inc     l
                ld      h,(hl)
                ld      l,a                     ; the chain entry
                ex      (sp),hl                 ; HL = the byte, the entry down
                ld      b,d                     ; cnt = dy
                ex      af,af'                  ; A = err
                ret                             ; into the chain
pl_steep_r:     xor     a
                jr      pl_steep_x
pl_steep_l:     ld      a,1
pl_steep_x:     ld      (ln_left),a
                ld      a,d
                ld      (ln_dy),a
                jp      pl_steep

pl_horiz:       ; B = the row; C, E = the x's in either order
                ld      a,c
                cp      e
                jp      c,plot_horiz
                ld      c,e
                ld      e,a
                jp      plot_horiz

pl_vert:        ; B = y0 (the bottom), D = dy, C = x
                ld      a,b
                sub     d
                ld      d,b                     ; D = the bottom row
                ld      b,a                     ; B = the top row
                jp      plot_vert

                ALIGN   64
PLTAB_R:        DB      $ff,0
                DW      pr0
                DB      $7f,0
                DW      pr1
                DB      $3f,0
                DW      pr2
                DB      $1f,0
                DW      pr3
                DB      $0f,0
                DW      pr4
                DB      $07,0
                DW      pr5
                DB      $03,0
                DW      pr6
                DB      $01,0
                DW      pr7
PLTAB_L:        DB      $80,0
                DW      pl0
                DB      $c0,0
                DW      pl1
                DB      $e0,0
                DW      pl2
                DB      $f0,0
                DW      pl3
                DB      $f8,0
                DW      pl4
                DB      $fc,0
                DW      pl5
                DB      $fe,0
                DW      pl6
                DB      $ff,0
                DW      pl7

pl_steep:
                ld      a,e
                or      a
                jr      z,pl_vert
                ld      a,d
                srl     a
                ld      (ln_err),a
                ld      iyh,2                   ; the e-phase count
                ld      a,b                     ; rows left in the cell
                and     7
                inc     a
                ld      iyl,a
                push    de
                call    addr_of                 ; HL = the byte, A = the mask
                pop     de
                ld      c,a                     ; C = the pixel mask
                ld      b,e                     ; B = cnt = dx
                ld      a,e
                ld      d,a                     ; D = step = dx
                ld      a,(ln_dy)
                ld      e,a                     ; E = dy
                ld      a,(ln_left)
                or      a
                ld      a,(ln_err)
                jr      nz,st_left
st_right:
                ex      af,af'
                ld      a,(hl)
                or      c
                ld      (hl),a
                ex      af,af'
                sub     d                       ; r -= step
                jr      c,st_rx
st_r1:          dec     iyl
                jr      z,st_rc
                dec     h
                jp      st_right
st_rc:          call    row_cross
                jr      st_right
st_rx:          call    st_xstep
                rrc     c
                jp      nc,st_r1
                inc     l
                jr      st_r1
st_left:
                ex      af,af'
                ld      a,(hl)
                or      c
                ld      (hl),a
                ex      af,af'
                sub     d
                jr      c,st_lx
st_l1:          dec     iyl
                jr      z,st_lc
                dec     h
                jp      st_left
st_lc:          call    row_cross
                jr      st_left
st_lx:          call    st_xstep
                rlc     c
                jp      nc,st_l1
                dec     l
                jr      st_l1

; row_cross : HL -> row 0 of a cell -> row 7 of the cell above (a borrow
; crosses into the third above), IYL = the rows left there.  A preserved.
row_cross:
                ld      iyl,8
                ex      af,af'
                ld      a,l
                sub     32
                ld      l,a
                ld      a,h
                jp      nc,rc_same
                sub     8
rc_same:        or      7
                ld      h,a
                ex      af,af'
                ret

st_xstep:
                add     a,e
                dec     b
                ret     nz
                dec     iyh
                jr      z,st_done
                push    hl
                ld      l,e
                srl     l                       ; errs = the major delta >> 1
                sub     l
                pop     hl
                jr      c,st_done
                ld      b,1
                ret
st_done:        pop     hl
                ret

; --- the shallow core, right-going: bit n of the byte is mask $80 >> n --
; A = err, D = dy, E = dx, B = cnt, C = the run mask, HL = the byte.
; Each position marks its bit in the run, then err -= dy: no borrow means
; the run extends to the next bit; a borrow is a y-step, which plots the
; run and moves up a row.
; --- the shallow core, right-going: bit n of the byte is mask $80 >> n --
; A = err, D = dy, E = dx, B = cnt, HL = the byte, IYL = rows left in the
; cell, C = the run's start mask (every bit from the start rightwards).
; Each position tests err -= dy: no borrow means the run extends to the
; next bit; a borrow is a y-step, which plots the run up to this bit (the
; static mask of the position) and moves up a row.
pr0:            sub     d
                jr      c,yr0
pr1:            sub     d
                jr      c,yr1
pr2:            sub     d
                jr      c,yr2
pr3:            sub     d
                jr      c,yr3
pr4:            sub     d
                jp      c,yr4
pr5:            sub     d
                jp      c,yr5
pr6:            sub     d
                jp      c,yr6
pr7:            sub     d
                jp      c,yr7
                ex      af,af'                  ; the byte is full: plot the run
                ld      a,c
                or      (hl)
                ld      (hl),a
                ex      af,af'
                ld      c,$ff
                inc     l
                jp      pr0
yr0:
                ex      af,af'
                ld      a,c
                and     $80
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yr0_c
                dec     h
yr0_b:          ld      c,$7f
                jp      pr1
yr0_c:       call    row_cross
                jr      yr0_b
yr1:
                ex      af,af'
                ld      a,c
                and     $c0
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yr1_c
                dec     h
yr1_b:          ld      c,$3f
                jp      pr2
yr1_c:       call    row_cross
                jr      yr1_b
yr2:
                ex      af,af'
                ld      a,c
                and     $e0
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yr2_c
                dec     h
yr2_b:          ld      c,$1f
                jp      pr3
yr2_c:       call    row_cross
                jr      yr2_b
yr3:
                ex      af,af'
                ld      a,c
                and     $f0
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yr3_c
                dec     h
yr3_b:          ld      c,$0f
                jp      pr4
yr3_c:       call    row_cross
                jr      yr3_b
yr4:
                ex      af,af'
                ld      a,c
                and     $f8
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yr4_c
                dec     h
yr4_b:          ld      c,$07
                jp      pr5
yr4_c:       call    row_cross
                jr      yr4_b
yr5:
                ex      af,af'
                ld      a,c
                and     $fc
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yr5_c
                dec     h
yr5_b:          ld      c,$03
                jp      pr6
yr5_c:       call    row_cross
                jr      yr5_b
yr6:
                ex      af,af'
                ld      a,c
                and     $fe
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yr6_c
                dec     h
yr6_b:          ld      c,$01
                jp      pr7
yr6_c:       call    row_cross
                jr      yr6_b
yr7:
                ex      af,af'
                ld      a,c
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yr7_c
                dec     h
yr7_b:          ld      c,$ff
                inc     l
                jp      pr0
yr7_c:       call    row_cross
                jr      yr7_b
; --- and left-going: the run grows toward mask $80 -----------------------
pl7:            sub     d
                jr      c,yl7
pl6:            sub     d
                jr      c,yl6
pl5:            sub     d
                jr      c,yl5
pl4:            sub     d
                jr      c,yl4
pl3:            sub     d
                jp      c,yl3
pl2:            sub     d
                jp      c,yl2
pl1:            sub     d
                jp      c,yl1
pl0:            sub     d
                jp      c,yl0
                ex      af,af'
                ld      a,c
                or      (hl)
                ld      (hl),a
                ex      af,af'
                ld      c,$ff
                dec     l
                jp      pl7
yl7:
                ex      af,af'
                ld      a,c
                and     $01
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yl7_c
                dec     h
yl7_b:          ld      c,$fe
                jp      pl6
yl7_c:       call    row_cross
                jr      yl7_b
yl6:
                ex      af,af'
                ld      a,c
                and     $03
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yl6_c
                dec     h
yl6_b:          ld      c,$fc
                jp      pl5
yl6_c:       call    row_cross
                jr      yl6_b
yl5:
                ex      af,af'
                ld      a,c
                and     $07
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yl5_c
                dec     h
yl5_b:          ld      c,$f8
                jp      pl4
yl5_c:       call    row_cross
                jr      yl5_b
yl4:
                ex      af,af'
                ld      a,c
                and     $0f
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yl4_c
                dec     h
yl4_b:          ld      c,$f0
                jp      pl3
yl4_c:       call    row_cross
                jr      yl4_b
yl3:
                ex      af,af'
                ld      a,c
                and     $1f
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yl3_c
                dec     h
yl3_b:          ld      c,$e0
                jp      pl2
yl3_c:       call    row_cross
                jr      yl3_b
yl2:
                ex      af,af'
                ld      a,c
                and     $3f
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yl2_c
                dec     h
yl2_b:          ld      c,$c0
                jp      pl1
yl2_c:       call    row_cross
                jr      yl2_b
yl1:
                ex      af,af'
                ld      a,c
                and     $7f
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yl1_c
                dec     h
yl1_b:          ld      c,$80
                jp      pl0
yl1_c:       call    row_cross
                jr      yl1_b
yl0:
                ex      af,af'
                ld      a,c
                or      (hl)
                ld      (hl),a
                ex      af,af'
                add     a,e                     ; err += dx
                dec     b
                call    z,ys_phase              ; the y-steps are spent
                dec     iyl
                jr      z,yl0_c
                dec     h
yl0_b:          ld      c,$ff
                dec     l
                jp      pl7
yl0_c:       call    row_cross
                jr      yl0_b
; ys_phase : the y-steps are spent (B = 0): the e-phase, and when the line
; is done, straight back to plot_line's caller.
ys_phase:
                dec     iyh                     ; the e-phase count
                jr      z,ysp_done
                push    hl
                ld      l,e
                srl     l                       ; errs = dx >> 1
                sub     l                       ; the e-phase
                pop     hl
                jr      c,ysp_done
                ld      b,1
                ret
ysp_done:       pop     hl                      ; drop the call's return: the
                ret                             ;  line is done, back to the caller


addr_of:
rsel1:          ld      h,ROWLO_A>>8
                ld      l,b
                ld      e,(hl)
                inc     h
                ld      d,(hl)                  ; DE = row base address
                ld      a,c
                rrca
                rrca
                rrca
                and     $1f                     ; x >> 3
                add     a,e
                ld      l,a
                ld      a,0
                adc     a,d
                ld      h,a
                ld      d,MASKTAB>>8
                ld      e,c
                ld      a,(de)                  ; the pixel's bit, by x
                ret

; ---------------------------------------------------------------------------
; plot_vert : C = x, B = y1, D = y2
; ---------------------------------------------------------------------------
; plot_vert : C = x, B and D = the rows, either order.  The unrolled column
; (vcol.inc) is entered at the top row's plot and left by a RET patched over
; the byte after the bottom row's; it returns to pv_restore.
; ---------------------------------------------------------------------------
plot_vert:
                ld      a,b
                cp      d
                jp      c,pv_ord
                ld      a,b
                ld      b,d
                ld      d,a                     ; B = the top row, D = the bottom
pv_ord:         ; The BBC port's vplot dispatch: un-arm the previous run's stop
                ; (every row block opens with `ld a,(hl)`, so the byte to put
                ; back is a constant), arm a RET over the first byte of the
                ; block BELOW the bottom row (entry 160 is the column's own
                ; ret), and enter at the top row's block: the run falls down
                ; the column and the armed RET returns straight to the caller.
                ld      a,$7E                   ; ld a,(hl)
pv_una:         ld      (vpx159),a              ; SMC: the previous arm
                inc     d
                ld      l,d
                ld      h,VPE_LO>>8
                ld      a,(hl)
                inc     h
                ld      h,(hl)
                ld      l,a                     ; HL = the stop
                ld      (pv_una+1),hl
                ld      (hl),$C9                ; ret
                ld      l,b
                ld      h,VPE_LO>>8
                ld      e,(hl)
                inc     h
                ld      d,(hl)                  ; DE = the top row's plot
                ld      l,b
rsel_v:         ld      h,ROWLO_A>>8            ; (patched by raster_select)
                ld      a,(hl)
                inc     h
                ld      h,(hl)
                ld      l,a
                ld      a,c
                rrca
                rrca
                rrca
                and     $1f
                add     a,l
                ld      l,a                     ; HL = the top byte
                ld      b,MASKTAB>>8
                ld      a,(bc)
                ld      c,a                     ; C = the pixel's bit
                push    de
                ld      de,$F920                ; the cell step (vcol.inc)
                ret                             ; into the column

                include "vcol.inc"

plot_horiz:
                ; C = x1 <= E = x2 on row B: byte strips, the same pixels as
                ; the shallow core would accumulate
                ld      l,b
rsel_h:         ld      h,ROWLO_A>>8
                ld      a,(hl)
                inc     h
                ld      h,(hl)
                ld      l,a                     ; the row's base
                ld      a,c
                rrca
                rrca
                rrca
                and     $1f
                ld      b,a                     ; x1 >> 3
                add     a,l
                ld      l,a                     ; HL = the byte holding x1
                ld      a,e
                rrca
                rrca
                rrca
                and     $1f
                sub     b
                ld      d,a                     ; D = bytes spanned - 1
                ld      a,d
                ex      af,af'                  ; A' = bytes spanned - 1
                ld      d,MASKL256 >> 8
                ld      a,(de)                  ; the mask up to and incl. x2
                ld      b,MASKR256 >> 8
                ld      d,a
                ld      a,(bc)                  ; the mask from x1 rightwards
                ld      c,a                     ; C = mask from x1 rightwards
                ld      b,d                     ; B = mask up to and incl. x2
                ex      af,af'
                ld      d,a
                or      a
                jr      nz,ph_multi
                ld      a,c
                and     b
                or      (hl)
                ld      (hl),a
                ret
ph_multi:
                ld      a,(hl)
                or      c
                ld      (hl),a
                inc     l
                dec     d
                jr      z,ph_last
ph_mid:
                ld      (hl),$ff
                inc     l
                dec     d
                jp      nz,ph_mid
ph_last:
                ld      a,(hl)
                or      b
                ld      (hl),a
                ret

; ---------------------------------------------------------------------------
; plot_shallow : |dy| < dx.  C = x1, B = y1.
; ---------------------------------------------------------------------------
; plot_shallow : |dy| < dx >= 1.  C = x1, B = y1.
;
; Eight copies of the pixel step, one per bit of the byte, so the mask is an
; immediate in a SET and the byte pointer only moves once every eight pixels.
; The read-modify-write and the rotate that cost 39 T-states between them
; become one 15 T-state SET, and with the error in A rather than shuttled
; through E the whole step is 37 T-states instead of 74.  Most of a wireframe
; frame's sloped pixels come through here - 880 of them a frame against 21
; for the steep path - and they are near-horizontal, so the scanline step the
; unrolling makes dearer is paid about one time in six.
; ---------------------------------------------------------------------------
; ---------------------------------------------------------------------------
; The BBC port's Hamiltonian band rasterisers (raster/shallow_12 and
; shallow_23): a line whose slope lies in the 1:2 band (dx/2 < dy <= dx)
; plots a run of 1 or 2 pixels a row, one in the 2:3 band (2dy < dx <= 3dy)
; a run of 2 or 3, the run length chosen by the carry out of a biased error
; update - no per-pixel error term, and the line's end is folded into the
; cell crossing (hm_cross).  The cores are generated (tools/genham.py ->
; ham.inc); the entries below stage them from pl_shallow's registers.
;   HL = the byte, IYL = the rows left in the cell, B = the y-steps beyond
;   it, E = e, D = delta1, C = delta2.
; ---------------------------------------------------------------------------
; h_byte : A = a row, C = a column -> HL = its screen byte
h_byte:         ld      l,a
rsel_m2:        ld      h,ROWLO_A>>8            ; (patched by raster_select)
                ld      a,(hl)
                inc     h
                ld      h,(hl)
                ld      l,a
                ld      a,c
                rrca
                rrca
                rrca
                and     $1f
                add     a,l
                ld      l,a
                ret
; hm_cross : the cell's rows ran out (IYL = 0): the cell above, or the end.
; Returns to the block's `dec h` with H pre-incremented, or drops the block
; to end the line at the caller of plot_line.
hm_cross:       ld      a,b
                or      a
                jr      z,hm_done
                cp      8
                jr      c,hm_part
                sub     8
                ld      b,a
                call    row_cross               ; IYL = 8, HL a cell up (A kept)
                inc     h
                ret
hm_part:        ld      b,0
                call    row_cross
                ld      iyl,a                   ; the last cell's rows
                inc     h
                ret
hm_done:        pop     hl
                ret
; pl_ham12 : from pl_shallow: IYH = the direction table (PLTAB_L & 255 when
; leftward), C = x0, B = y0, D = dy, E = dx.  e = (dx >> 1) - dy, delta1 =
; dx - dy after a 1px run (carry: 2px next), delta2 = 2dy - dx after a 2px
; run (no borrow: 2px next); dy rows above the first.
pl_ham12:
                ld      a,c
                and     7
                add     a,a
                ld      l,a                     ; (x0 & 7) * 2
                ld      a,iyh
                cp      PLTAB_L & 255
                ld      a,l
                jr      nz,h12_d
                inc     a                       ; + leftward
h12_d:          add     a,a
                ld      l,a
                ld      h,HAM_TAB >> 8
                ld      a,(hl)
                inc     l
                ld      h,(hl)
                ld      l,a
                push    hl                      ; the first block's plot
                ld      a,b
                call    h_byte                  ; HL = (x0, y0)'s byte
                ld      a,b
                and     7                       ; y0 & 7
                cp      d
                jr      nc,h12_one              ; >= dy: within one cell
                inc     a
                ld      iyl,a                   ; the cell's rows
                dec     a
                neg
                add     a,d
                ld      b,a                     ; dy - (y0 & 7) beyond it
                jp      h12_del
h12_one:        ld      a,d
                inc     a
                ld      iyl,a                   ; dy steps, then the crossing ends it
                ld      b,0
h12_del:        ld      a,d
                add     a,d
                sub     e
                ld      c,a                     ; delta2 = 2dy - dx
                ld      a,e
                srl     a
                sub     d
                ex      af,af'                  ; e = (dx >> 1) - dy
                ld      a,e
                sub     d
                ld      d,a                     ; delta1 = dx - dy
                ex      af,af'
                ld      e,a
                ret                             ; into the core
; pl_ham23 : the 2:3 band.  e = (dx >> 1) - 2dy, delta1 = dx - 2dy after a
; 2px run (carry: 3px next), delta2 = dy - delta1 after a 3px run.  The last
; run is always 2 and is drawn first at the far endpoint (x_end, y0 - dy);
; the core then runs dy - 1 steps above the first row.
pl_ham23:
                push    bc                      ; (x0, y0)
                push    de                      ; (dy, dx)
                ld      a,iyh
                cp      PLTAB_L & 255
                jr      z,h23_left
                ld      a,c
                add     a,e
                ld      c,a                     ; x_end = x0 + dx
                ld      a,b
                sub     d                       ; y_top
                call    h_byte
                ld      a,c
                and     7
                jr      z,h23r_split
                add     a,P23R & 255
                ld      e,a
                ld      d,HAM_TAB >> 8
                ld      a,(de)                  ; the pair at bits k-1..k
                or      (hl)
                ld      (hl),a
                jr      h23_near
h23r_split:     ld      a,(hl)                  ; x_end at bit 0: the pair splits
                or      $80
                ld      (hl),a
                dec     l
                ld      a,(hl)
                or      $01
                ld      (hl),a
                jr      h23_near
h23_left:       ld      a,c
                sub     e
                ld      c,a                     ; x_end = x0 - dx
                ld      a,b
                sub     d
                call    h_byte
                ld      a,c
                and     7
                cp      7
                jr      z,h23l_split
                add     a,P23L & 255
                ld      e,a
                ld      d,HAM_TAB >> 8
                ld      a,(de)                  ; the pair at bits k..k+1
                or      (hl)
                ld      (hl),a
                jr      h23_near
h23l_split:     ld      a,(hl)                  ; x_end at bit 7
                or      $01
                ld      (hl),a
                inc     l
                ld      a,(hl)
                or      $80
                ld      (hl),a
h23_near:       pop     de                      ; (dy, dx)
                pop     bc                      ; (x0, y0)
                ld      a,c
                and     7
                add     a,a
                ld      l,a
                ld      a,iyh
                cp      PLTAB_L & 255
                ld      a,l
                jr      nz,h23_d
                inc     a
h23_d:          add     a,a
                add     a,HAM23_TAB & 255
                ld      l,a
                ld      h,HAM_TAB >> 8
                ld      a,(hl)
                inc     l
                ld      h,(hl)
                ld      l,a
                push    hl                      ; the first block's plot
                ld      a,b
                call    h_byte                  ; HL = the near byte
                ld      a,b
                and     7
                inc     a                       ; (y0 & 7) + 1
                cp      d                       ; >= dy: within one cell
                jr      nc,h23_one
                ld      iyl,a
                ld      b,a
                ld      a,d
                sub     b
                ld      b,a                     ; dy - 1 - (y0 & 7) beyond
                jr      h23_del
h23_one:        ld      iyl,d                   ; dy - 1 steps, then the crossing
                ld      b,0
h23_del:        ld      a,e
                srl     a
                sub     d
                sub     d
                ex      af,af'                  ; e = (dx >> 1) - 2dy
                ld      a,e
                sub     d
                sub     d                       ; delta1 = dx - 2dy
                ld      c,d
                ld      d,a
                ld      a,c
                sub     d
                ld      c,a                     ; delta2 = dy - delta1
                ex      af,af'
                ld      e,a
                ret
                include "ham.inc"

                ALIGN   256
MASKTAB:        DUP     32
                DB      $80,$40,$20,$10,$08,$04,$02,$01
                EDUP
                ALIGN   256
MASKR256:       DUP     32                      ; by x: from x rightwards
                DB      $ff,$7f,$3f,$1f,$0f,$07,$03,$01
                EDUP
MASKL256:       DUP     32                      ; by x: up to and incl. x
                DB      $80,$c0,$e0,$f0,$f8,$fc,$fe,$ff
                EDUP
