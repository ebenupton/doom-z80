; ---------------------------------------------------------------------------
; View transform and perspective projection.
;
; The rotation is  vx = wx*sin - wy*cos,  vy = wx*cos + wy*sin,  with sin and
; cos held as unsigned 0.8 magnitudes plus sign and unity flags. Doing that as
; four 16x8 quarter-square multiplies would cost about 1600 T-states a point,
; and a frame transforms sixty vertices plus a couple of bbox corners per BSP
; node, so instead each frame builds two 256-entry product tables - i*sin and
; i*cos - and a rotation term becomes two table lookups. The tables cost about
; 29k T-states to fill and save five times that.
;
; Results are TRUE16 counts: 32 counts to one prescaled unit, so a rotation
; output is round-to-nearest shifted down by 3 and added to the per-frame
; origin term (vs_rx / vs_ry).
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; sincos_lookup : A = angle byte -> magnitude in C, neg in B, unity in E
; Mirrors fp._sin_mag_sign.
; ---------------------------------------------------------------------------
sincos_lookup:
                ld      d,a
                rlca
                rlca
                and     3
                ld      b,a                     ; B = quadrant
                ld      a,d
                and     63
                ld      e,a                     ; E = index
                bit     0,b
                jr      z,sc_noflip
                ld      a,64
                sub     e
                ld      e,a                     ; mirror in odd quadrants
sc_noflip:
                ld      a,e
                or      a
                jr      nz,sc_nonzero
                ld      c,0                     ; sin 0: magnitude 0, positive
                ld      b,0
                ld      e,0
                ret
sc_nonzero:
                ld      a,b
                cp      2
                ld      b,0
                jr      c,sc_pos
                ld      b,1                     ; negative in quadrants 2 and 3
sc_pos:
                ld      h,SIN_UNITY>>8
                ld      a,SIN_UNITY&$ff
                add     a,e
                ld      l,a
                ld      a,(hl)
                or      a
                jr      z,sc_notunity
                ld      c,0
                ld      e,1                     ; unity: skip the multiply
                ret
sc_notunity:
                ld      h,SIN_MAG>>8
                ld      a,SIN_MAG&$ff
                add     a,e
                ld      l,a
                ld      c,(hl)
                ld      e,0
                ret

; ---------------------------------------------------------------------------
; view_setup : rebuild the per-frame view state.
; Reads pl_x/pl_xf/pl_y/pl_yf/pl_ang/vs_vz, writes the trig state, the product
; tables and vs_rx/vs_ry.
; ---------------------------------------------------------------------------
view_setup:
                ; The trig state and the two 256-entry product tables depend
                ; only on the view angle, so a frame that merely moved reuses
                ; them; rebuilding costs about 29k T-states.
                ld      a,(vs_haveang)
                or      a
                jr      z,vs_rebuild
                ld      a,(pl_ang)
                ld      b,a
                ld      a,(vs_lastang)
                cp      b
                jp      z,vs_origin
vs_rebuild:
                ld      a,(pl_ang)
                ld      (vs_lastang),a
                ld      a,1
                ld      (vs_haveang),a
                ; the trig state and every patch site it feeds live in
                ; bank 4 (fsetup.z80): once an angle change, not in the walk
                ld      a,BANK_OBJ
                call    set_page
                call    vs_rebuild_b4
                ld      a,BANK_GEOM
                call    set_page

vs_origin:
                ; --- origin term ----------------------------------------
                ; nx = (-px88) >> 8, dx_lo = (-px88) & 255
                ld      hl,(pl_x)
                ld      a,(pl_xf)
                call    neg_pos                 ; HL = nx, A = dx_lo
                ld      (vs_nx),hl
                ld      (vs_dxlo),a
                ld      hl,(pl_y)
                ld      a,(pl_yf)
                call    neg_pos
                ld      (vs_ny),hl
                ld      (vs_dylo),a

                ; frac_vx = fterm(dx_lo, sin) - fterm(dy_lo, cos)
                ld      a,(vs_dxlo)
                call    fterm_sin
                ld      (vs_t1),hl
                ld      a,(vs_dylo)
                call    fterm_cos
                ex      de,hl
                ld      hl,(vs_t1)
                or      a
                sbc     hl,de
                ld      b,3
                call    rns_hl                  ; rns(frac_vx, 3)
                ld      (vs_t1),hl

                ; frac_vy = fterm(dx_lo, cos) + fterm(dy_lo, sin)
                ld      a,(vs_dxlo)
                call    fterm_cos
                ld      (vs_t2),hl
                ld      a,(vs_dylo)
                call    fterm_sin
                ex      de,hl
                ld      hl,(vs_t2)
                add     hl,de
                ld      b,3
                call    rns_hl
                ld      (vs_t2),hl

                ; ref_vx = rot_sin(nx) - rot_cos(ny)
                ld      de,(vs_nx)
                call    rot_sin
                call    push_ahl
                ld      de,(vs_ny)
                call    rot_cos
                call    neg_ahl
                call    add_pushed              ; A:HL = ref_vx
                call    rns3_ahl
                ld      de,(vs_t1)
                add     hl,de
                ld      (vs_rx),hl

                ; ref_vy = rot_cos(nx) + rot_sin(ny)
                ld      de,(vs_nx)
                call    rot_cos
                call    push_ahl
                ld      de,(vs_ny)
                call    rot_sin
                call    add_pushed
                call    rns3_ahl
                ld      de,(vs_t2)
                add     hl,de
                ld      (vs_ry),hl

                ; advance the vertex-cache generation
                ld      a,(vc_stamp)
                inc     a
                jr      nz,vs_stampok
                call    vcache_wipe
                ld      a,1
vs_stampok:
                ld      (vc_stamp),a
                ret

; patch_sign : HL = patch site, A = 0 for "RET NOP NOP", else "JP neg_ahl"
patch_sign:
                or      a
                jr      nz,ps_neg
                ld      (hl),$c9                ; RET
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),0
                ret
ps_neg:
                ld      (hl),$c3                ; JP nn
                inc     hl
                ld      (hl),neg_ahl & $ff
                inc     hl
                ld      (hl),neg_ahl >> 8
                ret

; neg_pos : HL = integer part, A = fraction -> HL = (-v)>>8, A = (-v)&255
neg_pos:
                ld      d,a
                xor     a
                sub     d
                ld      d,a                     ; D = (-frac) & 255
                ld      a,h
                cpl
                ld      h,a
                ld      a,l
                cpl
                ld      l,a                     ; HL = ~v = -v - 1
                ld      a,d
                or      a
                jr      nz,np_done
                inc     hl                      ; no fraction: -v exactly
np_done:
                ld      a,d
                ret

; fterm_sin / fterm_cos : A = unsigned 0.8 delta -> HL = signed 0.8 term
fterm_sin:
                ld      e,a
                ld      a,(vs_sunity)
                or      a
                jr      nz,ft_unity_s
                ld      a,(vs_smag)
                ld      l,a
                ld      h,e
                call    mul_u8                  ; HL = lo*mag
                ld      de,128
                add     hl,de
                ld      l,h
                ld      h,0                     ; HL = (lo*mag + 128) >> 8
                ld      a,(vs_sneg)
                jr      ft_sign
ft_unity_s:
                ld      h,0
                ld      l,e
                ld      a,(vs_sneg)
                jr      ft_sign
fterm_cos:
                ld      e,a
                ld      a,(vs_cunity)
                or      a
                jr      nz,ft_unity_c
                ld      a,(vs_cmag)
                ld      l,a
                ld      h,e
                call    mul_u8
                ld      de,128
                add     hl,de
                ld      l,h
                ld      h,0
                ld      a,(vs_cneg)
                jr      ft_sign
ft_unity_c:
                ld      h,0
                ld      l,e
                ld      a,(vs_cneg)
ft_sign:
                or      a
                ret     z
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ret

; ---------------------------------------------------------------------------
; rot_sin / rot_cos : DE = s16 -> A:HL = s24 product with sin / cos.
; The dispatch target, the magnitude and the sign step are patched per frame.
; ---------------------------------------------------------------------------
rot_sin:
rs_k:           jp      rot_sin_gen             ; patched: _gen, _unity
rot_sin_gen:
rsm1:           ld      a,0                     ; the magnitude, patched
                call    mul_s16_u8
rsn:            ret                             ; or JP neg_ahl, patched
                nop
                nop
rot_sin_unity:
                ld      l,0
                ld      h,e
                ld      a,d                     ; A:HL = w << 8
                jp      rsn

rot_cos:
rc_k:           jp      rot_cos_gen
rot_cos_gen:
rcm1:           ld      a,0
                call    mul_s16_u8
rcn:            ret
                nop
                nop
rot_cos_unity:
                ld      l,0
                ld      h,e
                ld      a,d
                jp      rcn

; ---------------------------------------------------------------------------
; s24 helpers used to sum rotation terms.
; ---------------------------------------------------------------------------
push_ahl:
                ld      (vs_acc),hl
                ld      (vs_acc+2),a
                ret
add_pushed:
                ld      de,(vs_acc)
                add     hl,de
                ld      d,a
                ld      a,(vs_acc+2)
                adc     a,d
                ret
; sub_pushed : A:HL = vs_acc - A:HL, replacing a negate-then-add pair.
sub_pushed:
                ex      de,hl
                ld      c,a
                ld      hl,(vs_acc)
                or      a
                sbc     hl,de
                ld      a,(vs_acc+2)
                sbc     a,c
                ret

; ---------------------------------------------------------------------------
; recip : HL = tvy (positive s16 counts) -> D = S, E = M8, A = S
;   idx = tvy >> 4, clamped to the table's 1023 and reduced by right shifts
;   into [2, 255]; S counts those on top of the table's own.  Each case is
;   a shift up read a byte high.
; ---------------------------------------------------------------------------
recip:
                ld      a,h
                cp      $10
                jr      nc,rp_far
                add     hl,hl
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      b,0
                jr      rp_idx
rp_far:         cp      $20
                jr      nc,rp_far2
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      b,1
                jr      rp_idx
rp_far2:        cp      $40
                jr      nc,rp_clamp
                add     hl,hl
                add     hl,hl
                ld      b,2
                jr      rp_idx
rp_clamp:       ld      h,255
                ld      b,2
rp_idx:         ld      a,h
                cp      2
                jr      nc,rp_ok
                ld      a,2
rp_ok:          ld      l,a
                ld      h,RECIP_M8>>8
                ld      e,(hl)
                inc     h
                ld      a,(hl)
                add     a,b
                ld      d,a
                ret


project_y:
                ; A = height delta, E = M8, D = S -> HL = screen y (biased).
                ; The whole input tuple is the key, so an entry survives
                ; frames and positions and a hit is the body's own answer by
                ; construction.  A live reciprocal never has S = 0, so the S
                ; plane doubles as the valid flag: cleared once by cpm_init.
                ; 256 slots on h ^ M8; the planes are pages, so the slot is L
                ; and the walk between them is INC H.  DE is kept.
                ld      c,a                     ; h
                xor     e
                ld      l,a                     ; the slot
                ld      h,VYC_H>>8
                ld      a,c
                cp      (hl)
                jr      nz,py_miss
                inc     h                       ; VYC_M8
                ld      a,e
                cp      (hl)
                jr      nz,py_miss
                inc     h                       ; VYC_S
                ld      a,d
                cp      (hl)
                jr      nz,py_miss
                inc     h                       ; VYC_L
                ld      a,(hl)
                inc     h                       ; VYC_HI
                ld      h,(hl)
                ld      l,a
                ret
py_miss:
                ld      h,VYC_H>>8
                ld      (hl),c                  ; the key first: h,
                inc     h
                ld      (hl),e                  ;   M8,
                inc     h
                ld      (hl),d                  ;   S (valid: nothing can
                inc     h                       ;   interrupt the fill)
                push    hl                      ; -> VYC_L slot
                push    de                      ; (M8, S)
                push    bc                      ; h (the multiply eats BC)
                ld      h,c
                ld      l,e
                call    mul_s8_u8               ; HL = h * M8 (signed)
                pop     bc
                ld      d,c
                ld      e,0                     ; DE = h << 8
                add     hl,de                   ; HL = h * m9, fits s16
                pop     de
                ld      b,d
                call    rns_hl                  ; leaves DE alone
                ld      a,HALF_H+Y_BIAS         ; the row, in the clipper's
                sub     l                       ; biased units
                ld      l,a
                ld      a,0
                sbc     a,h
                ld      h,a                     ; HL = sy + Y_BIAS
                pop     bc                      ; the VYC_L slot
                ld      a,l
                ld      (bc),a
                inc     b                       ; VYC_HI
                ld      a,h
                ld      (bc),a
                ret

; ---------------------------------------------------------------------------
; project_x : HL = tvx (s16 counts), E = M8, D = S -> HL = screen column, s16.
;
; The BBC's project_x_c (bsp/project.s) compare-for-compare:
;       Q  = floor(tvx * m9 / 256),  m9 = 256 + M8
;       sx = HALF_W + Q << (3 - S)          S < 3
;                   + Q                     S = 3   (no rounding)
;                   + rns(Q, S - 3)         S > 3
; The floor is the whole low byte of tvx * M8 dropped, so Q is tvx plus the
; signed 24-bit product's top two bytes.  (The earlier version rounded at
; S = 3 and kept three more bits for S < 3, which put a vertex one column
; off in 5 of 1000 frames.)  Eats A, BC, DE.
; ---------------------------------------------------------------------------
project_x:
                ld      a,e
                or      a
                jr      z,px_q                  ; m9 = 256: Q = tvx
                ; floor(tvx * M8 / 256) = hi * M8 + floor(lo * M8 / 256) for
                ; tvx = 256 * hi + lo (hi signed, lo unsigned): two 8x8s,
                ; and none at all for the high byte when it is 0 or -1
                push    de                      ; (M8, S)
                push    hl                      ; tvx
                ld      h,l                     ; lo
                ld      l,e                     ; M8
                MUL_U8_BODY                     ; HL = lo * M8
                ld      a,h
                ld      (px_lop),a              ; the low partial
                pop     hl                      ; tvx
                pop     de                      ; (M8, S)
                ld      a,h
                or      a
                jr      z,px_hi0
                inc     a
                jr      z,px_him1
                dec     a
                push    de
                push    hl
                ld      h,a                     ; hi, as unsigned
                ld      l,e                     ; M8
                MUL_U8_BODY                     ; HL = hi_u * M8
                pop     de                      ; tvx
                pop     bc                      ; C = M8, B = S
                bit     7,d
                jr      z,px_hp
                ld      a,h
                sub     c
                ld      h,a                     ; signed: less M8 << 8
px_hp:          ld      a,(px_lop)
                add     a,l
                ld      l,a
                ld      a,0
                adc     a,h
                ld      h,a                     ; hi * M8 + the low partial
                add     hl,de                   ; Q
                ld      d,b                     ; S
                jr      px_q
px_hi0:         ld      a,(px_lop)              ; Q = tvx + the low partial
                add     a,l
                ld      l,a
                jr      nc,px_q
                inc     h
                jr      px_q
px_him1:        ld      a,(px_lop)              ; Q = tvx + the partial - M8,
                sub     e                       ;   the difference in [-M8, -1]
                ld      c,a
                ld      b,$ff
                add     hl,bc
px_q:           ld      a,d
                sub     3
                jr      z,px_done
                jr      c,px_left
                ld      b,a
                call    rns_hl                  ; round half up by S - 3
                jr      px_done
px_left:        add     hl,hl                   ; S = 2: one doubling,
                inc     a
                jr      z,px_done
                add     hl,hl                   ; S = 1: two
px_done:        ld      de,HALF_W
                add     hl,de
                ret

; ---------------------------------------------------------------------------
vcache_wipe:
                ld      hl,VCACHE_BASE
                ld      de,VCACHE_ENT
                ld      bc,NVERTS
vw_loop:
                ld      (hl),0
                add     hl,de
                dec     bc
                ld      a,b
                or      c
                jr      nz,vw_loop
                ret
