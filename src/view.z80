; ---------------------------------------------------------------------------
; View transform and perspective projection.
;
; The rotation is  vx = wx*sin - wy*cos,  vy = wx*cos + wy*sin,  with sin and
; cos held as unsigned 0.8 magnitudes plus sign and unity flags. Doing that as
; four 16x8 quarter-square multiplies would cost about 1600 T-states a point,
; and a frame transforms sixty vertices plus a couple of bbox corners per BSP
; node, so instead each frame builds two 256-entry product tables - i*sin and
; i*cos - and a rotation term becomes two table lookups. The tables cost about
; 29k T-states to fill and save five times that.
;
; Results are TRUE16 counts: 32 counts to one prescaled unit, so a rotation
; output is round-to-nearest shifted down by 3 and added to the per-frame
; origin term (vs_rx / vs_ry).
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; sincos_lookup : A = angle byte -> magnitude in C, neg in B, unity in E,
; the quadrant index (0..64) in D.  Mirrors fp._sin_mag_sign.
; ---------------------------------------------------------------------------
sincos_lookup:
                ld      d,a
                rlca
                rlca
                and     3
                ld      b,a                     ; B = quadrant
                ld      a,d
                and     63
                ld      e,a                     ; E = index
                bit     0,b
                jr      z,sc_noflip
                ld      a,64
                sub     e
                ld      e,a                     ; mirror in odd quadrants
sc_noflip:
                ld      d,e                     ; D = the index
                ld      a,e
                or      a
                jr      nz,sc_nonzero
                ld      c,0                     ; sin 0: magnitude 0, positive
                ld      b,0
                ld      e,0
                ret
sc_nonzero:
                ld      a,b
                cp      2
                ld      b,0
                jr      c,sc_pos
                ld      b,1                     ; negative in quadrants 2 and 3
sc_pos:
                ld      h,SIN_UNITY>>8
                ld      a,SIN_UNITY&$ff
                add     a,e
                ld      l,a
                ld      a,(hl)
                or      a
                jr      z,sc_notunity
                ld      c,0
                ld      e,1                     ; unity: skip the multiply
                ret
sc_notunity:
                ld      h,SIN_MAG>>8
                ld      a,SIN_MAG&$ff
                add     a,e
                ld      l,a
                ld      c,(hl)
                ld      e,0
                ret

; ---------------------------------------------------------------------------
; view_setup : rebuild the per-frame view state.
; Reads pl_x/pl_xf/pl_y/pl_yf/pl_ang/vs_vz, writes the trig state, the product
; tables and vs_rx/vs_ry.
; ---------------------------------------------------------------------------
view_setup:
                ld      a,(vs_vz)               ; bake the eye height into
                ld      (pyv_imm+1),a           ; project_y_vz for this frame
                ld      (pyv1+1),a              ;  and its eight inlined probes
                ld      (pyv2+1),a
                ld      (pyv3+1),a
                ld      (pyv4+1),a
                ld      (pyv5+1),a
                ld      (pyv6+1),a
                ld      (pyv7+1),a
                ld      (pyv8+1),a
                ld      hl,(pl_x)               ; the viewer as immediates at
                ld      (bfx1+1),hl             ;  the back-face sites
                ld      (bfx2+1),hl
                ld      hl,(pl_y)
                ld      (bfy1+1),hl
                ld      (bfy2+1),hl
                ; The trig state and the two 256-entry product tables depend
                ; only on the view angle, so a frame that merely moved reuses
                ; them; rebuilding costs about 29k T-states.
                ld      a,(vs_haveang)
                or      a
                jr      z,vs_rebuild
                ld      a,(pl_ang)
                ld      b,a
                ld      a,(vs_lastang)
                cp      b
                jp      z,vs_origin
vs_rebuild:
                ld      a,(pl_ang)
                ld      (vs_lastang),a
                ld      a,1
                ld      (vs_haveang),a
                ; the rotated-vertex cache goes with the angle
                ld      a,(vx_stamp)
                inc     a
                jr      nz,vxs_ok
                call    vxcache_wipe
                ld      a,1
vxs_ok:         ld      (vx_stamp),a
                ld      (vgm_vxs+1),a           ; vg_miss's immediate
                ; the trig state and every patch site it feeds live in
                ; bank 4 (fsetup.z80): once an angle change, not in the walk
                ld      a,BANK_OBJ
                call    set_page
                call    vs_rebuild_b4
                ld      a,BANK_GEOM
                call    set_page

vs_origin:
                ; --- origin term ----------------------------------------
                ; nx = (-px88) >> 8, dx_lo = (-px88) & 255
                ld      hl,(pl_x)
                ld      a,(pl_xf)
                call    neg_pos                 ; HL = nx, A = dx_lo
                ld      (vs_nx),hl
                ld      (vs_dxlo),a
                ld      hl,(pl_y)
                ld      a,(pl_yf)
                call    neg_pos
                ld      (vs_ny),hl
                ld      (vs_dylo),a

                ; frac_vx = fterm(dx_lo, sin) - fterm(dy_lo, cos)
                ld      a,(vs_dxlo)
                call    fterm_sin
                ld      (vs_t1),hl
                ld      a,(vs_dylo)
                call    fterm_cos
                ex      de,hl
                ld      hl,(vs_t1)
                or      a
                sbc     hl,de
                ld      b,3
                call    rns_hl                  ; rns(frac_vx, 3)
                ld      (vs_t1),hl

                ; frac_vy = fterm(dx_lo, cos) + fterm(dy_lo, sin)
                ld      a,(vs_dxlo)
                call    fterm_cos
                ld      (vs_t2),hl
                ld      a,(vs_dylo)
                call    fterm_sin
                ex      de,hl
                ld      hl,(vs_t2)
                add     hl,de
                ld      b,3
                call    rns_hl
                ld      (vs_t2),hl

                ; ref_vx = rot_sin(nx) - rot_cos(ny)
                ld      de,(vs_nx)
                call    rot_sin
                call    push_ahl
                ld      de,(vs_ny)
                call    rot_cos
                call    neg_ahl
                call    add_pushed              ; A:HL = ref_vx
                call    rns3_ahl
                ld      de,(vs_t1)
                add     hl,de
                ld      (vs_rx),hl
                ld      (vxh_rx+1),hl           ; vg_have's and vx_have's immediates
                ld      (vxh_rx2+1),hl

                ; ref_vy = rot_cos(nx) + rot_sin(ny)
                ld      de,(vs_nx)
                call    rot_cos
                call    push_ahl
                ld      de,(vs_ny)
                call    rot_sin
                call    add_pushed
                call    rns3_ahl
                ld      de,(vs_t2)
                add     hl,de
                ld      (vs_ry),hl
                ld      (vxh_ry+1),hl
                ld      (vxh_ry2+1),hl

                ; advance the vertex-cache generation
                ld      a,(vc_stamp)
                inc     a
                jr      nz,vs_stampok
                call    vcache_wipe
                ld      a,1
vs_stampok:
                ld      (vc_stamp),a
                ld      (vcs1+1),a              ; the three VGETP sites
                ld      (vcs2+1),a
                ld      (vcs3+1),a
                ret

; patch_sign : HL = patch site, A = 0 for "RET NOP NOP", else "JP neg_ahl"
patch_sign:
                or      a
                jr      nz,ps_neg
                ld      (hl),$c9                ; RET
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),0
                ret
ps_neg:
                ld      (hl),$c3                ; JP nn
                inc     hl
                ld      (hl),neg_ahl & $ff
                inc     hl
                ld      (hl),neg_ahl >> 8
                ret

; neg_pos : HL = integer part, A = fraction -> HL = (-v)>>8, A = (-v)&255
neg_pos:
                ld      d,a
                xor     a
                sub     d
                ld      d,a                     ; D = (-frac) & 255
                ld      a,h
                cpl
                ld      h,a
                ld      a,l
                cpl
                ld      l,a                     ; HL = ~v = -v - 1
                ld      a,d
                or      a
                jr      nz,np_done
                inc     hl                      ; no fraction: -v exactly
np_done:
                ld      a,d
                ret

; fterm_sin / fterm_cos : A = unsigned 0.8 delta -> HL = signed 0.8 term
fterm_sin:
                ld      e,a
                ld      a,(vs_sunity)
                or      a
                jr      nz,ft_unity_s
                ld      a,(vs_smag)
                ld      l,a
                ld      h,e
                call    mul_u8                  ; HL = lo*mag
                ld      de,128
                add     hl,de
                ld      l,h
                ld      h,0                     ; HL = (lo*mag + 128) >> 8
                ld      a,(vs_sneg)
                jr      ft_sign
ft_unity_s:
                ld      h,0
                ld      l,e
                ld      a,(vs_sneg)
                jr      ft_sign
fterm_cos:
                ld      e,a
                ld      a,(vs_cunity)
                or      a
                jr      nz,ft_unity_c
                ld      a,(vs_cmag)
                ld      l,a
                ld      h,e
                call    mul_u8
                ld      de,128
                add     hl,de
                ld      l,h
                ld      h,0
                ld      a,(vs_cneg)
                jr      ft_sign
ft_unity_c:
                ld      h,0
                ld      l,e
                ld      a,(vs_cneg)
ft_sign:
                or      a
                ret     z
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ret

; ---------------------------------------------------------------------------
; rot_sin / rot_cos : DE = s16 -> A:HL = s24 product with sin / cos.
; The dispatch target, the magnitude and the sign step are patched per frame.
; ---------------------------------------------------------------------------
rot_sin:
rs_k:           jp      rot_sin_gen             ; patched: _gen, _unity
rot_sin_gen:
rsm1:           ld      a,0                     ; the magnitude, patched
                call    mul_s16_u8
rsn:            ret                             ; or JP neg_ahl, patched
                nop
                nop
rot_sin_unity:
                ld      l,0
                ld      h,e
                ld      a,d                     ; A:HL = w << 8
                jp      rsn

rot_cos:
rc_k:           jp      rot_cos_gen
rot_cos_gen:
rcm1:           ld      a,0
                call    mul_s16_u8
rcn:            ret
                nop
                nop
rot_cos_unity:
                ld      l,0
                ld      h,e
                ld      a,d
                jp      rcn

; ---------------------------------------------------------------------------
; s24 helpers used to sum rotation terms.
; ---------------------------------------------------------------------------
push_ahl:
                ld      (vs_acc),hl
                ld      (vs_acc+2),a
                ret
add_pushed:
                ld      de,(vs_acc)
                add     hl,de
                ld      d,a
                ld      a,(vs_acc+2)
                adc     a,d
                ret
; sub_pushed : A:HL = vs_acc - A:HL, replacing a negate-then-add pair.
sub_pushed:
                ex      de,hl
                ld      c,a
                ld      hl,(vs_acc)
                or      a
                sbc     hl,de
                ld      a,(vs_acc+2)
                sbc     a,c
                ret

; ---------------------------------------------------------------------------
; recip : HL = tvy (positive s16 counts) -> D = S, E = M8, A = S
;   idx = tvy >> 4, clamped to the table's 1023 and reduced by right shifts
;   into [2, 255]; S counts those on top of the table's own.  Each case is
;   a shift up read a byte high.
; ---------------------------------------------------------------------------
                MACRO   RECIP_BODY              ; HL = tvy -> E = M8, D = S; eats A, B, HL
                ld      a,h
                cp      $10
                jr      nc,.far
                add     hl,hl
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      b,0
                jr      .idx
.far:           cp      $20
                jr      nc,.far2
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      b,1
                jr      .idx
.far2:          cp      $40
                jr      nc,.clamp
                add     hl,hl
                add     hl,hl
                ld      b,2
                jr      .idx
.clamp:         ld      h,255
                ld      b,2
.idx:           ld      a,h
                cp      2
                jr      nc,.ok
                ld      a,2
.ok:            ld      l,a
                ld      h,RECIP_M8>>8
                ld      e,(hl)
                inc     h
                ld      a,(hl)
                add     a,b
                ld      d,a
                ENDM
recip:
                RECIP_BODY
                ret


; PY_INLINE : project_y_vz's probe inlined at a hot site (the seg body's
; eight): A = raw height, DE = (M8, S) -> HL = the row; the site's eye
; height is patched with pyv_imm's each frame (view_setup's list)
                MACRO   PY_INLINE site
site:           sub     0                       ; SMC: - vs_vz
                ld      c,a                     ; h
                xor     e
                ld      l,a                     ; the slot = h ^ M8
                ld      h,VYC_M8>>8
                ld      a,e
                cp      (hl)
                jr      nz,.miss
                inc     h                       ; VYC_S
                ld      a,d
                cp      (hl)
                jr      nz,.miss
                inc     h                       ; VYC_L
                ld      a,(hl)
                inc     h                       ; VYC_HI
                ld      h,(hl)
                ld      l,a
                jr      .done
.miss:          call    py_miss
.done:
                ENDM
project_y_vz:
                ; A = raw height; subtract the eye height (patched each frame
                ; by find_eye_height) to form the delta, then fall into the
                ; core.  Saves the `ld hl,vs_vz / sub (hl)` (17 T -> 7 T) at
                ; every render-path call site.
pyv_imm:        sub     0                       ; SMC: - vs_vz
project_y:
                ; A = height delta, E = M8, D = S -> HL = screen y (biased).
                ; The whole input tuple is the key, so an entry survives
                ; frames and positions and a hit is the body's own answer by
                ; construction.  A live reciprocal never has S = 0, so the S
                ; plane doubles as the valid flag: cleared once by cpm_init.
                ; 256 slots on h ^ M8; the planes are pages, so the slot is L
                ; and the walk between them is INC H.  DE is kept.
                ld      c,a                     ; h
                xor     e
                ld      l,a                     ; the slot = h ^ M8, so a slot
                ld      h,VYC_M8>>8             ; whose M8 matches has h implied:
                ld      a,e                     ; the key is (M8, S) alone
                cp      (hl)
                jr      nz,py_miss
                inc     h                       ; VYC_S
                ld      a,d
                cp      (hl)
                jr      nz,py_miss
                inc     h                       ; VYC_L
                ld      a,(hl)
                inc     h                       ; VYC_HI
                ld      h,(hl)
                ld      l,a
                ret
py_miss:
                ld      h,VYC_M8>>8
                ld      (hl),e                  ; the key: M8,
                inc     h
                ld      (hl),d                  ;   S (valid: nothing can
                inc     h                       ;   interrupt the fill)
                push    hl                      ; -> VYC_L slot
                ld      a,c
                ex      af,af'                  ; h rides A' across the multiply
                ld      a,c
                or      a
                jp      m,pym_neg
                MUL_AE                          ; HL = h * M8 (DE kept)
pym_add:        ex      af,af'
                ld      b,a
                ld      c,0                     ; BC = h << 8
                add     hl,bc                   ; HL = h * m9, fits s16
                ; rns by S, the common counts inline in order of frequency
                ; (S = 8 is the mode): 8 as rh_8 ((V + 128) >> 8), 7 and 6 as
                ; rh_7/rh_6 ((V + 2^(S-1)) as s24 shifted LEFT by 8 - S, the
                ; top two bytes taken), 9 as rh_drop (the low byte dropped, one
                ; rounding shift); the rest through rns_hl
                ld      a,d
                cp      8
                jr      z,pyr_8
                cp      7
                jr      z,pyr_7
                cp      9
                jr      z,pyr_9
                cp      6
                jr      nz,pyr_gen
                ld      a,h                     ; S = 6
                rla
                sbc     a,a
                ld      bc,32
                add     hl,bc
                adc     a,0
                add     hl,hl
                rla
                add     hl,hl
                rla
                ld      l,h
                ld      h,a
                jp      pyr_done
pyr_8:          ld      a,h
                rla
                sbc     a,a
                ld      b,a                     ; the sign
                ld      a,l
                rla                             ; carry = the rounding bit
                ld      a,h
                adc     a,0
                ld      l,a
                ld      a,b
                adc     a,0
                ld      h,a
                jp      pyr_done
pyr_7:          ld      a,h
                rla
                sbc     a,a
                ld      bc,64
                add     hl,bc
                adc     a,0
                add     hl,hl
                rla
                ld      l,h
                ld      h,a
                jp      pyr_done
pyr_9:          ld      a,h
                ld      l,a
                rla
                sbc     a,a
                ld      h,a                     ; HL = V >> 8, s16
                inc     hl
                sra     h
                rr      l
                jp      pyr_done
pyr_gen:        ld      b,d
                call    rns_hl                  ; leaves DE alone
pyr_done:       ld      a,HALF_H+Y_BIAS         ; the row, in the clipper's
                sub     l                       ; biased units
                ld      l,a
                ld      a,0
                sbc     a,h
                ld      h,a                     ; HL = sy + Y_BIAS
                pop     bc                      ; the VYC_L slot
                ld      a,l
                ld      (bc),a
                inc     b                       ; VYC_HI
                ld      a,h
                ld      (bc),a
                ret
pym_neg:        MUL_AE                          ; (h + 256) * M8: less M8 << 8
                ld      a,h
                sub     e
                ld      h,a
                jp      pym_add

; ---------------------------------------------------------------------------
; project_x : HL = tvx (s16 counts), E = M8, D = S -> HL = screen column, s16.
;
; The BBC's project_x_c (bsp/project.s) compare-for-compare:
;       Q  = floor(tvx * m9 / 256),  m9 = 256 + M8
;       sx = HALF_W + Q << (3 - S)          S < 3
;                   + Q                     S = 3   (no rounding)
;                   + rns(Q, S - 3)         S > 3
; The floor is the whole low byte of tvx * M8 dropped, so Q is tvx plus the
; signed 24-bit product's top two bytes.  (The earlier version rounded at
; S = 3 and kept three more bits for S < 3, which put a vertex one column
; off in 5 of 1000 frames.)  Eats A, BC, DE.
; ---------------------------------------------------------------------------
; PROJECT_X : project_x's body as a macro, so vg_front (the hot caller) runs
; it in line; project_x is the routine form for the objects
                MACRO   PROJECT_X
                ld      a,e
                or      a
                jp      z,.q                  ; m9 = 256: Q = tvx
                ; floor(tvx * M8 / 256) = hi * M8 + floor(lo * M8 / 256) for
                ; tvx = 256 * hi + lo (hi signed, lo unsigned): two 8x8s
                ; (MUL_AE keeps M8 and S in DE), and none at all for the high
                ; byte when it is 0 or -1
                push    hl                      ; tvx
                ld      a,h
                ex      af,af'                  ; A' = hi
                ld      a,l
                or      a
                jr      z,.lo0                  ; frac = 0 (BBC px_frac_z): no
                MUL_AE                          ; HL = lo * M8
                ld      a,h                     ; the low partial
.lojoin:        ex      af,af'                  ; A = hi, A' = the partial
                or      a
                jr      z,.hi0
                inc     a
                jr      z,.him1
                dec     a
                jp      m,.neg
                MUL_AE                          ; HL = hi * M8
.join:        ex      af,af'
                add     a,l                     ; + the low partial
                ld      l,a
                ld      a,0
                adc     a,h
                ld      h,a
                pop     bc                      ; tvx
                add     hl,bc                   ; Q
                jr      .q
.neg:         MUL_AE                          ; HL = hi_u * M8: the two's
                ld      a,h                     ;  complement's 256 * M8 off
                sub     e
                ld      h,a
                jr      .join
.lo0:           xor     a                       ;  product and no partial
                jr      .lojoin
.hi0:         ex      af,af'                  ; Q = tvx + the low partial
                pop     hl
                add     a,l
                ld      l,a
                jr      nc,.q
                inc     h
                jr      .q
.him1:        ex      af,af'                  ; Q = tvx + the partial - M8,
                sub     e                       ;   the difference in [-M8, -1]
                ld      c,a
                ld      b,$ff
                pop     hl
                add     hl,bc
.q:           ld      a,d
                sub     3
                jr      z,.done
                jr      c,.left
                ; round half up by S - 3, the common counts inline in order
                ; of frequency (S = 8 is the mode): 5 and 6 as rh_5/rh_6
                ; ((V + 2^(B-1)) as s24 shifted LEFT by 8 - B, the top two
                ; bytes taken), 1..4 as the chain (B - 1 plain shifts, + 1,
                ; one more); the rest through rns_hl
                cp      5
                jr      z,.r5
                cp      4
                jr      z,.r4
                cp      6
                jr      z,.r6
                cp      3
                jr      z,.r3
                cp      2
                jr      z,.r2
                dec     a
                jr      nz,.rgen
.r1:          inc     hl
                sra     h
                rr      l
                jr      .done
.r4:          sra     h
                rr      l
.r3:          sra     h
                rr      l
.r2:          sra     h
                rr      l
                inc     hl
                sra     h
                rr      l
                jr      .done
.r5:          ld      a,h
                rla
                sbc     a,a
                ld      bc,16
                add     hl,bc
                adc     a,0
                add     hl,hl
                rla
                add     hl,hl
                rla
                add     hl,hl
                rla
                ld      l,h
                ld      h,a
                jr      .done
.r6:          ld      a,h
                rla
                sbc     a,a
                ld      bc,32
                add     hl,bc
                adc     a,0
                add     hl,hl
                rla
                add     hl,hl
                rla
                ld      l,h
                ld      h,a
                jr      .done
.rgen:        ld      b,d
                dec     b
                dec     b
                dec     b
                call    rns_hl
                jr      .done
.left:        add     hl,hl                   ; S = 2: one doubling,
                inc     a
                jr      z,.done
                add     hl,hl                   ; S = 1: two
.done:        ld      de,HALF_W
                add     hl,de
                ENDM
project_x:
                PROJECT_X
                ret

; ---------------------------------------------------------------------------
vcache_wipe:                                    ; the VXCACHE stamps
                ld      hl,VXR
                jr      wipe8
vxcache_wipe:                                   ; the VRCACHE stamps
                ld      hl,VRR
; wipe8 : clear every 8th byte from HL over 16 pages (the 512 record slots)
wipe8:
                ld      a,h
                add     a,16
                ld      c,a                     ; the end page
w8_loop:        ld      (hl),0
                ld      a,l
                add     a,8
                ld      l,a
                jr      nc,w8_loop
                inc     h
                ld      a,h
                cp      c
                jr      nz,w8_loop
                ret
