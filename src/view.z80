; ---------------------------------------------------------------------------
; View transform and perspective projection.
;
; The rotation is  vx = wx*sin - wy*cos,  vy = wx*cos + wy*sin,  with sin and
; cos held as unsigned 0.8 magnitudes plus sign and unity flags. Doing that as
; four 16x8 quarter-square multiplies would cost about 1600 T-states a point,
; and a frame transforms sixty vertices plus a couple of bbox corners per BSP
; node, so instead each frame builds two 256-entry product tables - i*sin and
; i*cos - and a rotation term becomes two table lookups. The tables cost about
; 29k T-states to fill and save five times that.
;
; Results are TRUE16 counts: 32 counts to one prescaled unit, so a rotation
; output is round-to-nearest shifted down by 3 and added to the per-frame
; origin term (vs_rx / vs_ry).
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; sincos_lookup : A = angle byte -> magnitude in C, neg in B, unity in E
; Mirrors fp._sin_mag_sign.
; ---------------------------------------------------------------------------
sincos_lookup:
                ld      d,a
                rlca
                rlca
                and     3
                ld      b,a                     ; B = quadrant
                ld      a,d
                and     63
                ld      e,a                     ; E = index
                bit     0,b
                jr      z,sc_noflip
                ld      a,64
                sub     e
                ld      e,a                     ; mirror in odd quadrants
sc_noflip:
                ld      a,e
                or      a
                jr      nz,sc_nonzero
                ld      c,0                     ; sin 0: magnitude 0, positive
                ld      b,0
                ld      e,0
                ret
sc_nonzero:
                ld      a,b
                cp      2
                ld      b,0
                jr      c,sc_pos
                ld      b,1                     ; negative in quadrants 2 and 3
sc_pos:
                ld      h,SIN_UNITY>>8
                ld      a,SIN_UNITY&$ff
                add     a,e
                ld      l,a
                ld      a,(hl)
                or      a
                jr      z,sc_notunity
                ld      c,0
                ld      e,1                     ; unity: skip the multiply
                ret
sc_notunity:
                ld      h,SIN_MAG>>8
                ld      a,SIN_MAG&$ff
                add     a,e
                ld      l,a
                ld      c,(hl)
                ld      e,0
                ret

; ---------------------------------------------------------------------------
; build_prod : fill a pair of product planes with i*mag.
; in : A = magnitude, D = low plane page (high plane is the next page)
; ---------------------------------------------------------------------------
build_prod:
                ld      e,a
                ld      d,0                     ; DE = mag
                ld      hl,0                    ; running product
bp_page:        ld      b,TSLO>>8               ; patched by the caller
                ld      c,0
bp_loop:
                ld      a,l
                ld      (bc),a
                inc     b
                ld      a,h
                ld      (bc),a
                dec     b
                add     hl,de
                inc     c
                jr      nz,bp_loop
                ret

; ---------------------------------------------------------------------------
; view_setup : rebuild the per-frame view state.
; Reads pl_x/pl_xf/pl_y/pl_yf/pl_ang/vs_vz, writes the trig state, the product
; tables and vs_rx/vs_ry.
; ---------------------------------------------------------------------------
view_setup:
                ; The trig state and the two 256-entry product tables depend
                ; only on the view angle, so a frame that merely moved reuses
                ; them; rebuilding costs about 29k T-states.
                ld      a,(vs_haveang)
                or      a
                jr      z,vs_rebuild
                ld      a,(pl_ang)
                ld      b,a
                ld      a,(vs_lastang)
                cp      b
                jp      z,vs_origin
vs_rebuild:
                ; the angle moved, so every stored rotation is stale
                ld      hl,VXVALID
                ld      de,VXVALID+1
                ld      bc,VXVALID_LEN-1
                ld      (hl),0
                ldir
                ld      a,(pl_ang)
                ld      (vs_lastang),a
                ld      a,1
                ld      (vs_haveang),a
                ld      a,(pl_ang)
                call    sincos_lookup
                ld      a,c
                ld      (vs_smag),a
                ld      a,b
                ld      (vs_sneg),a
                ld      a,e
                ld      (vs_sunity),a
                ld      a,(pl_ang)
                add     a,64
                call    sincos_lookup
                ld      a,c
                ld      (vs_cmag),a
                ld      a,b
                ld      (vs_cneg),a
                ld      a,e
                ld      (vs_cunity),a

                ; product tables
                ld      a,TSLO>>8
                ld      (bp_page+1),a
                ld      a,(vs_smag)
                call    build_prod
                ld      a,TCLO>>8
                ld      (bp_page+1),a
                ld      a,(vs_cmag)
                call    build_prod

                ; patch the rotation dispatchers
                ld      hl,rot_sin_tab
                ld      a,(vs_sunity)
                or      a
                jr      z,vs_s1
                ld      hl,rot_sin_unity
vs_s1:          ld      (rs_k+1),hl
                ld      a,(vs_smag)
                ld      (rsm2+1),a
                ld      hl,rsn
                ld      a,(vs_sneg)
                call    patch_sign

                ld      hl,rot_cos_tab
                ld      a,(vs_cunity)
                or      a
                jr      z,vs_c1
                ld      hl,rot_cos_unity
vs_c1:          ld      (rc_k+1),hl
                ld      a,(vs_cmag)
                ld      (rcm2+1),a
                ld      hl,rcn
                ld      a,(vs_cneg)
                call    patch_sign

vs_origin:
                ; --- origin term ----------------------------------------
                ; nx = (-px88) >> 8, dx_lo = (-px88) & 255
                ld      hl,(pl_x)
                ld      a,(pl_xf)
                call    neg_pos                 ; HL = nx, A = dx_lo
                ld      (vs_nx),hl
                ld      (vs_dxlo),a
                ld      hl,(pl_y)
                ld      a,(pl_yf)
                call    neg_pos
                ld      (vs_ny),hl
                ld      (vs_dylo),a

                ; frac_vx = fterm(dx_lo, sin) - fterm(dy_lo, cos)
                ld      a,(vs_dxlo)
                call    fterm_sin
                ld      (vs_t1),hl
                ld      a,(vs_dylo)
                call    fterm_cos
                ex      de,hl
                ld      hl,(vs_t1)
                or      a
                sbc     hl,de
                ld      b,3
                call    rns_hl                  ; rns(frac_vx, 3)
                ld      (vs_t1),hl

                ; frac_vy = fterm(dx_lo, cos) + fterm(dy_lo, sin)
                ld      a,(vs_dxlo)
                call    fterm_cos
                ld      (vs_t2),hl
                ld      a,(vs_dylo)
                call    fterm_sin
                ex      de,hl
                ld      hl,(vs_t2)
                add     hl,de
                ld      b,3
                call    rns_hl
                ld      (vs_t2),hl

                ; ref_vx = rot_sin(nx) - rot_cos(ny)
                ld      de,(vs_nx)
                call    rot_sin
                call    push_ahl
                ld      de,(vs_ny)
                call    rot_cos
                call    neg_ahl
                call    add_pushed              ; A:HL = ref_vx
                call    rns3_ahl
                ld      de,(vs_t1)
                add     hl,de
                ld      (vs_rx),hl

                ; ref_vy = rot_cos(nx) + rot_sin(ny)
                ld      de,(vs_nx)
                call    rot_cos
                call    push_ahl
                ld      de,(vs_ny)
                call    rot_sin
                call    add_pushed
                call    rns3_ahl
                ld      de,(vs_t2)
                add     hl,de
                ld      (vs_ry),hl

                ; advance the vertex-cache generation
                ld      a,(vc_stamp)
                inc     a
                jr      nz,vs_stampok
                call    vcache_wipe
                ld      a,1
vs_stampok:
                ld      (vc_stamp),a
                ret

; patch_sign : HL = patch site, A = 0 for "RET NOP NOP", else "JP neg_ahl"
patch_sign:
                or      a
                jr      nz,ps_neg
                ld      (hl),$c9                ; RET
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),0
                ret
ps_neg:
                ld      (hl),$c3                ; JP nn
                inc     hl
                ld      (hl),neg_ahl & $ff
                inc     hl
                ld      (hl),neg_ahl >> 8
                ret

; neg_pos : HL = integer part, A = fraction -> HL = (-v)>>8, A = (-v)&255
neg_pos:
                ld      d,a
                xor     a
                sub     d
                ld      d,a                     ; D = (-frac) & 255
                ld      a,h
                cpl
                ld      h,a
                ld      a,l
                cpl
                ld      l,a                     ; HL = ~v = -v - 1
                ld      a,d
                or      a
                jr      nz,np_done
                inc     hl                      ; no fraction: -v exactly
np_done:
                ld      a,d
                ret

; fterm_sin / fterm_cos : A = unsigned 0.8 delta -> HL = signed 0.8 term
fterm_sin:
                ld      e,a
                ld      a,(vs_sunity)
                or      a
                jr      nz,ft_unity_s
                ld      h,TSLO>>8
                ld      l,e
                ld      e,(hl)
                inc     h
                ld      d,(hl)                  ; DE = lo*mag
                ld      hl,128
                add     hl,de
                ld      l,h
                ld      h,0                     ; HL = (lo*mag + 128) >> 8
                ld      a,(vs_sneg)
                jr      ft_sign
ft_unity_s:
                ld      h,0
                ld      l,e
                ld      a,(vs_sneg)
                jr      ft_sign
fterm_cos:
                ld      e,a
                ld      a,(vs_cunity)
                or      a
                jr      nz,ft_unity_c
                ld      h,TCLO>>8
                ld      l,e
                ld      e,(hl)
                inc     h
                ld      d,(hl)
                ld      hl,128
                add     hl,de
                ld      l,h
                ld      h,0
                ld      a,(vs_cneg)
                jr      ft_sign
ft_unity_c:
                ld      h,0
                ld      l,e
                ld      a,(vs_cneg)
ft_sign:
                or      a
                ret     z
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ret

; ---------------------------------------------------------------------------
; rot_sin / rot_cos : DE = s16 -> A:HL = s24 product with sin / cos.
; The dispatch target, the magnitude and the sign step are patched per frame.
; ---------------------------------------------------------------------------
rot_sin:
rs_k:           jp      rot_sin_tab
rot_sin_tab:
                ld      a,d
                ld      h,TSLO>>8
                ld      l,e
                ld      c,(hl)
                inc     h
                ld      b,(hl)                  ; BC = lo * mag
                dec     h
                ld      l,a
                ld      e,(hl)
                inc     h
                ld      d,(hl)                  ; DE = hi_unsigned * mag
                or      a
                jp      p,rst_pos
                ld      a,d
rsm2:           sub     0                       ; hi was negative: -= mag<<8
                ld      d,a
rst_pos:
                ld      l,c
                ld      a,b
                add     a,e
                ld      h,a
                ld      a,d
                adc     a,0
rsn:            ret
                nop
                nop
rot_sin_unity:
                ld      l,0
                ld      h,e
                ld      a,d                     ; A:HL = d << 8
                jp      rsn

rot_cos:
rc_k:           jp      rot_cos_tab
rot_cos_tab:
                ld      a,d
                ld      h,TCLO>>8
                ld      l,e
                ld      c,(hl)
                inc     h
                ld      b,(hl)
                dec     h
                ld      l,a
                ld      e,(hl)
                inc     h
                ld      d,(hl)
                or      a
                jp      p,rct_pos
                ld      a,d
rcm2:           sub     0
                ld      d,a
rct_pos:
                ld      l,c
                ld      a,b
                add     a,e
                ld      h,a
                ld      a,d
                adc     a,0
rcn:            ret
                nop
                nop
rot_cos_unity:
                ld      l,0
                ld      h,e
                ld      a,d
                jp      rcn

; ---------------------------------------------------------------------------
; s24 helpers used to sum rotation terms.
; ---------------------------------------------------------------------------
push_ahl:
                ld      (vs_acc),hl
                ld      (vs_acc+2),a
                ret
add_pushed:
                ld      de,(vs_acc)
                add     hl,de
                ld      d,a
                ld      a,(vs_acc+2)
                adc     a,d
                ret
; sub_pushed : A:HL = vs_acc - A:HL, replacing a negate-then-add pair.
sub_pushed:
                ex      de,hl
                ld      c,a
                ld      hl,(vs_acc)
                or      a
                sbc     hl,de
                ld      a,(vs_acc+2)
                sbc     a,c
                ret

; ---------------------------------------------------------------------------
; recip : HL = tvy (positive s16 counts) -> D = S, E = M8, A = S
;   idx = tvy >> 4, clamped to the table's 1023 and reduced by right shifts
;   into [2, 255]; S counts those on top of the table's own.  Each case is
;   a shift up read a byte high.
; ---------------------------------------------------------------------------
recip:
                ld      a,h
                cp      $10
                jr      nc,rp_far
                add     hl,hl
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      b,0
                jr      rp_idx
rp_far:         cp      $20
                jr      nc,rp_far2
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      b,1
                jr      rp_idx
rp_far2:        cp      $40
                jr      nc,rp_clamp
                add     hl,hl
                add     hl,hl
                ld      b,2
                jr      rp_idx
rp_clamp:       ld      h,255
                ld      b,2
rp_idx:         ld      a,h
                cp      2
                jr      nc,rp_ok
                ld      a,2
rp_ok:          ld      l,a
                ld      h,RECIP_M8>>8
                ld      e,(hl)
                inc     h
                ld      a,(hl)
                add     a,b
                ld      d,a
                ret


project_y:
                ; A = height delta, E = M8, D = S -> HL = screen y.
                ; The whole input tuple is the key, so an entry survives
                ; frames and positions and a hit is the body's own answer by
                ; construction.  A live reciprocal never has S = 0, so the S
                ; plane doubles as the valid flag and nothing needs clearing.
                ld      (py_h),a
                xor     e
                and     127
                ld      c,a
                or      128
                ld      b,a
                ld      h,VYC_M8>>8
                ld      l,b
                ld      a,e
                cp      (hl)
                jr      nz,py_miss
                ld      h,VYC_S>>8
                ld      l,c
                ld      a,d
                cp      (hl)
                jr      nz,py_miss
                ld      h,VYC_H>>8
                ld      a,(py_h)
                cp      (hl)
                jr      nz,py_miss
                ld      h,VYC_L>>8
                ld      l,b
                ld      a,(hl)
                ld      h,VYC_HI>>8
                ld      l,c
                ld      h,(hl)
                ld      l,a
                ret
py_miss:
                push    bc                      ; the slot, for the writeback
                push    de                      ; (M8, S)
                ld      a,(py_h)
                ld      h,a
                ld      l,e
                call    mul_s8_u8               ; HL = h * M8 (signed)
                ld      a,(py_h)
                ld      d,a
                ld      e,0                     ; DE = h << 8
                add     hl,de                   ; HL = h * m9, fits s16
                pop     de
                ld      b,d
                call    rns_hl                  ; leaves DE alone
                ld      a,HALF_H
                sub     l
                ld      l,a
                ld      a,0
                sbc     a,h
                ld      h,a                     ; HL = sy
                pop     bc
                ld      (py_res),hl
                ld      a,(py_h)
                ld      h,VYC_H>>8
                ld      l,c
                ld      (hl),a
                ld      h,VYC_M8>>8
                ld      l,b
                ld      (hl),e
                ld      h,VYC_L>>8
                ld      a,(py_res)
                ld      (hl),a
                ld      h,VYC_HI>>8
                ld      l,c
                ld      a,(py_res+1)
                ld      (hl),a
                ld      h,VYC_S>>8
                ld      (hl),d                  ; last: it is the valid flag
                ld      hl,(py_res)
                ret

; ---------------------------------------------------------------------------
; project_x : HL = tvx (s16 counts), rc_m8 / rc_s set -> HL = screen x (s16)
;
;   X88 = tvx << 3   (exact 8.8 view x)
;   shrink X88 into s16, decrementing S (or counting a deficit past its floor)
;   B32 = (X88 << 8) + X88 * M8
;   sx  = 128 + rns(B32, S + 8)
; ---------------------------------------------------------------------------
; ---------------------------------------------------------------------------
; project_x : HL = tvx (s16 counts), E = M8, D = S -> HL = screen column,
; saturated to s16 (far off-screen endpoints only need sign and order).
;
;   sx = HALF_W + rns(X88 * m9, S + 8),  X88 = tvx << 3,  m9 = 256 + M8
;
; X88 is first shrunk to s16 - halved with S decremented, to a floor of 1
; beyond which the halvings become a deficit shifted back at the end.  Every
; bit below the eighth of the product is shifted out, so
;       (X88 * m9) >> 8  ==  ((X88 * M8) >> 8) + X88
; which is one signed 8x8 and the high byte of an unsigned one.
; ---------------------------------------------------------------------------
project_x:
                ld      c,0                     ; the deficit
                ld      a,h
                add     a,16
                cp      32
                jr      c,px_k0                 ; tvx fits 13 bits
                ld      a,h
                add     a,32
                cp      64
                jr      c,px_k1
                ld      a,h
                add     a,64
                cp      128
                jr      c,px_k2
                ld      b,3                     ; X88 = tvx
                jr      px_sadj
px_k2:          add     hl,hl
                ld      b,2
                jr      px_sadj
px_k1:          add     hl,hl
                add     hl,hl
                ld      b,1
px_sadj:        ; each halving costs a unit of S down to its floor of one;
                ; the rest are deficit
                ld      a,d
                cp      2
                jr      c,px_sdef
                dec     d
                djnz    px_sadj
                jr      px_mul
px_sdef:        ld      c,b
                jr      px_mul
px_k0:          add     hl,hl
                add     hl,hl
                add     hl,hl
px_mul:         ; HL = X88, E = M8, D = S, C = deficit
                push    de
                push    bc
                push    hl
                ld      a,e
                ld      l,a                     ; H = vx (s8), L = M8
                push    af
                call    mul_s8_u8               ; HL = vx * M8
                pop     af
                pop     de                      ; DE = X88
                push    de
                push    hl
                ld      h,e                     ; H = frac
                ld      l,a
                MUL_U8_BODY                     ; HL = frac * M8
                ld      a,h
                pop     hl                      ; vx * M8
                pop     de                      ; X88
                ld      c,a                     ; the fraction's carry byte
                ld      a,h
                rla
                sbc     a,a
                ld      b,a
                ld      a,d
                rla
                sbc     a,a
                add     hl,de
                adc     a,b                     ; A:HL = vx*M8 + X88
                ld      e,c
                ld      d,0
                add     hl,de
                adc     a,0                     ; A:HL = (X88 * m9) >> 8
                pop     bc                      ; C = deficit
                pop     de                      ; D = S
                ld      b,d
                ld      d,a
                ld      a,c
                or      a
                jr      nz,px_defpath
                ld      a,d
                call    rns_ahl
                ld      de,HALF_W
                add     hl,de
                adc     a,0
                jp      sat_ahl
px_defpath:
                ; the shrink's truncation is the only rounding here: the
                ; product, whole, shifted back up by all but one
                dec     a
                ld      b,a
                ld      a,d
                jr      z,px_dfdone
px_dfsh:        add     hl,hl
                rla
                djnz    px_dfsh
px_dfdone:
                ld      de,HALF_W
                add     hl,de
                adc     a,0
                jp      sat_ahl


sat_ahl:
                ld      d,a
                ld      a,h
                rla
                sbc     a,a
                cp      d
                ret     z                       ; already fits
                bit     7,d
                jr      nz,sat_neg
                ld      hl,$7fff
                ret
sat_neg:
                ld      hl,$8000
                ret

; ---------------------------------------------------------------------------
vcache_wipe:
                ld      hl,VCACHE_BASE
                ld      de,VCACHE_ENT
                ld      bc,NVERTS
vw_loop:
                ld      (hl),0
                add     hl,de
                dec     bc
                ld      a,b
                or      c
                jr      nz,vw_loop
                ret
