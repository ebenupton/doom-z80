; ===========================================================================
; walk4.z80 : the BSP walk, in bank 4 with its node records, the BBC port's
; bounding-box planes and a transcription of its angle-space box check
; (ang/bca.s: box_classify, the corner arms, the corner-phi memo, lf_ns,
; the VATOX tail).  render_frame pages this bank in for the whole walk;
; walk_ss pages the geometry in only for a subsector's segs.  The span
; pool, the counters, hg_u8 and set_page are in the always-mapped bank 2.
; ===========================================================================

; ---------------------------------------------------------------------------
; walk_frame : the per-frame presets of the check (view.s) - the viewer as
; s16 with its high byte offset-binned like the bounds, and the fine view
; angle ab*16 + 512 + EPSILON as a 12-bit pair - then the walk from the root.
; ---------------------------------------------------------------------------
walk_frame:
                ld      hl,(pl_x)
                ld      a,h
                xor     $80
                ld      h,a
                ld      (bv_pxs+1),hl           ; bbox_visible's immediates
                ld      hl,(pl_y)
                ld      a,h
                xor     $80
                ld      h,a
                ld      (bv_pys+1),hl
                ld      a,(pl_ang)
                ld      b,a
                rrca
                rrca
                rrca
                rrca
                and     $0F
                add     a,2                     ; the FOV window's bias
                and     $0F
                ld      (bca_afn+1),a
                ld      a,b
                rlca
                rlca
                rlca
                rlca
                and     $F0
                or      EPSILON_F               ; the first corner's widening
                ld      (bca_afn),a
                ld      (walk_sp),sp            ; the unwind's target
                ld      hl,(pl_wx)              ; the viewer as immediates at
                ld      (pos_wx1+1),hl          ;  point_on_side's sites
                ld      (pos_wx2+1),hl
                ld      hl,(pl_wy)
                ld      (pos_wy1+1),hl
                ld      (pos_wy2+1),hl
                ld      hl,(bsp_root)
                jp      walk

; ---------------------------------------------------------------------------
; walk : HL = child id.  Bit 15 marks a subsector.
; ---------------------------------------------------------------------------
walk:
                ld      a,(sp_head)
                or      a
                ret     z                       ; screen fully occluded
                bit     7,h
                jp      nz,walk_ss
                ; L = the node id: the fields are planes, no record address
                push    hl
                call    point_on_side           ; A = the side
                pop     bc                      ; C = the id
                ld      b,c                     ; B = the id
                ld      c,a                     ; C = the near side
                push    bc
                ; BBC 5e9b019: descend the NEAR child UNCONDITIONALLY, as
                ; r_bsp.c does.  It is the half-space the viewer stands in, so
                ; the box check rejected it only ~5% of the time while costing
                ; a bbox_visible call on every node.  Over-descent draws
                ; nothing - an invisible subtree's segs are rejected one by one
                ; (the far child still gets the check).  Pixels unchanged.
                ld      l,b
                or      a
                jr      nz,wk_n1
                ld      h,NP_C0L
                jr      wk_go
wk_n1:          ld      h,NP_C1L
wk_go:          ld      a,(hl)
                inc     h
                ld      h,(hl)
                ld      l,a                     ; HL = the near child
                call    walk
wk_back:
                ld      a,(sp_head)
                or      a
                jr      z,walk_done
                pop     bc                      ; B = the id, C = the near side
                ld      a,c
                xor     1
                jr      walk_child              ; the far child, if its box shows
walk_done:      ; the screen is full: the BBC's bsp_done_full resets the
                ; stack to the root's frame, so every pending far-side judge
                ; is skipped and its bit stays as it was
                ld      sp,(walk_sp)
                ret

; walk_child : A = the side, B = the node id.  The far child's box is
; checked against the view and the span list; a no-show prunes it.
; BBC 4cab6b5 measured the static always-descend policy (ADESC, baked into
; ND_POL) a net loss - it over-descended into subtrees that drew nothing -
; and it is a bigger loss on the Z80, where bbox_visible is dearer; retired.
walk_child:                                     ; A = the side, B = the node
                ld      c,a                     ; (the side rides C)
                ; the dynamic always-descend bit (BBC 4cab6b5): one bit per
                ; (node, side) says the last descent here drew something, so
                ; the box check is skipped and the far child taken on faith;
                ; a judge after every descent sets or clears it from the
                ; emitted-segment counter.  Over-descent costs one wasted
                ; descent; the bits carry across frames.
                ld      l,b
                ld      h,ND_POL>>8
                ld      a,(hl)
                dec     c
                inc     c
                jr      nz,wc_s1
                rlca                            ; carry = side 0's bit ($80)
                jr      c,wc_spec
                jr      wc_check
wc_s1:          rlca
                rlca                            ; carry = side 1's bit ($40)
                jr      c,wc_spec
wc_check:       push    bc
                ld      a,c                     ; the side
                call    bbox_visible            ; carry when a column may show
                pop     bc
                ret     nc
wc_spec:        ld      a,(adyn_ctr)            ; the judge's before-sample
                push    af
                push    bc
                call    wc_descend
                pop     bc
                pop     af
                ld      e,$80                   ; the side's bit
                dec     c
                inc     c
                jr      z,wc_mask
                ld      e,$40
wc_mask:        ld      hl,adyn_ctr
                cp      (hl)                    ; unchanged: nothing was drawn
                ld      l,b
                ld      h,ND_POL>>8
                ld      a,e
                jr      z,wc_clear
                or      (hl)
                ld      (hl),a
                ret
wc_clear:       cpl
                and     (hl)
                ld      (hl),a
                ret
wc_descend:     ld      a,c
                ld      l,b
                or      a
                jr      nz,wc_c1
                ld      h,NP_C0L
                jr      wc_go2
wc_c1:          ld      h,NP_C1L
wc_go2:         ld      a,(hl)
                inc     h
                ld      h,(hl)
                ld      l,a
                jp      walk

; ---------------------------------------------------------------------------
; walk_ss : HL = subsector id with bit 15 set.  Static objects FIRST
; (subsector.s: an object inside a convex cell stands in front of every
; wall of that cell), from the bank 2 copy of the has-objects bitmap; then
; the geometry bank for the segs.
; ---------------------------------------------------------------------------
walk_ss:
                res     7,h
                ld      a,l
                rrca
                rrca
                rrca
                and     31
                ld      e,a
                ld      d,0
                push    hl
                ld      hl,OBJ_ANYB
                add     hl,de
                ld      c,(hl)
                pop     hl
                ld      a,l
                and     7
                add     a,ws_bits & 255
                ld      e,a
                ld      d,ws_bits >> 8
                ld      a,(de)
                and     c
                jr      z,ws_noobj
                push    hl
                ld      a,l
                call    obj_subsector
                pop     hl
ws_noobj:
                jp      walk_ss_segs
ws_bits:        DB      1,2,4,8,16,32,64,128
                ASSERT  (ws_bits & 255) <= 248, "ws_bits crosses a page"            ; main RAM: it pages the geometry
                                                ; in, and this bank back before
                                                ; returning here (a page flip
                                                ; must come from code that stays
                                                ; mapped)

; fe_descend : HL = the root -> HL = the subsector under the player
; (find_eye_height's descent, here with the records)
fe_descend:
                bit     7,h
                ret     nz
                push    hl                      ; L = the node id
                call    point_on_side           ; A = the side
                pop     hl
                or      a
                jr      nz,fe_c1
                ld      h,NP_C0L
                jr      fe_go
fe_c1:          ld      h,NP_C1L
fe_go:          ld      a,(hl)
                inc     h
                ld      h,(hl)
                ld      l,a
                jr      fe_descend

; ---------------------------------------------------------------------------
; point_on_side : DOOM's R_PointOnSide against the node at bsp_node.
; Returns A = 0 (front) or 1 (back).
; ---------------------------------------------------------------------------
point_on_side:
                ; DOOM's R_PointOnSide on the gcd-reduced partition direction.
                ; L = the node id (the fields are planes: H = the page).  The
                ; form is tested first, as the BBC port's NODE_SETUP_DISPATCH:
                ; an axis partition (73% of nodes) needs one delta and no
                ; product, a diagonal one with opposite product signs none.
                ; Returns A = the side; clobbers BC, DE, HL.
                ld      h,NP_RDX
                ld      a,(hl)
                or      a
                jr      nz,pos_notx0
                ; a north-south partition: the side is dx's, by rdy's sign
                ld      h,NP_RDY
                ld      c,(hl)                  ; C = rdy
                ld      h,NP_NXL
                ld      e,(hl)
                inc     h
                ld      d,(hl)                  ; nx
pos_wx1:        ld      hl,0                    ; SMC: pl_wx (walk_frame)
                or      a
                sbc     hl,de                   ; dx
                ld      a,h
                or      a
                jp      m,pos_dxle
                or      l
                jr      z,pos_dxle
                ld      a,c                     ; dx > 0: side = rdy < 0
                rla
                sbc     a,a
                and     1
                ret
pos_dxle:
                ld      a,c                     ; dx <= 0: side = rdy != 0 (rdy is
                or      a                       ; never negative with rdx zero)
                ret     z
                ld      a,1
                ret
pos_notx0:
                ld      b,a                     ; B = rdx
                ld      h,NP_RDY
                ld      a,(hl)
                or      a
                jr      nz,pos_general
                ; an east-west partition
                ld      h,NP_NYL
                ld      e,(hl)
                inc     h
                ld      d,(hl)                  ; ny
pos_wy1:        ld      hl,0                    ; SMC: pl_wy
                or      a
                sbc     hl,de                   ; dy
                ld      a,h
                or      a
                jp      m,pos_dyle
                or      l
                jr      z,pos_dyle
                ld      a,b                     ; dy > 0: side = rdx > 0
                rla
                sbc     a,a
                and     1
                xor     1
                ret
pos_dyle:
                ld      a,b                     ; dy <= 0: side = rdx < 0
                rla
                sbc     a,a
                and     1
                ret
pos_general:
                ld      c,a                     ; C = rdy
                ld      h,NP_NXL
                ld      e,(hl)
                inc     h
                ld      d,(hl)                  ; nx
                push    hl                      ; (the id)
pos_wx2:        ld      hl,0                    ; SMC: pl_wx
                or      a
                sbc     hl,de
                ex      (sp),hl                 ; dx down, the id up
                ld      h,NP_NYL
                ld      e,(hl)
                inc     h
                ld      d,(hl)                  ; ny
pos_wy2:        ld      hl,0                    ; SMC: pl_wy
                or      a
                sbc     hl,de                   ; HL = dy
                pop     de                      ; DE = dx
                ; the sign shortcut (the BBC port's node_side_general): with
                ; both deltas nonzero and P1 = rdy*dx, P2 = rdx*dy of opposite
                ; signs, D = P1 - P2 has P1's sign - no product
                ld      a,d
                or      e
                jr      z,pos_mul
                ld      a,h
                or      l
                jr      z,pos_mul
                ld      a,d
                xor     c                       ; b7 = sign(P1)
                ld      (pos_l),a
                xor     h
                xor     b                       ; b7 set = opposite signs
                jp      p,pos_mul
                ld      a,(pos_l)               ; side = P1 < 0
                rla
                sbc     a,a
                and     1
                ret
pos_mul:
                push    hl                      ; dy
                push    bc
                ld      a,c
                call    mul_s16_u8_signed       ; A:HL = rdy * dx
                ld      (pos_l),hl
                ld      (pos_l+2),a
                pop     bc
                pop     de
                ld      a,b
                call    mul_s16_u8_signed       ; A:HL = rdx * dy
                ld      c,a
                ld      de,(pos_l)
                ex      de,hl
                or      a
                sbc     hl,de
                ld      a,(pos_l+2)
                sbc     a,c
                rla                             ; rdy*dx - rdx*dy < 0: side 1
                sbc     a,a
                and     1
                ret


; ===========================================================================
; bbox_visible : A = the side (0 = the right child's box, 1 = the left's),
; B = the node id -> carry when the box subtends visible columns AND the
; span list has a gap in them.  The BBC port's box_classify: the viewer is
; placed against the box by two 16-bit compares per axis (hi first, early
; out), and each of the nine outside classes has its own arm naming the two
; silhouette corners and their sign classes; a corner's view-relative fine
; angle r comes from corner_phi (the memo, else lf_ns), and the tail turns
; the pair into columns through VATOX.  Register-resident: the deltas ride
; in DE (dx) and BC (dy), the memo slot in IXL, the octant in IXH.
; ===========================================================================
; The four bound deltas from the viewer (the biases cancel) are formed
; first - the Beeb's hi-then-lo compares are exactly their signs - and the
; arms take their corner's pair from them.
                ; ZDELTA/ZDELTAY : one box edge less the viewer, s16, into a
                ; register pair (the low byte's borrow feeds the high byte:
                ; nothing between may touch the carry)
                MACRO   ZDELTA_IY s, pg
                ld      h,(pg)+(s)
                ld      a,(hl)
                sub     e
                ld      iyl,a
                inc     h
                inc     h
                ld      a,(hl)
                sbc     a,d
                ld      iyh,a
                ENDM
                MACRO   ZDELTA_IX s, pg
                ld      h,(pg)+(s)
                ld      a,(hl)
                sub     e
                ld      ixl,a
                inc     h
                inc     h
                ld      a,(hl)
                sbc     a,d
                ld      ixh,a
                ENDM
                MACRO   ZDELTAY_DE s, pg        ; (DE = px is spent by now)
                ld      h,(pg)+(s)
                ld      a,(hl)
                sub     c
                ld      e,a
                inc     h
                inc     h
                ld      a,(hl)
                sbc     a,b
                ld      d,a
                ENDM
                MACRO   ZDELTAY_BC s, pg        ; into BC itself: the low byte
                ld      h,(pg)+(s)              ; waits on the stack
                ld      a,(hl)
                sub     c
                push    af
                inc     h
                inc     h
                ld      a,(hl)
                sbc     a,b
                ld      b,a
                pop     hl
                ld      c,h
                ENDM
                ; CLASSIFY : one side's tree, from the deltas' signs.
                ; L = the node, DE = pxs, BC = pys.  The deltas ride the
                ; registers: L - px in IY, R - px in IX, T - py in DE,
                ; B - py in BC; each arm gets its pair in DE (x) and BC (y).
                MACRO   CLASSIFY s
                ZDELTA_IY  s, BBP_L_LO
                ZDELTA_IX  s, BBP_R_LO
                ZDELTAY_DE s, BBP_T_LO
                ZDELTAY_BC s, BBP_B_LO
                ld      a,iyh
                or      a
                jp      p,.yL                   ; L - px >= 0: left of the box
                ld      a,ixh
                or      a
                jp      p,.yM                   ; R - px >= 0: within its x
.yR:            ld      a,d
                or      a
                jp      m,.yRtop                ; T - py < 0
                or      e
                jr      z,.yRtop                ; T - py = 0: at or above the top
                ld      a,b
                or      a
                jp      m,.yRmid                ; B - py < 0
                or      c
                jr      z,.yRmid                ; B - py = 0: within its y
.yRbot:
                ; the leaf arms (bd_l, bd_b) then (bd_r, bd_t)
                push    ix
                push    de
                push    iy
                pop     de
                call    corner_phi_np
                ld      (bca_p1),hl
                pop     bc
                pop     de
                call    corner_phi_np
                jp      bca_tail
.yRtop:
                ; the leaf arms (bd_r, bd_b) then (bd_l, bd_t)
                push    iy
                push    de
                push    ix
                pop     de
                call    corner_phi_nn
                ld      (bca_p1),hl
                pop     bc
                pop     de
                call    corner_phi_nn
                jp      bca_tail
.yRmid:
                ; the leaf arms (bd_r, bd_b) then (bd_r, bd_t)
                push    ix
                push    de
                push    ix
                pop     de
                call    corner_phi_nn
                ld      (bca_p1),hl
                pop     bc
                pop     de
                call    corner_phi_np
                jp      bca_tail
.yL:            ld      a,d
                or      a
                jp      m,.yLtop
                or      e
                jr      z,.yLtop
                ld      a,b
                or      a
                jp      m,.yLmid
                or      c
                jr      z,.yLmid
.yLbot:
                ; the leaf arms (bd_l, bd_t) then (bd_r, bd_b)
                push    ix
                push    bc
                ld      b,d
                ld      c,e
                push    iy
                pop     de
                call    corner_phi_pp
                ld      (bca_p1),hl
                pop     bc
                pop     de
                call    corner_phi_pp
                jp      bca_tail
.yLtop:
                ; the leaf arms (bd_r, bd_t) then (bd_l, bd_b)
                push    iy
                push    bc
                ld      b,d
                ld      c,e
                push    ix
                pop     de
                call    corner_phi_pn
                ld      (bca_p1),hl
                pop     bc
                pop     de
                call    corner_phi_pn
                jp      bca_tail
.yLmid:
                ; the leaf arms (bd_l, bd_t) then (bd_l, bd_b)
                push    iy
                push    bc
                ld      b,d
                ld      c,e
                push    iy
                pop     de
                call    corner_phi_pp
                ld      (bca_p1),hl
                pop     bc
                pop     de
                call    corner_phi_pn
                jp      bca_tail
.yM:            ld      a,d
                or      a
                jp      m,.yMtop
                or      e
                jr      z,.yMtop
                ld      a,b
                or      a
                jp      m,full_vis              ; inside the box
                or      c
                jp      z,full_vis
.yMbot:
                ; the leaf arms (bd_l, bd_b) then (bd_r, bd_b)
                push    ix
                push    bc
                push    iy
                pop     de
                call    corner_phi_np
                ld      (bca_p1),hl
                pop     bc
                pop     de
                call    corner_phi_pp
                jp      bca_tail
.yMtop:
                ; the leaf arms (bd_r, bd_t) then (bd_l, bd_t)
                push    iy
                push    de
                ld      b,d
                ld      c,e
                push    ix
                pop     de
                call    corner_phi_pn
                ld      (bca_p1),hl
                pop     bc
                pop     de
                call    corner_phi_nn
                jp      bca_tail
                ENDM

bbox_visible:                                   ; A = the side, B = the node
                ld      l,b
bv_pxs:         ld      de,0                    ; SMC: the binned viewer
bv_pys:         ld      bc,0                    ;  (walk_frame)
                or      a
                jp      nz,bv_side1
                CLASSIFY 0
bv_side1:       CLASSIFY 1

; ---------------------------------------------------------------------------
; corner_phi_XX : DE = dx, BC = dy -> HL = r = (afn - psi) & $0FFF, for the
; sign class XX (x then y: p = the corner is at or beyond the viewer's
; coordinate, n = short of it).  The memo: 128 slots on (dy ^ dx) & $7F,
; the key as (lo, hi) pairs of dx and dy, the value psi; a miss records the
; key, folds the signs into the octant base and runs lf_ns.
; ---------------------------------------------------------------------------
                ; The corner-phi memo is retired (BBC b872178: it cost more
                ; than it saved on both machines - on the Z80 it hit 22% of
                ; 39 probes a frame): an entry folds the signs into the
                ; octant base and runs lf_ns.
                MACRO   CPM_ENTRY name, negx, negy, obase
name:
                ld      ixh,obase
                ld      a,d
                or      e
                jp      z,ns_dx0
                IF      negx
                xor     a
                sub     e
                ld      e,a
                sbc     a,a
                sub     d
                ld      d,a
                ENDIF
                IF      negy
                xor     a
                sub     c
                ld      c,a
                sbc     a,a
                sub     b
                ld      b,a
                ENDIF
                ld      a,b
                or      c
                jp      z,ns_dy0
                jp      lf_ns
                ENDM
                CPM_ENTRY corner_phi_nn, 1, 1, 6
                CPM_ENTRY corner_phi_pn, 0, 1, 2
                CPM_ENTRY corner_phi_np, 1, 0, 4
                CPM_ENTRY corner_phi_pp, 0, 0, 0

; lf_ns : DE = |dx|, BC = |dy| (never both zero), IXH = the octant base
; index, IXL = the memo slot -> DE = psi (stored), HL = r.
; k = L8(|dy|) - L8(|dx|) in log2/32 units, its sign the octant's swap;
; wide magnitudes go through L8 of the value >> 3 (half-step
; interpolated) plus 96.
lf_ns:
                ld      a,d
                or      b
                jr      nz,ns_wide
                ld      h,L8_PG
                ld      l,c
                ld      a,(hl)
                ld      l,e
                sub     (hl)
                jr      nc,ns_khave
ns_neg:         neg
                inc     ixh                     ; the swapped octant
ns_khave:       ld      l,a
                ld      h,AE_LO_PG
                ld      e,(hl)
                inc     h
                ld      d,(hl)                  ; DE = ta
                ld      a,ixh
                add     a,PA_OCT & 255
                ld      l,a
                ld      h,PA_OCT >> 8
                ld      a,(hl)                  ; base hi | sign << 7
                bit     7,a
                jr      nz,khave_sub
                add     a,d
                ld      d,a                     ; psi = base + ta
mask_done:
cp_havepsi:     ld      hl,(bca_afn)
                or      a
                sbc     hl,de
                ld      a,h
                and     $0F
                ld      h,a                     ; HL = r
                ret
khave_sub:      and     $0F
                ld      h,a
                ld      l,0
                or      a
                sbc     hl,de                   ; psi = base - ta
                ld      a,h
                and     $0F
                ld      d,a
                ld      e,l
                jr      mask_done
ns_dy0:         inc     ixh
ns_dx0:         ld      a,ixh                   ; ta = 0: psi = the base
                add     a,PA_OCT & 255
                ld      l,a
                ld      h,PA_OCT >> 8
                ld      a,(hl)
                and     $0F
                ld      d,a
                ld      e,0
                jr      mask_done
ns_wide:        ld      a,d
                or      a
                jr      nz,ns_x16
                ; |dx| a byte, |dy| wide: k = L(dy >> 3) + 96 - L8[dx]
                ld      h,b
                ld      l,c
                call    lf_wide
                ld      l,e
                ld      h,L8_PG
                sub     (hl)
                jr      nc,ns_pos96
                add     a,96
                jp      ns_khave
ns_pos96:       add     a,96
                jp      nc,ns_khave
                ld      a,255
                jp      ns_khave
ns_x16:         ld      a,b
                or      a
                jr      nz,ns_x16y16
                ; |dx| wide, |dy| a byte: the swapped octant
                inc     ixh
                ex      de,hl
                call    lf_wide
                ld      l,c
                ld      h,L8_PG
                sub     (hl)
                jr      nc,ns_pos96
                add     a,96
                jp      ns_khave
ns_x16y16:      ex      de,hl
                call    lf_wide
                ld      e,a                     ; L(dx)
                ld      h,b
                ld      l,c
                call    lf_wide
                sub     e                       ; L(dy) - L(dx)
                jp      nc,ns_khave
                jp      ns_neg
; lf_wide : HL = a magnitude >= 256 -> A = L8 of (HL >> 3), the odd half
; steps averaging the two neighbouring entries (index 255 has none).  DE
; and BC kept.
lf_wide:
                srl     h
                rr      l
                srl     h
                rr      l
                srl     h
                rr      l                       ; carry = the half step
                ld      h,L8_PG
                jr      nc,lw_flat
                ld      a,l
                inc     a
                jr      z,lw_flat
                ld      a,(hl)
                inc     l
                scf
                adc     a,(hl)                  ; a + b + 1, 9 bits
                rra                             ; >> 1
                ret
lw_flat:        ld      a,(hl)
                ret

; ---------------------------------------------------------------------------
; bca_tail : HL = the second corner's r, (bca_p1) = the first's -> the
; columns [ilo, ihi) through VATOX (r in [0, 1024) is inside the window;
; the first corner is widened by 2*EPSILON here, having carried +EPSILON in
; afn), then hg_u8 on them: carry = a gap.
; ---------------------------------------------------------------------------
bca_tail:
                ld      a,h
                cp      4
                jr      nc,ct_r2out
                add     a,VATOX_PG
                ld      h,a
                ld      a,(hl)
                inc     a
                jr      z,ct_ih_cl
ct_ih:          ld      c,a                     ; ihi
ct_left:        ld      hl,(bca_p1)
                ld      de,2*EPSILON_F
                or      a
                sbc     hl,de
                ld      a,h
                and     $0F
                cp      4
                jr      nc,ct_r1out_r2f
lk_left:        add     a,VATOX_PG
                ld      h,a
                ld      a,(hl)
                sub     1
                jr      c,ct_il_z
ct_il:          ld      b,a                     ; ilo
                jp      hg_u8
ct_ih_cl:       ld      a,255
                jr      ct_ih
ct_il_z:        ld      b,0
                jp      hg_u8
ct_r1out_r2f:   ld      b,0
                jp      hg_u8
ct_r2out:       ld      e,0
                cp      10
                jr      c,ct_r2have
                inc     e                       ; r2 in the wrapped left arc
ct_r2have:      push    de
                ld      hl,(bca_p1)
                ld      de,2*EPSILON_F
                or      a
                sbc     hl,de
                pop     de
                ld      a,h
                and     $0F
                cp      4
                jr      c,ct_f_r2out            ; r1 inside, r2 beyond the right
                cp      10
                jr      c,cull                  ; both beyond: culled
                ld      a,e
                or      a
                jr      z,full_vis              ; r1 left of, r2 right of: all
cull:           or      a
                ret
full_vis:       ld      b,0
                ld      c,255
                jp      hg_u8
ct_f_r2out:     ld      c,255
                jr      lk_left
