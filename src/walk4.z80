; ===========================================================================
; walk4.z80 : the BSP walk, in bank 4 with its node records, the BBC port's
; bounding-box planes and a transcription of its angle-space box check
; (ang/bca.s: box_classify, the corner arms, the corner-phi memo, lf_ns,
; the VATOX tail).  render_frame pages this bank in for the whole walk;
; walk_ss pages the geometry in only for a subsector's segs.  The span
; pool, the counters, hg_u8 and set_page are in the always-mapped bank 2.
; ===========================================================================

; ---------------------------------------------------------------------------
; walk_frame : the per-frame presets of the check (view.s) - the viewer as
; s16 with its high byte offset-binned like the bounds, and the fine view
; angle ab*16 + 512 + EPSILON as a 12-bit pair - then the walk from the root.
; ---------------------------------------------------------------------------
walk_frame:
                ld      hl,(pl_x)
                ld      a,h
                xor     $80
                ld      h,a
                ld      (bca_pxs),hl
                ld      hl,(pl_y)
                ld      a,h
                xor     $80
                ld      h,a
                ld      (bca_pys),hl
                ld      a,(pl_ang)
                ld      b,a
                rrca
                rrca
                rrca
                rrca
                and     $0F
                add     a,2                     ; the FOV window's bias
                and     $0F
                ld      (bca_afn+1),a
                ld      a,b
                rlca
                rlca
                rlca
                rlca
                and     $F0
                or      EPSILON_F               ; the first corner's widening
                ld      (bca_afn),a
                ld      hl,(bsp_root)
                jp      walk

; ---------------------------------------------------------------------------
; walk : HL = child id.  Bit 15 marks a subsector.
; ---------------------------------------------------------------------------
walk:
                ld      a,(sp_head)
                ld      c,a
                ld      a,(sp_head+1)
                or      c
                ret     z                       ; screen fully occluded
                bit     7,h
                jp      nz,walk_ss
                ld      a,(frame_nodes)
                inc     a
                ld      (frame_nodes),a
                ld      b,l                     ; B = the node id (a byte)
                add     hl,hl
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,hl
                add     hl,de                   ; * ND_SIZE
                ld      de,NODES4
                add     hl,de
                ld      (bsp_node),hl
                push    bc
                call    point_on_side           ; A = the side, IX = the node
                pop     bc
                ld      c,a
                push    ix
                push    bc                      ; B = id, C = the near side
                ; BBC 5e9b019: descend the NEAR child UNCONDITIONALLY, as
                ; r_bsp.c does.  It is the half-space the viewer stands in, so
                ; the box check rejected it only ~5% of the time while costing
                ; a bbox_visible call on every node.  Over-descent draws
                ; nothing - an invisible subtree's segs are rejected one by one
                ; (the far child still gets the check).  Pixels unchanged.
                ld      a,c
                ld      (bsp_side),a
                or      a
                jr      nz,wk_n1
                ld      l,(ix+ND_CHILD0)
                ld      h,(ix+ND_CHILD0+1)
                jr      wk_go
wk_n1:          ld      l,(ix+ND_CHILD1)
                ld      h,(ix+ND_CHILD1+1)
wk_go:          call    walk
wk_back:
                ld      a,(sp_head)
                ld      c,a
                ld      a,(sp_head+1)
                or      c
                jr      z,walk_pop
                pop     bc
                pop     ix
                ld      (bsp_node),ix
                ld      a,c
                xor     1
                jr      walk_child              ; the far child, if its box shows
walk_pop:
                pop     bc
                pop     ix
                ret

; walk_child : A = the side, B = the node id, IX = the node.  The far child's
; box is checked against the view and the span list; a no-show prunes it.
; BBC 4cab6b5 measured the static always-descend policy (ADESC, baked into
; ND_POL) a net loss - it over-descended into subtrees that drew nothing -
; and it is a bigger loss on the Z80, where bbox_visible is dearer; retired.
walk_child:
                ld      (bsp_side),a
                push    ix
                call    bbox_visible            ; carry when a column may show
                pop     ix
                ret     nc
wc_go:          ld      a,(bsp_side)
                or      a
                jr      nz,wc_c1
                ld      l,(ix+ND_CHILD0)
                ld      h,(ix+ND_CHILD0+1)
                jp      walk
wc_c1:          ld      l,(ix+ND_CHILD1)
                ld      h,(ix+ND_CHILD1+1)
                jp      walk

; ---------------------------------------------------------------------------
; walk_ss : HL = subsector id with bit 15 set.  Static objects FIRST
; (subsector.s: an object inside a convex cell stands in front of every
; wall of that cell), from the bank 2 copy of the has-objects bitmap; then
; the geometry bank for the segs.
; ---------------------------------------------------------------------------
walk_ss:
                res     7,h
                ld      a,l
                rrca
                rrca
                rrca
                and     31
                ld      e,a
                ld      d,0
                push    hl
                ld      hl,OBJ_ANYB
                add     hl,de
                ld      c,(hl)
                pop     hl
                ld      a,l
                and     7
                inc     a
                ld      b,a
                ld      a,c
ws_bit:         rrca
                djnz    ws_bit
                jr      nc,ws_noobj
                push    hl
                ld      a,l
                call    obj_subsector
                pop     hl
ws_noobj:
                jp      walk_ss_segs            ; main RAM: it pages the geometry
                                                ; in, and this bank back before
                                                ; returning here (a page flip
                                                ; must come from code that stays
                                                ; mapped)

; fe_descend : HL = the root -> HL = the subsector under the player
; (find_eye_height's descent, here with the records)
fe_descend:
                bit     7,h
                ret     nz
                add     hl,hl
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,hl
                add     hl,de
                ld      de,NODES4
                add     hl,de
                ld      (bsp_node),hl
                call    point_on_side
                ld      hl,(bsp_node)
                ld      de,ND_CHILD0
                or      a
                jr      z,fe_c0
                ld      de,ND_CHILD1
fe_c0:          add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ex      de,hl
                jr      fe_descend

; ---------------------------------------------------------------------------
; point_on_side : DOOM's R_PointOnSide against the node at bsp_node.
; Returns A = 0 (front) or 1 (back).
; ---------------------------------------------------------------------------
point_on_side:
                ; DOOM's R_PointOnSide on the gcd-reduced partition
                ; direction; IX = the node, dx and dy in registers
                ld      ix,(bsp_node)
                ld      e,(ix+0)
                ld      d,(ix+1)
                ld      hl,(pl_wx)
                or      a
                sbc     hl,de                   ; dx
                push    hl
                ld      e,(ix+2)
                ld      d,(ix+3)
                ld      hl,(pl_wy)
                or      a
                sbc     hl,de                   ; dy
                ld      b,(ix+4)                ; rdx
                ld      c,(ix+5)                ; rdy
                pop     de                      ; DE = dx, HL = dy
                ld      a,b
                or      a
                jr      nz,pos_notx0
                ; a north-south partition: the side is dx's, by rdy's sign
                ld      a,d
                or      a
                jp      m,pos_dxle
                or      e
                jr      z,pos_dxle
                ld      a,c                     ; dx > 0: side = rdy < 0
                rla
                sbc     a,a
                and     1
                ret
pos_dxle:
                ld      a,c                     ; dx <= 0: side = rdy != 0 (rdy is
                or      a                       ; never negative with rdx zero)
                ret     z
                ld      a,1
                ret
pos_notx0:
                ld      a,c
                or      a
                jr      nz,pos_general
                ; an east-west partition
                ld      a,h
                or      a
                jp      m,pos_dyle
                or      l
                jr      z,pos_dyle
                ld      a,b                     ; dy > 0: side = rdx > 0
                rla
                sbc     a,a
                and     1
                xor     1
                ret
pos_dyle:
                ld      a,b                     ; dy <= 0: side = rdx < 0
                rla
                sbc     a,a
                and     1
                ret
pos_general:
                push    hl                      ; dy
                push    bc
                ld      a,c
                call    mul_s16_u8_signed       ; A:HL = rdy * dx
                ld      (pos_l),hl
                ld      (pos_l+2),a
                pop     bc
                pop     de
                ld      a,b
                call    mul_s16_u8_signed       ; A:HL = rdx * dy
                ld      c,a
                ld      de,(pos_l)
                ex      de,hl
                or      a
                sbc     hl,de
                ld      a,(pos_l+2)
                sbc     a,c
                rla                             ; rdy*dx - rdx*dy < 0: side 1
                sbc     a,a
                and     1
                ret



; ===========================================================================
; bbox_visible : A = the side (0 = the right child's box, 1 = the left's),
; B = the node id -> carry when the box subtends visible columns AND the
; span list has a gap in them.  The BBC port's box_classify: the viewer is
; placed against the box by two 16-bit compares per axis (hi first, early
; out), and each of the nine outside classes has its own arm naming the two
; silhouette corners and their sign classes; a corner's view-relative fine
; angle r comes from corner_phi (the memo, else lf_ns), and the tail turns
; the pair into columns through VATOX.  Register-resident: the deltas ride
; in DE (dx) and BC (dy), the memo slot in IXL, the octant in IXH.
; ===========================================================================
; The four bound deltas from the viewer (the biases cancel) are formed
; first - the Beeb's hi-then-lo compares are exactly their signs - and the
; arms take their corner's pair from them.
                MACRO   ZDELTA s, pg, var
                ld      h,(pg)+(s)
                ld      a,(hl)
                sub     e
                ld      (var),a
                inc     h
                inc     h
                ld      a,(hl)
                sbc     a,d
                ld      (var+1),a
                ENDM
                MACRO   ZDELTAY s, pg, var
                ld      h,(pg)+(s)
                ld      a,(hl)
                sub     c
                ld      (var),a
                inc     h
                inc     h
                ld      a,(hl)
                sbc     a,b
                ld      (var+1),a
                ENDM
                ; the leaf arms: the two silhouette corners (x, y deltas)
                ; and their sign classes
                MACRO   ZARM x1, y1, x2, y2, e1, e2
                ld      de,(x1)
                ld      bc,(y1)
                call    e1
                ld      (bca_p1),hl
                ld      de,(x2)
                ld      bc,(y2)
                call    e2
                jp      bca_tail
                ENDM
                ; CLASSIFY : one side's tree, from the deltas' signs.
                ; L = the node, DE = pxs, BC = pys
                MACRO   CLASSIFY s
                ZDELTA  s, BBP_L_LO, bd_l
                ZDELTA  s, BBP_R_LO, bd_r
                ZDELTAY s, BBP_T_LO, bd_t
                ZDELTAY s, BBP_B_LO, bd_b
                ld      a,(bd_l+1)
                or      a
                jp      p,.yL                   ; L - px >= 0: left of the box
                ld      a,(bd_r+1)
                or      a
                jp      p,.yM                   ; R - px >= 0: within its x
.yR:            ld      a,(bd_t+1)
                or      a
                jp      m,.yRtop                ; T - py < 0
                ld      hl,bd_t
                or      (hl)
                jr      z,.yRtop                ; T - py = 0: at or above the top
                ld      a,(bd_b+1)
                or      a
                jp      m,.yRmid                ; B - py < 0
                ld      hl,bd_b
                or      (hl)
                jr      z,.yRmid                ; B - py = 0: within its y
.yRbot:         ZARM    bd_l, bd_b, bd_r, bd_t, corner_phi_np, corner_phi_np
.yRtop:         ZARM    bd_r, bd_b, bd_l, bd_t, corner_phi_nn, corner_phi_nn
.yRmid:         ZARM    bd_r, bd_b, bd_r, bd_t, corner_phi_nn, corner_phi_np
.yL:            ld      a,(bd_t+1)
                or      a
                jp      m,.yLtop
                ld      hl,bd_t
                or      (hl)
                jr      z,.yLtop
                ld      a,(bd_b+1)
                or      a
                jp      m,.yLmid
                ld      hl,bd_b
                or      (hl)
                jr      z,.yLmid
.yLbot:         ZARM    bd_l, bd_t, bd_r, bd_b, corner_phi_pp, corner_phi_pp
.yLtop:         ZARM    bd_r, bd_t, bd_l, bd_b, corner_phi_pn, corner_phi_pn
.yLmid:         ZARM    bd_l, bd_t, bd_l, bd_b, corner_phi_pp, corner_phi_pn
.yM:            ld      a,(bd_t+1)
                or      a
                jp      m,.yMtop
                ld      hl,bd_t
                or      (hl)
                jr      z,.yMtop
                ld      a,(bd_b+1)
                or      a
                jp      m,full_vis              ; inside the box
                ld      hl,bd_b
                or      (hl)
                jp      z,full_vis
.yMbot:         ZARM    bd_l, bd_b, bd_r, bd_b, corner_phi_np, corner_phi_pp
.yMtop:         ZARM    bd_r, bd_t, bd_l, bd_t, corner_phi_pn, corner_phi_nn
                ENDM

bbox_visible:
                ld      l,b
                ld      a,(bsp_side)
                ld      de,(bca_pxs)
                ld      bc,(bca_pys)
                or      a
                jp      nz,bv_side1
                CLASSIFY 0
bv_side1:       CLASSIFY 1

; ---------------------------------------------------------------------------
; corner_phi_XX : DE = dx, BC = dy -> HL = r = (afn - psi) & $0FFF, for the
; sign class XX (x then y: p = the corner is at or beyond the viewer's
; coordinate, n = short of it).  The memo: 128 slots on (dy ^ dx) & $7F,
; the key as (lo, hi) pairs of dx and dy, the value psi; a miss records the
; key, folds the signs into the octant base and runs lf_ns.
; ---------------------------------------------------------------------------
                MACRO   CPM_ENTRY name, negx, negy, obase
name:
                ld      a,c
                xor     e
                and     $7F
                add     a,a
                ld      l,a
                ld      ixl,a                   ; the slot
                ld      h,CPM_PG+1              ; the dy key
                ld      a,c
                cp      (hl)
                jr      nz,.miss
                inc     l
                ld      a,b
                cp      (hl)
                jr      nz,.miss
                dec     h                       ; the dx key
                ld      a,d
                cp      (hl)
                jr      nz,.miss
                dec     l
                ld      a,e
                cp      (hl)
                jr      nz,.miss
                inc     h
                inc     h                       ; psi
                ld      e,(hl)
                inc     l
                ld      d,(hl)
                jp      cp_havepsi
.miss:          ld      a,ixl
                ld      l,a
                ld      h,CPM_PG
                ld      (hl),e
                inc     l
                ld      (hl),d
                inc     h
                ld      (hl),b
                dec     l
                ld      (hl),c
                ld      ixh,obase
                ld      a,d
                or      e
                jp      z,ns_dx0
                IF      negx
                xor     a
                sub     e
                ld      e,a
                sbc     a,a
                sub     d
                ld      d,a
                ENDIF
                IF      negy
                xor     a
                sub     c
                ld      c,a
                sbc     a,a
                sub     b
                ld      b,a
                ENDIF
                ld      a,b
                or      c
                jp      z,ns_dy0
                jp      lf_ns
                ENDM
                CPM_ENTRY corner_phi_nn, 1, 1, 6
                CPM_ENTRY corner_phi_pn, 0, 1, 2
                CPM_ENTRY corner_phi_np, 1, 0, 4
                CPM_ENTRY corner_phi_pp, 0, 0, 0

; lf_ns : DE = |dx|, BC = |dy| (never both zero), IXH = the octant base
; index, IXL = the memo slot -> DE = psi (stored), HL = r.
; k = L8(|dy|) - L8(|dx|) in log2/32 units, its sign the octant's swap;
; wide magnitudes go through L8 of the value >> 3 (half-step
; interpolated) plus 96.
lf_ns:
                ld      a,d
                or      b
                jr      nz,ns_wide
                ld      h,L8_PG
                ld      l,c
                ld      a,(hl)
                ld      l,e
                sub     (hl)
                jr      nc,ns_khave
ns_neg:         neg
                inc     ixh                     ; the swapped octant
ns_khave:       ld      l,a
                ld      h,AE_LO_PG
                ld      e,(hl)
                inc     h
                ld      d,(hl)                  ; DE = ta
                ld      a,ixh
                add     a,PA_OCT & 255
                ld      l,a
                ld      h,PA_OCT >> 8
                ld      a,(hl)                  ; base hi | sign << 7
                bit     7,a
                jr      nz,khave_sub
                add     a,d
                ld      d,a                     ; psi = base + ta
mask_done:      ld      a,ixl
                ld      l,a
                ld      h,CPM_PSI_PG
                ld      (hl),e
                inc     l
                ld      (hl),d
cp_havepsi:     ld      hl,(bca_afn)
                or      a
                sbc     hl,de
                ld      a,h
                and     $0F
                ld      h,a                     ; HL = r
                ret
khave_sub:      and     $0F
                ld      h,a
                ld      l,0
                or      a
                sbc     hl,de                   ; psi = base - ta
                ld      a,h
                and     $0F
                ld      d,a
                ld      e,l
                jr      mask_done
ns_dy0:         inc     ixh
ns_dx0:         ld      a,ixh                   ; ta = 0: psi = the base
                add     a,PA_OCT & 255
                ld      l,a
                ld      h,PA_OCT >> 8
                ld      a,(hl)
                and     $0F
                ld      d,a
                ld      e,0
                jr      mask_done
ns_wide:        ld      a,d
                or      a
                jr      nz,ns_x16
                ; |dx| a byte, |dy| wide: k = L(dy >> 3) + 96 - L8[dx]
                ld      h,b
                ld      l,c
                call    lf_wide
                ld      l,e
                ld      h,L8_PG
                sub     (hl)
                jr      nc,ns_pos96
                add     a,96
                jp      ns_khave
ns_pos96:       add     a,96
                jp      nc,ns_khave
                ld      a,255
                jp      ns_khave
ns_x16:         ld      a,b
                or      a
                jr      nz,ns_x16y16
                ; |dx| wide, |dy| a byte: the swapped octant
                inc     ixh
                ex      de,hl
                call    lf_wide
                ld      l,c
                ld      h,L8_PG
                sub     (hl)
                jr      nc,ns_pos96
                add     a,96
                jp      ns_khave
ns_x16y16:      ex      de,hl
                call    lf_wide
                ld      e,a                     ; L(dx)
                ld      h,b
                ld      l,c
                call    lf_wide
                sub     e                       ; L(dy) - L(dx)
                jp      nc,ns_khave
                jp      ns_neg
; lf_wide : HL = a magnitude >= 256 -> A = L8 of (HL >> 3), the odd half
; steps averaging the two neighbouring entries (index 255 has none).  DE
; and BC kept.
lf_wide:
                srl     h
                rr      l
                srl     h
                rr      l
                srl     h
                rr      l                       ; carry = the half step
                ld      h,L8_PG
                jr      nc,lw_flat
                ld      a,l
                inc     a
                jr      z,lw_flat
                ld      a,(hl)
                inc     l
                scf
                adc     a,(hl)                  ; a + b + 1, 9 bits
                rra                             ; >> 1
                ret
lw_flat:        ld      a,(hl)
                ret

; ---------------------------------------------------------------------------
; bca_tail : HL = the second corner's r, (bca_p1) = the first's -> the
; columns [ilo, ihi) through VATOX (r in [0, 1024) is inside the window;
; the first corner is widened by 2*EPSILON here, having carried +EPSILON in
; afn), then hg_u8 on them: carry = a gap.
; ---------------------------------------------------------------------------
bca_tail:
                ld      a,h
                cp      4
                jr      nc,ct_r2out
                add     a,VATOX_PG
                ld      h,a
                ld      a,(hl)
                inc     a
                jr      z,ct_ih_cl
ct_ih:          ld      c,a                     ; ihi
ct_left:        ld      hl,(bca_p1)
                ld      de,2*EPSILON_F
                or      a
                sbc     hl,de
                ld      a,h
                and     $0F
                cp      4
                jr      nc,ct_r1out_r2f
lk_left:        add     a,VATOX_PG
                ld      h,a
                ld      a,(hl)
                sub     1
                jr      c,ct_il_z
ct_il:          ld      b,a                     ; ilo
                jp      hg_u8
ct_ih_cl:       ld      a,255
                jr      ct_ih
ct_il_z:        ld      b,0
                jp      hg_u8
ct_r1out_r2f:   ld      b,0
                jp      hg_u8
ct_r2out:       ld      e,0
                cp      10
                jr      c,ct_r2have
                inc     e                       ; r2 in the wrapped left arc
ct_r2have:      push    de
                ld      hl,(bca_p1)
                ld      de,2*EPSILON_F
                or      a
                sbc     hl,de
                pop     de
                ld      a,h
                and     $0F
                cp      4
                jr      c,ct_f_r2out            ; r1 inside, r2 beyond the right
                cp      10
                jr      c,cull                  ; both beyond: culled
                ld      a,e
                or      a
                jr      z,full_vis              ; r1 left of, r2 right of: all
cull:           or      a
                ret
full_vis:       ld      b,0
                ld      c,255
                jp      hg_u8
ct_f_r2out:     ld      c,255
                jr      lk_left
