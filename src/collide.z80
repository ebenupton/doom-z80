; ===========================================================================
; collide.z80 : player wall collision - the BBC port's P_CheckPosition box
; test (colmap.py box_scan / bsp/pmove.s), solid lines only, with
; axis-separated sliding.
;
; The player is a radius-16 box.  A candidate point is blocked if the box
; straddles any solid blocking line in the 128-unit X column(s) the box
; spans.  The blocking lines and per-column index live in bank 1
; (COL_SEG/COL_IDX/COL_LIST), paged in for the whole of read_input.
;
; Coordinates: pl_x/pl_y are 8.8 prescaled, centre-relative; the raw
; centre-relative world coordinate is (integer part << 3), which is what the
; colmap tables use.  box_hits_seg is bit-identical to colmap._box_hits_seg.
; ===========================================================================

; player_move : mv_dx/mv_dy = the desired move (s16 8.8).  Commit the full
; move if the box is clear there; else x alone, else y alone (slide along the
; wall); else nothing.
; player_move : split the move into chunks no bigger than MM_HALF (so a
; single chunk's box overlaps the last, and a thin wall can't be tunnelled),
; then apply each chunk with pm_step.  n = halvings until max(|dx|,|dy|) <=
; MM_HALF; chunk = mv_dx >> n, mv_dy >> n; 2^n chunks.
player_move:
                ld      hl,(mv_dx)
                call    abs_hl                  ; |dx|
                ex      de,hl                   ; DE = |dx|
                ld      hl,(mv_dy)
                call    abs_hl                  ; HL = |dy|
                or      a                       ; amax = max(|dx|,|dy|) in HL
                sbc     hl,de
                add     hl,de
                jr      nc,pm_amax              ; |dy| >= |dx|: HL = |dy|
                ex      de,hl                   ; else HL = |dx|
pm_amax:        ld      b,0                     ; n
pm_ncount:      ld      de,MM_HALF
                or      a
                sbc     hl,de
                jr      c,pm_have_n             ; amax < MM_HALF: done
                jr      z,pm_have_n             ; amax == MM_HALF: done
                add     hl,de                   ; restore
                srl     h
                rr      l                       ; amax >>= 1
                inc     b
                jr      pm_ncount
pm_have_n:      ld      a,b
                or      a
                ld      a,1                     ; count = 1 when n = 0
                jr      z,pm_setcount
                ; chunk = mv_dx >> n, mv_dy >> n (arithmetic); count = 1 << n.
                ; sra_hl_b consumes B, so save n across each shift.
                ld      hl,(mv_dx)
                push    bc
                call    sra_hl_b
                pop     bc
                ld      (mv_dx),hl
                ld      hl,(mv_dy)
                push    bc
                call    sra_hl_b
                pop     bc
                ld      (mv_dy),hl
                ld      a,1
pm_shl:         add     a,a
                djnz    pm_shl                  ; A = 1 << n (B = n here)
pm_setcount:    ld      (pm_count),a
                ; zero move?  (a chunk of 0,0 - nothing to do)
                ld      hl,(mv_dx)
                ld      a,h
                or      l
                jr      nz,pm_loop
                ld      hl,(mv_dy)
                ld      a,h
                or      l
                ret     z
pm_loop:
                call    pm_step
                ld      a,(pm_count)
                dec     a
                ld      (pm_count),a
                jr      nz,pm_loop
                ret

; pm_step : apply one chunk (mv_dx, mv_dy) with box collision + sliding.
pm_step:
                ld      hl,(mv_dx)
                call    cand_px                 ; cand_x/xf = pl_x + mv_dx
                ld      hl,(mv_dy)
                call    cand_py                 ; cand_y/yf = pl_y + mv_dy
                ; full move (candidate x and y, with their fractions)
                ld      hl,(cand_x)
                ld      (cm_qx),hl
                ld      a,(cand_xf)
                ld      (cm_qxf),a
                ld      hl,(cand_y)
                ld      (cm_qy),hl
                ld      a,(cand_yf)
                ld      (cm_qyf),a
                call    box_clear
                jr      c,pm_commit_xy
pm_try_x:
                ; x only (candidate x, current y)
                ld      hl,(cand_x)
                ld      (cm_qx),hl
                ld      a,(cand_xf)
                ld      (cm_qxf),a
                ld      hl,(pl_y)
                ld      (cm_qy),hl
                ld      a,(pl_yf)
                ld      (cm_qyf),a
                call    box_clear
                jr      c,pm_commit_x
pm_try_y:
                ; y only (current x, candidate y)
                ld      hl,(pl_x)
                ld      (cm_qx),hl
                ld      a,(pl_xf)
                ld      (cm_qxf),a
                ld      hl,(cand_y)
                ld      (cm_qy),hl
                ld      a,(cand_yf)
                ld      (cm_qyf),a
                call    box_clear
                ret     nc                      ; fully blocked: stay put
                ; commit y
                ld      a,(cm_vz)
                ld      (vs_vz),a
                ld      hl,(cand_y)
                ld      (pl_y),hl
                ld      a,(cand_yf)
                ld      (pl_yf),a
                ret
pm_commit_x:    ld      hl,(cand_x)
                ld      (pl_x),hl
                ld      a,(cand_xf)
                ld      (pl_xf),a
                ret
pm_commit_xy:   ld      hl,(cand_x)
                ld      (pl_x),hl
                ld      a,(cand_xf)
                ld      (pl_xf),a
                ld      hl,(cand_y)
                ld      (pl_y),hl
                ld      a,(cand_yf)
                ld      (pl_yf),a
                ret

; cand_px : HL = an 8.8 delta -> cand_x/cand_xf = pl_x/pl_xf + HL (no commit)
cand_px:
                ld      a,(pl_xf)
                add     a,l
                ld      (cand_xf),a
                ld      a,0
                adc     a,0
                ld      c,a                     ; carry out of the fraction
                ld      a,h
                rla
                sbc     a,a
                ld      d,a
                ld      e,h                     ; DE = sign-extended delta int
                ld      hl,(pl_x)
                add     hl,de
                ld      d,0
                ld      e,c
                add     hl,de
                ld      (cand_x),hl
                ret
cand_py:
                ld      a,(pl_yf)
                add     a,l
                ld      (cand_yf),a
                ld      a,0
                adc     a,0
                ld      c,a
                ld      a,h
                rla
                sbc     a,a
                ld      d,a
                ld      e,h
                ld      hl,(pl_y)
                add     hl,de
                ld      d,0
                ld      e,c
                add     hl,de
                ld      (cand_y),hl
                ret

; box_clear : cm_qx/cm_qy = a candidate point, 16-bit prescaled centre-rel.
; Build the radius-16 box in raw centre-relative world coords and scan the
; column(s) it spans.  Carry SET = clear (no solid line hit), clear = blocked.
box_clear:
                ld      a,-40                   ; tm_ob sentinel (colmap)
                ld      (cm_tmob),a
                ; nx = (q << 3) + (qf >> 5); box[axis] = nx -/+ 16.  The
                ; fraction (0.8 of a prescaled = 8-world unit) contributes the
                ; low 3 world bits, so the box tracks the true position.
                ld      hl,(cm_qx)
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      a,(cm_qxf)
                srl     a
                srl     a
                srl     a
                srl     a
                srl     a                       ; qf >> 5 (0..7)
                add     a,l
                ld      l,a
                jr      nc,bcx_n
                inc     h
bcx_n:          ld      ix,cm_bx0
                call    mk_axis
                ld      hl,(cm_qy)
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      a,(cm_qyf)
                srl     a
                srl     a
                srl     a
                srl     a
                srl     a
                add     a,l
                ld      l,a
                jr      nc,bcy_n
                inc     h
bcy_n:          ld      ix,cm_by0
                call    mk_axis
                ; columns c0 = col(bx0), c1 = col(bx1).  scan_col clobbers all
                ; registers, so both column indices ride in memory.
                ld      hl,(cm_bx0)
                call    col_of
                ld      (cm_c1),a               ; cm_c1 = c0
                ld      hl,(cm_bx1)
                call    col_of
                ld      (cm_qx),a               ; cm_qx = c1 (cm_qx free now)
                ld      a,(cm_c1)
                call    scan_col                ; scan c0
                ret     nc                      ; blocked
                ld      a,(cm_c1)
                ld      hl,cm_qx
                cp      (hl)
                jr      z,bc_done               ; c0 == c1: done, clear
                ld      a,(cm_qx)
                jp      scan_col                ; scan c1
bc_done:        scf
                ret

; mk_axis : HL = nx (raw centre-relative), IX -> (lo, hi) pair.  Stores
; nx-16 at (IX), nx+16 at (IX+2).
mk_axis:
                ld      de,PL_RADIUS
                add     hl,de
                ld      (ix+2),l
                ld      (ix+3),h                ; nx + 16
                or      a
                sbc     hl,de
                sbc     hl,de                   ; (nx+16) - 32 = nx - 16
                ld      (ix+0),l
                ld      (ix+1),h
                ret

; dest_ok (GATED 2026-09-06: reuses fe_descend, whose render-walk descent
; diverges from colmap.find_ss in ~13% of the map -> over-blocks. Re-enable in
; pm_step once an exact colmap find_ss is ported. Kept here, verified logic.)
; dest_ok : cm_qx/cm_qy = a candidate (prescaled pl_x/pl_y).  Descends the
; BSP to the subsector there and takes its floor vz (EYEZ[SSSEC[ss]], the
; same value find_eye_height uses); the step is legal iff vz - vs_vz <=
; PM_STEP_PS (a drop is always legal).  Carry SET = OK, and cm_vz = the new
; floor.  Mirrors colmap.dest_check for static (non-mover) subsectors.
; Pages bank 4 (NODES4/fe_descend) then bank 0 (SSSEC/EYEZ), then bank 1 back.
dest_ok:
                ld      hl,(pl_wx)
                push    hl
                ld      hl,(pl_wy)
                push    hl
                ; candidate world = cm_q*8 + MAP_CENTER
                ld      hl,(cm_qx)
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      de,MAP_CENTER_X
                add     hl,de
                ld      (pl_wx),hl
                ld      hl,(cm_qy)
                add     hl,hl
                add     hl,hl
                add     hl,hl
                ld      de,MAP_CENTER_Y
                add     hl,de
                ld      (pl_wy),hl
                ld      a,BANK_OBJ
                call    set_page
                ld      hl,(bsp_root)
                call    fe_descend              ; HL = subsector, bit 15 set
                ld      a,BANK_GEOM
                call    set_page
                res     7,h
                ld      de,SSSEC
                add     hl,de
                ld      l,(hl)
                ld      h,0
                ld      de,EYEZ
                add     hl,de
                ld      a,(hl)                  ; destination subsector floor vz
                ld      b,a                     ; eff = max(destfloor, tm_ob), signed
                ld      a,(cm_tmob)
                sub     b
                jp      p,do_vz                 ; tm_ob >= destfloor: use tm_ob
                ld      a,b                     ; else destfloor
                jr      do_vst
do_vz:          ld      a,(cm_tmob)
do_vst:         ld      (cm_vz),a               ; effective candidate floor
                ld      a,BANK_COL
                call    set_page
                pop     hl
                ld      (pl_wy),hl
                pop     hl
                ld      (pl_wx),hl
                ; step test: cm_vz - vs_vz > PM_STEP_PS  ->  blocked
                ld      a,(cm_vz)
                ld      hl,vs_vz
                sub     (hl)                    ; s8 floor difference
                jp      m,do_ok                 ; a drop (or level) is fine
                cp      PM_STEP_PS+1
                jr      c,do_ok                 ; <= PM_STEP_PS: legal step
                or      a                       ; too high: blocked (carry clear)
                ret
do_ok:          scf
                ret

; col_of : HL = a centre-relative raw x -> A = clamp((x - RAWX_MIN) >> 7, 0, 35)
col_of:
                ld      de,-COL_RAWX_MIN        ; + 1936
                add     hl,de
                bit     7,h
                jr      nz,co_lo                ; negative -> column 0
                ; >> 7  (=  (hi<<1) | (lo>>7) )
                ld      a,h
                add     a,a                     ; hi << 1, carry = hi bit7 (0 here)
                ld      b,a
                ld      a,l
                rlca                            ; lo bit7 -> carry, but we want lo>>7
                and     1                       ; A = lo >> 7
                or      b
                cp      36
                ret     c
                ld      a,35                    ; clamp high
                ret
co_lo:          xor     a
                ret

; scan_col : A = column index -> scan its solid segs against the box.
; Carry SET = clear, carry CLEAR = a line hit (blocked).
scan_col:
                ld      l,a
                ld      h,0
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,de                   ; c * 3
                ld      de,COL_IDX
                add     hl,de                   ; -> the column's (ptr, count)
                ld      e,(hl)
                inc     hl
                ld      d,(hl)                  ; DE = list pointer
                inc     hl
                ld      b,(hl)                  ; B = count
                ld      a,b
                or      a
                scf
                ret     z                       ; empty column: clear
sc_loop:
                ld      a,(de)                  ; unified index
                push    de
                push    bc
                cp      COL_N_SOLID
                jr      nc,sc_port              ; idx >= N_SOLID: a port
                ; IX = COL_SEG + idx * 8
                ld      l,a
                ld      h,0
                add     hl,hl
                add     hl,hl
                add     hl,hl                   ; idx * 8
                ld      de,COL_SEG
                add     hl,de
                push    hl
                pop     ix
                call    box_hits_seg            ; carry = hit
                pop     bc
                pop     de
                jr      c,sc_hit                ; a solid line: hard block
                inc     de
                djnz    sc_loop
                scf                             ; scanned all, no hard hit: clear
                ret
sc_port:
                ; IX = COL_PORT + (idx - N_SOLID) * 11
                sub     COL_N_SOLID
                ld      l,a
                ld      h,0
                ld      d,h
                ld      e,l
                add     hl,hl
                add     hl,hl
                add     hl,hl                   ; *8
                add     hl,de
                add     hl,de
                add     hl,de                   ; *11
                ld      de,COL_PORT
                add     hl,de
                push    hl
                pop     ix
                call    box_hits_seg            ; does the box cross this port?
                jr      nc,sc_port_miss
                ; opening = ot - (ob - EYE_PS) ; < DOOR_MIN -> hard block
                ld      a,(ix+9)                ; ot
                ld      c,a
                ld      a,(ix+8)                ; ob
                sub     EYE_PS
                ld      b,a
                ld      a,c
                sub     b                       ; ot - (ob - EYE_PS)  (s8)
                sub     DOOR_MIN_OPEN
                jp      m,sc_hit_pop            ; opening < DOOR_MIN: blocked
                ; head bump: ot - (vs_vz - EYE_PS) < DOOR_MIN -> block
                ld      a,(vs_vz)
                sub     EYE_PS
                ld      b,a
                ld      a,(ix+9)
                sub     b                       ; ot - (z - EYE_PS)  (s8)
                sub     DOOR_MIN_OPEN
                jp      m,sc_hit_pop            ; head bump: blocked
                ; passable: tm_ob = max(tm_ob, ob)
                ld      a,(ix+8)                ; ob (s8)
                ld      hl,cm_tmob
                sub     (hl)                    ; ob - tm_ob (s8)
                jp      m,sc_port_miss          ; ob < tm_ob: keep
                jr      z,sc_port_miss
                ld      a,(ix+8)
                ld      (cm_tmob),a             ; raise tm_ob to ob
sc_port_miss:
                pop     bc
                pop     de
                inc     de
                djnz    sc_loop
                scf
                ret
sc_hit_pop:     pop     bc
                pop     de
sc_hit:         or      a                       ; blocked
                ret

; box_hits_seg : IX -> seg (x1,y1,dx,dy s16); box in cm_bx0/by0/bx1/by1.
; Carry SET = the box straddles the line (a hit).  Mirrors colmap.
box_hits_seg:
                ; --- lx0/lx1 from x1, dx ---
                ld      l,(ix+0)
                ld      h,(ix+1)                ; HL = x1
                ld      e,(ix+4)
                ld      d,(ix+5)                ; DE = dx
                bit     7,d
                jr      nz,bh_dxneg
                ld      (cm_lx0),hl             ; dx >= 0: lx0 = x1
                add     hl,de
                ld      (cm_lx1),hl             ;          lx1 = x1 + dx
                jr      bh_ly
bh_dxneg:       ld      (cm_lx1),hl             ; dx < 0: lx1 = x1
                add     hl,de
                ld      (cm_lx0),hl             ;         lx0 = x1 + dx
bh_ly:
                ld      l,(ix+2)
                ld      h,(ix+3)                ; HL = y1
                ld      e,(ix+6)
                ld      d,(ix+7)                ; DE = dy
                bit     7,d
                jr      nz,bh_dyneg
                ld      (cm_ly0),hl
                add     hl,de
                ld      (cm_ly1),hl
                jr      bh_bbox
bh_dyneg:       ld      (cm_ly1),hl
                add     hl,de
                ld      (cm_ly0),hl
bh_bbox:
                ; strict overlap: miss if bx1<=lx0 or bx0>=lx1 or by1<=ly0 or by0>=ly1
                ld      hl,(cm_bx1)
                ld      de,(cm_lx0)
                call    cmp16                   ; carry = HL < DE
                jp      c,bh_miss               ; bx1 < lx0
                jp      z,bh_miss               ; bx1 == lx0 (<=)
                ld      hl,(cm_lx1)
                ld      de,(cm_bx0)
                call    cmp16
                jp      c,bh_miss               ; lx1 < bx0  (bx0 > lx1)
                jp      z,bh_miss               ; bx0 == lx1
                ld      hl,(cm_by1)
                ld      de,(cm_ly0)
                call    cmp16
                jp      c,bh_miss
                jp      z,bh_miss
                ld      hl,(cm_ly1)
                ld      de,(cm_by0)
                call    cmp16
                jp      c,bh_miss
                jp      z,bh_miss
                ; --- axis line? dx==0 or dy==0 -> the overlap IS the hit ---
                ld      a,(ix+4)
                or      (ix+5)
                jp      z,bh_hit                ; dx == 0
                ld      a,(ix+6)
                or      (ix+7)
                jp      z,bh_hit                ; dy == 0
                ; --- diagonal: the two quadrant corners must straddle ---
                ; if (dx>0)==(dy>0): c1=(bx0,by1) c2=(bx1,by0)
                ; else:              c1=(bx0,by0) c2=(bx1,by1)
                ld      a,(ix+5)                ; dx hi (sign)
                xor     (ix+7)                  ; ^ dy hi
                bit     7,a
                jr      nz,bh_opp
                ; same sign: c1=(bx0,by1), c2=(bx1,by0)
                ld      hl,(cm_bx0)
                ld      (cm_c1x),hl
                ld      hl,(cm_by1)
                ld      (cm_c1y),hl
                ld      hl,(cm_bx1)
                ld      (cm_c2x),hl
                ld      hl,(cm_by0)
                ld      (cm_c2y),hl
                jr      bh_cross
bh_opp:         ld      hl,(cm_bx0)
                ld      (cm_c1x),hl
                ld      hl,(cm_by0)
                ld      (cm_c1y),hl
                ld      hl,(cm_bx1)
                ld      (cm_c2x),hl
                ld      hl,(cm_by1)
                ld      (cm_c2y),hl
bh_cross:
                ; s = (cx - x1)*dy - (cy - y1)*dx ; the two corners straddle
                ; when (s1 > 0) != (s2 > 0)  (colmap's test; 0 counts as "not >0")
                ld      hl,(cm_c1x)
                ld      (cm_cx),hl
                ld      hl,(cm_c1y)
                ld      (cm_cy),hl
                call    corner_side             ; A = 1 if s1 > 0 else 0
                push    af                      ; (corner_side/mul_s16 clobber BC)
                ld      hl,(cm_c2x)
                ld      (cm_cx),hl
                ld      hl,(cm_c2y)
                ld      (cm_cy),hl
                call    corner_side             ; A = 1 if s2 > 0 else 0
                pop     bc                      ; B = s1's verdict
                xor     b
                jp      nz,bh_hit               ; the two differ: straddle
bh_miss:        or      a                       ; carry clear = no hit
                ret
bh_hit:         scf
                ret

; corner_side : s = (cm_cx - x1)*dy - (cm_cy - y1)*dx, IX -> the seg.
; Returns the 4-byte signed result in cm_s (LE); A = its top (sign) byte.
; colmap tests s>0, i.e. sign bit 0 AND non-zero; but only sign(s1)!=sign(s2)
; matters and colmap uses (s1>0)!=(s2>0).  Zero is treated as its sign bit
; (0 = "not >0"), matching (s>0) being false for s<=0.
corner_side:
                ; P = cx - x1
                ld      hl,(cm_cx)
                ld      e,(ix+0)
                ld      d,(ix+1)
                or      a
                sbc     hl,de
                push    hl                      ; P
                ; dy
                ld      l,(ix+6)
                ld      h,(ix+7)
                pop     de                      ; DE = P, HL = dy
                call    mul_s16                 ; cm_prod = P * dy (s32)
                ld      hl,cm_prod
                ld      de,cm_s
                ld      bc,4
                ldir                            ; cm_s = P*dy
                ; Q = cy - y1
                ld      hl,(cm_cy)
                ld      e,(ix+2)
                ld      d,(ix+3)
                or      a
                sbc     hl,de
                push    hl                      ; Q
                ld      l,(ix+4)
                ld      h,(ix+5)                ; dx
                pop     de                      ; DE = Q
                call    mul_s16                 ; cm_prod = Q * dx
                ; cm_s = cm_s - cm_prod  (32-bit)
                ld      hl,(cm_s)
                ld      de,(cm_prod)
                or      a
                sbc     hl,de
                ld      (cm_s),hl
                ld      hl,(cm_s+2)
                ld      de,(cm_prod+2)
                sbc     hl,de
                ld      (cm_s+2),hl
                ; A = 1 if cm_s > 0 (positive AND non-zero), else 0
                bit     7,h                     ; H = cm_s top byte
                jr      nz,cs_notpos            ; negative -> 0
                ld      a,(cm_s)
                or      a
                jr      nz,cs_pos
                ld      a,(cm_s+1)
                or      a
                jr      nz,cs_pos
                ld      a,(cm_s+2)
                or      a
                jr      nz,cs_pos
                or      h                       ; all four bytes zero -> 0
                jr      nz,cs_pos
                xor     a                       ; s == 0 -> 0
                ret
cs_pos:         ld      a,1
                ret
cs_notpos:      xor     a
                ret

; mul_s16 : HL * DE (both signed s16) -> cm_prod (4-byte signed LE).
mul_s16:
                ld      a,h
                xor     d
                ld      (cm_sign),a
                bit     7,h
                jr      z,ms16_a
                call    neg_hl16
ms16_a:         bit     7,d
                jr      z,ms16_b
                ex      de,hl
                call    neg_hl16
                ex      de,hl
ms16_b:
                ; cm_acc = |a| (32-bit), cm_prod = 0, BC = |b|
                ld      (cm_acc),hl
                ld      hl,0
                ld      (cm_acc+2),hl
                ld      (cm_prod),hl
                ld      (cm_prod+2),hl
                ld      c,e
                ld      b,d                     ; BC = |b|
ms16_loop:
                ld      a,b
                or      c
                jr      z,ms16_sign
                srl     b
                rr      c                       ; BC >>= 1, carry = old bit0
                jr      nc,ms16_shift
                ld      hl,(cm_prod)
                ld      de,(cm_acc)
                add     hl,de
                ld      (cm_prod),hl
                ld      hl,(cm_prod+2)
                ld      de,(cm_acc+2)
                adc     hl,de
                ld      (cm_prod+2),hl
ms16_shift:
                ld      hl,(cm_acc)
                add     hl,hl
                ld      (cm_acc),hl
                ld      hl,(cm_acc+2)
                adc     hl,hl
                ld      (cm_acc+2),hl
                jr      ms16_loop
ms16_sign:
                ld      a,(cm_sign)
                bit     7,a
                ret     z
                ld      hl,0
                ld      de,(cm_prod)
                or      a
                sbc     hl,de
                ld      (cm_prod),hl
                ld      hl,0
                ld      de,(cm_prod+2)
                sbc     hl,de
                ld      (cm_prod+2),hl
                ret

; abs_hl : HL = |HL| (signed)
abs_hl:
                bit     7,h
                ret     z
                ; fall into neg_hl16
; neg_hl16 : HL = -HL
neg_hl16:
                ld      a,h
                cpl
                ld      h,a
                ld      a,l
                cpl
                ld      l,a
                inc     hl
                ret

; sra_hl_b : HL >>= B, arithmetic (sign-preserving)
sra_hl_b:
                ld      a,b
                or      a
                ret     z
sra_hl_l:       sra     h
                rr      l
                djnz    sra_hl_l
                ret

; cmp16 : signed compare HL vs DE.  Carry SET when HL < DE; Z set when equal.
cmp16:
                ld      a,h
                xor     d
                jp      m,cm_diff               ; signs differ
                or      a
                sbc     hl,de                   ; same sign: true subtract, no overflow
                ret
cm_diff:        ; different signs: HL < DE iff HL is negative
                bit     7,h
                jr      z,cm_ge                 ; HL positive, DE negative -> HL >= DE
                scf                             ; HL negative -> HL < DE
                ret
cm_ge:          or      a                       ; clear carry; Z is irrelevant here
                ret
