; ---------------------------------------------------------------------------
; The span clipper: a transcription of the BBC port's shipping 6502 clipper
; (src/clip/{pool,query,mark_solid,interp,dcl,dcl_s16,fused,fusedw,tfr}.s),
; compare for compare - the Spectrum port matches that engine's pixels, not
; the Python model it grew from.
;
; The visible region is a sorted linked list of spans, each a half-open
; column range [xs, xe) with a top line and a bottom line: y at two anchor
; columns (xlo and xlo + den), and the extremes of the two values, outer
; and inner.  Every y is a byte biased by Y_BIAS: rows [0, 159] are
; [48, 207].  Column 255 does not exist (the screen span is [0, 255)).
;
; Record: a slot is an id (a multiple of 8; 0 = none, the end of a list),
; its hot fields at SPH + id and its lines at SPL + id, the page below:
;   SPH: +0 next  +1 xs  +2 xe  +3 ot  +4 it  +5 ob  +6 ib
;   SPL: +0 txlo  +1 tden  +2 tl  +3 tr   the top line
;        +4 bxlo  +5 bden  +6 bl  +7 br   the bottom line
; A walk holds the id in L (or IXL) with H = SPH >> 8; a line is `dec h`.
;
; Lines arrive as s16 (lc_x1/lc_y1 - lc_x2/lc_y2, rows biased), are clipped
; to the u8 box by dcl_s16 (s16 interpolation, half away from zero), and
; walked in bytes by draw_clipped_line, which plots the visible runs.  A
; portal's aperture edges go through the FUSED walker instead: the same
; clip, but each visible run is applied to the spans it covers as the new
; boundary (the whole line, a pure copy) as soon as it is plotted.
; ---------------------------------------------------------------------------

; ===========================================================================
; Arithmetic
; ===========================================================================

; --- udiv16_8 : HL / C -> A = the quotient (fits a byte: H < C), L = the
; remainder.  The BBC port's cell classify: a u8 dividend under the divisor
; is a zero quotient on one compare; a u8 dividend over a divisor of 16 or
; more has a quotient under 16, so the first four steps of the divide can
; never commit and the last four are entered with the nibbles pre-shifted.
udiv16_8:
                ld      a,h
                or      a
                jp      nz,ud_wide
                ld      a,c
                cp      16
                jr      c,ud_full
                ld      a,l
                cp      c
                jr      c,ud_zq                 ; num < den: 0
                ld      h,a
                and     $0f
                rlca
                rlca
                rlca
                rlca
                ld      l,a                     ; L = num << 4
                ld      a,h
                rrca
                rrca
                rrca
                rrca
                and     $0f                     ; A = num >> 4 (carry clear)
                call    db_n3                   ; the last four steps
                ld      c,l
                ld      l,a
                ld      a,c
                ret
ud_zq:          ld      a,l                     ; (A = 0 and the remainder)
                ld      l,a
                xor     a
                ret
ud_full:        xor     a
                jr      ud_go
ud_wide:        ld      a,h
ud_go:          call    div8b                   ; L = q, A = r
                ld      c,l
                ld      l,a
                ld      a,c
                ret

; --- umul_round_div : A = |dy|, B = the offset, C = den
;     -> A = (off * |dy| + den/2) / den                    (umul_round_div)
; The BBC port's small-|dy| tiers: off <= den (the clip's precondition on
; a sloped line) bounds the quotient by |dy|, so |dy| = 1 is one compare
; and |dy| 2..7 keeps the multiply but walks the divide in <= |dy|
; subtractions.  Both are exact.  Eats B, HL.
umul_round_div:
                cp      2
                jr      c,urd_dy1
                cp      8
                jr      c,urd_dysm
                ld      h,a
                ld      l,b
                push    bc
                MUL_U8_BODY                     ; HL = off * |dy|
                pop     bc
                ld      a,c
                srl     a
                add     a,l
                ld      l,a
                jp      nc,udiv16_8
                inc     h
                jr      udiv16_8
urd_dy1:        or      a
                ret     z                       ; |dy| = 0: nothing
                ld      a,c
                srl     a
                add     a,b                     ; off + den/2
                jr      c,urd_q1                ; a carry is over den
                cp      c
                ld      a,0
                ret     c
urd_q1:         ld      a,1
                ret
urd_dysm:       ld      h,a
                ld      l,b
                push    bc
                MUL_U8_BODY                     ; HL = off * |dy|, H <= 6
                pop     bc
                ld      a,c
                srl     a
                add     a,l
                ld      l,a
                jp      nc,urd_sm
                inc     h
urd_sm:         ld      b,0                     ; the quotient
urd_sm_hi:      ld      a,h
                or      a
                jp      z,urd_sm_lo
                ld      a,l                     ; the high byte set: num >= 256
                sub     c                       ; > den, a whole step
                ld      l,a
                jr      nc,urd_sm_nb
                dec     h
urd_sm_nb:      inc     b
                jr      urd_sm_hi
urd_sm_lo:      ld      a,l
                cp      c
                jr      c,urd_sm_done
                sub     c
                ld      l,a
                inc     b
                jp      urd_sm_lo
urd_sm_done:    ld      a,b
                ret

; --- interp_store : A = x on the line B = x0, C = den, D = y0, E = y1 -> A =
; its y: y0 at the anchor, y1 at anchor + den, in between (off * |dy| + den/2)
; / den taken in the line's direction.  Eats BC, DE, HL; IX, IY and the
; alternate set kept.  The line is loaded straight into
; the registers by IW_TOP/IW_BOT/IW_LINE/IW_FWL - no staging.
interp_store:
                sub     b                       ; the offset
                jr      z,is_y0
                cp      c
                jr      z,is_y1
                ld      b,a                     ; B = off, C = den
                ld      a,e
                sub     d                       ; dy
                jr      z,is_y0
                push    de                      ; y0 rides the stack (the
                jr      c,is_desc               ;  multiply eats DE; the
                call    umul_round_div          ;  alternate set stays the
                pop     de                      ;  caller's)
                add     a,d
                ret
is_desc:        neg
                call    umul_round_div
                pop     de
                ld      b,a
                ld      a,d
                sub     b
                ret
is_y0:          ld      a,d
                ret
is_y1:          ld      a,e
                ret

                MACRO   IW_TOP                  ; the span's top line (IX; eats HL)
                ld      a,ixl
                ld      l,a
                ld      h,SPL>>8
                ld      b,(hl)
                inc     l
                ld      c,(hl)
                inc     l
                ld      d,(hl)
                inc     l
                ld      e,(hl)
                ENDM
                MACRO   IW_BOT
                ld      a,ixl
                or      SL_BXLO
                ld      l,a
                ld      h,SPL>>8
                ld      b,(hl)
                inc     l
                ld      c,(hl)
                inc     l
                ld      d,(hl)
                inc     l
                ld      e,(hl)
                ENDM
                MACRO   LP_TLTR                 ; IX's top line ends: A = tl, cp tr
                ld      a,ixl
                or      SL_TL
                ld      l,a
                ld      h,SPL>>8
                ld      a,(hl)
                inc     l
                cp      (hl)
                ENDM
                MACRO   LP_BLBR
                ld      a,ixl
                or      SL_BL
                ld      l,a
                ld      h,SPL>>8
                ld      a,(hl)
                inc     l
                cp      (hl)
                ENDM
                MACRO   IW_LINE                 ; the u8 line (eats A)
                ld      a,(lc_x1)
                ld      b,a
                ld      a,(cd_dx)
                ld      c,a
                ld      a,(lc_y1)
                ld      d,a
                ld      a,(lc_y2)
                ld      e,a
                ENDM
                MACRO   IW_FWL                  ; the walker's line (eats A)
                ld      a,(fwl_xl)
                ld      b,a
                ld      a,(fwl_dx)
                ld      c,a
                ld      a,(fwl_yl)
                ld      d,a
                ld      a,(fwl_yr)
                ld      e,a
                ENDM

; --- line_y8 : A = x -> A = the u8 line's y there   (dcl_line_y_at_a)
line_y8:
                ex      af,af'
                IW_LINE
                ex      af,af'
                jp      interp_store
; --- cb_top_at / cb_bot_at : A = x -> the span's boundary there
cb_top_at:
                ex      af,af'
                IW_TOP
                ex      af,af'
                jp      interp_store
cb_bot_at:
                ex      af,af'
                IW_BOT
                ex      af,af'
                jp      interp_store

; --- dcl_boundary_ix : the column where the line crosses a boundary, from
; the distances |d1| (tmp0) at cb_cx1 and |d2| (tmp1) at cb_cx2, on the
; other side: A = 1 rounds up (clipping the left end), 0 down.
;   ix = cx1 + (cx2 - cx1) * |d1| / (|d1| + |d2|), clamped to cx2
; A nine-bit denominator is halved with the product; the floor arm rounds
; the halved denominator up when the dropped bit was set.
dcl_boundary_ix:                                ; A = the rounding, D = |d1|, E = |d2|
                ld      (bix_ceil),a
                ld      a,(cb_cx2)
                ld      hl,cb_cx1
                sub     (hl)
                jr      z,bix_cx1               ; dx = 0
                ld      b,a
                ld      a,d
                or      a
                jr      z,bix_cx1               ; |d1| = 0: at cx1
                push    de
                ld      h,a
                ld      l,b
                MUL_U8_BODY                     ; HL = dx * |d1|
                ex      de,hl                   ; DE = the product
                pop     bc                      ; B = |d1|, C = |d2|
                ld      a,b
                add     a,c                     ; den, nine bits
                jp      nc,bix_norm
                rr      a                       ; den >> 1, carry = the dropped bit
                ld      c,a
                sbc     a,a
                ld      l,a                     ; L = -1 when a bit was dropped
                ld      a,(bix_ceil)
                or      a
                jr      nz,bix_half             ; the ceiling arm keeps the floored den
                ld      a,l
                or      a
                jr      z,bix_half
                inc     c                       ; the floor arm rounds den up
bix_half:       srl     d
                rr      e                       ; the product too
                jr      bix_norm2
bix_norm:       ld      c,a
bix_norm2:      ld      a,(bix_ceil)
                or      a
                jr      z,bix_div
                ld      a,c
                dec     a
                add     a,e                     ; + den - 1
                ld      e,a
                jr      nc,bix_div
                inc     d
bix_div:        ex      de,hl
                call    udiv16_8                ; A = q
                ld      hl,cb_cx1
                add     a,(hl)
                ld      hl,cb_cx2
                cp      (hl)
                ret     c
                ld      a,(hl)                  ; clamped to cx2
                ret
bix_cx1:        ld      a,(cb_cx1)
                ret

; --- The wide arithmetic, for clipping a line's s16 ends to the box ------
; interp_s16 : HL = x, IX -> (x0, y0, x1, y1) s16 -> HL = y, rounded half
; away from zero with |offset|, |den| and |dy|             (s16_interp)
interp_s16:
                ; register-resident (the BBC port's zp operands): DE = |off|,
                ; HL = |den| in the main set, HL' = |dy| with B' = the sign
                ld      e,(ix+0)
                ld      d,(ix+1)
                or      a
                sbc     hl,de                   ; x - x0
                ex      de,hl                   ; DE = off, HL = x0
                ld      c,l
                ld      b,h
                ld      l,(ix+4)
                ld      h,(ix+5)
                or      a
                sbc     hl,bc                   ; x1 - x0
                ld      a,h
                or      l
                jr      z,is16_y0
                bit     7,h
                jp      z,is16_dp
                call    neg_hl                  ; (DE kept)
                ex      de,hl
                call    neg_hl
                ex      de,hl
is16_dp:        ld      a,d
                or      e
                jr      z,is16_y0               ; at the first anchor
                push    hl
                sbc     hl,de                   ; (carry clear: or)
                pop     hl
                jr      z,is16_y1               ; at the second
                exx
                ld      l,(ix+6)
                ld      h,(ix+7)
                ld      e,(ix+2)
                ld      d,(ix+3)
                or      a
                sbc     hl,de                   ; y1 - y0
                exx
                jr      z,is16_y0               ; level
                exx
                ld      b,0                     ; B' = the sign
                bit     7,h
                jr      z,is16_dyp
                call    neg_hl
                inc     b
is16_dyp:       ld      a,h
                exx
                ; the byte tier (the BBC port's si_general u8 path): every
                ; operand a byte -> one 8x8 and a 16/8, the quotient a byte
                or      d
                or      h
                jr      nz,is16_wide
                ld      b,e                     ; B = |off| (< den)
                ld      c,l                     ; C = den
                exx
                ld      a,l                     ; |dy|
                exx
                call    umul_round_div          ; A = q (off < den keeps it a byte)
                ld      l,a
                ld      h,0
                jp      is16_q
is16_wide:
                push    hl                      ; |den|
                ld      c,e
                ld      b,d                     ; BC = |off|
                exx
                push    hl
                exx
                pop     de                      ; DE = |dy|
                call    umul16                  ; DE:HL = |off| * |dy|
                pop     bc                      ; |den|
                push    bc
                srl     b
                rr      c
                add     hl,bc
                jp      nc,is16_2
                inc     de
is16_2:         pop     bc
                call    udiv32_16               ; HL = q
is16_q:         ld      e,(ix+2)
                ld      d,(ix+3)
                exx
                ld      a,b                     ; the sign
                exx
                or      a
                jr      nz,is16_fall
                add     hl,de
                ret
is16_fall:      ex      de,hl
                or      a
                sbc     hl,de
                ret
is16_y0:        ld      l,(ix+2)
                ld      h,(ix+3)
                ret
is16_y1:        ld      l,(ix+6)
                ld      h,(ix+7)
                ret

; s16_at : HL = the target on the free axis -> HL = the s16 result, A = it
; clamped to a byte
s16_at:
                ld      ix,lci
                call    interp_s16
clamp8:         bit     7,h
                jr      nz,c8_lo
                ld      a,h
                or      a
                jr      nz,c8_hi
                ld      a,l
                ret
c8_lo:          xor     a
                ret
c8_hi:          ld      a,255
                ret

umul16:                                         ; BC * DE -> DE:HL
                ; the 8x8 partials (arith.s si_general), zero halves skipped
                ld      (um_bc),bc
                ld      (um_de),de
                ld      h,c
                ld      l,e
                MUL_U8_BODY                     ; C * E
                ld      (um_r0),hl
                ld      hl,0
                ld      (um_r2),hl
                ld      a,(um_bc+1)             ; B
                or      a
                jr      z,um_nob
                ld      h,a
                ld      a,(um_de)
                ld      l,a
                MUL_U8_BODY                     ; B * E, at byte 1
                call    um_add1
                ld      a,(um_de+1)             ; D
                or      a
                jr      z,um_nod
                ld      h,a
                ld      a,(um_bc+1)
                ld      l,a
                MUL_U8_BODY                     ; B * D, at byte 2
                ld      de,(um_r2)
                add     hl,de
                ld      (um_r2),hl
um_nob:         ld      a,(um_de+1)             ; D
                or      a
                jr      z,um_nod
                ld      h,a
                ld      a,(um_bc)
                ld      l,a
                MUL_U8_BODY                     ; C * D, at byte 1
                call    um_add1
um_nod:         ld      hl,(um_r0)
                ld      de,(um_r2)
                ret
um_add1:        ld      a,(um_r0+1)
                add     a,l
                ld      (um_r0+1),a
                ld      a,(um_r2)
                adc     a,h
                ld      (um_r2),a
                ld      a,(um_r2+1)
                adc     a,0
                ld      (um_r2+1),a
                ret

udiv32_16:                                      ; DE:HL / BC -> HL = q
                ; DE < BC (else q = 0, arith.s's no_u16_quot), BC < $8000.
                ; The BBC port's tiers: eight steps when the top three bytes
                ; fall short of the divisor (the quotient is a byte), else
                ; sixteen.  Each step shifts a dividend bit into the
                ; remainder and collects the borrow through RLA; the
                ; complement of the borrows is the quotient.
                ld      a,d
                cp      b
                jp      c,ud_ok
                jp      nz,ud_zero
                ld      a,e
                cp      c
                jp      nc,ud_zero
ud_ok:          ld      a,d
                or      a
                jr      nz,ud_16
                ld      a,e
                cp      b
                jr      c,ud_8
                jp      nz,ud_16
                ld      a,h
                cp      c
                jp      nc,ud_16
ud_8:           ld      a,l                     ; the byte to bring in
                ld      l,h
                ld      h,e                     ; the remainder, E:H
                or      a
                DUP     8
                rla
                adc     hl,hl
                sbc     hl,bc
                jr      nc,1F
                add     hl,bc
                scf
1:
                EDUP
                rla
                cpl
                ld      l,a
                ld      h,0
                ret
ud_16:          ex      de,hl                   ; HL = the remainder, DE = the low word
                ld      a,d
                or      a
                DUP     8
                rla
                adc     hl,hl
                sbc     hl,bc
                jr      nc,1F
                add     hl,bc
                scf
1:
                EDUP
                rla
                cpl
                ld      d,a                     ; q hi
                ld      a,e
                DUP     8
                rla
                adc     hl,hl
                sbc     hl,bc
                jr      nc,1F
                add     hl,bc
                scf
1:
                EDUP
                rla
                cpl
                ld      e,a                     ; q lo
                ex      de,hl
                ret
ud_zero:        ld      hl,0
                ret

; cl_range : HL = lo, DE = hi (s16) -> B = max(0, lo), C = min(255, hi) as
; bytes, carry set when the range [B, C) is not empty
cl_range:
                ld      a,h                     ; both already bytes (the common
                or      d                       ; case): no clamping at all
                jr      nz,cr_clamp
                ld      b,l
                ld      c,e
                ld      a,l
                cp      c
                ret                             ; carry: ilo < ihi
cr_clamp:       bit     7,h
                jr      z,cr_1
                ld      hl,0
cr_1:           ld      a,h
                or      a
                ret     nz                      ; lo >= 256 (carry clear)
                ld      b,l
                bit     7,d
                ret     nz                      ; hi < 0
                ld      a,d
                or      a
                jr      z,cr_2
                ld      e,RENDER_W-1
cr_2:           ld      c,e
                ld      a,b
                cp      c
                ret                             ; carry: ilo < ihi

; ===========================================================================
; The pool                                                          (pool.s)
; ===========================================================================
; sp_next : IX -> its successor's id in A, Z when there is none
                MACRO   SP_NEXT_A
                ld      a,(ix+SP_NEXT)
                or      a
                ENDM
                MACRO   IX_FROM_A               ; (IXH = SPH >> 8 stands)
                ld      ixl,a
                ENDM

; ===========================================================================
; sp_hasgap : HL = lo, DE = hi (s16, half-open) -> carry when a live span
; overlaps [max(0, lo), min(255, hi)).  One cached span answers the common
; repeat.                                                          (query.s)
; ===========================================================================
sp_hasgap:
                ld      a,h                     ; cl_range's common case inline:
                or      d                       ;  both already bytes
                jr      nz,shg_clamp
                ld      b,l
                ld      c,e
                ld      a,l
                cp      c
                ret     nc                      ; ilo >= ihi: nothing
                jp      shg_go
shg_clamp:      call    cl_range                ; B = ilo, C = ihi
                ret     nc
shg_go:
                ; the seg's own query: its walk IS the seek every one of the
                ; seg's lines would repeat (they share xl = sx1 and run before
                ; any list change), so the span found and its predecessor are
                ; memoed (dcls_first/dcls_prev) for dcl_pair2 and mark_solid
                ld      a,(sp_head)
                ld      h,SPH>>8
                ld      e,0                     ; the predecessor
                inc     b                       ; (ilo < ihi <= 255, so lo + 1
                                                ;  never wraps: `xe <= lo` is
                                                ;  ONE compare against it)
sg_l:           or      a
                jr      z,sg_none               ; (carry clear)
                ld      l,a
                inc     l
                inc     l                       ; -> xe
                ld      a,(hl)
                cp      b
                jr      c,sg_n                  ; xe <= lo: wholly left
sg_hit:         dec     l
                dec     l
                ld      a,l
                ld      (dcls_first),a
                ld      a,e
                ld      (dcls_prev),a
                inc     l                       ; -> xs
                dec     b                       ; (the bias back for the caller)
                ld      a,(hl)
                cp      c                       ; carry: xs < hi, a gap
                ret
sg_n:           dec     l
                dec     l
                ld      e,l                     ; the predecessor
                ld      a,(hl)
                or      a                       ; (the second span of the pair,
                jr      z,sg_none               ;  so only every other skip
                ld      l,a                     ;  pays the back edge)
                inc     l
                inc     l
                ld      a,(hl)
                cp      b
                jp      nc,sg_hit
                dec     l
                dec     l
                ld      e,l
                ld      a,(hl)
                jp      sg_l
sg_none:        dec     b                       ; (the bias back for the caller)
                ret
; hg_u8 : B = ilo, C = ihi already bytes with ilo < ihi (the box checks)
hg_u8:                                          ; the walk in HL (free here);
                ld      a,(sp_head)             ; B = ilo, C = ihi ride
                ld      h,SPH>>8
                inc     b                       ; (ilo < ihi <= 255: `xe <= lo`
                                                ;  is ONE compare against lo + 1)
                ; BBC 62a60e7: the has_gap candidate cache is retired - a miss
                ; walks only ~1.8 spans, so the probe cost about what it saved
                ; and the store ran every call (costlier still on the Z80)
hg_l:           or      a
                ret     z                       ; (carry clear)
                ld      l,a
                inc     l
                inc     l                       ; -> xe
                ld      a,(hl)
                cp      b
                jr      c,hg_n                  ; xe <= lo: wholly left
hg_hit:         dec     l                       ; -> xs
                ld      a,(hl)
                cp      c                       ; carry: xs < hi, a gap
                ret
hg_n:           dec     l
                dec     l
                ld      a,(hl)
                or      a                       ; (two spans to a back edge)
                ret     z
                ld      l,a
                inc     l
                inc     l
                ld      a,(hl)
                cp      b
                jp      nc,hg_hit
                dec     l
                dec     l
                ld      a,(hl)
                jp      hg_l

; ===========================================================================
; sp_marksolid : HL = lo, DE = hi (s16): the columns [lo, hi) become solid.
; Lazy: the spans' lines are copied verbatim across a split.
;                                                             (mark_solid.s)
; ===========================================================================
; sp_marksolid_memo : a solid pair's columns [sx1, sx2), both u8 and apart
; (rsb_solid checked), so cl_range is the identity; the walk starts at the
; span the pair's seek found (dcls_first, with dcls_prev before it): the
; vertical emits between are read-only, so the list is as the seek left it
sp_marksolid_memo:
                ld      a,(sg_sx1)
                ld      b,a
                ld      (cl_ilo),a
                ld      a,(sg_sx2)
                ld      c,a
                ld      (cl_ihi),a
                ld      a,(dcls_prev)
                ld      (sp_prev),a
                ld      a,(dcls_first)
                ld      h,SPH>>8
                jp      ms_loop
sp_marksolid:
                call    cl_range
                ret     nc
                ld      a,b
                ld      (cl_ilo),a
                ld      a,c
                ld      (cl_ihi),a
ms_u8:                                          ; B = ilo, C = ihi
                ; L walks the slots (H = the hot page); E is the successor
                ; when a slot goes
                xor     a
                ld      (sp_prev),a
                ld      a,(sp_head)
                ld      h,SPH>>8
ms_loop:        or      a
                ret     z
                ld      l,a
                inc     l
                inc     l                       ; -> xe
                ld      a,(hl)
                cp      b
                jr      z,ms_adv
                jr      c,ms_adv                ; xe <= lo: wholly left
                dec     l
                ld      a,(hl)                  ; xs
                cp      c
                ret     nc                      ; xs >= hi: past the range
                cp      b
                jr      c,ms_has_left           ; xs < lo
                inc     l
                ld      a,c
                cp      (hl)
                jp      nc,ms_free              ; hi >= xe: the whole span
                dec     l
                ld      (hl),c                  ; [hi, xe) survives
                ret
ms_free:        ; unlink it and give it back (L at xe)
                dec     l
                dec     l
                ld      e,(hl)                  ; E = the successor
                ld      a,(sp_free)
                ld      (hl),a
                ld      a,l
                ld      (sp_free),a
                ld      a,(sp_prev)
                or      a
                jr      z,ms_free_head
                ld      l,a
                ld      (hl),e
                jp      ms_cont
ms_free_head:   ld      a,e
                ld      (sp_head),a
ms_cont:        ld      a,e
                jp      ms_loop
ms_adv:         dec     l
                dec     l
                ld      a,l
                ld      (sp_prev),a
                ld      a,(hl)
                jp      ms_loop
ms_has_left:                                    ; L at xs
                inc     l                       ; -> xe
                ld      a,c
                cp      (hl)
                jr      nc,ms_left_only         ; hi >= xe: [xs, lo) survives
                ; [xs, lo) and [hi, xe): a fresh slot takes the right part
                ld      a,(sp_free)
                or      a
                jr      z,ms_left_only          ; the pool is spent
                ld      e,a
                ld      d,h                     ; DE = the new slot
                ld      a,(hl)                  ; the old xe
                ld      (hl),b                  ; this: xe = lo
                ex      af,af'
                dec     l
                dec     l                       ; HL = this
                ld      a,(de)                  ; the free list moves on
                ld      (sp_free),a
                ld      a,(hl)                  ; new.next = this.next
                ld      (de),a
                ld      (hl),e                  ; this.next = new
                inc     e                       ; -> xs
                ld      a,c
                ld      (de),a                  ; new.xs = hi
                inc     e
                ex      af,af'
                ld      (de),a                  ; new.xe = the old xe
                inc     e                       ; -> ot
                inc     l
                inc     l
                inc     l
                push    bc
                ldi                             ; the extremes
                ldi
                ldi
                ldi
                ld      a,l
                and     $F8
                ld      l,a
                ld      a,e
                and     $F8
                ld      e,a
                dec     h                       ; the lines
                dec     d
                ldi
                ldi
                ldi
                ldi
                ldi
                ldi
                ldi
                ldi
                pop     bc
                ret
ms_left_only:
                ld      (hl),b                  ; xe = lo
                jr      ms_adv
; ===========================================================================
; The display list
; ===========================================================================
; dl_emit : A = x0, B = y0, C = x1, D = y1 (screen rows): plotted at once.
; The rasteriser's bank is paged in around the plot and the caller's bank
; (cur_port, kept by set_page) put back, both from here in main RAM, so a
; bank-4 caller's return address is mapped again by the time it is used.
; OUT (n),A reaches $7FFD because the 128's paging port decodes only A15
; and A1, and the byte written never has bit 7 set.  Clobbers BC, DE, HL,
; IY, AF' (plot_line's).  BEEB NOTE: the display list this replaces cost
; ~250 T a line (emit + the render loop); this is ~95.
dl_emit:
                ld      e,c
                ld      c,a
dle_port:       ld      a,0                     ; SMC: rast_port, per frame
                out     (PORT_7FFD & 255),a
                call    plot_line
                ld      a,(cur_port)
                out     (PORT_7FFD & 255),a
                ret
                MACRO   DL_EMIT_TAIL            ; dl_emit inline, as a tail
                ld      e,c
                ld      c,a
                ld      a,(dle_port+1)
                out     (PORT_7FFD & 255),a
                call    plot_line
                ld      a,(cur_port)
                out     (PORT_7FFD & 255),a
                ret
                ENDM

; dcl_emit_segment : the run (IYH, IYL) - (C, D), unless it is a
; point
dcl_emit_segment:                               ; C = x1, D = y1 (biased)
                ld      a,iyh
                cp      c
                jp      nz,des_go
                ld      a,iyl
                cp      d
                ret     z
des_go:         ld      hl,adyn_ctr             ; a run went out: the walk's
                inc     (hl)                    ;  always-descend judge counts it
                ld      a,iyl
                sub     Y_BIAS
                ld      b,a
                ld      a,d
                sub     Y_BIAS
                ld      d,a
                ld      a,iyh
                cp      c
                jp      nz,des_emit
                ld      a,b                     ; a vertical goes out top first,
                cp      d                       ; as the 6502's des_to_v orders it
                ld      a,c
                jr      c,des_emit
                ld      e,b
                ld      b,d
                ld      d,e
des_emit:       DL_EMIT_TAIL

; ===========================================================================
; draw_clipped_line : the u8 line lc_x1/lc_y1 - lc_x2/lc_y2 (low bytes),
; x1 <= x2, clipped to the spans and plotted as runs.  Read-only.  (dcl.s)
; ===========================================================================
draw_clipped_line:
                ; The common line sits wholly inside one span with its rows
                ; inside the span's inner extremes: it goes out as it is,
                ; the very segment the walk below would build (ox0 = xl,
                ; ox1 = xr, the run closed by the exit check).  The walk
                ; takes over from that span otherwise.
                ld      a,(lc_x2)
                ld      hl,lc_x1
                sub     (hl)
                jp      z,dcl_vertical_h
                ld      (cd_dx),a
                ld      c,(hl)                  ; C = xl
                ld      a,(lc_x2)
                ld      b,a                     ; B = xr
                ld      a,(sp_head)
                or      a
                ret     z
                ld      h,SPH>>8
dcl_seek:       ; A = a slot: skip the spans wholly left of xl
                ld      l,a
                inc     l
                inc     l                       ; -> xe
                ld      a,(hl)
                cp      c
                jr      z,dcl_fn
                jr      c,dcl_fn                ; xe <= xl: wholly left
                dec     l
                dec     l
dcl_enter:                                      ; (dcl_pair2 enters here at the memo)
dcl_fx:         inc     l                       ; -> xs
                ld      a,(hl)
                cp      c
                jr      z,dcl_f1
                jr      nc,dcl_general          ; xs > xl: the line starts in a hole
dcl_f1:         inc     l                       ; -> xe
                ld      a,(hl)
                cp      b
                jr      c,dcl_general           ; xe < xr: it runs on past the span
                ld      a,(lc_y1)
                ld      e,a
                ld      a,(lc_y2)
                cp      e
                jp      nc,dcl_f2
                ld      d,a                     ; E = ylo, A = yhi
                ld      a,e
                ld      e,d
dcl_f2:         inc     l
                inc     l
                inc     l
                inc     l                       ; -> ib
                cp      (hl)
                jr      z,dcl_f3
                jr      nc,dcl_general          ; yhi > IB
dcl_f3:         dec     l
                dec     l                       ; -> it
                ld      a,e
                cp      (hl)
                jr      c,dcl_general           ; ylo < IT
                ld      a,c                     ; wholly inside: the line itself
                ex      af,af'
                ld      c,b
                ld      a,(lc_y2)
                sub     Y_BIAS
                ld      d,a
                ld      a,(lc_y1)
                sub     Y_BIAS
                ld      b,a
adyn_f3:        ld      hl,adyn_ctr             ; (a run: the walk's judge counts
                inc     (hl)                    ;  it, as dcl_emit_segment would)
                ex      af,af'
                DL_EMIT_TAIL
dcl_fn:         dec     l
                dec     l
                ld      a,(hl)
                or      a
                ret     z
                jp      dcl_seek
; dcl_pair2 : a seg's u8 line from sx1 to sx2 (the BBC port's dcl_solid_pair
; generalised): sp_hasgap already walked to the seg's first span, and the
; seg's lines all run before any list change, so the seek resumes there.
dcl_pair2:
                ld      a,(lc_x2)
                ld      b,a                     ; (B = xr: not reloaded below)
                ld      hl,lc_x1
                sub     (hl)
                ld      (cd_dx),a
                ld      c,(hl)
                ld      a,(dcls_first)
                or      a
                ret     z                       ; every span left of the pair
                ld      l,a
                ld      h,SPH>>8
                jp      dcl_enter
dcl_general:
                ; the walk proper, register-resident: C = xl, B = xr, D = ylo,
                ; E = yhi, L = the span (H = the hot page), IXH = ox0, IXL =
                ; ox1, IY = the open run's start (IYH = $FF: none; a plot
                ; eats IY, and every plot closes the run).  The trapezoid clip (dcl_cb_clip) works from the
                ; workspace with IX = the span and re-enters through the
                ; reload stubs.
                ld      a,(lc_y1)
                ld      e,a
                ld      a,(lc_y2)
                ld      d,a                     ; (D = y2: not reloaded below)
                sub     e
                ld      (cd_dy),a
                ld      a,d
                cp      e
                jp      nc,dcl_bb1              ; yr >= yl
                ld      d,a
                ld      a,e
                ld      e,d
dcl_bb1:        ld      d,e                     ; D = ylo
                ld      e,a                     ; E = yhi
                ld      iyh,$ff                 ; no open run
                ld      a,l
                and     $F8
                ld      l,a
dcl_not_left:                                   ; L = a span with xe > xl
                inc     l                       ; -> xs
                ld      a,(hl)
                cp      b
                jp      nc,dcl_flush            ; xs >= xr: done
                cp      c
                jp      nc,dcl_ox0
                ld      a,c                     ; ox0 = max(xs, xl)
dcl_ox0:        ld      ixh,a
                inc     l                       ; -> xe
                ld      a,(hl)
                cp      b
                jr      c,dcl_ox1
                ld      a,b                     ; ox1 = min(xe, xr)
dcl_ox1:        ld      ixl,a
dcl_entry_path:
                inc     l
                inc     l                       ; -> it
                ld      a,d
                cp      (hl)
                jr      c,dcl_ent_top           ; ylo < IT: above or ambiguous
                inc     l
                inc     l                       ; -> ib
                ld      a,(hl)
                cp      e
                jr      c,dcl_ent_bot           ; IB < yhi: below or ambiguous
dcl_accept:
                ld      a,iyh
                inc     a
                jr      nz,dcl_acc_haveopen
dcl_acc_open:
                ld      a,ixh
                ld      iyh,a
                cp      c
                jr      z,dcl_accept_yl
                ld      a,(cd_dy)
                or      a
                jr      z,dcl_accept_yl
                ld      a,ixh
                push    hl
                push    de
                push    bc
                call    line_y8
                pop     bc
                pop     de
                pop     hl
                jp      dcl_acc_sy
dcl_accept_yl:  ld      a,(lc_y1)
dcl_acc_sy:     ld      iyl,a
dcl_acc_extend:
                ld      a,ixl
                ld      (se_x),a
dcl_exit_check:
                ld      a,l
                and     $F8
                or      SP_XE
                ld      l,a
                ld      a,(hl)
                cp      b
                jr      c,dcl_next              ; the line runs on
                ld      a,(lc_y2)
                ld      d,a
                ld      a,ixl
                ld      c,a
                jp      dcl_emit_segment        ; the line ends here: its run
dcl_acc_haveopen:
                ld      a,(se_x)
                cp      ixh
                jp      z,dcl_acc_extend        ; contiguous
                push    hl
                push    de
                push    bc
                call    dcl_emit_open
                pop     bc
                pop     de
                pop     hl
                jr      dcl_acc_open
dcl_ent_bot:                                    ; L at ib
                dec     l                       ; -> ob
                ld      a,(hl)
                cp      d
                jp      c,dcl_reject            ; OB < ylo: wholly below
                jp      dcl_cb_go
dcl_ent_top:                                    ; L at it
                dec     l                       ; -> ot
                ld      a,e
                cp      (hl)
                jr      nc,dcl_cb_go
dcl_reject:                                     ; wholly outside: close a run
                ld      a,iyh
                inc     a
                jp      z,dcl_next
                push    hl
                push    de
                push    bc
                call    dcl_emit_open
                pop     bc
                pop     de
                pop     hl
                ld      iyh,$ff                 ; no open run
dcl_next:
                ld      a,l
                and     $F8
                ld      l,a
                ld      a,(hl)
                or      a
                jr      z,dcl_flush
                ld      l,a
                jp      dcl_not_left
dcl_cb_go:      ld      a,ixh
                ld      (ox0),a
                ld      a,ixl
                ld      (ox1),a
                ld      a,d                     ; the box, for dcl_reload
                ld      (cd_ylo),a
                ld      a,e
                ld      (cd_yhi),a
                ld      a,l
                and     $F8
                ld      ixl,a
                ld      ixh,SPH>>8              ; IX = the span, for the clip
                jp      dcl_cb_clip
; the trapezoid clip comes back here with the walk's state in the workspace
dcl_next_r:     call    dcl_reload
                jp      dcl_next
dcl_exit_check_r:
                call    dcl_reload
                ld      a,(ox1)
                ld      ixl,a
                jp      dcl_exit_check
dcl_reload:     ld      a,ixl
                ld      l,a
                ld      h,SPH>>8
                ld      a,(lc_x1)
                ld      c,a
                ld      a,(lc_x2)
                ld      b,a
                ld      a,(cd_ylo)
                ld      d,a
                ld      a,(cd_yhi)
                ld      e,a
                ret
dcl_flush:
                ld      a,iyh
                inc     a
                ret     z
                ; fall into dcl_emit_open
; dcl_emit_open : the open run ends at se_x
dcl_emit_open:
                ld      a,(se_x)
                ld      hl,lc_x2
                cp      (hl)
                jr      z,deo_yr
                ld      a,(cd_dy)
                or      a
                jr      z,deo_yr
                ld      a,(se_x)
                call    line_y8
                jp      deo_have
deo_yr:         ld      a,(lc_y2)
deo_have:       ld      d,a
                ld      a,(se_x)
                ld      c,a
                jp      dcl_emit_segment
dcl_close_open_nx:
                ld      a,iyh
                inc     a
                ret     z
                call    dcl_emit_open
                ld      iyh,$ff                 ; no open run
                ret

; --- the trapezoid clip on [ox0, ox1] against span IX -----------------------
dcl_cb_clip:
                ld      a,(ox0)
                ld      (cb_cx1),a
                ld      a,(ox1)
                ld      (cb_cx2),a
                ld      a,(cd_dy)
                or      a
                jp      nz,dcb_cy_slow
                ld      a,(lc_y1)
                ld      (cb_cy1),a
                ld      (cb_cy2),a
                jr      dcb_cy_done
dcb_cy_slow:
                IW_LINE
                ld      a,(cb_cx1)
                cp      b                       ; at x1: y1
                jr      z,dcb_cy1_yl
                call    interp_store
                jp      dcb_cy1_have
dcb_cy1_yl:     ld      a,(lc_y1)
dcb_cy1_have:   ld      (cb_cy1),a
                ld      a,(cb_cx2)
                ld      hl,lc_x2
                cp      (hl)
                jr      z,dcb_cy2_yr
                IW_LINE
                ld      a,(cb_cx2)
                call    interp_store
                jp      dcb_cy2_have
dcb_cy2_yr:     ld      a,(lc_y2)
dcb_cy2_have:   ld      (cb_cy2),a
dcb_cy_done:
                ld      a,(cb_cy2)
                cp      (ix+SP_IT)
                jr      c,dcb_top_c2u
                ld      a,(cb_cy1)
                cp      (ix+SP_IT)
                jr      c,dcb_top_c1only
                jp      dcb_top_done            ; both at or under IT
dcb_top_c2u:
                ld      a,(cb_cy1)
                cp      (ix+SP_IT)
                jr      c,dcb_top_eval          ; both above IT: two-sided
                ld      a,(cb_cx2)
                call    cb_top_at
                ld      (cb_top2),a
                ld      hl,cb_cy2
                cp      (hl)
                jp      z,dcb_top_done
                jp      c,dcb_top_done          ; top2 <= cy2: no clip
                ld      a,(cb_cx1)
                call    cb_top_at
                ld      (cb_top1),a
                jp      dcb_top_p2clip
dcb_top_c1only:
                ld      a,(cb_cx1)
                call    cb_top_at
                ld      (cb_top1),a
                ld      hl,cb_cy1
                ld      a,(hl)
                ld      hl,cb_top1
                cp      (hl)
                jp      nc,dcb_top_done         ; cy1 >= top1: no clip
                ld      a,(cb_cx2)
                call    cb_top_at
                ld      (cb_top2),a
                jp      dcb_top_clip
dcb_top_eval:
                LP_TLTR
                jr      nz,dcb_top_interp
                ld      (cb_top1),a
                ld      (cb_top2),a
                jr      dcb_top_evaled
dcb_top_interp:
                IW_TOP
                ld      a,(cb_cx1)
                call    interp_store
                ld      (cb_top1),a
                IW_TOP
                ld      a,(cb_cx2)
                call    interp_store
                ld      (cb_top2),a
dcb_top_evaled:
                ld      a,(cb_cy1)
                ld      hl,cb_top1
                cp      (hl)
                jr      nc,dcb_top_p1_ok
                ld      a,(cb_cy2)
                ld      hl,cb_top2
                cp      (hl)
                jr      nc,dcb_top_clip
                jp      dcl_cb_reject           ; both above
dcb_top_p1_ok:
                ld      a,(cb_cy2)
                ld      hl,cb_top2
                cp      (hl)
                jr      nc,dcb_top_done         ; both inside
dcb_top_p2clip:                                 ; cy1 >= top1, cy2 < top2
                ld      a,(cb_cy1)
                ld      hl,cb_top1
                sub     (hl)
                ld      d,a                     ; |d1| = cy1 - top1
                ld      a,(cb_top2)
                ld      hl,cb_cy2
                sub     (hl)
                ld      e,a                     ; |d2| = top2 - cy2
                xor     a
                call    dcl_boundary_ix
                ld      (cb_cx2),a
                call    line_y8
                ld      (cb_cy2),a
                jp      dcb_top_done
dcb_top_clip:                                   ; cy1 < top1, cy2 >= top2
                ld      a,(cb_top1)
                ld      hl,cb_cy1
                sub     (hl)
                ld      d,a                     ; |d1| = top1 - cy1
                ld      a,(cb_cy2)
                ld      hl,cb_top2
                sub     (hl)
                ld      e,a                     ; |d2| = cy2 - top2
                ld      a,1
                call    dcl_boundary_ix
                ld      (cb_cx1),a
                call    line_y8
                ld      (cb_cy1),a
                ld      a,(ox0)
                ld      hl,cb_cx1
                cp      (hl)
                jr      nc,dcb_top_done
                call    dcl_close_open_nx       ; a gap before cx1
dcb_top_done:
                ld      a,(cb_cx2)
                ld      hl,cb_cx1
                cp      (hl)
                jp      c,dcl_cb_reject         ; the top left nothing
dcb_top_ok:
                ld      a,(ix+SP_IB)
                ld      hl,cb_cy1
                cp      (hl)
                jr      c,dcb_bot_c1o           ; IB < cy1
                ld      hl,cb_cy2
                cp      (hl)
                jr      c,dcb_bot_c2only        ; IB < cy2
                jp      dcb_bot_done            ; both at or above IB
dcb_bot_c1o:
                ld      hl,cb_cy2
                cp      (hl)
                jr      c,dcb_bot_eval          ; both below IB: two-sided
                ld      a,(cb_cx1)
                call    cb_bot_at
                ld      (cb_bot1),a
                ld      hl,cb_cy1
                cp      (hl)
                jp      nc,dcb_bot_done         ; bot1 >= cy1: no clip
                ld      a,(cb_cx2)
                call    cb_bot_at
                ld      (cb_bot2),a
                jp      dcb_bot_clip
dcb_bot_c2only:
                ld      a,(cb_cx2)
                call    cb_bot_at
                ld      (cb_bot2),a
                ld      hl,cb_cy2
                cp      (hl)
                jp      nc,dcb_bot_done         ; bot2 >= cy2: no clip
                ld      a,(cb_cx1)
                call    cb_bot_at
                ld      (cb_bot1),a
                jp      dcb_bot_p2clip
dcb_bot_eval:
                LP_BLBR
                jp      nz,dcb_bot_interp
                ld      (cb_bot1),a
                ld      (cb_bot2),a
                jr      dcb_bot_evaled
dcb_bot_interp:
                IW_BOT
                ld      a,(cb_cx1)
                call    interp_store
                ld      (cb_bot1),a
                IW_BOT
                ld      a,(cb_cx2)
                call    interp_store
                ld      (cb_bot2),a
dcb_bot_evaled:
                ld      a,(cb_bot1)
                ld      hl,cb_cy1
                cp      (hl)
                jr      nc,dcb_bot_p1_ok
                ld      a,(cb_bot2)
                ld      hl,cb_cy2
                cp      (hl)
                jr      nc,dcb_bot_clip
                jp      dcl_cb_reject           ; both below
dcb_bot_p1_ok:
                ld      a,(cb_bot2)
                ld      hl,cb_cy2
                cp      (hl)
                jr      nc,dcb_bot_done         ; both inside
dcb_bot_p2clip:                                 ; bot1 >= cy1, bot2 < cy2
                ld      a,(cb_bot1)
                ld      hl,cb_cy1
                sub     (hl)
                ld      d,a                     ; |d1| = bot1 - cy1
                ld      a,(cb_cy2)
                ld      hl,cb_bot2
                sub     (hl)
                ld      e,a                     ; |d2| = cy2 - bot2
                xor     a
                call    dcl_boundary_ix
                ld      (cb_cx2),a
                call    line_y8
                ld      (cb_cy2),a
                jp      dcb_bot_done
dcb_bot_clip:                                   ; bot1 < cy1, bot2 >= cy2
                ld      a,(cb_cy1)
                ld      hl,cb_bot1
                sub     (hl)
                ld      d,a                     ; |d1| = cy1 - bot1
                ld      a,(cb_bot2)
                ld      hl,cb_cy2
                sub     (hl)
                ld      e,a                     ; |d2| = bot2 - cy2
                ld      a,1
                call    dcl_boundary_ix
                ld      (cb_cx1),a
                call    line_y8
                ld      (cb_cy1),a
                ld      a,(ox0)
                ld      hl,cb_cx1
                cp      (hl)
                jr      nc,dcb_bot_done
                call    dcl_close_open_nx
dcb_bot_done:
                ld      a,(cb_cx2)
                ld      hl,cb_cx1
                cp      (hl)
                jr      c,dcl_cb_reject         ; the bottom left nothing
                ld      hl,ox1
                cp      (hl)
                jr      nc,dcb_no_exit_clip     ; cx2 >= ox1: it runs on
                ; the line leaves the aperture inside this span
                ld      a,iyh
                inc     a
                jr      z,dcbx_open
                ld      a,(cb_cx1)
                ld      hl,se_x
                cp      (hl)
                jr      z,dcbx_emit             ; contiguous: extend the run
                call    dcl_close_open_nx
dcbx_open:      ld      a,(cb_cx1)
                ld      iyh,a
                ld      a,(cb_cy1)
                ld      iyl,a
dcbx_emit:      ld      a,(cb_cy2)
                ld      d,a
                ld      a,(cb_cx2)
                ld      c,a
                call    dcl_emit_segment
                ld      iyh,$ff                 ; no open run
                jp      dcl_next_r
dcb_no_exit_clip:
                ld      a,iyh
                inc     a
                jr      z,dcbn_open
                ld      a,(cb_cx1)
                ld      hl,se_x
                cp      (hl)
                jr      z,dcbn_extend
                call    dcl_emit_open           ; a gap: close the old run
dcbn_open:      ld      a,(cb_cx1)
                ld      iyh,a
                ld      a,(cb_cy1)
                ld      iyl,a
dcbn_extend:    ld      a,(cb_cx2)
                ld      (se_x),a
                jp      dcl_exit_check_r
dcl_cb_reject:
                call    dcl_close_open_nx
                jp      dcl_next_r

; ===========================================================================
; Verticals.  dcl_vert_on : A = the column, lc_y1/lc_y2 s16 rows, biased -
; the descriptors' entry, which clamps the rows into the band first.
; dcl_vertical : the u8 vertical at lc_x1 from lc_y1 to lc_y2.
; ===========================================================================
dcl_vert_on:
                ld      (lc_x1),a
                ld      a,(lc_y1+1)
                or      a
                jp      nz,dvc_y1_clamp
dvc_y1_done:    ld      a,(lc_y2+1)
                or      a
                jp      nz,dvc_y2_clamp
dvc_y2_done:    ld      a,(lc_y1)
                ld      hl,lc_y2
                cp      (hl)
                ret     z                       ; a point
dcl_vertical:   ; FALLEN INTO from dcl_vert_on: a seg's vertical, at a
                ; column >= sx1 before any list change, so the scan starts at
                ; the span sp_hasgap memoed (0 = none) instead of the head.
                ; (It used to fall into dcl_vertical_h below - the head scan -
                ; which walked 4.2 spans a call where the Beeb walks 1.3.)
                ld      a,(dcls_first)
                jp      dcl_vertical_go
dcl_vertical_h: ; the general entry (draw_clipped_line): the scan from the head
                ld      a,(sp_head)
dcl_vertical_go:
                ld      l,a
                ld      h,SPH>>8
                ; register-resident: C = x, D = ylo, E = yhi, IX = the column's
                ; span; the ambiguous cases stage cb_cy1/cb_cy2 as before
                ld      a,(lc_y1)
                ld      d,a
                ld      a,(lc_y2)
                cp      d
                jp      nc,dv_bb1               ; yr >= yl
                ld      e,d
                ld      d,a
                ld      a,e
dv_bb1:         ld      e,a                     ; D = ylo, E = yhi
                ld      a,l                     ; (L = the first slot to scan)
                or      a
                ret     z
                ld      a,(lc_x1)
                ld      c,a
                inc     l
                inc     l                       ; -> the span's xe
dv_x:           ld      a,c                     ; (two spans to a back edge)
                cp      (hl)
                jr      c,dv_own                ; xl < xe: reaches past the column
                dec     l
                dec     l
                ld      a,(hl)                  ; the successor
                or      a
                ret     z
                ld      l,a
                inc     l
                inc     l
                ld      a,c
                cp      (hl)
                jr      c,dv_own
                dec     l
                dec     l
                ld      a,(hl)
                or      a
                ret     z
                ld      l,a
                inc     l
                inc     l
                jp      dv_x
dv_own:         dec     l                       ; -> xs
                ld      a,c
                cp      (hl)
                ret     c                       ; xl < xs: the column is solid
                dec     l
                ld      a,l
                ld      ixl,a
                ld      ixh,SPH>>8
dv_in:
                ld      a,d
                cp      (ix+SP_IT)
                jr      c,dv_amb_top
                ld      a,(ix+SP_IB)
                cp      e
                jr      c,dv_amb_botonly        ; IB < yhi
                ld      b,d                     ; the whole column: (ylo, yhi)
                jp      dv_emit
dv_amb_botonly:
                ld      a,(ix+SP_OB)
                cp      d
                ret     c                       ; OB < ylo: wholly below
                ld      a,d
                ld      (cb_cy1),a
                jr      dv_bot_eval
dv_amb_top:
                ld      a,e
                cp      (ix+SP_OT)
                ret     c                       ; yhi < OT: wholly above
                ld      a,(ix+SP_OB)
                cp      d
                ret     c
dv_fp_exact:
                LP_TLTR
                jr      z,dv_top_const
                push    de
                push    bc
                IW_TOP
                ld      a,(lc_x1)
                call    interp_store
                pop     bc
                pop     de
dv_top_const:   cp      d
                jr      c,dv_cy1_ok             ; top1 < ylo: ylo stands
                jr      z,dv_cy1_ok
                ld      d,a                     ; cy1 = top1
dv_cy1_ok:      ld      a,d
                ld      (cb_cy1),a
                ld      a,(ix+SP_IB)
                cp      e
                jr      nc,dv_bot_skip          ; IB >= yhi
dv_bot_eval:
                LP_BLBR
                jr      z,dv_bot_const
                push    de
                push    bc
                IW_BOT
                ld      a,(lc_x1)
                call    interp_store
                pop     bc
                pop     de
dv_bot_const:   cp      e
                jr      nc,dv_cy2_ok            ; bot1 >= yhi: yhi stands
                ld      e,a                     ; cy2 = bot1
dv_cy2_ok:      ld      a,(cb_cy1)
                ld      b,a
                ld      a,e
                cp      b
                ret     c                       ; cy2 < cy1: clipped away
                jp      dv_emit
dv_bot_skip:
                ld      a,(cb_cy1)
                ld      b,a
                ld      a,e
                cp      b
                ret     c
dv_emit:        ; B = cy1, E = cy2, C = x
                ld      a,e
                sub     Y_BIAS
                ld      d,a
                ld      a,b
                sub     Y_BIAS
                ld      b,a
                ld      a,c
                DL_EMIT_TAIL
dvc_y1_clamp:
                bit     7,a
                jr      nz,dvc_y1_neg
                ld      a,(lc_y2+1)             ; y1 below the band
                bit     7,a
                jr      nz,dvc_y1_cl
                or      a
                ret     nz                      ; y2 below too
dvc_y1_cl:      ld      a,$ff
                ld      (lc_y1),a
                jp      dvc_y1_done
dvc_y1_neg:     ld      a,(lc_y2+1)             ; y1 above the band
                bit     7,a
                ret     nz                      ; y2 above too
                xor     a
                ld      (lc_y1),a
                jp      dvc_y1_done
dvc_y2_clamp:
                bit     7,a
                jr      nz,dvc_y2_neg
                ld      a,$ff
                ld      (lc_y2),a
                jp      dvc_y2_done
dvc_y2_neg:     xor     a
                ld      (lc_y2),a
                jp      dvc_y2_done

; ===========================================================================
; dcl_s16 : the s16 line lc_x1/lc_y1 - lc_x2/lc_y2 (rows biased), clipped
; to the u8 box and handed to draw_clipped_line - or, in fused mode, to the
; walker, with the clipped-off ranges' verdicts applied as flats.
;                                                               (dcl_s16.s)
; ===========================================================================
dcl_s16:
                ld      a,(lc_x1+1)
                ld      hl,lc_y1+1
                or      (hl)
                ld      hl,lc_x2+1
                or      (hl)
                ld      hl,lc_y2+1
                or      (hl)
                jr      nz,dcl16_main
dcl16_fastu8:
                ld      a,(lc_x1)
                ld      hl,lc_x2
                cp      (hl)
                jp      nz,draw_clipped_line
                ld      a,(lc_y1)
                ld      hl,lc_y2
                cp      (hl)
                ret     z                       ; a point
                jp      draw_clipped_line       ; a vertical
dcl16_main:
                ld      a,$80
                ld      (dclv_s16vy),a          ; no pending right verdict
                ld      a,(lc_x1)
                ld      hl,lc_x2
                cp      (hl)
                jp      nz,mc_ordered
                ld      a,(lc_x1+1)
                ld      hl,lc_x2+1
                cp      (hl)
                jr      nz,mc_ordered
                ld      a,(lc_y1)
                ld      hl,lc_y2
                cp      (hl)
                jp      nz,mc_vertical
                ld      a,(lc_y1+1)
                ld      hl,lc_y2+1
                cp      (hl)
                jr      nz,mc_vertical
                ret                             ; a point
mc_vertical:
                ld      a,(fw_mode)
                bit     7,a
                jr      nz,mc_ordered           ; armed verticals take the generic path
                ld      a,(lc_x1+1)
                or      a
                ret     nz                      ; off the screen either side
                ld      a,(lc_y1+1)
                or      a
                jr      z,mcv_y1_done
                jp      m,mcv_y1_neg
                ld      a,(lc_y2+1)             ; y1 below the band
                bit     7,a
                jr      nz,mcv_y1_cl
                or      a
                ret     nz                      ; y2 below too
mcv_y1_cl:      ld      a,$ff
                ld      (lc_y1),a
                xor     a
                ld      (lc_y1+1),a
                jr      mcv_y1_done
mcv_y1_neg:     ld      a,(lc_y2+1)             ; y1 above the band
                bit     7,a
                ret     nz
                xor     a
                ld      (lc_y1),a
                ld      (lc_y1+1),a
mcv_y1_done:
                ld      a,(lc_y2+1)
                or      a
                jr      z,mcv_y2_done
                jp      m,mcv_y2_neg
                ld      a,$ff
                ld      (lc_y2),a
                xor     a
                ld      (lc_y2+1),a
                jr      mcv_y2_done
mcv_y2_neg:     xor     a
                ld      (lc_y2),a
                ld      (lc_y2+1),a
mcv_y2_done:
                ld      a,(lc_y1)
                ld      hl,lc_y2
                cp      (hl)
                ret     z
                jp      draw_clipped_line
mc_ordered:
                ld      a,(lc_x1+1)
                bit     7,a
                jr      z,x1_in_or_big
                ld      a,(lc_x2+1)
                bit     7,a
                jr      z,not_both_x
                jp      dcl_rec_s16r_flush      ; both x < 0
x1_in_or_big:
                or      a
                jp      z,not_both_x            ; x1 in [0, 255]
                ld      a,(lc_x2+1)
                bit     7,a
                jr      nz,not_both_x
                or      a
                jr      z,not_both_x
                jp      dcl_rec_s16r_flush      ; both x > 255
not_both_x:
                ld      a,(lc_y1+1)
                ld      hl,lc_y2+1
                or      (hl)
                jp      z,mc_xonly
                ld      a,(lc_y1+1)
                bit     7,a
                jr      z,y1_in_or_big
                ld      a,(lc_y2+1)
                bit     7,a
                jr      z,not_both_y
                ld      a,(fw_mode)             ; armed: keep the flat verdict
                bit     7,a
                jr      nz,not_both_y
                jp      dcl_rec_s16r_flush
y1_in_or_big:
                or      a
                jr      z,not_both_y
                ld      a,(lc_y2+1)
                bit     7,a
                jr      nz,not_both_y
                or      a
                jr      z,not_both_y
                ld      a,(fw_mode)
                bit     7,a
                jr      nz,not_both_y
                jp      dcl_rec_s16r_flush
not_both_y:
                ld      a,(lc_x1+1)
                ld      hl,lc_x2+1
                or      (hl)
                jr      z,skip_xclip
                ; --- the x clip: each end outside [0, 255] moves to the edge,
                ; its y the s16 interpolation there (unclamped) ---
                call    stage_lc_xy
                ld      a,(lc_x1+1)
                bit     7,a
                jr      z,x1_not_neg
                ld      hl,0
                call    s16_at
                ld      (lc_y1),hl
                ld      hl,0
                ld      (lc_x1),hl
                jr      x1_done
x1_not_neg:     or      a
                jr      z,x1_done
                ld      hl,255
                call    s16_at
                ld      (lc_y1),hl
                ld      hl,255
                ld      (lc_x1),hl
x1_done:
                ld      a,(lc_x2+1)
                bit     7,a
                jp      z,x2_not_neg
                ld      hl,0
                call    s16_at
                ld      (lc_y2),hl
                ld      hl,0
                ld      (lc_x2),hl
                jr      skip_xclip
x2_not_neg:     or      a
                jr      z,skip_xclip
                ld      hl,255
                call    s16_at
                ld      (lc_y2),hl
                ld      hl,255
                ld      (lc_x2),hl
skip_xclip:
                ld      a,(lc_y1+1)
                bit     7,a
                jp      z,y1a_in_or_big
                ld      a,(lc_y2+1)
                bit     7,a
                jr      z,not_both_y2
                xor     a                       ; the whole line above the band
                call    dcl_rec_flat_line
                jp      dcl_rec_s16r_flush
y1a_in_or_big:
                or      a
                jr      z,not_both_y2
                ld      a,(lc_y2+1)
                bit     7,a
                jr      nz,not_both_y2
                or      a
                jr      z,not_both_y2
                ld      a,$ff                   ; the whole line below the band
                call    dcl_rec_flat_line
                jp      dcl_rec_s16r_flush
not_both_y2:
                ld      a,(lc_y1+1)
                ld      hl,lc_y2+1
                or      (hl)
                jp      z,y_in_range
                ; --- the y clip, axes swapped: an end outside the band moves
                ; to the band's edge, its x the interpolation there ---
                call    stage_lc_yx
                ld      a,(lc_x1)
                ld      (lc_ox1),a              ; the flats' originals
                ld      a,(lc_x2)
                ld      (lc_ox2),a
                ld      a,(lc_y1+1)
                bit     7,a
                jr      z,y1c_not_neg
                ld      hl,0
                call    s16_at
                ld      (lc_x1),a
                xor     a
                ld      (lc_x1+1),a
                ld      (lc_y1),a
                ld      (lc_y1+1),a
                ld      a,(fw_mode)
                bit     7,a
                jr      z,y1c_done
                xor     a                       ; [orig xl, xl) left via the top
                call    dcl_rec_flat_y1
                jr      y1c_done
y1c_not_neg:    or      a
                jr      z,y1c_done
                ld      hl,255
                call    s16_at
                ld      (lc_x1),a
                xor     a
                ld      (lc_x1+1),a
                ld      a,$ff
                ld      (lc_y1),a
                xor     a
                ld      (lc_y1+1),a
                ld      a,(fw_mode)
                bit     7,a
                jr      z,y1c_done
                ld      a,$ff                   ; [orig xl, xl) left via the bottom
                call    dcl_rec_flat_y1
y1c_done:
                ld      a,(lc_y2+1)
                bit     7,a
                jr      z,y2c_not_neg
                ld      hl,0
                call    s16_at
                ld      (lc_x2),a
                xor     a
                ld      (lc_x2+1),a
                ld      (lc_y2),a
                ld      (lc_y2+1),a
                ld      (dclv_s16vy),a          ; [xr, orig xr) left via the top
                jr      y_in_range
y2c_not_neg:    or      a
                jr      z,y_in_range
                ld      hl,255
                call    s16_at
                ld      (lc_x2),a
                xor     a
                ld      (lc_x2+1),a
                ld      a,$ff
                ld      (lc_y2),a
                xor     a
                ld      (lc_y2+1),a
                ld      a,$ff
                ld      (dclv_s16vy),a          ; [xr, orig xr) left via the bottom
y_in_range:
                ld      a,(lc_x1)
                ld      hl,lc_x2
                cp      (hl)
                jp      c,dispatch_dcl
                jr      nz,rsac                 ; the clip reordered the ends
                ld      a,(lc_y1)
                ld      hl,lc_y2
                cp      (hl)
                jp      z,dcl_rec_s16r_flush    ; a point
dispatch_dcl:
                ld      a,(fw_mode)
                bit     7,a
                jr      nz,dd_fused
                call    draw_clipped_line
                jp      dcl_rec_s16r_flush
dd_fused:       call    fw_walk_line
                jp      dcl_rec_s16r_flush
rsac:           ld      a,(lc_x1)
                ld      hl,lc_x2
                ld      b,(hl)
                ld      (hl),a
                ld      a,b
                ld      (lc_x1),a
                ld      a,(lc_y1)
                ld      hl,lc_y2
                ld      b,(hl)
                ld      (hl),a
                ld      a,b
                ld      (lc_y1),a
                jr      dispatch_dcl

; the x clip alone: both rows in the band
mc_xonly:
                call    stage_lc_xy
                ld      a,(lc_x1+1)
                bit     7,a
                jr      z,xo_x1_notneg
                ld      hl,0
                call    s16_at
                ld      (lc_y1),a
                ld      hl,0
                ld      (lc_x1),hl
                jp      xo_x2
xo_x1_notneg:   or      a
                jp      z,xo_x2
                ld      hl,255
                call    s16_at
                ld      (lc_y1),a
                ld      hl,255
                ld      (lc_x1),hl
xo_x2:
                ld      a,(lc_x2+1)
                bit     7,a
                jp      z,xo_x2_notneg
                ld      hl,0
                call    s16_at
                ld      (lc_y2),a
                ld      hl,0
                ld      (lc_x2),hl
                jr      xo_disp
xo_x2_notneg:   or      a
                jr      z,xo_disp
                ld      hl,255
                call    s16_at
                ld      (lc_y2),a
                ld      hl,255
                ld      (lc_x2),hl
xo_disp:
                ld      a,(lc_x1)
                ld      hl,lc_x2
                cp      (hl)
                jp      z,dcl16_fastu8          ; vertical or point
                ld      a,(fw_mode)
                bit     7,a
                jp      nz,fw_walk_line
                jp      draw_clipped_line

; the s16 interp block: (x0, y0, x1, y1) from the line, or with the axes
; swapped for the y clip
stage_lc_xy:
                ld      hl,(lc_x1)
                ld      (lci),hl
                ld      hl,(lc_y1)
                ld      (lci+2),hl
                ld      hl,(lc_x2)
                ld      (lci+4),hl
                ld      hl,(lc_y2)
                ld      (lci+6),hl
                ret
stage_lc_yx:
                ld      hl,(lc_y1)
                ld      (lci),hl
                ld      hl,(lc_x1)
                ld      (lci+2),hl
                ld      hl,(lc_y2)
                ld      (lci+4),hl
                ld      hl,(lc_x2)
                ld      (lci+6),hl
                ret

; --- the clipped-off ranges' verdicts: a flat 'above' (0) or 'below'
; ($FF) over a column range, applied at once in fused mode ---------------
dcl_rec_flat_line:                              ; A = the verdict, the whole line
                ld      (dclv_yv),a
                ld      a,(lc_x1)
                ld      (dclv_x0),a
                ld      a,(lc_x2)
                ld      (dclv_x1),a
                jr      dcl_rec_flat_v
dcl_rec_flat_y1:                                ; [orig xl, xl)
                ld      (dclv_yv),a
                ld      a,(lc_ox1)
                ld      (dclv_x0),a
                ld      a,(lc_x1)
                ld      (dclv_x1),a
                jr      dcl_rec_flat_v
dcl_rec_s16r_flush:                             ; [xr, orig xr), if pending
                ld      a,(dclv_s16vy)
                cp      $80
                ret     z
                ld      (dclv_yv),a
                ld      a,$80
                ld      (dclv_s16vy),a
                ld      a,(lc_x2)
                ld      (dclv_x0),a
                ld      a,(lc_ox2)
                ld      (dclv_x1),a
dcl_rec_flat_v:
                ld      a,(fw_mode)
                bit     7,a
                ret     z                       ; plain draws keep no verdicts
                ld      a,(dclv_x0)
                ld      hl,dclv_x1
                cp      (hl)
                ret     nc                      ; empty
                ld      c,(hl)
                ld      hl,dclv_yv
                ld      b,(hl)
                ld      (fw_pol),a              ; (below: fused_flat takes B)
                ld      a,b
                ld      (fw_pol),a
                ld      a,(dclv_x0)
                jp      fused_flat

; ===========================================================================
; The FUSED walker: an aperture edge is clipped like any line, its visible
; runs plotted, and each run applied at once as the side's new boundary on
; the spans it covers.                                    (fused.s, fusedw.s)
; ===========================================================================
; fused_line : the s16 line in lc_*, A = the side (0 top, $80 bottom)
fused_line:
                ld      (fw_side),a
                ld      a,(lc_y1+1)
                ld      hl,lc_y2+1
                or      (hl)
                ld      hl,lc_x1+1
                or      (hl)
                ld      hl,lc_x2+1
                or      (hl)
                jr      nz,fh_slow
                ld      a,(lc_x1)
                ld      hl,lc_x2
                cp      (hl)
                jr      z,fh_vert
                jp      fw_walk_staged          ; (fwl_* alias the lc_* bytes)
fh_vert:        ld      a,(lc_y1)
                ld      hl,lc_y2
                cp      (hl)
                ret     z                       ; a point
                jp      draw_clipped_line       ; a vertical: plotted as ever
fh_slow:        ld      a,$80
                ld      (fw_mode),a
                call    dcl16_main
                xor     a
                ld      (fw_mode),a
                ret

; fw_walk_line : the u8 line in lc_* (the s16 dispatch lands here)
fw_walk_line:
                ld      a,(lc_x1)
                ld      hl,lc_x2
                cp      (hl)
                jp      z,draw_clipped_line     ; a vertical
fw_walk_staged:                                 ; (fwl_* alias the lc_* bytes; the
                                                ;  open run rides IY: IYH = its x0,
                                                ;  $FF none, IYL = its end column)
                ld      a,(fwl_yr)
                ld      d,a                     ; (D = yr: not reloaded below)
                ld      hl,fwl_yl
                sub     (hl)
                ld      (fwl_dy),a
                ld      a,(fwl_xr)
                ld      hl,fwl_xl
                sub     (hl)
                ld      (fwl_dx),a
                ld      a,(fwl_yl)
                ld      b,a
                ld      a,d
                cp      b
                jp      nc,wl_min
                ld      c,a
                ld      a,b
                ld      b,c
wl_min:         ld      (fwl_hi),a
                ld      a,b
                ld      (fwl_lo),a
                ld      iyh,$ff                 ; no open run             ; no open run
                ld      a,(fwl_xl)
                ld      c,a
                ld      a,(sp_head)
                or      a
                jr      z,wl_flush
                ld      h,SPH>>8
wl_sx:          ld      l,a                     ; the seek, two spans to a
                inc     l                       ;  back edge
                inc     l                       ; -> xe
                ld      a,c
                cp      (hl)
                jr      c,wl_found              ; xl < xe
                dec     l
                dec     l
                ld      a,(hl)
                or      a
                jr      z,wl_flush
                ld      l,a
                inc     l
                inc     l
                ld      a,c
                cp      (hl)
                jr      c,wl_found
                dec     l
                dec     l
                ld      a,(hl)
                or      a
                jr      z,wl_flush
                jp      wl_sx
wl_found:       dec     l
                dec     l
                ld      a,l
                ld      ixl,a
                ld      ixh,SPH>>8
wl_proc:
                ld      a,(ix+SP_NEXT)
                ld      (fw_next),a
                ld      a,(ix+SP_XS)
                ld      hl,fwl_xr
                cp      (hl)
                jr      nc,wl_flush             ; xs >= xr: done
                call    fw_clip_span            ; A = xs rides in
                ld      a,(fw_next)
                or      a
                jr      z,wl_flush
                ld      ixl,a
                ld      ixh,SPH>>8
                jp      wl_proc
wl_flush:
                ld      a,iyh
                inc     a
                ret     z
                jp      fw_close_run

; fw_clip_span : the line on span IX's overlap [zx0, zx1): A = xs
fw_clip_span:
                ld      hl,fwl_xl
                cp      (hl)
                jp      nc,cs_ox0
                ld      a,(hl)
cs_ox0:         ld      c,a                     ; C = zx0 = max(xs, xl)
                ld      a,(ix+SP_XE)
                ld      hl,fwl_xr
                cp      (hl)
                jr      c,cs_ox1
                ld      a,(hl)
cs_ox1:         ld      b,a                     ; B = zx1 = min(xe, xr)
                ld      a,(fwl_lo)
                cp      (ix+SP_IT)
                jr      c,cs_ent_top
                ld      a,(ix+SP_IB)
                ld      hl,fwl_hi
                cp      (hl)
                jr      c,cs_ent_bot
                ; visible over the whole overlap: the piece rides B/C
                ld      de,$ff80                ; the entry y comes lazily, an
                jp      fw_run_visible          ;  open end
cs_ent_top:
                ld      (fwl_zx0),bc            ; the overlap, for the clip
                ld      a,(fwl_hi)
                cp      (ix+SP_OT)
                jr      nc,fw_cb
cs_rej_above:                                   ; 'above': kills on the bottom side
                call    fw_touch_close
                ld      a,(fw_side)
                bit     7,a
                ret     z
                jr      cs_kill
cs_ent_bot:
                ld      (fwl_zx0),bc
                ld      a,(ix+SP_OB)
                ld      hl,fwl_lo
                cp      (hl)
                jp      nc,fw_cb
cs_rej_below:                                   ; 'below': kills on the top side
                call    fw_touch_close
                ld      a,(fw_side)
                bit     7,a
                ret     nz
cs_kill:        ld      a,(fwl_zx1)
                ld      c,a
                ld      a,(fwl_zx0)
                jp      fused_kill

; the flat's bookkeeping: it counts, and closes any open run first
fw_touch_close:
                ld      a,1
                ld      (fw_touch),a
                ld      a,iyh
                inc     a
                ret     z
                jp      fw_close_run

; --- fw_cb : the trapezoid clip on [zx0, zx1), the flats and run closes
; applied at once ---------------------------------------------------------
fw_cb:
                ld      a,$80
                ld      (fwl_pend),a
                ld      a,(fwl_zx0)
                ld      (fwl_leftf),a
                ld      (cb_cx1),a
                ld      a,(fwl_zx1)
                ld      (cb_cx2),a
                ld      a,(fwl_dy)
                or      a
                jp      nz,fcb_cy_slow
                ld      a,(fwl_yl)
                ld      (cb_cy1),a
                ld      (cb_cy2),a
                jr      fcb_cy_done
fcb_cy_slow:
                IW_FWL
                ld      a,(cb_cx1)
                cp      b
                jr      z,fcb_cy1_yl
                call    interp_store
                jr      fcb_cy1_have
fcb_cy1_yl:     ld      a,(fwl_yl)
fcb_cy1_have:   ld      (cb_cy1),a
                ld      a,(cb_cx2)
                ld      hl,fwl_xr
                cp      (hl)
                jr      z,fcb_cy2_yr
                IW_FWL
                ld      a,(cb_cx2)
                call    interp_store
                jr      fcb_cy2_have
fcb_cy2_yr:     ld      a,(fwl_yr)
fcb_cy2_have:   ld      (cb_cy2),a
fcb_cy_done:
                ld      a,(cb_cy2)
                cp      (ix+SP_IT)
                jr      c,fcb_top_eval
                ld      a,(cb_cy1)
                cp      (ix+SP_IT)
                jr      c,fcb_top_eval
                jp      fcb_top_done            ; both at or under IT
fcb_top_eval:
                LP_TLTR
                jr      nz,fcb_top_interp
                ld      (fw_top1),a
                ld      (fw_top2),a
                jr      fcb_top_evaled
fcb_top_interp:
                IW_TOP
                ld      a,(cb_cx1)
                call    interp_store
                ld      (fw_top1),a
                IW_TOP
                ld      a,(cb_cx2)
                call    interp_store
                ld      (fw_top2),a
fcb_top_evaled:
                ld      a,(cb_cy1)
                ld      hl,fw_top1
                cp      (hl)
                jr      nc,fcb_top_p1_ok
                ld      a,(cb_cy2)
                ld      hl,fw_top2
                cp      (hl)
                jr      nc,fcb_top_clip_p1
                jp      fcb_whole_above
fcb_top_p1_ok:
                ld      a,(cb_cy2)
                ld      hl,fw_top2
                cp      (hl)
                jr      nc,fcb_top_done         ; both inside
                ld      a,(cb_cy1)              ; p2 leaves through the top
                ld      hl,fw_top1
                sub     (hl)
                ld      d,a
                ld      a,(fw_top2)
                ld      hl,cb_cy2
                sub     (hl)
                ld      e,a
                xor     a
                call    dcl_boundary_ix
                ld      (cb_cx2),a
                call    fw_bval_top
                ld      (cb_cy2),a
                xor     a
                ld      (fwl_pend),a            ; a right flat 'above'
                jp      fcb_top_done
fcb_top_clip_p1:                                ; cy1 < top1, cy2 >= top2
                ld      a,(fw_top1)
                ld      hl,cb_cy1
                sub     (hl)
                ld      d,a
                ld      a,(cb_cy2)
                ld      hl,fw_top2
                sub     (hl)
                ld      e,a
                ld      a,1
                call    dcl_boundary_ix
                ld      (cb_cx1),a
                call    fw_bval_top
                ld      (cb_cy1),a
                ld      a,(fwl_zx0)
                ld      hl,cb_cx1
                cp      (hl)
                jr      nc,fcb_top_done
                call    fw_touch_close          ; the left flat 'above'
                ld      a,(fw_side)
                bit     7,a
                jr      z,fcb_tlf_done          ; top side: neutral
                ld      a,(cb_cx1)
                ld      c,a
                ld      a,(fwl_leftf)
                call    fused_kill
fcb_tlf_done:   ld      a,(cb_cx1)
                ld      (fwl_leftf),a
fcb_top_done:
                ld      a,(cb_cx2)
                ld      hl,cb_cx1
                cp      (hl)
                jp      c,fcb_whole_above
fcb_bot:
                ld      a,(ix+SP_IB)
                ld      hl,cb_cy1
                cp      (hl)
                jr      c,fcb_bot_eval
                ld      hl,cb_cy2
                cp      (hl)
                jr      c,fcb_bot_eval
                jp      fcb_bot_done            ; both at or above IB
fcb_bot_eval:
                LP_BLBR
                jr      nz,fcb_bot_interp
                ld      (fw_top1),a             ; (the slots serve as bot1/bot2)
                ld      (fw_top2),a
                jr      fcb_bot_evaled
fcb_bot_interp:
                IW_BOT
                ld      a,(cb_cx1)
                call    interp_store
                ld      (fw_top1),a
                IW_BOT
                ld      a,(cb_cx2)
                call    interp_store
                ld      (fw_top2),a
fcb_bot_evaled:
                ld      a,(fw_top1)
                ld      hl,cb_cy1
                cp      (hl)
                jr      nc,fcb_bot_p1_ok
                ld      a,(fw_top2)
                ld      hl,cb_cy2
                cp      (hl)
                jr      nc,fcb_bot_clip_p1
                jp      fcb_whole_below
fcb_bot_p1_ok:
                ld      a,(fw_top2)
                ld      hl,cb_cy2
                cp      (hl)
                jr      nc,fcb_bot_done         ; both inside
                ld      a,(fw_top1)             ; p2 leaves through the bottom
                ld      hl,cb_cy1
                sub     (hl)
                ld      d,a
                ld      a,(cb_cy2)
                ld      hl,fw_top2
                sub     (hl)
                ld      e,a
                xor     a
                call    dcl_boundary_ix
                ld      (cb_cx2),a
                call    fw_bval_bot
                ld      (cb_cy2),a
                ld      a,$ff
                ld      (fwl_pend),a            ; a right flat 'below'
                jp      fcb_bot_done
fcb_bot_clip_p1:                                ; bot1 < cy1, bot2 >= cy2
                ld      a,(cb_cy1)
                ld      hl,fw_top1
                sub     (hl)
                ld      d,a
                ld      a,(fw_top2)
                ld      hl,cb_cy2
                sub     (hl)
                ld      e,a
                ld      a,1
                call    dcl_boundary_ix
                ld      (cb_cx1),a
                call    fw_bval_bot
                ld      (cb_cy1),a
                ld      a,(fwl_zx0)
                ld      hl,cb_cx1
                cp      (hl)
                jr      nc,fcb_bot_done
                call    fw_touch_close          ; the left flat 'below'
                ld      a,(fw_side)
                bit     7,a
                jr      nz,fcb_blf_done         ; bottom side: neutral
                ld      a,(cb_cx1)
                ld      c,a
                ld      a,(fwl_leftf)
                call    fused_kill
fcb_blf_done:   ld      a,(cb_cx1)
                ld      (fwl_leftf),a
fcb_bot_done:
                ld      a,(cb_cx2)
                ld      hl,cb_cx1
                cp      (hl)
                jr      c,fcb_whole_below
                ; the visible piece [cx1, cx2)
                ld      a,(cb_cy1)
                ld      d,a                     ; the entry y
                ld      a,(cb_cx2)
                ld      hl,fwl_zx1
                cp      (hl)
                ld      a,$80                   ; an open end...
                jr      nc,fcb_end_open
                ld      a,(cb_cy2)              ; ...or the crossing value
fcb_end_open:   ld      e,a
                ld      bc,(cb_cx1)             ; C = cx1, B = cx2
                call    fw_run_visible
                ; the right flat, if one is pending
                ld      a,(fwl_pend)
                cp      $80
                ret     z
                ld      a,1
                ld      (fw_touch),a
                ld      a,(cb_cx2)
                ld      hl,fwl_zx1
                cp      (hl)
                ret     nc                      ; empty
                ld      a,(fw_side)
                bit     7,a
                ld      a,(fwl_pend)
                jr      nz,fcb_rp_bot
                inc     a                       ; top side: 'below' ($FF) kills
                ret     nz
                jr      fcb_rp_kill
fcb_rp_bot:     or      a                       ; bottom side: 'above' (0) kills
                ret     nz
fcb_rp_kill:    ld      a,(fwl_zx1)
                ld      c,a
                ld      a,(cb_cx2)
                jp      fused_kill
fcb_whole_above:
                call    fw_touch_close
                ld      a,(fw_side)
                bit     7,a
                jr      nz,fcb_wf_kill
                ret
fcb_whole_below:
                call    fw_touch_close
                ld      a,(fw_side)
                bit     7,a
                ret     nz
fcb_wf_kill:    ld      a,(fwl_leftf)
                ld      hl,fwl_zx1
                cp      (hl)
                ret     nc                      ; nothing left to kill
                ld      c,(hl)
                jp      fused_kill

; the boundary value at a crossing: constant when the two evaluations
; agreed, else the interpolation on the span's line
fw_bval_top:
                ld      hl,fw_top1
                ld      b,(hl)
                inc     hl
                ld      c,a
                ld      a,(hl)
                cp      b
                ld      a,c
                jr      z,fw_bval_const
                jp      cb_top_at
fw_bval_bot:
                ld      hl,fw_top1
                ld      b,(hl)
                inc     hl
                ld      c,a
                ld      a,(hl)
                cp      b
                ld      a,c
                jr      z,fw_bval_const
                jp      cb_bot_at
fw_bval_const:  ld      a,b
                ret

; --- fw_run_visible : a visible piece (cp_vx0, cp_vy0) - (cp_vx1), its end
; value cp_vev ($80 = open), joins the run or starts one -------------------
fw_run_visible:                                 ; C = x0, B = x1 of the piece,
                ld      a,c                     ; D = its entry y ($FF: lazy),
                cp      b                       ; E = its end value ($80: open)
                jr      z,rv_degen
                ld      a,iyh
                inc     a
                jp      z,rv_open
                ld      a,iyl
                cp      c
                jp      z,rv_extend             ; contiguous
                push    bc
                push    de
                call    fw_close_run
                pop     de
                pop     bc
                jr      rv_open
rv_extend:      ld      a,b
                ld      iyl,a
                ld      a,e
                ld      (fwl_rendv),a
                ret
rv_open:
                ld      a,ixl                   ; (IX = the span being clipped)
                ld      (fw_rslot),a            ; the apply starts here
                ld      a,c
                ld      iyh,a
                ld      a,d
                cp      $ff
                jr      nz,rv_have_y
                ld      a,c                     ; the lazy entry y
                ld      hl,fwl_xl
                cp      (hl)
                jp      z,rv_y_yl
                ld      a,(fwl_dy)
                or      a
                jr      z,rv_y_yl
                push    bc
                push    de
                ld      a,c
                ex      af,af'
                IW_FWL
                ex      af,af'
                call    interp_store
                pop     de
                pop     bc
                jr      rv_have_y
rv_y_yl:        ld      a,(fwl_yl)
rv_have_y:      ld      (fwl_ry0),a
                ld      a,b
                ld      iyl,a
                ld      a,e
                ld      (fwl_rendv),a
                ld      a,1
                ld      (fw_touch),a
                ret
rv_degen:                                       ; a contiguous point closes the
                ld      a,iyh             ; run at its end with the value
                inc     a
                ret     z
                ld      a,iyl
                cp      c
                jr      nz,fw_close_run
                ld      a,e
                ld      (fwl_rendv),a
                ; fall into fw_close_run

; --- fw_close_run : plot the run, then apply it ----------------------------
fw_close_run:
                ld      a,(fwl_rendv)
                cp      $80
                jr      nz,cr_store
                ld      a,iyl
                ld      hl,fwl_xr
                cp      (hl)
                jp      z,cr_yr
                ld      a,(fwl_dy)
                or      a
                jr      z,cr_yl
                IW_FWL
                ld      a,iyl
                call    interp_store
                jr      cr_store
cr_yr:          ld      a,(fwl_yr)
                jp      cr_store
cr_yl:          ld      a,(fwl_yl)
cr_store:       sub     Y_BIAS
                ld      d,a                     ; D = the end row
                ld      a,(fwl_ry0)
                sub     Y_BIAS
                ld      b,a                     ; B = the start row
                ld      a,iyl
                ld      c,a                     ; C = x1
                ld      (fw_ax1),a
                ld      a,iyh
                ld      (fw_ax0),a              ; A = x0 (< x1: never a point
adyn_fw:        ld      hl,adyn_ctr             ;  nor a vertical, so straight
                inc     (hl)                    ;  to the rasteriser; the walk's
                call    dl_emit                 ;  judge counts the run)
                ld      a,$ff                   ;  to the rasteriser)
                ld      iyh,a
                ; fall into fused_apply_run
; --- fused_apply_run : the whole line becomes the side's boundary on every
; span overlapping [fw_ax0, fw_ax1), partial edges split first ----------
fused_apply_run:
                ; L walks the spans from fw_rslot (H = the hot page); a span
                ; the run straddles is split at the run's ends first
                ; (fw_split_r), then the side's line and extremes are written
                ; into it
                ld      de,(fw_ax0)             ; E = ax0, D = ax1 ride
                ld      a,(fw_rslot)
                ld      h,SPH>>8
ar_walk:        or      a
                ret     z
                ld      l,a
                inc     l
                inc     l                       ; -> xe
                ld      a,e
                cp      (hl)
                jp      nc,ar_next              ; ax0 >= xe: wholly left
ar_hit:         dec     l
                ld      b,(hl)                  ; xs
                ld      a,d
                cp      b
                ret     c                       ; xs > ax1: done
                ret     z                       ; xs = ax1: done
                ld      a,e
                cp      b
                jr      c,ar_no_lsplit          ; xs > ax0: no left part
                jp      z,ar_no_lsplit          ; xs = ax0: no left part
                ld      c,a                     ; split at ax0
                dec     l
                push    de
                call    fw_split_r              ; HL keeps [xs, ax0)
                pop     de
                ld      a,(hl)
                or      a
                jr      z,ar_no_lsplit          ; spent: the whole span takes it
                ld      l,a
ar_no_lsplit:   ld      a,l
                and     $F8
                or      SP_XE
                ld      l,a
                ld      a,d
                cp      (hl)
                jr      nc,ar_no_rsplit         ; ax1 >= xe
                ld      c,a
                dec     l
                dec     l
                push    de
                call    fw_split_r              ; HL keeps [xs, ax1)
                pop     de
ar_no_rsplit:   ld      a,(fw_side)
                bit     7,a
                jp      nz,ar_bot
                ld      a,l
                and     $F8
                ld      l,a
                dec     h                       ; the top line
                ld      a,(fwl_xl)
                ld      (hl),a
                inc     l
                ld      a,(fwl_dx)
                ld      (hl),a
                inc     l
                ld      a,(fwl_yl)
                ld      (hl),a
                inc     l
                ld      a,(fwl_yr)
                ld      (hl),a
                inc     h                       ; -> ot (the same offset)
                ld      a,(fwl_lo)
                ld      (hl),a
                inc     l
                ld      a,(fwl_hi)
                ld      (hl),a
                jp      ar_next
ar_bot:         ld      a,l
                and     $F8
                or      SL_BXLO
                ld      l,a
                dec     h                       ; the bottom line
                ld      a,(fwl_xl)
                ld      (hl),a
                inc     l
                ld      a,(fwl_dx)
                ld      (hl),a
                inc     l
                ld      a,(fwl_yl)
                ld      (hl),a
                inc     l
                ld      a,(fwl_yr)
                ld      (hl),a
                inc     h
                dec     l
                dec     l                       ; -> ob
                ld      a,(fwl_hi)
                ld      (hl),a
                inc     l
                ld      a,(fwl_lo)
                ld      (hl),a
ar_next:        ld      a,l                     ; (two spans to a back edge)
                and     $F8
                ld      l,a
                ld      a,(hl)
                or      a
                ret     z
                ld      l,a
                inc     l
                inc     l                       ; -> xe
                ld      a,e
                cp      (hl)
                jp      c,ar_hit                ; ax0 < xe
                ld      a,l
                and     $F8
                ld      l,a
                ld      a,(hl)
                jp      ar_walk

; fw_split_r : span HL (at its base) keeps [xs, C); a fresh slot takes
; [C, xe) with every field copied, linked after it.  No slot: no-op.  HL
; comes back at the base; B, C kept.
fw_split_r:
                ld      a,(sp_free)
                or      a
                ret     z
                ld      e,a
                ld      d,h                     ; DE = the new slot
                ld      a,(de)                  ; the free list moves on
                ld      (sp_free),a
                ld      a,(hl)                  ; new.next = this.next
                ld      (de),a
                ld      (hl),e                  ; this.next = new
                inc     e                       ; -> xs
                ld      a,c
                ld      (de),a                  ; new.xs = the split
                inc     e                       ; -> xe
                inc     l
                inc     l
                ld      a,(hl)
                ld      (de),a                  ; new.xe = this.xe
                ld      (hl),c                  ; this.xe = the split
                inc     e
                inc     l                       ; both -> ot
                push    bc
                ldi                             ; the extremes
                ldi
                ldi
                ldi
                ld      a,l
                and     $F8
                ld      l,a
                ld      a,e
                and     $F8
                ld      e,a
                dec     h                       ; the lines
                dec     d
                ldi
                ldi
                ldi
                ldi
                ldi
                ldi
                ldi
                ldi
                pop     bc
                inc     h
                ld      a,l
                sub     8
                ld      l,a
                ret

; fused_kill : the columns [A, C) close (mark_solid, the seg's range kept)
fused_kill:
                ld      b,a
                ld      hl,(cl_ilo)             ; ilo, ihi
                ld      (fk_save),hl
                ld      a,b
                ld      (cl_ilo),a
                ld      a,c
                ld      (cl_ihi),a
                call    ms_u8
                ld      hl,(fk_save)
                ld      (cl_ilo),hl
                ret

; fused_flat : a verdict fw_pol over [A, C): counts, kills when it is the
; killing polarity for the side
fused_flat:
                ld      b,a
                ld      a,1
                ld      (fw_touch),a
                ld      a,(fw_side)
                bit     7,a
                ld      a,(fw_pol)
                jr      nz,ff_bot
                inc     a                       ; top side: 'below' kills
                ret     nz
                jr      ff_kill
ff_bot:         or      a                       ; bottom side: 'above' kills
                ret     nz
ff_kill:        ld      a,b
                jp      fused_kill

; ===========================================================================
; fused_merge_range : HL = lo, DE = hi (s16): every value-equal abutting
; pair of spans inside the range coalesces
; ===========================================================================
fused_merge_range:
                ; L = P, E = Q its successor (H = D = the hot page); B = ilo,
                ; C = ihi ride in registers
                call    cl_range
                ret     nc
                ld      a,(sp_head)
                or      a
                ret     z
                ld      h,SPH>>8
                ld      d,h
                ld      l,a
                inc     l
                inc     l                       ; -> P.xe
                ld      a,b
                cp      (hl)
                jr      c,fm_found0             ; ilo < xe: the head starts it
fm_sx:          dec     l                       ; P = HL (at xe): Q = its successor
                dec     l
                ld      e,(hl)
                ld      a,e
                or      a
                ret     z
                inc     e
                inc     e                       ; -> Q.xe
                ld      a,b
                ex      de,hl
                cp      (hl)
                jp      nc,fm_sx                ; ilo >= Q.xe: P = Q, on
                ex      de,hl                   ; ilo < Q.xe: the pair (P, Q)
                dec     e                       ; -> Q.xs
                jp      fm_pair
fm_found0:      dec     l
                dec     l
                ld      e,(hl)
                ld      a,e
                or      a
                ret     z
fm_chk:         inc     e                       ; -> Q.xs
                ld      a,(de)
                cp      c
                jr      c,fm_chk_p              ; xs < ihi: still in range
                ret     nz
fm_chk_p:       ld      a,l
                and     $F8
                or      SP_XE
                ld      l,a
fm_pair:        ; HL = P.xe, DE = Q.xs.  P absorbs Q when they abut and the
                ; eight line bytes match.  The bottom anchor is compared FIRST
                ; (the BBC port's grind: a seg's spans share the top line, so
                ; the T fields match trivially and the failing majority dies
                ; at BXLO)
                ld      a,(de)                  ; Q.xs
                cp      (hl)                    ; P.xe
                jr      nz,fm_stepq
                ld      a,l
                and     $F8
                or      SL_BXLO
                ld      l,a
                ld      a,e
                and     $F8
                or      SL_BXLO
                ld      e,a
                dec     h                       ; the lines
                dec     d
                ld      a,(de)
                cp      (hl)                    ; BXLO
                jp      nz,fm_stepq_l
                inc     l
                inc     e
                DUP     SL_BR-SL_BXLO-1
                ld      a,(de)
                cp      (hl)                    ; BDEN, BL
                jp      nz,fm_stepq_l
                inc     l
                inc     e
                EDUP
                ld      a,(de)
                cp      (hl)                    ; BR
                jr      nz,fm_stepq_l
                ld      a,l
                and     $F8
                ld      l,a
                ld      a,e
                and     $F8
                ld      e,a
                DUP     SL_TR-SL_TXLO
                ld      a,(de)
                cp      (hl)                    ; TXLO, TDEN, TL
                jp      nz,fm_stepq_l
                inc     l
                inc     e
                EDUP
                ld      a,(de)
                cp      (hl)                    ; TR
                jr      nz,fm_stepq_l
                inc     h
                inc     d
                ld      a,e
                and     $F8
                or      SP_XE
                ld      e,a
                ld      a,(de)                  ; P.xe = Q.xe
                ld      b,a
                ld      a,l
                and     $F8
                or      SP_XE
                ld      l,a
                ld      (hl),b
                dec     l
                dec     l                       ; P
                dec     e
                dec     e                       ; Q
                ld      a,(de)                  ; P.next = Q.next
                ld      (hl),a
                ld      a,(sp_free)             ; Q -> the free list
                ld      (de),a
                ld      a,e
                ld      (sp_free),a
                ld      e,(hl)                  ; Q = P.next
                ld      a,e
                or      a
                jp      nz,fm_chk
                ret
fm_stepq_l:     inc     h
                inc     d
fm_stepq:       ex      de,hl                   ; P = old Q
                ld      a,l
                and     $F8
                ld      l,a
                ld      e,(hl)
                ld      a,e
                or      a
                jp      nz,fm_chk
                ret

; ===========================================================================
; seg_zero_rec_solid : a portal whose armed edges touched nothing: carry
; when its opening is wholly off the screen (every column closes), from the
; seg's projected rows (s16, unbiased): sg_ft1/ft2, sg_fb1/fb2, and the
; back pair where the flags need it.                             (tfr.s)
; ===========================================================================
seg_zero_rec_solid:
                ld      hl,(sg_fb1)
                call    szr_lt
                jr      c,szr_b1
                ld      a,(sg_flags)
                and     SF_NEEDBB
                jr      z,szr_top
                ld      hl,(sg_bb1)
                call    szr_lt
                jr      nc,szr_top
szr_b1:         ld      hl,(sg_fb2)
                call    szr_lt
                jr      c,szr_closed
                ld      a,(sg_flags)
                and     SF_NEEDBB
                jr      z,szr_top
                ld      hl,(sg_bb2)
                call    szr_lt
                jr      c,szr_closed
szr_top:        ld      hl,(sg_ft1)
                call    szr_gt
                jr      c,szr_t1
                ld      a,(sg_flags)
                and     SF_NEEDBT
                jr      z,szr_open
                ld      hl,(sg_bt1)
                call    szr_gt
                jr      nc,szr_open
szr_t1:         ld      hl,(sg_ft2)
                call    szr_gt
                jr      c,szr_closed
                ld      a,(sg_flags)
                and     SF_NEEDBT
                jr      z,szr_open
                ld      hl,(sg_bt2)
                jp      szr_gt
szr_open:       or      a
                ret
szr_closed:     scf
                ret
szr_lt:                                         ; carry when the biased row is above the screen
                ld      de,Y_BIAS
                or      a
                sbc     hl,de
                bit     7,h
                jr      nz,szr_closed
                or      a
                ret
szr_gt:                                         ; carry when the biased row is below the screen
                ld      de,Y_BIAS+RENDER_H
                or      a
                sbc     hl,de
                bit     7,h
                jr      nz,szr_open
                scf
                ret
