; ---------------------------------------------------------------------------
; Trapezoid clip spans.
;
; The visible region of the screen is a sorted array of column ranges, each
; carrying a linear top and bottom boundary:
;
;       span = [xlo, xlast]  with  top(x) = ta*x + tb,  bot(x) = ba*x + bb
;
; Slopes are 8.8 signed, intercepts s16. A one-sided wall calls mark_solid to
; delete its columns outright; a portal calls tighten, which takes the
; pointwise max of the old and new tops and the pointwise min of the bottoms,
; splitting a span wherever those cross. A frame ends up holding a handful of
; spans instead of the per-column arrays DOOM uses.
;
; Both operations rebuild into a second pool and swap, which keeps iteration
; simple at the cost of two bytes of state.
; ---------------------------------------------------------------------------

; ---------------------------------------------------------------------------
; divs : HL = (DE << 8) / BC, signed, truncated toward zero, saturating to s16.
;
; Restoring division in two phases: sixteen steps consume the numerator's own
; bits and eight more consume the appended fraction. The remainder invariant
; rem < den keeps rem*2+1 inside 16 bits, so no wide remainder is needed - the
; divisor is clamped to $7FFF to guarantee that.
; ---------------------------------------------------------------------------
divs:
                xor     a
                bit     7,d
                jr      z,dv_np
                inc     a
                push    af
                ld      hl,0
                or      a
                sbc     hl,de
                ex      de,hl
                pop     af
dv_np:
                bit     7,b
                jr      z,dv_dp
                xor     1
                push    af
                ld      hl,0
                or      a
                sbc     hl,bc
                ld      b,h
                ld      c,l
                pop     af
dv_dp:
                ld      (dv_sign),a
                ld      a,b
                or      c
                jr      nz,dv_go
                ld      hl,0
                ret
dv_go:
                bit     7,b
                jr      z,dv_ok
                ld      bc,$7fff                ; keep rem*2 inside 16 bits
dv_ok:
                ; A divisor under 256 - which is every slope this engine takes,
                ; the denominator being a column span - divides byte at a time
                ; against an 8-bit remainder, and the leading zero bytes of the
                ; dividend can be skipped outright.  That is 51 T-states a bit
                ; against 75, over fewer bits.
                ld      a,b
                or      a
                jr      nz,dv_wide
                ld      a,d
                or      a
                jr      nz,dv_by3
                ld      a,e
                cp      c
                jr      nc,dv_by2
                ld      a,e                     ; quotient is under 256
                ld      l,0
                call    div8b
                ld      h,0
                jp      dv_sign_apply
dv_by2:
                xor     a
                ld      l,e
                call    div8b
                ld      e,l
                ld      l,0
                call    div8b
                ld      h,e
                bit     7,h
                jp      nz,dv_sat
                jp      dv_sign_apply
dv_by3:
                xor     a
                ld      l,d
                call    div8b
                ld      d,l
                ld      l,e
                call    div8b
                ld      e,l
                ld      l,0
                call    div8b
                ld      h,e
                ld      a,d
                or      a
                jp      nz,dv_sat
                bit     7,h
                jp      nz,dv_sat
                jp      dv_sign_apply

; div8b : one byte of dividend in L against the divisor in C, with the running
; remainder in A.  L comes back as the quotient byte, A as the new remainder.
div8b:
                ld      b,8
                or      a
db_lp:
                rl      l
                rla
                jr      c,db_s
                cp      c
                jr      c,db_n
db_s:           sub     c
                scf
                jr      db_h
db_n:           or      a
db_h:           djnz    db_lp
                rl      l
                ret

dv_wide:
                ; Fast path: when the numerator is smaller than the divisor the
                ; integer quotient is zero, so the sixteen integer steps are
                ; pure overhead - and that is the usual case for a parametric
                ; t in [0, 256].
                ld      h,d
                ld      l,e
                or      a
                sbc     hl,bc
                jr      nc,dv_full
                ld      h,d
                ld      l,e                     ; remainder = numerator
                xor     a
                ld      (dv_q+1),a
                jr      dv_frac
dv_full:
                ld      hl,0                    ; remainder
                ld      a,16
dv_p1:
                sla     e
                rl      d
                adc     hl,hl
                sbc     hl,bc
                jr      nc,dv_p1s
                add     hl,bc
                jr      dv_p1n
dv_p1s:
                inc     e
dv_p1n:
                dec     a
                jp      nz,dv_p1
                ; DE is the integer quotient; saturate once the full quotient
                ; would not fit a signed 16-bit slope
                ld      a,d
                or      a
                jr      nz,dv_sat
                bit     7,e
                jr      nz,dv_sat
                ld      a,e
                ld      (dv_q+1),a
dv_frac:
                ld      e,0
                ld      a,8
dv_p2:
                add     hl,hl
                sla     e
                or      a
                sbc     hl,bc
                jr      nc,dv_p2s
                add     hl,bc
                jr      dv_p2n
dv_p2s:
                inc     e
dv_p2n:
                dec     a
                jp      nz,dv_p2
                ld      a,e
                ld      (dv_q),a
                ld      hl,(dv_q)
dv_sign_apply:
                ld      a,(dv_sign)
                or      a
                ret     z
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ret
dv_sat:
                ld      hl,$7fff
                jr      dv_sign_apply

; ---------------------------------------------------------------------------
; ev_at : HL = pointer to (slope s16, intercept s16), A = column 0..255
;         -> A = y, biased by Y_BIAS and clamped to a byte.
;
; A boundary evaluated inside its own span always lands in the visible band,
; so the clamp only ever fires on a line that has left it - and then it lands
; on the correct side of every boundary, which is all any comparison needs.
; Flat boundaries skip the multiply.
; ---------------------------------------------------------------------------
ev_at:
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      c,(hl)
                inc     hl
                ld      b,(hl)                  ; DE = slope, BC = intercept
                ld      l,a                     ; L = column
                ld      a,d
                or      e
                jr      nz,ev_slope
                ld      h,b
                ld      l,c
                jp      ev_clamp
ev_slope:
                ; (slope*col) >> 8 == shi*col + ((slo*col) >> 8); the high
                ; byte is 0 or -1 for any gradient under one pixel a column,
                ; which is most of them, so that term usually vanishes - and
                ; testing it here rather than after the multiply saves keeping
                ; it and the column alive across one.
                ld      a,d
                or      a
                jr      z,ev_hi0
                inc     a
                jp      nz,ev_gen
                push    bc                      ; intercept
                ld      a,l
                ld      (ev_tmp),a              ; column
                ld      h,e
                MUL_U8_BODY                     ; HL = slo * col
                ld      l,h
                ld      h,0
                ld      a,(ev_tmp)
                ld      e,a
                ld      d,0
                or      a
                sbc     hl,de
                jr      ev_fin
ev_hi0:
                push    bc
                ld      h,e
                MUL_U8_BODY
                ld      l,h
                ld      h,0
                jr      ev_fin
ev_gen:
                push    bc
                ld      b,d
                ld      c,l
                push    bc
                ld      h,e
                MUL_U8_BODY
                ld      l,h
                ld      h,0
                pop     bc
                push    hl
                ld      h,b
                ld      l,c
                call    mul_s8_u8
                pop     de
                add     hl,de
ev_fin:
                pop     de
                add     hl,de
; ev_clamp : HL (already biased) -> A, clamped to a byte.
ev_clamp:
                ld      a,h
                or      a
                jr      z,cb_ok
                bit     7,h
                ld      a,255
                ret     z
                xor     a
                ret
cb_ok:          ld      a,l
                ret

; clampb : HL (raw s16 screen y) -> A, biased and clamped.
clampb:
                ld      de,Y_BIAS
                add     hl,de
                jr      ev_clamp

; ---------------------------------------------------------------------------
; linfn : write (slope, intercept) for the line through
;         (cl_lx1, cl_ly1) - (cl_lx2, cl_ly2) into the buffer at HL.
; ---------------------------------------------------------------------------
linfn:
                ld      (lf_out),hl
                ; bias the endpoints here, so every intercept this writes is
                ; already in the clipper's byte space and ev_at need only
                ; range-check.  The slope is a difference, so it is untouched.
                ld      hl,(cl_ly1)
                ld      de,Y_BIAS
                add     hl,de
                ld      (cl_ly1),hl
                ld      hl,(cl_ly2)
                add     hl,de
                ld      (cl_ly2),hl
                ld      hl,(cl_lx2)
                ld      de,(cl_lx1)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                jr      nz,lf_slope
                ld      hl,(cl_ly1)
                ld      de,(cl_ly2)
                add     hl,de
                sra     h
                rr      l                       ; (y1 + y2) >> 1
                jr      lf_store0
lf_slope:
                ld      b,h
                ld      c,l                     ; BC = dx
                ld      hl,(cl_ly2)
                ld      de,(cl_ly1)
                or      a
                sbc     hl,de
                ld      a,h
                or      l
                jr      nz,lf_div
                ld      hl,(cl_ly1)             ; a level edge needs no divide
                jr      lf_store0
lf_div:
                ex      de,hl                   ; DE = dy
                call    divs
                ld      a,h
                or      l
                jr      nz,lf_real
                ld      hl,(cl_ly1)
lf_store0:
                ex      de,hl
                ld      hl,(lf_out)
                ld      (hl),0
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),e
                inc     hl
                ld      (hl),d
                ret
lf_real:
                ld      (lf_slope_v),hl
                ld      hl,(cl_lx1)
                call    abs_hl
                ld      b,h
                ld      c,l
                ld      hl,(cl_lx2)
                call    abs_hl
                or      a
                sbc     hl,bc
                jr      c,lf_use2
                ld      de,(cl_lx1)
                ld      hl,(cl_ly1)
                jr      lf_calc
lf_use2:
                ld      de,(cl_lx2)
                ld      hl,(cl_ly2)
lf_calc:
                ld      (lf_y),hl
                ex      de,hl                   ; HL = x
                ; (slope * x) >> 8.  Screen columns are almost always inside
                ; +/-255, which turns the wide product into one 16x8.
                ld      a,h
                or      a
                jr      z,lf_narrow
                inc     a
                jr      nz,lf_wide
                ; x is negative and fits a byte.  The product must be negated
                ; before the shift: floor(-p/256) is not -floor(p/256).
                ld      a,l
                neg
                ld      (lf_absx),a
                ld      de,(lf_slope_v)
                ld      a,(lf_absx)
                call    mul_s16_u8
                call    neg_ahl
                ld      l,h
                ld      h,a
                jr      lf_haveprod
lf_narrow:
                ld      a,l
                ld      (lf_absx),a
                ld      de,(lf_slope_v)
                call    lf_mulcol
                jr      lf_haveprod
lf_wide:
                ; An anchor column outside a byte: (slope*x)>>8 splits into
                ; slope*xh + ((slope*xl)>>8), both 16-by-8.  E1M1 never gets
                ; here - linfn anchors on whichever endpoint is nearer the
                ; screen - so it costs nothing to spend two calls on it.
                push    hl
                ld      de,(lf_slope_v)
                ld      a,l
                call    mul_s16_u8
                ld      l,h
                ld      h,a
                ld      (lf_wtmp),hl
                pop     hl
                ld      de,(lf_slope_v)
                ld      a,h
                call    mul_s16_u8_signed
                ld      de,(lf_wtmp)
                add     hl,de
lf_haveprod:
                ex      de,hl
                ld      hl,(lf_y)
                or      a
                sbc     hl,de
                ex      de,hl                   ; DE = intercept
                ld      hl,(lf_out)
                ld      bc,(lf_slope_v)
                ld      (hl),c
                inc     hl
                ld      (hl),b
                inc     hl
                ld      (hl),e
                inc     hl
                ld      (hl),d
                ret

; lf_mulcol : DE = slope, (lf_absx) = column 0..255 -> HL = (slope*col) >> 8
lf_mulcol:
                ld      a,(lf_absx)
                call    mul_s16_u8
                ld      l,h
                ld      h,a
                ret

abs_hl:
                bit     7,h
                ret     z
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ret

; ---------------------------------------------------------------------------
; sp_reset : one span covering the whole screen, top 0 and bottom RENDER_H-1.
; ---------------------------------------------------------------------------
sp_reset:
                ; chain every slot onto the free list, then take the first
                ; back for the full-screen span
                ld      hl,SPANS_BASE+SLOT_SIZE
                ld      de,SPANS_BASE+SLOT_SIZE*2
                ld      b,SPANS_MAX-2
sr_l:
                push    bc
                push    hl
                ld      bc,SP_NEXT
                add     hl,bc
                ld      (hl),e
                inc     hl
                ld      (hl),d
                pop     hl
                ld      bc,SLOT_SIZE
                add     hl,bc
                ex      de,hl
                add     hl,bc
                ex      de,hl
                pop     bc
                djnz    sr_l
                ld      bc,SP_NEXT
                add     hl,bc
                ld      (hl),0
                inc     hl
                ld      (hl),0
                ld      hl,SPANS_BASE+SLOT_SIZE
                ld      (sp_free),hl
                ld      hl,SPANS_BASE
                ld      (sp_head),hl
                ld      a,1
                ld      (sp_count),a
                ld      (hl),0                  ; xlo
                inc     hl
                ld      (hl),RENDER_W-1         ; xlast
                inc     hl
                ld      (hl),0                  ; top slope
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),Y_BIAS             ; top intercept, biased
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),0                  ; bottom slope
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),Y_BIAS+RENDER_H-1  ; bottom intercept, biased
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),1                  ; aperture open throughout
                inc     hl
                ld      (hl),0
                inc     hl
                ld      (hl),Y_BIAS             ; the top is flat at row 0
                inc     hl
                ld      (hl),Y_BIAS
                inc     hl
                ld      (hl),Y_BIAS+RENDER_H-1  ; and the bottom at row 159
                inc     hl
                ld      (hl),Y_BIAS+RENDER_H-1
                inc     hl
                ld      (hl),0                  ; end of the live list
                inc     hl
                ld      (hl),0
                ret

; ---------------------------------------------------------------------------
; The pool is a partition: the live list and the free chain between them hold
; every slot, always.  A walk keeps sp_prev as its insertion point, so a span
; it does not touch costs nothing but the pointer chase.
; ---------------------------------------------------------------------------

; sp_alloc : HL = a slot off the free chain, or 0 when the pool is spent.
sp_alloc:
                ld      hl,(sp_free)
                ld      a,h
                or      l
                ret     z
                push    hl
                ld      de,SP_NEXT
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (sp_free),de
                ld      a,(sp_count)
                inc     a
                ld      (sp_count),a
                pop     hl
                ret

; sp_freeslot : HL back onto the free chain.
sp_freeslot:
                push    hl
                ld      de,SP_NEXT
                add     hl,de
                ld      de,(sp_free)
                ld      (hl),e
                inc     hl
                ld      (hl),d
                pop     hl
                ld      (sp_free),hl
                ld      a,(sp_count)
                dec     a
                ld      (sp_count),a
                ret

; sp_advance : leave the span at sp_cur where it is and step past it.
sp_advance:
                ld      hl,(sp_cur)
                ld      (sp_prev),hl
                ld      de,SP_NEXT
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (sp_cur),de
                ret

; ---------------------------------------------------------------------------
; sp_emit : link the span at HL (16 bytes) into the live list after sp_prev,
; coalescing it with that one if they abut and carry the same boundaries.
;
; A fuse splits every span it touches at the seg's own column range whether or
; not anything changed there, and two of them run per seg, so without this the
; list fragments a little further with every wall.
; ---------------------------------------------------------------------------
sp_emit:
                ld      (sp_tmp8),hl
                call    se_try
                ret     c
                jp      se_new

; se_try : fold the record at sp_tmp8 into the span at sp_prev if they abut
; and carry the same boundaries.  Carry set when it went in.
se_try:
                ld      hl,(sp_prev)
                ld      a,h
                or      l
                ret     z
                ld      (se_prev),hl
                ld      bc,SP_XLAST
                add     hl,bc
                ld      a,(hl)
                inc     a
                ld      c,a                     ; C = previous xlast + 1
                ld      hl,(sp_tmp8)
                ld      a,(hl)
                cp      c
                jr      nz,se_fail
                ld      de,(se_prev)
                inc     de
                inc     de
                inc     hl
                inc     hl                      ; both -> SP_TA
                ld      b,8
se_cmp:
                ld      a,(de)
                cp      (hl)
                jr      nz,se_fail
                inc     hl
                inc     de
                djnz    se_cmp
                ld      hl,(sp_tmp8)
                ld      de,SP_OPEN
                add     hl,de
                ld      a,(hl)
                ld      hl,(se_prev)
                add     hl,de
                and     (hl)                    ; the merged span is only open
                ld      (hl),a                  ; where both halves were
                call    se_widen                ; and spans both extremes
                ld      hl,(sp_tmp8)
                inc     hl
                ld      a,(hl)                  ; the new span's xlast
                ld      hl,(se_prev)
                inc     hl
                ld      (hl),a
                scf
                ret

; se_widen : fold the new span's extremes into the one it merged with.
se_widen:
                ld      hl,(sp_tmp8)
                ld      de,SP_OT
                add     hl,de
                ex      de,hl
                ld      hl,(se_prev)
                ld      bc,SP_OT
                add     hl,bc
                ld      a,(de)                  ; outer top: the smaller
                cp      (hl)
                jr      nc,sw_1
                ld      (hl),a
sw_1:           inc     hl
                inc     de
                ld      a,(de)                  ; inner top: the larger
                cp      (hl)
                jr      c,sw_2
                ld      (hl),a
sw_2:           inc     hl
                inc     de
                ld      a,(de)                  ; outer bottom: the larger
                cp      (hl)
                jr      c,sw_3
                ld      (hl),a
sw_3:           inc     hl
                inc     de
                ld      a,(de)                  ; inner bottom: the smaller
                cp      (hl)
                jr      nc,sw_4
                ld      (hl),a
sw_4:           ret

se_fail:
                or      a
                ret

se_new:
                call    sp_alloc
                ld      a,h
                or      l
                ret     z                       ; pool spent: drop the span
                ld      (se_prev),hl
                ex      de,hl
                ld      hl,(sp_tmp8)
                ld      bc,SPAN_SIZE
                ldir
                ld      hl,(sp_prev)
                ld      a,h
                or      l
                jr      z,se_head
                ld      de,SP_NEXT
                add     hl,de
                ld      de,(se_prev)
                ld      (hl),e
                inc     hl
                ld      (hl),d
                jr      se_done
se_head:
                ld      hl,(se_prev)
                ld      (sp_head),hl
se_done:
                ld      hl,(se_prev)
                ld      (sp_prev),hl
                ret

; sp_emit_range : emit the span at HL with xlast replaced by A.
sp_emit_range:
                ld      (sp_tmp8+2),a
                ld      de,sp_scratch
                ld      bc,SPAN_SIZE
                ldir
                ld      a,(sp_tmp8+2)
                ld      (sp_scratch+SP_XLAST),a
                ld      hl,sp_scratch
                jp      sp_emit

; sp_emit_range2 : emit the span at HL with xlo = B and xlast = A.
sp_emit_range2:
                ld      (sp_tmp8+2),a
                ld      a,b
                ld      (sp_tmp8+3),a
                ld      de,sp_scratch
                ld      bc,SPAN_SIZE
                ldir
                ld      a,(sp_tmp8+2)
                ld      (sp_scratch+SP_XLAST),a
                ld      a,(sp_tmp8+3)
                ld      (sp_scratch+SP_XLO),a
                ld      hl,sp_scratch
                jp      sp_emit

; sp_relink : the walk is done - hang whatever is left of the list off the
; insertion point.
sp_relink:
                ld      hl,(sp_prev)
                ld      a,h
                or      l
                jr      z,sr_head
                ld      hl,(sp_cur)
                ld      a,h
                or      l
                jr      z,sr_link
                ld      (sp_tmp8),hl            ; the rebuild used to coalesce
                call    se_try                  ; across this join too
                jr      nc,sr_link
                ld      hl,(sp_cur)
                ld      de,SP_NEXT
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                push    de
                ld      hl,(sp_cur)
                call    sp_freeslot
                pop     hl
                ld      (sp_cur),hl
                jr      sp_relink
sr_link:
                ld      de,(sp_cur)
                ld      hl,(sp_prev)
                ld      bc,SP_NEXT
                add     hl,bc
                ld      (hl),e
                inc     hl
                ld      (hl),d
                ret
sr_head:
                ld      de,(sp_cur)
                ld      (sp_head),de
                ret

; sp_walk_begin : point the walk at the first span that can overlap the op
; range, leaving sp_prev at the one before it.
sp_walk_begin:
                ld      hl,(sp_head)
                ld      (sp_cur),hl
                ld      hl,0
                ld      (sp_prev),hl
swb_l:
                ld      hl,(sp_cur)
                ld      a,h
                or      l
                ret     z
                inc     hl
                ld      a,(hl)                  ; xlast
                ld      b,a
                ld      a,(cl_lo)
                cp      b
                ret     z
                ret     c                       ; ilo <= xlast: overlaps
                call    sp_advance
                jr      swb_l

; ---------------------------------------------------------------------------
; sp_hasgap : are any columns in [cl_lo, cl_hi] still visible?
; in : B = lo, C = hi (already clamped to 0..255).  Carry set if a gap exists.
; ---------------------------------------------------------------------------
sp_hasgap:
                ld      a,b
                ld      (hg_lo),a
                ld      a,c
                ld      (hg_hi),a
                ld      hl,(sp_head)
hg_loop:
                ld      a,h
                or      l
                jr      z,hg_none
                ld      (cl_span),hl
                ld      a,(hg_hi)
                ld      c,a
                ld      a,(hl)                  ; xlo
                cp      c
                jr      z,hg_over
                jr      nc,hg_none              ; sorted: past the range
hg_over:
                inc     hl
                ld      a,(hg_lo)
                ld      c,a
                ld      a,(hl)                  ; xlast
                cp      c
                jr      c,hg_next
                ; clamp the overlap to [max(xlo,lo), min(xlast,hi)]
                ld      b,a                     ; B = xlast
                ld      hl,(cl_span)
                ld      a,(hl)
                cp      c
                jr      nc,hg_l1
                ld      a,c
hg_l1:          ld      (hg_clo),a
                ld      a,(hg_hi)
                ld      c,a
                ld      a,b
                cp      c
                jr      c,hg_l2
                ld      a,c
hg_l2:          ld      (hg_chi),a
                ; an aperture that is open at both ends of the span is open
                ; right across it, so any overlap is a gap
                ld      hl,(cl_span)
                ld      de,SP_OPEN
                add     hl,de
                ld      a,(hl)
                or      a
                jr      nz,hg_yes
                ld      a,(hg_clo)
                call    hg_alive
                jr      c,hg_yes
                ld      a,(hg_chi)
                call    hg_alive
                jr      c,hg_yes
hg_next:
                ld      hl,(cl_span)
                ld      de,SP_NEXT
                add     hl,de
                ld      a,(hl)
                inc     hl
                ld      h,(hl)
                ld      l,a
                jp      hg_loop
hg_none:
                or      a
                ret
hg_yes:
                scf
                ret

; hg_alive : carry set when column A of the span at cl_span is inside its
; aperture.
hg_alive:
                ld      (hg_col),a
                ld      hl,(cl_span)
                ld      de,SP_TA
                add     hl,de
                ld      a,(hg_col)
                call    ev_at
                ld      (hg_top),a
                ld      hl,(cl_span)
                ld      de,SP_BA
                add     hl,de
                ld      a,(hg_col)
                call    ev_at
                ld      hl,hg_top
                cp      (hl)
                jr      c,hg_a_no
                jr      z,hg_a_no
                scf
                ret
hg_a_no:
                or      a
                ret

; ---------------------------------------------------------------------------
; sp_marksolid : delete columns [cl_lo, cl_hi) from the span list.
; ---------------------------------------------------------------------------
sp_marksolid:
                call    sp_walk_begin
ms_loop:
                ld      hl,(sp_cur)
                ld      a,h
                or      l
                jp      z,ms_done
                ld      (cl_span),hl
                ld      a,(hl)
                ld      (tg_xlo),a
                ld      b,a
                ld      a,(cl_hi)
                dec     a
                cp      b
                jp      c,ms_done               ; xlo past the range: finished
                inc     hl
                ld      a,(hl)
                ld      (tg_xlast),a
                ld      hl,(cl_span)
                ld      de,SP_NEXT
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (sp_nextp),de

                ld      a,(sq_n)
                or      a
                jr      z,ms_left
                ld      a,(cl_lo)
                ld      b,a
                ld      a,(tg_xlo)
                cp      b
                jr      nc,ms_d0
                ld      a,b
ms_d0:          ld      (ct_xa0),a
                ld      a,(cl_hi)
                dec     a
                ld      b,a
                ld      a,(tg_xlast)
                cp      b
                jr      c,ms_d1
                ld      a,b
ms_d1:          ld      (ct_xb0),a
                call    fu_extras
ms_left:
                ; left piece [xlo, ilo-1]
                ld      a,(cl_lo)
                ld      b,a
                ld      a,(tg_xlo)
                cp      b
                jr      nc,ms_right
                ld      hl,(cl_span)
                ld      a,b
                dec     a
                call    sp_emit_range
ms_right:
                ; right piece [ihi, xlast]
                ld      a,(cl_hi)
                dec     a
                ld      b,a
                ld      a,(tg_xlast)
                cp      b
                jr      z,ms_next
                jr      c,ms_next
                ld      hl,(cl_span)
                ld      a,(cl_hi)
                ld      b,a
                ld      a,(tg_xlast)
                call    sp_emit_range2
ms_next:
                ld      hl,(cl_span)
                call    sp_freeslot
                ld      hl,(sp_nextp)
                ld      (sp_cur),hl
                jp      ms_loop
ms_done:
                jp      sp_relink

; pw_evd : A = column -> HL = the staged difference function's value there.
pw_evd:
                ld      (ev_col_x),a
                ld      de,(pw_da)
                ld      a,d
                or      e
                jr      nz,pwe_slope
                ld      hl,(pw_db)
                ret
pwe_slope:
                ld      a,(ev_col_x)
                call    mul_s16_u8
                ld      l,h
                ld      h,a
                ld      de,(pw_db)
                add     hl,de
                ret

; ---------------------------------------------------------------------------
; pw_diff : fill pw_da / pw_db from the functions at pw_f and pw_g.
; ---------------------------------------------------------------------------
pw_diff:
                ld      hl,(pw_f)
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      c,(hl)
                inc     hl
                ld      b,(hl)
                push    bc
                ld      hl,(pw_g)
                ld      a,(hl)
                inc     hl
                ld      h,(hl)
                ld      l,a
                ex      de,hl
                or      a
                sbc     hl,de
                ld      (pw_da),hl
                ld      hl,(pw_g)
                inc     hl
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                pop     hl
                or      a
                sbc     hl,de
                ld      (pw_db),hl
                ret

; ---------------------------------------------------------------------------
; sp_alive : is any column of [B, C] inside the aperture between the top
; function at tg_tp and the bottom at tg_bp?  Carry set if so.
; ---------------------------------------------------------------------------
sp_alive:
                push    bc
                ld      hl,(tg_bp)
                ld      (pw_f),hl
                ld      hl,(tg_tp)
                ld      (pw_g),hl
                call    pw_diff
                pop     bc
                push    bc
                ld      a,b
                call    pw_evd
                call    al_pos
                ld      (al_open),a
                pop     bc
                ld      a,c
                call    pw_evd
                call    al_pos
                ld      b,a
                ld      a,(al_open)
                and     b
                ld      (al_both),a             ; open right across the span
                ld      a,(al_open)
                or      b
                ret     z
                scf
                ret

; al_pos : A = 1 when HL is strictly positive.
;
; The aperture is measured on the difference function, not on the two
; boundaries evaluated apart: each evaluation truncates its own shift, so the
; separated form can disagree with the reference by a row.
al_pos:
                ld      a,h
                or      l
                ret     z
                bit     7,h
                ld      a,0
                ret     nz
                inc     a
                ret

; ---------------------------------------------------------------------------
; sp_fuse : clip both of a seg's boundary lines to the span list, draw them,
; and make them the new boundaries - all in one walk.
;
; A line that was drawn is, by construction, inside the aperture on every
; column it lit, so there max(old top, line) is just the line: the tighten is
; a copy, not a piecewise max with a crossover search.  Columns where the line
; ran past the far boundary close; columns where it never reached the near one
; keep what they had.  The bottom line then meets whatever the top line left
; behind, which is what a second pass over the list would have shown it - so
; one walk does the work the draw pass and the tighten pass split between them.
;
; in : fu_tfn / fu_bfn = the armed lines, cl_lo/cl_hi = their column range,
;      sg_emitt / sg_emitb = whether each is drawn
; ---------------------------------------------------------------------------
sp_fuse:
                call    sp_walk_begin
fu_loop:
                ld      hl,(sp_cur)
                ld      a,h
                or      l
                jp      z,fu_done
                ld      (cl_span),hl
                ld      a,(hl)
                ld      (tg_xlo),a
                ld      b,a
                ld      a,(cl_hi)
                dec     a
                cp      b
                jp      c,fu_done               ; xlo past the range: finished
                inc     hl
                ld      a,(hl)
                ld      (tg_xlast),a
                ld      hl,(cl_span)
                ld      de,SP_NEXT
                add     hl,de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                ld      (sp_nextp),de
                ld      a,(cl_lo)
                ld      b,a
                ld      a,(tg_xlo)
                cp      b
                jr      nc,fu_o0
                ld      a,b
fu_o0:          ld      (fu_ox0),a
                ld      a,(cl_hi)
                dec     a
                ld      b,a
                ld      a,(tg_xlast)
                cp      b
                jr      c,fu_o1
                ld      a,b
fu_o1:          ld      (fu_ox1),a
fu_over:
                ld      a,(fu_ox0)
                ld      b,a
                ld      a,(tg_xlo)
                cp      b
                jr      nc,fu_nolt
                ld      hl,(cl_span)
                ld      a,(fu_ox0)
                dec     a
                call    sp_emit_range           ; [xlo, ox0-1]
fu_nolt:
                ld      a,(fu_ox0)
                ld      (ct_xa0),a
                ld      a,(fu_ox1)
                ld      (ct_xb0),a
                call    fu_extras
                ld      a,1
                ld      (fu_have),a
                ld      hl,(cl_span)
                ld      de,SP_TA
                add     hl,de
                ld      (fu_tp),hl
                ld      hl,(cl_span)
                ld      de,SP_BA
                add     hl,de
                ld      (fu_bp),hl
                ld      a,(fu_ox0)
                ld      (fu_x0),a
                ld      a,(fu_ox1)
                ld      (fu_x1),a
                ld      hl,fu_tfn
                ld      (cl_lfnp),hl
                ld      a,1
                ld      (fu_side),a
                ld      (fu_stage),a
                ld      a,(sg_emitt)
                ld      (fu_emit),a
                xor     a
                ld      (fu_np),a
                call    fu_line
                ld      hl,fu_bfn
                ld      (cl_lfnp),hl
                xor     a
                ld      (fu_side),a
                ld      (fu_stage),a
                ld      a,(sg_emitb)
                ld      (fu_emit),a
                ld      hl,fu_pb
fu_ploop:
                ld      a,(fu_np)
                or      a
                jr      z,fu_right
                dec     a
                ld      (fu_np),a
                ld      a,(hl)
                ld      (fu_x0),a
                inc     hl
                ld      a,(hl)
                ld      (fu_x1),a
                inc     hl
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      (fu_tp),de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      (fu_bp),de
                ld      a,(hl)
                ld      (fu_t_o),a
                inc     hl
                ld      a,(hl)
                ld      (fu_t_i),a
                inc     hl
                ld      a,(hl)
                ld      (fu_b_o),a
                inc     hl
                ld      a,(hl)
                ld      (fu_b_i),a
                inc     hl
                push    hl
                call    fu_line
                pop     hl
                jr      fu_ploop
fu_right:
                ld      a,(fu_ox1)
                ld      b,a
                ld      a,(tg_xlast)
                cp      b
                jr      z,fu_next
                jr      c,fu_next
                ld      hl,(cl_span)
                ld      a,(fu_ox1)
                inc     a
                ld      b,a
                ld      a,(tg_xlast)
                call    sp_emit_range2
fu_next:
                ld      hl,(cl_span)
                call    sp_freeslot
                ld      hl,(sp_nextp)
                ld      (sp_cur),hl
                jp      fu_loop
fu_done:
                jp      sp_relink

; ---------------------------------------------------------------------------
; fu_line : one line against one trapezoid piece - draw the visible run and
; hand on the pieces that survive, the run carrying the line.
; ---------------------------------------------------------------------------
fu_line:
                ld      a,(fu_have)
                ld      (fu_hv),a
                xor     a
                ld      (fu_have),a
                ld      hl,(cl_lfnp)
                ld      a,(fu_x0)
                call    ev_at
                ld      (ct_ya),a
                ld      hl,(cl_lfnp)
                ld      a,(fu_x1)
                call    ev_at
                ld      (ct_yb),a
                call    fu_verdict
                jr      c,fl_outside
                jp      nz,fl_slow
                ; wholly inside: the whole range is one run, unclamped
                ld      a,(fu_emit)
                or      a
                jr      z,fl_in_p
                ld      a,(ct_ya)
                sub     Y_BIAS
                ld      b,a
                ld      a,(ct_yb)
                sub     Y_BIAS
                ld      d,a
                ld      a,(fu_x1)
                ld      c,a
                ld      a,(fu_x0)
                call    dl_emit
fl_in_p:
                ld      a,(fu_x0)
                ld      b,a
                ld      a,(fu_x1)
                ld      d,a
                jp      fu_orun
fl_outside:
                ; the line never enters the aperture: one piece, kept or shut
                ld      a,(fu_lyhi)
                ld      hl,fu_t_o
                cp      (hl)
                ld      a,1                     ; above the top
                jr      c,fl_out1
                xor     a                       ; below the bottom
fl_out1:
                ld      c,a
                ld      a,(fu_x1)
                ld      d,a
                ld      a,(fu_x0)
                ld      b,a
                ld      a,c
                jp      fu_okeep
fl_slow:
                ld      a,(fu_hv)
                or      a
                jr      z,fl_ev
                call    ct_need
                ld      a,(ct_ta0)
                ld      (ct_ta),a
                ld      a,(ct_ba0)
                ld      (ct_ba),a
                ld      a,(ct_tb0)
                ld      (ct_tb),a
                ld      a,(ct_bb0)
                ld      (ct_bb),a
                jr      fl_have
fl_ev:
                ld      hl,(fu_tp)
                ld      a,(fu_x0)
                call    ev_at
                ld      (ct_ta),a
                ld      hl,(fu_bp)
                ld      a,(fu_x0)
                call    ev_at
                ld      (ct_ba),a
                ld      hl,(fu_tp)
                ld      a,(fu_x1)
                call    ev_at
                ld      (ct_tb),a
                ld      hl,(fu_bp)
                ld      a,(fu_x1)
                call    ev_at
                ld      (ct_bb),a
fl_have:
                ; columns at or past the near boundary
                ld      a,(ct_ya)
                ld      hl,ct_ta
                sub     (hl)
                sbc     a,a                     ; 0 when y >= top, else -1
                and     $80
                ld      (fu_v0),a
                ld      a,(ct_yb)
                ld      hl,ct_tb
                sub     (hl)
                sbc     a,a
                and     $80
                ld      (fu_v1),a
                ld      hl,(cl_lfnp)
                ld      (pw_f),hl
                ld      hl,(fu_tp)
                ld      (pw_g),hl
                call    fu_ge
                ld      a,(fu_g0)
                ld      (fu_t0),a
                ld      a,(fu_g1)
                ld      (fu_t1),a
                ; and the ones at or short of the far one
                ld      a,(ct_ba)
                ld      hl,ct_ya
                sub     (hl)
                sbc     a,a
                and     $80
                ld      (fu_v0),a
                ld      a,(ct_bb)
                ld      hl,ct_yb
                sub     (hl)
                sbc     a,a
                and     $80
                ld      (fu_v1),a
                ld      hl,(fu_bp)
                ld      (pw_f),hl
                ld      hl,(cl_lfnp)
                ld      (pw_g),hl
                call    fu_ge
                ld      a,(fu_t0)
                ld      b,a
                ld      a,(fu_g0)
                cp      b
                jr      nc,fl_r0
                ld      a,b
fl_r0:          ld      (fu_r0),a
                ld      a,(fu_t1)
                ld      b,a
                ld      a,(fu_g1)
                cp      b
                jr      c,fl_r1
                ld      a,b
fl_r1:          ld      (fu_r1),a

                ld      a,(fu_emit)
                or      a
                jr      z,fl_pieces
                ld      a,(fu_r0)
                ld      b,a
                ld      a,(fu_r1)
                cp      b
                jr      c,fl_pieces
                ld      a,(fu_x0)
                cp      b                       ; B still holds r0
                jr      z,fl_dr1
                ld      hl,(cl_lfnp)
                ld      a,(fu_r0)
                call    ev_at
                ld      (ct_ya),a
                ld      hl,(fu_tp)
                ld      a,(fu_r0)
                call    ev_at
                ld      (ct_ta),a
                ld      hl,(fu_bp)
                ld      a,(fu_r0)
                call    ev_at
                ld      (ct_ba),a
fl_dr1:
                ld      a,(fu_r1)
                ld      b,a
                ld      a,(fu_x1)
                cp      b
                jr      z,fl_dr2
                ld      hl,(cl_lfnp)
                ld      a,(fu_r1)
                call    ev_at
                ld      (ct_yb),a
                ld      hl,(fu_tp)
                ld      a,(fu_r1)
                call    ev_at
                ld      (ct_tb),a
                ld      hl,(fu_bp)
                ld      a,(fu_r1)
                call    ev_at
                ld      (ct_bb),a
fl_dr2:
                ld      a,(fu_r0)
                ld      (ct_xa),a
                ld      a,(fu_r1)
                ld      (ct_xb),a
                call    ct_emit

fl_pieces:
                ld      a,(fu_r0)
                ld      b,a
                ld      a,(fu_r1)
                cp      b
                jp      c,fl_nrun
                ld      a,(fu_x0)
                ld      b,a
                ld      a,(fu_r0)
                cp      b
                jr      z,fl_lpd
                ld      a,(fu_x0)
                call    fu_above
                ld      c,a
                ld      a,(fu_r0)
                dec     a
                ld      d,a
                ld      a,(fu_x0)
                ld      b,a
                ld      a,c
                call    fu_okeep
fl_lpd:
                ld      a,(fu_r0)
                ld      b,a
                ld      a,(fu_r1)
                ld      d,a
                call    fu_orun
                ld      a,(fu_r1)
                ld      b,a
                ld      a,(fu_x1)
                cp      b
                ret     z
                ld      a,(fu_x1)
                call    fu_above
                ld      c,a
                ld      a,(fu_x1)
                ld      d,a
                ld      a,(fu_r1)
                inc     a
                ld      b,a
                ld      a,c
                jp      fu_okeep
fl_nrun:
                ; no run: the piece sits outside one boundary throughout, or
                ; leaves one and passes the other within it
                ld      a,(fu_x0)
                call    fu_above
                ld      (fu_k0),a
                ld      a,(fu_x1)
                call    fu_above
                ld      (fu_k1),a
                ld      b,a
                ld      a,(fu_k0)
                cp      b
                jr      nz,fl_nr2
                ld      a,(fu_x1)
                ld      d,a
                ld      a,(fu_x0)
                ld      b,a
                ld      a,(fu_k0)
                jp      fu_okeep
fl_nr2:
                ld      a,(fu_k0)
                or      a
                jr      z,fl_nr2b
                ld      a,(fu_t0)
                jr      fl_nr2c
fl_nr2b:
                ld      a,(fu_g0)
fl_nr2c:
                ld      b,a
                ld      a,(fu_x0)
                inc     a
                cp      b
                jr      nc,fl_nr2d
                ld      a,b
fl_nr2d:
                ld      b,a
                ld      a,(fu_x1)
                cp      b
                jr      nc,fl_nr2e
                ld      b,a
fl_nr2e:
                ld      a,b
                ld      (fu_c),a
                dec     a
                ld      d,a
                ld      a,(fu_x0)
                ld      b,a
                ld      a,(fu_k0)
                call    fu_okeep
                ld      a,(fu_x1)
                ld      d,a
                ld      a,(fu_c)
                ld      b,a
                ld      a,(fu_k1)
                jp      fu_okeep

; fu_verdict : the two-level test.  Carry set when the line never enters the
; aperture anywhere in the range; otherwise Z set when it is inside it
; everywhere, and Z clear when the boundaries have to be evaluated.
fu_verdict:
                ld      a,(ct_yb)               ; the line's own extremes
                ld      hl,ct_ya
                cp      (hl)
                jr      nc,fv_yo
                ld      (fu_lylo),a
                ld      a,(hl)
                ld      (fu_lyhi),a
                jr      fv_go
fv_yo:
                ld      (fu_lyhi),a
                ld      a,(hl)
                ld      (fu_lylo),a
fv_go:
                ld      a,(fu_lyhi)
                ld      hl,fu_t_o
                cp      (hl)
                ret     c                       ; wholly above the top
                ld      a,(fu_b_o)
                ld      hl,fu_lylo
                cp      (hl)
                ret     c                       ; wholly below the bottom
                ld      a,(fu_lylo)
                ld      hl,fu_t_i
                cp      (hl)
                jr      c,fv_slow
                ld      a,(fu_b_i)
                ld      hl,fu_lyhi
                cp      (hl)
                jr      c,fv_slow
                cp      a                       ; Z, carry clear: inside
                ret
fv_slow:
                ld      a,1
                or      a                       ; NZ, carry clear
                ret

; fu_ge : the sub-interval of [fu_x0, fu_x1] on which the line is at or past
; the staged boundary, into fu_g0/fu_g1, given the sign of the difference at
; each end in fu_v0/fu_v1.  The difference itself is only formed when they
; disagree and a crossing has to be divided out.  Empty comes back as (255,0).
fu_ge:
                ld      a,(fu_v0)
                ld      b,a
                ld      a,(fu_v1)
                or      b
                jr      nz,fu_ge_m
                ld      a,(fu_x0)
                ld      (fu_g0),a
                ld      a,(fu_x1)
                ld      (fu_g1),a
                ret
fu_ge_m:
                ld      a,(fu_v0)
                ld      b,a
                ld      a,(fu_v1)
                xor     b
                jr      nz,fu_ge_c
fu_ge_e:
                ld      a,255
                ld      (fu_g0),a
                xor     a
                ld      (fu_g1),a
                ret
fu_ge_c:
                call    pw_diff
                ld      a,(fu_x0)
                ld      (ct_xa),a
                ld      a,(fu_x1)
                ld      (ct_xb),a
                call    cross_col
                jr      nc,fu_ge_e
                ld      c,a
                ld      a,(fu_v0)
                or      a
                jr      z,fu_ge_hi
                ld      a,c
                ld      (fu_g0),a
                ld      a,(fu_x1)
                ld      (fu_g1),a
                ret
fu_ge_hi:
                ld      a,(fu_x0)
                ld      (fu_g0),a
                ld      a,c
                ld      (fu_g1),a
                ret

; fu_above : A = column -> A = 1 when it lies outside [fu_t0, fu_t1], the
; columns at or past the near boundary.
fu_above:
                ld      b,a
                ld      a,(fu_t0)
                cp      b
                jr      z,fa_1
                jr      c,fa_1
                ld      a,1
                ret
fa_1:
                ld      a,(fu_t1)
                cp      b
                jr      nc,fa_in
                ld      a,1
                ret
fa_in:
                xor     a
                ret

; fu_okeep : A = kind, B = x0, D = x1.  Pass the piece on unchanged when the
; line never reached the near boundary there; when it ran past the far one
; instead, the columns simply do not come back.
fu_okeep:
                ld      c,a
                ld      a,(fu_side)
                cp      c
                ret     nz
                ld      hl,(fu_tp)
                ld      (fu_otp),hl
                ld      hl,(fu_bp)
                ld      (fu_obp),hl
                ld      a,(fu_t_o)
                ld      (fu_o_to),a
                ld      a,(fu_t_i)
                ld      (fu_o_ti),a
                ld      a,(fu_b_o)
                ld      (fu_o_bo),a
                ld      a,(fu_b_i)
                ld      (fu_o_bi),a
                jr      fu_out

; fu_orun : B = x0, D = x1.  The run carries the line as its new boundary.
fu_orun:
                ld      a,(fu_side)
                or      a
                jr      z,fu_or_b
                ld      hl,(cl_lfnp)
                ld      (fu_otp),hl
                ld      hl,(fu_bp)
                ld      (fu_obp),hl
                ld      a,(fu_lylo)
                ld      (fu_o_to),a
                ld      a,(fu_lyhi)
                ld      (fu_o_ti),a
                ld      a,(fu_b_o)
                ld      (fu_o_bo),a
                ld      a,(fu_b_i)
                ld      (fu_o_bi),a
                jr      fu_out
fu_or_b:
                ld      hl,(fu_tp)
                ld      (fu_otp),hl
                ld      hl,(cl_lfnp)
                ld      (fu_obp),hl
                ld      a,(fu_t_o)
                ld      (fu_o_to),a
                ld      a,(fu_t_i)
                ld      (fu_o_ti),a
                ld      a,(fu_lyhi)
                ld      (fu_o_bo),a
                ld      a,(fu_lylo)
                ld      (fu_o_bi),a

; fu_out : B = x0, D = x1, fu_otp / fu_obp = its boundaries.  Dead apertures
; are dropped; the rest are staged for the bottom line or emitted as spans.
fu_out:
                ld      a,b
                ld      (fu_ax0),a
                ld      a,d
                ld      (fu_ax1),a
                ; The inner extremes settle most apertures outright: an
                ; inner top two rows clear of the inner bottom leaves the
                ; piece open right across itself.  Two rows, because the
                ; difference function and the two boundaries evaluated apart
                ; each truncate their own shift and can disagree by one.
                ld      a,(fu_o_ti)
                inc     a
                jr      z,fo_measure
                ld      hl,fu_o_bi
                cp      (hl)
                jr      nc,fo_measure
                ld      a,1
                ld      (al_both),a
                jr      fo_alive
fo_measure:
                ld      hl,(fu_otp)
                ld      (tg_tp),hl
                ld      hl,(fu_obp)
                ld      (tg_bp),hl
                ld      a,(fu_ax0)
                ld      b,a
                ld      a,(fu_ax1)
                ld      c,a
                call    sp_alive
                ret     nc
fo_alive:
                ld      a,(fu_stage)
                or      a
                jr      nz,fo_stage
                ld      a,(fu_ax0)
                ld      (sp_scratch+SP_XLO),a
                ld      a,(fu_ax1)
                ld      (sp_scratch+SP_XLAST),a
                ld      hl,(fu_otp)
                ld      de,sp_scratch+SP_TA
                ld      bc,4
                ldir
                ld      hl,(fu_obp)
                ld      de,sp_scratch+SP_BA
                ld      bc,4
                ldir
                ld      a,(al_both)
                ld      (sp_scratch+SP_OPEN),a
                ld      a,(fu_o_to)
                ld      (sp_scratch+SP_OT),a
                ld      a,(fu_o_ti)
                ld      (sp_scratch+SP_IT),a
                ld      a,(fu_o_bo)
                ld      (sp_scratch+SP_OB),a
                ld      a,(fu_o_bi)
                ld      (sp_scratch+SP_IB),a
                ld      hl,sp_scratch
                jp      sp_emit
fo_stage:
                ld      a,(fu_np)
                cp      3
                ret     nc
                ld      c,a
                inc     a
                ld      (fu_np),a
                ld      a,c
                add     a,a
                add     a,a
                add     a,c
                add     a,a                     ; * 10
                ld      l,a
                ld      h,0
                ld      de,fu_pb
                add     hl,de
                ld      a,(fu_ax0)
                ld      (hl),a
                inc     hl
                ld      a,(fu_ax1)
                ld      (hl),a
                inc     hl
                ld      de,(fu_otp)
                ld      (hl),e
                inc     hl
                ld      (hl),d
                inc     hl
                ld      de,(fu_obp)
                ld      (hl),e
                inc     hl
                ld      (hl),d
                inc     hl
                ld      a,(fu_o_to)
                ld      (hl),a
                inc     hl
                ld      a,(fu_o_ti)
                ld      (hl),a
                inc     hl
                ld      a,(fu_o_bo)
                ld      (hl),a
                inc     hl
                ld      a,(fu_o_bi)
                ld      (hl),a
                ret

; ---------------------------------------------------------------------------
; dl_emit : append (A, B) - (C, D) to the display list.
; ---------------------------------------------------------------------------
; Writes first and bounds-checks after: the slot beyond DLIST_END is slack,
; and refusing to advance simply makes further segments overwrite it.
dl_emit:
                ld      hl,(dlist_ptr)
                ld      (hl),a
                inc     hl
                ld      (hl),b
                inc     hl
                ld      (hl),c
                inc     hl
                ld      (hl),d
                inc     hl
                ld      a,h
                cp      DLIST_END_PAGE
                ret     nc                      ; list full
                ld      (dlist_ptr),hl
                ret

; ---------------------------------------------------------------------------
; sp_drawv : vertical segment at column (dl_x1) from (dl_y1) to (dl_y2),
; clipped to whichever span owns that column.
; ---------------------------------------------------------------------------
sp_drawv:
                ld      hl,(dl_x1)
                ld      a,h
                or      a
                ret     nz                      ; off screen either side
                ld      a,l
                ld      (ev_col_x),a
                ; order y
                ld      hl,(dl_y1)
                ld      de,(dl_y2)
                call    cmp_s16
                jr      c,dv_ordered
                jr      z,dv_ordered
                ld      hl,(dl_y1)
                ld      de,(dl_y2)
                ld      (dl_y1),de
                ld      (dl_y2),hl
dv_ordered:
                ld      hl,(sp_head)
dv_find:
                ld      a,h
                or      l
                ret     z
                ld      (cl_span),hl
                ld      a,(ev_col_x)
                ld      c,a
                ld      a,(hl)
                cp      c
                jr      z,dv_in
                jr      nc,dv_none              ; xlo > x: sorted, so give up
                inc     hl
                ld      a,(hl)
                cp      c
                jr      nc,dv_in2
                call    dv_step
                jp      dv_find
dv_none:
                ret
dv_step:
                ld      hl,(cl_span)
                ld      de,SP_NEXT
                add     hl,de
                ld      a,(hl)
                inc     hl
                ld      h,(hl)
                ld      l,a
                ret
dv_in:
                inc     hl
                ld      a,(hl)
                ld      c,a
                ld      a,(ev_col_x)
                cp      c
                jr      z,dv_in2
                jr      c,dv_in2
                call    dv_step
                jp      dv_find
dv_in2:
                ; The span's extremes settle a vertical the same way they
                ; settle a sloped edge: inside the inner pair it needs no
                ; clamp, outside the outer pair it is not there at all, and
                ; either way neither boundary is evaluated.
                ld      hl,(dl_y1)
                call    clampb
                ld      (dv_a),a
                ld      hl,(dl_y2)
                call    clampb
                ld      (dv_b),a
                ld      hl,(cl_span)
                ld      de,SP_OT
                add     hl,de
                ld      a,(dv_b)
                cp      (hl)
                ret     c                       ; wholly above the top
                inc     hl
                ld      d,(hl)                  ; D = inner top
                inc     hl
                ld      a,(hl)                  ; outer bottom
                ld      hl,dv_a
                cp      (hl)
                ret     c                       ; wholly below the bottom
                ld      hl,(cl_span)
                ld      bc,SP_IB
                add     hl,bc
                ld      a,(hl)                  ; E = inner bottom
                ld      e,a
                ld      a,d
                cp      e
                jr      nc,dv_slow              ; inner pair not open
                ld      a,(dv_a)
                cp      d
                jr      c,dv_slow
                ld      a,e
                ld      hl,dv_b
                cp      (hl)
                jr      c,dv_slow
                ld      a,(dv_b)
                sub     Y_BIAS
                ld      d,a
                ld      a,(dv_a)
                sub     Y_BIAS
                ld      b,a
                ld      a,(ev_col_x)
                ld      c,a
                jp      dl_emit
dv_slow:
                ; aperture at this column
                ld      hl,(cl_span)
                ld      de,SP_TA
                add     hl,de
                ld      a,(ev_col_x)
                call    ev_at
                ld      (dv_top),a
                ld      hl,(cl_span)
                ld      de,SP_BA
                add     hl,de
                ld      a,(ev_col_x)
                call    ev_at
                ld      (dv_bot),a
                ld      hl,dv_top
                cp      (hl)
                ret     c                       ; empty aperture
                ret     z
                ; a = max(y1, top), b = min(y2, bot)
                ld      a,(dv_a)
                ld      hl,dv_top
                cp      (hl)
                jr      nc,dv_a1
                ld      a,(dv_top)
dv_a1:          ld      (dv_a),a
                ld      a,(dv_b)
                ld      hl,dv_bot
                cp      (hl)
                jr      c,dv_b1
                ld      a,(dv_bot)
dv_b1:          ld      (dv_b),a
                ld      hl,dv_a
                cp      (hl)
                ret     c                       ; a > b: nothing visible
                sub     Y_BIAS
                ld      d,a
                ld      a,(dv_a)
                sub     Y_BIAS
                ld      b,a
                ld      a,(ev_col_x)
                ld      c,a
                jp      dl_emit

; ---------------------------------------------------------------------------
; queue_edge : remember one sloped edge of the current seg.  HL = y at sx1,
; DE = y at sx2; every edge of a seg shares the same x endpoints.
; ---------------------------------------------------------------------------
queue_edge:
                ld      (qe_y1),hl
                ld      (qe_y2),de
                ld      a,(sq_n)
                cp      SQ_MAX
                ret     nc
                ld      c,a
                inc     a
                ld      (sq_n),a
                ld      a,c
                add     a,a
                add     a,a
                ld      l,a
                ld      h,0
                ld      de,sq_y
                add     hl,de
                ld      de,(qe_y1)
                ld      (hl),e
                inc     hl
                ld      (hl),d
                inc     hl
                ld      de,(qe_y2)
                ld      (hl),e
                inc     hl
                ld      (hl),d
                ret

; ---------------------------------------------------------------------------
; fe_prepare : reduce the seg's queued edges to line functions, ready for the
; walk that draws them.  They all share the seg's x range, so the ordering and
; the column clamp are done once here and the walk clips them span by span
; alongside the boundary lines.
; ---------------------------------------------------------------------------
fe_prepare:
                ld      a,(sq_n)
                or      a
                ret     z
                ld      a,(sp_count)
                or      a
                jp      z,fe_clear
                ld      hl,(sg_sx1)
                ld      de,(sg_sx2)
                call    cmp_s16
                jr      c,fe_ord
                ld      hl,(sg_sx2)
                ld      (fe_x1),hl
                ld      hl,(sg_sx1)
                ld      (fe_x2),hl
                call    fe_swapy
                jr      fe_have
fe_ord:
                ld      hl,(sg_sx1)
                ld      (fe_x1),hl
                ld      hl,(sg_sx2)
                ld      (fe_x2),hl
fe_have:
                ld      hl,(fe_x2)
                bit     7,h
                jp      nz,fe_clear             ; wholly left of the screen
                ld      hl,(fe_x1)
                bit     7,h
                jr      nz,fe_on
                ld      a,h
                or      a
                jp      nz,fe_clear             ; wholly right of it
fe_on:
                ld      hl,(fe_x1)
                ld      (cl_lx1),hl
                ld      hl,(fe_x2)
                ld      (cl_lx2),hl
                ld      hl,sq_y
                ld      (fe_yp),hl
                ld      hl,sq_fn
                ld      (fe_fp),hl
                ld      a,(sq_n)
                ld      (fe_i),a
fe_fl:
                ld      hl,(fe_yp)
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      (cl_ly1),de
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      (cl_ly2),de
                ld      (fe_yp),hl
                ld      hl,(fe_fp)
                call    linfn
                ld      hl,(fe_fp)
                ld      de,4
                add     hl,de
                ld      (fe_fp),hl
                ld      a,(fe_i)
                dec     a
                ld      (fe_i),a
                jr      nz,fe_fl
                ret
fe_clear:
                xor     a
                ld      (sq_n),a
                ret

; ---------------------------------------------------------------------------
; fu_extras : the boundary values at the staged column range, shared by every
; line clipped against this span, and then the seg's own edges through them.
; ---------------------------------------------------------------------------
fu_extras:
                ld      hl,(cl_span)
                ld      de,SP_OT
                add     hl,de
                ld      a,(hl)
                ld      (fu_t_o),a
                inc     hl
                ld      a,(hl)
                ld      (fu_t_i),a
                inc     hl
                ld      a,(hl)
                ld      (fu_b_o),a
                inc     hl
                ld      a,(hl)
                ld      (fu_b_i),a
                xor     a
                ld      (ct_have),a
                ld      a,(sq_n)
                or      a
                ret     z
                ld      hl,sq_fn
                ld      (fe_fp),hl
                ld      (fe_i),a
fx_loop:
                ld      hl,(fe_fp)
                call    ct_edge
                ld      hl,(fe_fp)
                ld      de,4
                add     hl,de
                ld      (fe_fp),hl
                ld      a,(fe_i)
                dec     a
                ld      (fe_i),a
                jr      nz,fx_loop
                ret

; fe_swapy : the seg's x endpoints were the wrong way round, so swap every
; queued edge's y pair to match.
fe_swapy:
                ld      hl,sq_y
                ld      a,(sq_n)
                ld      b,a
fs_l:
                ld      e,(hl)
                inc     hl
                ld      d,(hl)
                inc     hl
                ld      c,(hl)
                ld      (hl),e
                inc     hl
                ld      a,(hl)
                ld      (hl),d
                inc     hl
                ld      d,a
                ld      e,c
                dec     hl
                dec     hl
                dec     hl
                dec     hl
                ld      (hl),e
                inc     hl
                ld      (hl),d
                inc     hl
                inc     hl
                inc     hl
                djnz    fs_l
                ret

; ---------------------------------------------------------------------------
; ct_bounds : the trapezoid boundaries at ct_xa0 and ct_xb0 - the part of the
; clip that every line crossing this span shares.
; ---------------------------------------------------------------------------
; ct_need : evaluate the span's boundaries at the staged range, once.
ct_need:
                ld      a,(ct_have)
                or      a
                ret     nz
                inc     a
                ld      (ct_have),a
ct_bounds:
                ld      hl,(cl_span)
                ld      de,SP_TA
                add     hl,de
                ld      a,(ct_xa0)
                call    ev_at
                ld      (ct_ta0),a
                ld      hl,(cl_span)
                ld      de,SP_BA
                add     hl,de
                ld      a,(ct_xa0)
                call    ev_at
                ld      (ct_ba0),a
                ld      hl,(cl_span)
                ld      de,SP_TA
                add     hl,de
                ld      a,(ct_xb0)
                call    ev_at
                ld      (ct_tb0),a
                ld      hl,(cl_span)
                ld      de,SP_BA
                add     hl,de
                ld      a,(ct_xb0)
                call    ev_at
                ld      (ct_bb0),a
                ret

; ---------------------------------------------------------------------------
; ct_edge : clip one edge (HL = its line function) to the staged span.
; ---------------------------------------------------------------------------
ct_edge:
                ld      (cl_lfnp),hl
                ld      a,(ct_xa0)
                call    ev_at
                ld      (ct_ya),a
                ld      hl,(cl_lfnp)
                ld      a,(ct_xb0)
                call    ev_at
                ld      (ct_yb),a
                call    fu_verdict
                ret     c                       ; never enters the aperture
                jr      nz,ct_slow
                ; wholly inside: emit the overlap with no clamping at all
                ld      a,(ct_ya)
                sub     Y_BIAS
                ld      b,a
                ld      a,(ct_yb)
                sub     Y_BIAS
                ld      d,a
                ld      a,(ct_xb0)
                ld      c,a
                ld      a,(ct_xa0)
                jp      dl_emit
ct_slow:
                call    ct_need
                ld      a,(ct_xa0)
                ld      (ct_xa),a
                ld      a,(ct_xb0)
                ld      (ct_xb),a
                ld      a,(ct_ta0)
                ld      (ct_ta),a
                ld      a,(ct_ba0)
                ld      (ct_ba),a
                ld      a,(ct_tb0)
                ld      (ct_tb),a
                ld      a,(ct_bb0)
                ld      (ct_bb),a

                ; --- y >= top(x) ---------------------------------------
                ld      a,(ct_ya)
                ld      hl,ct_ta
                cp      (hl)
                jr      c,ct_topcross
                ld      a,(ct_yb)
                ld      hl,ct_tb
                cp      (hl)
                jr      nc,ct_bot
                call    ct_topdiff
                call    cross_col
                ret     nc
                ld      (ct_xb),a
                call    ct_eval_b
                jr      ct_order
ct_topcross:
                ld      a,(ct_yb)
                ld      hl,ct_tb
                cp      (hl)
                ret     c                       ; both ends above the top
                call    ct_topdiff
                call    cross_col
                ret     nc
                ld      (ct_xa),a
                call    ct_eval
ct_order:
                ld      a,(ct_xa)
                ld      b,a
                ld      a,(ct_xb)
                cp      b
                ret     c

                ; --- y <= bot(x) ---------------------------------------
ct_bot:
                ld      a,(ct_ba)
                ld      hl,ct_ya
                cp      (hl)
                jr      c,ct_botcross
                ld      a,(ct_bb)
                ld      hl,ct_yb
                cp      (hl)
                jr      nc,ct_emit
                call    ct_botdiff
                call    cross_col
                ret     nc
                ld      (ct_xb),a
                call    ct_eval_b
                jr      ct_order2
ct_botcross:
                ld      a,(ct_bb)
                ld      hl,ct_yb
                cp      (hl)
                ret     c                       ; both ends below the bottom
                call    ct_botdiff
                call    cross_col
                ret     nc
                ld      (ct_xa),a
                call    ct_eval
ct_order2:
                ld      a,(ct_xa)
                ld      b,a
                ld      a,(ct_xb)
                cp      b
                ret     c

ct_emit:
                ld      a,(ct_ya)
                ld      hl,ct_ta
                cp      (hl)
                jr      nc,ct_e1
                ld      a,(ct_ta)
                jr      ct_e2
ct_e1:          ld      hl,ct_ba
                cp      (hl)
                jr      c,ct_e2
                ld      a,(ct_ba)
ct_e2:          sub     Y_BIAS
                ld      (ct_ya),a
                ld      a,(ct_yb)
                ld      hl,ct_tb
                cp      (hl)
                jr      nc,ct_e3
                ld      a,(ct_tb)
                jr      ct_e4
ct_e3:          ld      hl,ct_bb
                cp      (hl)
                jr      c,ct_e4
                ld      a,(ct_bb)
ct_e4:          sub     Y_BIAS
                ld      d,a
                ld      a,(ct_ya)
                ld      b,a
                ld      a,(ct_xb)
                ld      c,a
                ld      a,(ct_xa)
                jp      dl_emit

; ct_eval / ct_eval_b : re-evaluate line, top and bottom after a crossing
; moved one end of the range.
ct_eval:
                ld      (ct_col),a
                ld      hl,(cl_lfnp)
                call    ev_at
                ld      (ct_ya),a
                ld      hl,(cl_span)
                ld      de,SP_TA
                add     hl,de
                ld      a,(ct_col)
                call    ev_at
                ld      (ct_ta),a
                ld      hl,(cl_span)
                ld      de,SP_BA
                add     hl,de
                ld      a,(ct_col)
                call    ev_at
                ld      (ct_ba),a
                ret
ct_eval_b:
                ld      (ct_col),a
                ld      hl,(cl_lfnp)
                call    ev_at
                ld      (ct_yb),a
                ld      hl,(cl_span)
                ld      de,SP_TA
                add     hl,de
                ld      a,(ct_col)
                call    ev_at
                ld      (ct_tb),a
                ld      hl,(cl_span)
                ld      de,SP_BA
                add     hl,de
                ld      a,(ct_col)
                call    ev_at
                ld      (ct_bb),a
                ret

ct_topdiff:
                ld      hl,(cl_span)
                ld      de,SP_TA
                add     hl,de
                ld      (pw_g),hl
                ld      hl,(cl_lfnp)
                ld      (pw_f),hl
                jp      pw_diff
ct_botdiff:
                ld      hl,(cl_span)
                ld      de,SP_BA
                add     hl,de
                ld      (pw_f),hl
                ld      hl,(cl_lfnp)
                ld      (pw_g),hl
                jp      pw_diff

; ---------------------------------------------------------------------------
; cross_col : first column in [ct_xa, ct_xb] where the staged difference
; function is non-negative.  Carry set and A = that column on success.
; ---------------------------------------------------------------------------
cross_col:
                ld      de,(pw_da)
                ld      a,d
                or      e
                jr      z,cc_fail
                ld      hl,(pw_db)
                ex      de,hl
                ld      hl,0
                or      a
                sbc     hl,de
                ex      de,hl
                ld      bc,(pw_da)
                call    divs
                ld      a,(ct_xa)
                ld      e,a
                ld      d,0
                call    cmp_s16
                jr      nc,cc_1
                ex      de,hl
cc_1:
                ld      a,(ct_xb)
                ld      e,a
                ld      d,0
                call    cmp_s16
                jr      c,cc_2
                ex      de,hl
cc_2:
                ld      a,l
                ld      (nw_xc),a
                call    pw_evd
                bit     7,h
                jr      z,cc_have
                ld      de,(pw_da)
                bit     7,d
                jr      nz,cc_down
                ld      a,(nw_xc)
                inc     a
                jr      z,cc_fail
                ld      b,a
                ld      a,(ct_xb)
                cp      b
                jr      c,cc_fail
                ld      a,b
                ld      (nw_xc),a
                jr      cc_have
cc_down:
                ld      a,(nw_xc)
                or      a
                jr      z,cc_fail
                dec     a
                ld      b,a
                ld      a,(ct_xa)
                cp      b
                jr      z,cc_dok
                jr      nc,cc_fail
cc_dok:
                ld      a,b
                ld      (nw_xc),a
cc_have:
                ld      a,(nw_xc)
                scf
                ret
cc_fail:
                or      a
                ret
